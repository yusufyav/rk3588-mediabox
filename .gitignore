# Generated test assets (scripts/make-test-assets.sh) and media.
# Anchored to the repository root: the product UI keeps its page and
# stylesheet in its own assets/ directory, and those are source.
/assets/
*.mp4
*.hevc

# Build output
build/
*.o
*.a
*.bin.tmp
__pycache__/
*.py[cod]

# Agent session telemetry and local tool settings
.claude/

# Cross-compilation sysroot copied from the appliance (scripts/build-mediabox-tv.sh).
/.sysroot/

# Cihaz çıktıları kaynak kodu değil. Bir oturumun kanıtı commit mesajında ve
# results/DURUM.md içinde yaşar; ham dökümler repo dışında arşivlenir.
logs/

# Release bundles. The appliance archive is a GitHub Release asset, not a blob
# in the tree; releases/current.env pins the one this repository installs.
/dist/
