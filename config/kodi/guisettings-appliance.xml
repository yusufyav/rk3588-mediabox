<!--
  What Kodi needs to be part of this appliance, and nothing more.

  This file is a *seed*: kodi.service installs it the first time Kodi runs on a
  box and never touches it again, so anything written here becomes a setting
  the owner then has to undo by hand. That is the reason the list is short.

  The longer profile this replaced was measured on the board this product was
  first built on, against its kernel and its sound path. Carried onto a clean
  install on vendor 6.1.172 it took the television with it: the film came up
  cyan with the picture folded into a corner, and AC-3 played back wrong. Those
  settings may well be right again once each one is measured on this kernel;
  until then they are not seeded, because Kodi's own defaults were what worked
  here before anything was seeded at all.

  What stays, and why each one is not a matter of taste:
-->
<settings version="2">
  <!-- Hardware decode to DRM PRIME. Without it Kodi software-decodes HEVC on a
       board that has a dedicated decoder, which is a different failure: not a
       broken picture, a slideshow. The second switch gates the first - while it
       is false the one above reads true and does nothing. -->
  <setting id="videoplayer.useprimedecoderforhw">true</setting>
  <setting id="videoplayer.useprimedecoder">true</setting>

  <!-- The HDMI sink, named rather than left on "Default": this board also has
       an ES8323 analogue codec that would happily take the stream and play it
       into nothing anyone is listening to. Rendered on every start by
       packaging/mediabox-hdmi-prepare for whichever output the box is on - on
       a board with two HDMI sockets that is not the same card in both. -->
  <setting id="audiooutput.audiodevice">@ALSA_DEVICE@</setting>
  <setting id="audiooutput.passthroughdevice">@ALSA_DEVICE@</setting>

  <!-- Which compressed formats go to the television untouched, and which are
       decoded here first. This is a property of the sink, not of the kernel:
       it was measured at the television, and what that television reproduces
       is AC-3. Everything else it declares - DTS, TrueHD, DTS-HD - is
       announced and then played as silence, so those are decoded into PCM
       instead of being sent as something that plays as nothing.
       CAESinkALSA pushes every type it can do onto an HDMI device on purpose
       ("we don't trust ELD information"), so Kodi will offer all of them in
       its own settings screen regardless of what is written here. -->
  <setting id="audiooutput.passthrough">true</setting>
  <setting id="audiooutput.ac3passthrough">true</setting>
  <setting id="audiooutput.eac3passthrough">false</setting>
  <setting id="audiooutput.dtspassthrough">false</setting>
  <setting id="audiooutput.truehdpassthrough">false</setting>
  <setting id="audiooutput.dtshdpassthrough">false</setting>

  <!-- Re-encoding a stream this sink cannot take into one it can sounds like
       the obvious answer and is not: with it on, a DTS source is re-encoded to
       AC-3 and this sink produces silence or noise from the result, while the
       stream Kodi builds is clean at every layer a machine can see - same
       48 kHz S16_LE carrier and same AES0=0x06 as the AC-3 passthrough that
       does work. Off, the same source is decoded and comes out as sound. -->
  <setting id="audiooutput.ac3transcode">false</setting>

  <!-- Two channels on the PCM path. Six-channel LPCM is declared by the
       television and is silent on it, which is the same failure again with a
       different name. -->
  <setting id="audiooutput.channels">1</setting>

  <!-- JSON-RPC over HTTP. This is how the control plane hands a film to Kodi;
       with it off - Kodi's own default - a handover starts Kodi on an empty
       library and the film stays behind. -->
  <setting id="services.webserver">true</setting>
  <setting id="services.webserverport">8080</setting>
  <setting id="services.webserverauthentication">false</setting>
  <setting id="services.esenabled">true</setting>
</settings>
