<!--
  Kodi's settings for this appliance, taken from the board that works.

  This file is not a set of opinions. It is the profile read off the appliance
  that had been running for months, with one line removed: services.deviceuuid,
  which is that box's identity rather than the product's. Two more are turned
  back into @ALSA_DEVICE@, which mediabox-hdmi-prepare renders per board.

  It is here because it was once NOT here, and the cost of that was a clean
  install that looked complete and could not show a Dolby Vision film or play
  anything that was not plain AC-3. The capture takes /opt; Kodi's profile
  lives under /var/tmp/kodi-home, which the capture treated as mutable state
  and dropped. It was never state -- it is configuration, and every value in it
  was arrived at by measurement against this television.

  So: do not "clean this up". A setting removed from here is a setting Kodi
  fills from its own defaults, and Kodi's defaults are what broke each of the
  three things above. If one of these turns out to be wrong on a new kernel,
  change that one, measure it, and say so in a comment next to it.

  The two that are easy to get wrong:

    * videoscreen.whitelist + videoscreen.resolution - the mode list this
      display actually accepts. With these missing, Kodi builds its own list
      and the picture came back blue and magenta on a DV profile 7 title.
    * audiooutput.ac3transcode + audiooutput.channels - one decision, not two.
      Kodi only transcodes while the output is configured as 2.0; set the
      output to 5.1 and it stops transcoding and sends six-channel LPCM, which
      this television declares and does not reproduce. "2.0" here does not mean
      stereo: it means Kodi builds a 5.1 AC-3 stream and sends the whole thing.
-->
<settings version="2">
  <setting id="videoplayer.useprimedecoder">true</setting>
  <setting id="videoplayer.useprimerenderer">0</setting>

  <setting id="videoscreen.resolution">17</setting>
  <setting id="videoscreen.whitelist">0409602160060.00000pstd,0409602160059.94010pstd,0409602160050.00000pstd,0409602160024.00000pstd,0409602160023.97600pstd,0384002160060.00000pstd,0384002160059.94010pstd,0384002160050.00000pstd,0384002160030.00000pstd,0384002160029.97000pstd,0384002160025.00000pstd,0384002160024.00000pstd,0384002160023.97600pstd,0192001080060.00000pstd,0192001080059.94020pstd,0192001080050.00000pstd,0192001080030.00000pstd,0192001080029.97010pstd,0192001080024.00000pstd,0192001080023.97608pstd,0168001050059.88325pstd,0160000900060.00000pstd,0128001024060.01974pstd,0128000720060.00000pstd,0128000720059.94020pstd,0128000720050.00000pstd,0128000720030.00000pstd,0128000720029.97010pstd,0128000720024.00000pstd,0128000720023.97616pstd,0115200864075.00000pstd,0102400768060.00384pstd</setting>

  <setting id="audiooutput.ac3transcode">true</setting>
  <setting id="audiooutput.audiodevice">@ALSA_DEVICE@</setting>
  <setting id="audiooutput.dtshdcorefallback">false</setting>
  <setting id="audiooutput.dtshdpassthrough">false</setting>
  <setting id="audiooutput.dtspassthrough">false</setting>
  <setting id="audiooutput.eac3passthrough">false</setting>
