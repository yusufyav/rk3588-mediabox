# The appliance this repository installs.
#
# An exact tag and an exact digest, never "latest": a moving pointer makes two
# boards installed a week apart two different products, and the first thing that
# goes wrong on one of them is unreproducible on the other.
#
# Written by scripts/release/create-mediabox-release.sh after the asset has been
# uploaded and its digest read back from GitHub.
MEDIABOX_RELEASE_REPO=yusufyav/rk3588-mediabox
MEDIABOX_RELEASE_TAG=appliance-golden-2026-10-05
MEDIABOX_RELEASE_ASSET=mediabox-appliance-2026-10-05-arm64.tar.zst
MEDIABOX_RELEASE_SHA256=8f4c17be1925f6e43b05d351f8e7744b85fa30423698ca07069c4d71f1419ef2
MEDIABOX_RELEASE_SIZE=382421172
MEDIABOX_RELEASE_ARCH=aarch64
# What the binaries were captured on. The installer reports it and does not
# require it: a clean board comes up on whatever vendor 6.1 kernel its image
# has, and the contract is the capability gate, not the version string.
MEDIABOX_REFERENCE_KERNEL=6.1.115-vendor-rk35xx
