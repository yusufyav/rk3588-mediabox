import { Theme, Metrics } from "theme.slint";
import { Home } from "home.slint";
import { Media } from "media.slint";
import { Search, SearchEntry } from "search.slint";
import { Library } from "library.slint";
import { Discover, DiscoverFilter } from "discover.slint";
import { Detail, SourceRow, EpisodeRow } from "detail.slint";
import { NowPlaying } from "now_playing.slint";
import { VolumeOsd } from "volume.slint";
import { Player, MenuRow } from "player.slint";
import { Settings } from "settings.slint";
import { CoolingView, CoolChip, CoolRow, CoolInfo, CoolPoint, CoolTick, CoolSeg } from "cooling.slint";
import { OutputView, OutRow, OutCell, OutAction, OutInfo, OutSimple } from "output.slint";
import { SettingNav, Badge, InfoLine, Toast, ChoiceItem } from "kit.slint";
import { EthernetView } from "ethernet.slint";
import { AudioView, AudioCard } from "audio.slint";
import { Account } from "account.slint";
import { WifiScreen, BluetoothScreen, WifiRow, BtRow } from "wireless.slint";
import { Diagnostics } from "diagnostics.slint";
import { AccountChip } from "chrome.slint";
export { AccountChip }
import {
    RailModel, PosterItem, AppTile, VitalsModel, TechRow, SettingRow, DiagGroup,
    SheetRow, KeyCap, KeyRow, NpControl, TopBar, Sheet,
} from "components.slint";

export {
    RailModel, PosterItem, AppTile, VitalsModel, SourceRow, TechRow, SettingRow,
    DiagGroup, SheetRow, KeyCap, KeyRow, NpControl, CoolingView, CoolChip, CoolRow,
    CoolInfo, CoolPoint, CoolTick, CoolSeg, OutputView, OutRow, OutCell, OutAction, OutInfo,
    OutSimple, ChoiceItem, SettingNav, Badge, InfoLine, EthernetView, AudioView, AudioCard, SearchEntry,
    EpisodeRow, DiscoverFilter,
}

// What the television shows before there is anything to show.
//
// Not a splash screen for its own sake: the home surface is assembled from
// third-party catalogues over the network, and the honest thing to put on the
// panel in the meantime is the product's name and what it is waiting for.
component Boot inherits Rectangle {
    in property <string> status;
    in property <bool> failed;

    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        spacing: Metrics.root-font;
        padding-left: Metrics.gutter;
        padding-right: Metrics.gutter;

        Text {
            text: "MediaBox";
            color: Theme.text;
            font-size: Metrics.title-hero;
            font-weight: 820;
            letter-spacing: -0.038 * Metrics.title-hero;
            horizontal-alignment: center;
        }

        Text {
            text: root.status;
            color: root.failed ? Theme.bad : Theme.muted;
            font-size: Metrics.text-meta;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component MediaBoxWindow inherits Window {
    title: "MediaBox";
    // The appliance's own platform makes this the size of the panel's mode, so
    // this only decides the shape of the window when the interface is run on a
    // desktop to look at a layout. It is the design's own size for that reason.
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: screen == "film" ? #00000000 : Theme.bg;
    default-font-size: Metrics.root-font;
    // Installed on the appliance from Debian's own archive rather than carried
    // in this repository: Slint reads the system's fonts, and a typeface is not
    // source code. If it is missing the interface still comes up in DejaVu —
    // wrong, but visible and reportable.
    default-font-family: "Inter";

    // Which screen is on the panel. Rust owns this; the interface never decides
    // where it is on its own.
    in property <string> screen: "boot";
    /// Whether the film's own controls are up. They come up on a key and go
    /// down by themselves; a film with a control bar permanently across it is
    /// not a television.
    in property <bool> film-controls;

    in property <string> status: "Başlatılıyor…";
    in property <bool> failed: false;
    in property <string> notice;
    // The volume indicator, over everything.
    in property <bool> volume-shown;
    in property <int> volume-level;
    in property <bool> volume-muted;
    in property <bool> volume-bitstream;
    in property <[string]> nav;
    in property <VitalsModel> vitals;

    // ---- home
    in property <[AppTile]> apps;
    in property <int> focus-col;

    // ---- the catalogue
    in property <[RailModel]> media-rails;
    in property <int> media-row;
    in property <[string]> media-menu;
    in property <int> media-menu-line: -1;
    in property <int> media-col;
    // Every shelf's own column, which is where each is scrolled to.
    in property <[int]> media-columns;
    in property <int> media-zone;
    in property <int> media-place;
    in property <[string]> media-places;

    // ---- discover
    in property <[DiscoverFilter]> discover-filters;
    in property <int> discover-filter;
    in property <bool> discover-on-filters;
    in property <int> discover-picker: -1;
    in property <[PosterItem]> discover-items;
    in property <int> discover-index;
    in property <int> discover-columns: 5;
    in property <bool> discover-loading;
    in property <bool> discover-ended;
    in property <string> discover-note;
    in property <bool> discover-on-grid;
    in property <int> discover-zone;
    in property <int> discover-place;
    in property <int> discover-button;
    in property <image> discover-art;
    in property <bool> discover-logo-pending;
    in property <image> discover-logo;
    in property <string> discover-title;
    in property <[string]> discover-facts;
    in property <bool> discover-imdb;
    in property <[string]> discover-summary;
    in property <[[string]]> discover-genres;
    in property <[[string]]> discover-cast;
    in property <[[string]]> discover-directors;
    in property <bool> discover-has-trailer;
    in property <bool> discover-known;
    in property <bool> discover-in-library;
    in property <bool> discover-watched;
    in property <bool> discover-series;

    // ---- search
    in property <string> search-query;
    in property <string> search-note;
    in property <[KeyRow]> search-keys;

    // ------------------------------------------------------------ the radios
    in property <bool> wifi-known;
    in property <bool> wifi-present;
    in property <bool> wifi-powered;
    in property <string> wifi-summary;
    in property <string> wifi-address;
    in property <[WifiRow]> wifi-networks;
    in property <int> wifi-index;
    in property <bool> wifi-busy;
    in property <bool> wifi-scanning;
    in property <string> wifi-notice;
    /// "list" | "password"
    in property <string> wifi-face;
    in property <string> wifi-target;
    in property <string> wifi-password-mask;
    in property <bool> wifi-show;
    /// "field" | "keys" | "join"
    in property <string> wifi-focus;
    in property <[KeyRow]> wifi-keys;
    in property <int> wifi-key-row;
    in property <int> wifi-key-col;

    in property <bool> bt-known;
    in property <bool> bt-present;
    in property <bool> bt-powered;
    in property <string> bt-summary;
    in property <[BtRow]> bt-devices;
    in property <int> bt-index;
    in property <bool> bt-busy;
    in property <string> bt-notice;
    in property <string> bt-press-label;
    in property <int> search-key-row;
    in property <int> search-key-col;
    in property <int> search-pane;
    in property <bool> search-searching;
    in property <bool> search-showing-results;
    in property <[SearchEntry]> search-entries;
    in property <int> search-list-index;
    in property <[RailModel]> search-rails;
    in property <int> search-rail-row;
    in property <int> search-rail-col;
    in property <[int]> search-rail-cols;
    in property <bool> search-editing;
    in property <int> search-place;

    // ---- library
    in property <[string]> library-tabs;
    in property <int> library-tab;
    in property <int> library-type-open: -1;
    in property <[string]> library-sorts;
    in property <int> library-sort;
    in property <bool> library-sortable;
    in property <int> library-zone;
    in property <int> library-filter;
    in property <[string]> library-actions;
    in property <int> library-action;
    in property <int> library-place: 2;
    in property <[PosterItem]> library-items;
    in property <int> library-index;
    in property <int> library-columns: 9;

    // ---- detail
    in property <image> detail-art-a;
    in property <image> detail-art-b;
    in property <float> detail-fade;
    in property <image> detail-poster;
    in property <string> detail-title;
    in property <[string]> detail-facts;
    in property <bool> detail-imdb;
    in property <string> detail-summary;
    in property <[string]> detail-genres;
    in property <[string]> detail-cast;
    in property <[string]> detail-directors;
    in property <[string]> detail-actions;
    in property <[string]> detail-marks;
    in property <[string]> detail-cuts;
    in property <[bool]> detail-enabled;
    in property <image> detail-logo;
    in property <bool> detail-logo-pending;
    in property <[SourceRow]> detail-sources;
    in property <string> detail-note;
    in property <bool> detail-on-sources;
    in property <bool> detail-on-filter;
    in property <[string]> detail-providers;
    in property <int> detail-provider;
    in property <bool> detail-filter-open;
    in property <int> detail-filter-focus;
    in property <int> detail-source-focus;
    in property <bool> detail-show-episodes;
    in property <bool> detail-on-episodes;
    in property <[string]> detail-seasons;
    in property <int> detail-season-index;
    in property <bool> detail-on-seasons;
    in property <[EpisodeRow]> detail-episodes;
    in property <int> detail-episode-focus;
    in property <bool> detail-on-mark;
    in property <string> detail-episode-heading;
    in property <int> detail-col;

    // ---- now playing
    in property <image> np-art;
    /// The film's name as a picture, for the screen it opens on.
    in property <image> np-logo;
    in property <string> np-title;
    in property <string> np-subtitle;
    in property <string> np-note;
    // What to say while a film is opening and there is nothing on the panel
    // yet. Its own property rather than the note, because the note is only
    // drawn with the controls and this has to be drawn without them.
    in property <string> np-waiting;
    in property <string> np-surface;
    in property <string> np-elapsed;
    in property <string> np-duration;
    in property <float> np-progress;
    in property <[NpControl]> np-controls;
    /// The same four, as words. The film's own line has no buttons on it.
    in property <[string]> np-actions;
    in property <[string]> np-marks;
    in property <[string]> np-lines;
    in property <[int]> np-rules;
    in property <string> np-menu;
    in property <string> np-menu-title;
    in property <[MenuRow]> np-menu-rows;
    in property <[MenuRow]> np-menu-tracks;
    in property <int> np-menu-focus;
    in property <int> np-menu-track-focus;
    in property <int> np-menu-column;
    in property <string> np-menu-side-label;
    in property <string> np-menu-side-value;
    in property <string> np-pill;
    /// The subtitle line on screen now, drawn here because the player draws
    /// nothing of its own; and how the subtitle that is on was timed.
    in property <string> np-caption;
    in property <string> np-menu-note;
    /// The panel's list goes on above or below what is drawn.
    in property <bool> np-menu-above;
    in property <bool> np-menu-below;
    in property <int> np-focus;
    /// Which row the remote is on while a film is playing: 0 the rule, 1 the
    /// words.
    in property <int> np-row;
    /// The time the scrub tick is sitting on, empty when nothing is moving.
    in property <string> np-scrub;
    in property <[TechRow]> np-technical;

    // ---- settings
    in property <[SettingNav]> settings-sections;
    in property <int> settings-section;
    in property <bool> settings-on-sections: true;
    in property <[SettingRow]> settings-rows;
    in property <int> settings-row;
    // The page open on the right-hand side, "" for a category's own list.
    in property <string> settings-page;
    in property <string> settings-page-icon;
    in property <string> settings-title;
    in property <string> settings-blurb;
    in property <bool> settings-cooling;
    in property <CoolingView> settings-cooling-view;
    in property <bool> settings-output;
    in property <OutputView> settings-output-view;
    in property <bool> settings-ethernet;
    in property <EthernetView> settings-ethernet-view;
    in property <bool> settings-audio;
    in property <AudioView> settings-audio-view;
    // A short list opened from a settings card: the lights' mode.
    in property <bool> settings-choice-open;
    in property <string> settings-choice-title;
    in property <[ChoiceItem]> settings-choice;
    in property <int> settings-choice-focus;
    in property <string> settings-choice-note;

    // ---- the Stremio account
    in property <string> account-email;
    in property <string> account-password-mask;
    in property <bool> account-show;
    in property <string> account-email-before;
    in property <string> account-email-after;
    in property <string> account-secret-before;
    in property <string> account-secret-after;
    in property <string> account-focus: "email";
    in property <string> account-editing: "email";
    in property <[KeyRow]> account-keys;
    in property <int> account-key-row;
    in property <int> account-key-col;
    in property <bool> account-shifted;
    in property <bool> account-signed-in;
    in property <string> account-who;
    in property <int> account-addons;
    in property <bool> account-busy;
    in property <string> account-notice;
    in property <string> account-submit-label: "Giriş yap";
    in property <bool> account-submit-ready;

    // ---- diagnostics
    in property <[DiagGroup]> diag-groups;
    in property <[SettingNav]> diag-nav;
    in property <int> diag-group;

    // ---- the sheet over everything
    in property <bool> sheet-open: false;
    in property <string> sheet-kind: "power";
    in property <string> sheet-title;
    in property <[SheetRow]> sheet-rows;
    in property <int> sheet-index;

    // Every key the television can send arrives here and is answered in Rust:
    // the focus model is deterministic and structural, and splitting it between
    // two languages is how it stops being either.
    callback key-pressed(string);
    callback key-released(string);

    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text);
            accept
        }
        key-released(event) => {
            root.key-released(event.text);
            accept
        }

        if screen == "boot": Boot {
            width: 100%;
            height: 100%;
            status: root.status;
            failed: root.failed;
        }

        if screen == "home": Home {
            width: 100%;
            height: 100%;
            apps: root.apps;
            vitals: root.vitals;
            focus-col: root.focus-col;
        }

        if screen == "media": Media {
            width: 100%;
            height: 100%;
            rails: root.media-rails;
            focus-row: root.media-row;
            menu: root.media-menu;
            menu-line: root.media-menu-line;
            focus-col: root.media-col;
            columns: root.media-columns;
            zone: root.media-zone;
            place: root.media-place;
            places: root.media-places;
        }

        if screen == "search": Search {
            width: 100%;
            height: 100%;
            query: root.search-query;
            note: root.search-note;
            keys: root.search-keys;
            key-row: root.search-key-row;
            key-col: root.search-key-col;
            pane: root.search-pane;
            searching: root.search-searching;
            showing-results: root.search-showing-results;
            entries: root.search-entries;
            list-index: root.search-list-index;
            rails: root.search-rails;
            rail-row: root.search-rail-row;
            rail-col: root.search-rail-col;
            rail-cols: root.search-rail-cols;
            editing: root.search-editing;
            place: root.search-place;
            places: root.media-places;
        }

        if screen == "discover": Discover {
            width: 100%;
            height: 100%;
            filters: root.discover-filters;
            filter: root.discover-filter;
            on-filters: root.discover-on-filters;
            picker: root.discover-picker;
            items: root.discover-items;
            index: root.discover-index;
            columns: root.discover-columns;
            loading: root.discover-loading;
            ended: root.discover-ended;
            note: root.discover-note;
            on-grid: root.discover-on-grid;
            zone: root.discover-zone;
            place: root.discover-place;
            places: root.media-places;
            button: root.discover-button;
            art: root.discover-art;
            logo: root.discover-logo;
            logo-pending: root.discover-logo-pending;
            title: root.discover-title;
            facts: root.discover-facts;
            imdb: root.discover-imdb;
            summary: root.discover-summary;
            genres: root.discover-genres;
            cast: root.discover-cast;
            directors: root.discover-directors;
            has-trailer: root.discover-has-trailer;
            known: root.discover-known;
            in-library: root.discover-in-library;
            watched: root.discover-watched;
            series: root.discover-series;
        }

        if screen == "library": Library {
            width: 100%;
            height: 100%;
            tabs: root.library-tabs;
            tab: root.library-tab;
            type-open: root.library-type-open;
            sorts: root.library-sorts;
            sort: root.library-sort;
            sortable: root.library-sortable;
            zone: root.library-zone;
            filter: root.library-filter;
            actions: root.library-actions;
            action: root.library-action;
            place: root.library-place;
            places: root.media-places;
            items: root.library-items;
            index: root.library-index;
            columns: root.library-columns;
        }

        if screen == "detail": Detail {
            width: 100%;
            height: 100%;
            art-a: root.detail-art-a;
            art-b: root.detail-art-b;
            fade: root.detail-fade;
            poster: root.detail-poster;
            title: root.detail-title;
            facts: root.detail-facts;
            imdb: root.detail-imdb;
            summary: root.detail-summary;
            logo: root.detail-logo;
            logo-pending: root.detail-logo-pending;
            genres: root.detail-genres;
            cast: root.detail-cast;
            directors: root.detail-directors;
            actions: root.detail-actions;
            marks: root.detail-marks;
            cuts: root.detail-cuts;
            enabled: root.detail-enabled;
            on-sources: root.detail-on-sources;
            sources: root.detail-sources;
            sources-note: root.detail-note;
            providers: root.detail-providers;
            provider: root.detail-provider;
            on-filter: root.detail-on-filter;
            filter-open: root.detail-filter-open;
            filter-focus: root.detail-filter-focus;
            show-episodes: root.detail-show-episodes;
            on-episodes: root.detail-on-episodes;
            seasons: root.detail-seasons;
            season-index: root.detail-season-index;
            on-seasons: root.detail-on-seasons;
            episodes: root.detail-episodes;
            episode-focus: root.detail-episode-focus;
            on-mark: root.detail-on-mark;
            episode-heading: root.detail-episode-heading;
            source-focus: root.detail-source-focus;
            focus-col: root.detail-col;
        }

        if screen == "now-playing": NowPlaying {
            width: 100%;
            height: 100%;
            art: root.np-art;
            title: root.np-title;
            subtitle: root.np-subtitle;
            note: root.np-note;
            surface: root.np-surface;
            elapsed: root.np-elapsed;
            duration: root.np-duration;
            progress: root.np-progress;
            controls: root.np-controls;
            focus-index: root.np-focus;
            technical: root.np-technical;
        }

        if screen == "settings": Settings {
            width: 100%;
            height: 100%;
            sections: root.settings-sections;
            section: root.settings-section;
            on-sections: root.settings-on-sections;
            rows: root.settings-rows;
            row-index: root.settings-row;
            page: root.settings-page;
            page-icon: root.settings-page-icon;
            title: root.settings-title;
            blurb: root.settings-blurb;
            vitals: root.vitals;
            cooling: root.settings-cooling;
            cooling-view: root.settings-cooling-view;
            output: root.settings-output;
            output-view: root.settings-output-view;
            ethernet: root.settings-ethernet;
            ethernet-view: root.settings-ethernet-view;
            audio: root.settings-audio;
            audio-view: root.settings-audio-view;
            choice-open: root.settings-choice-open;
            choice-title: root.settings-choice-title;
            choice: root.settings-choice;
            choice-focus: root.settings-choice-focus;
            choice-note: root.settings-choice-note;
        }

        if screen == "wifi": WifiScreen {
            width: 100%;
            height: 100%;
            known: root.wifi-known;
            present: root.wifi-present;
            powered: root.wifi-powered;
            summary: root.wifi-summary;
            address: root.wifi-address;
            networks: root.wifi-networks;
            index: root.wifi-index;
            busy: root.wifi-busy;
            scanning: root.wifi-scanning;
            notice: root.wifi-notice;
            face: root.wifi-face;
            target: root.wifi-target;
            password-mask: root.wifi-password-mask;
            show: root.wifi-show;
            focus-at: root.wifi-focus;
            keys: root.wifi-keys;
            key-row: root.wifi-key-row;
            key-col: root.wifi-key-col;
        }

        if screen == "bluetooth": BluetoothScreen {
            width: 100%;
            height: 100%;
            known: root.bt-known;
            present: root.bt-present;
            powered: root.bt-powered;
            summary: root.bt-summary;
            devices: root.bt-devices;
            index: root.bt-index;
            busy: root.bt-busy;
            notice: root.bt-notice;
            press-label: root.bt-press-label;
        }

        if screen == "account": Account {
            width: 100%;
            height: 100%;
            email: root.account-email;
            password-mask: root.account-password-mask;
            show: root.account-show;
            email-before: root.account-email-before;
            email-after: root.account-email-after;
            secret-before: root.account-secret-before;
            secret-after: root.account-secret-after;
            focus-at: root.account-focus;
            editing: root.account-editing;
            keys: root.account-keys;
            key-row: root.account-key-row;
            key-col: root.account-key-col;
            shifted: root.account-shifted;
            signed-in: root.account-signed-in;
            account-email: root.account-who;
            addons: root.account-addons;
            busy: root.account-busy;
            notice: root.account-notice;
            submit-label: root.account-submit-label;
            submit-ready: root.account-submit-ready;
        }

        if screen == "diagnostics": Diagnostics {
            width: 100%;
            height: 100%;
            groups: root.diag-groups;
            nav: root.diag-nav;
            group: root.diag-group;
            vitals: root.vitals;
        }

        // The bar. One component for every screen, so where the viewer is in
        // the product, what time it is and whether the box is on the network
        // are answered the same way everywhere.
        // The settings screens and the diagnostics carry their own heading and
        // clock in the corner, in the settings language.
        // The catalogue carries the reference's own chrome instead: its
        // places down the left and its search box across the top.
        if screen != "boot" && screen != "film" && screen != "detail" && screen != "media"
            && screen != "discover" && screen != "search" && screen != "library"
            && screen != "settings" && screen != "diagnostics": TopBar {
            x: 0;
            y: 0;
            width: 100%;
            items: screen == "media" ? root.nav : [];
            focus-col: root.media-col;
            active: screen == "media" && root.media-row == 0;
            vitals: root.vitals;
            heading: screen == "media" ? "Filmler ve Diziler"
                : screen == "search" ? "Ara"
                : screen == "discover" ? "Keşfet"
                : screen == "library" ? "Kitaplık"
                : screen == "account" ? "Hesap"
                : screen == "wifi" ? "Wi-Fi"
                : screen == "bluetooth" ? "Bluetooth"
                : screen == "now-playing" ? "Şimdi Oynatılan"
                : "";
        }

        // What went wrong, if anything did, without taking the screen away from
        // what is working.
        if notice != "": Toast {
            x: Metrics.safe-x;
            y: root.height - self.height - Metrics.safe-y * 0.8;
            text: notice;
        }

        if sheet-open: Sheet {
            title: root.sheet-title;
            kind: root.sheet-kind;
            rows: root.sheet-rows;
            index: root.sheet-index;
        }

        // On top of the film. `screen` is "film" while one is playing and no
        // other screen matches that, so nothing else is drawn and the panel is
        // the film, black where the film does not reach, and this.
        if screen == "film": Player {
            width: 100%;
            height: 100%;
            title: root.np-title;
            note: root.np-note;
            waiting: root.np-waiting;
            art: root.np-art;
            logo: root.np-logo;
            elapsed: root.np-elapsed;
            duration: root.np-duration;
            progress: root.np-progress;
            marks: root.np-marks;
            lines: root.np-lines;
            rules: root.np-rules;
            focus-index: root.np-focus;
            lane: root.np-row;
            scrub: root.np-scrub;
            open: root.film-controls;
            menu: root.np-menu;
            menu-title: root.np-menu-title;
            menu-rows: root.np-menu-rows;
            menu-tracks: root.np-menu-tracks;
            menu-focus: root.np-menu-focus;
            menu-track-focus: root.np-menu-track-focus;
            menu-column: root.np-menu-column;
            menu-side-label: root.np-menu-side-label;
            menu-side-value: root.np-menu-side-value;
            menu-note: root.np-menu-note;
            menu-above: root.np-menu-above;
            menu-below: root.np-menu-below;
            pill: root.np-pill;
            caption: root.np-caption;
        }

        // Last, so it is over the film and over every sheet.
        VolumeOsd {
            // 73 px in from the right edge of a 2160-line panel, centred top
            // to bottom: the reference's own place for it.
            x: root.width - self.width - root.height * 73 / 2160;
            y: (root.height - self.height) / 2;
            level: root.volume-level;
            muted: root.volume-muted;
            bitstream: root.volume-bitstream;
            shown: root.volume-shown;
        }
    }

    // The viewport drives every size in the theme. It is set here rather than
    // from Rust so a panel swapped while the box is running is followed without
    // a round trip.
    init => {
        Metrics.vw = root.width;
        Metrics.vh = root.height;
    }
    changed width => { Metrics.vw = self.width; }
    changed height => { Metrics.vh = self.height; }
}
