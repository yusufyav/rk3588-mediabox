import { Theme, Metrics } from "theme.slint";
import { GridPoster, PosterItem, KeyRow, KeyCap, Keyboard } from "components.slint";

// Searching from the sofa.
//
// The letters on the left, the results on the right, and one rule for crossing
// between them: Right off the edge of the grid goes to the posters, Left from
// the first column comes back. A keyboard, if there is one, types into the same
// box without moving the focus.
export component Search inherits Rectangle {
    in property <string> query;
    in property <string> note;
    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;
    in property <bool> on-keys;

    in property <[PosterItem]> results;
    in property <int> index;
    in property <int> columns;

    // Ten columns, the grid's own width.
    property <length> keys-w: Metrics.key-w * 10 + Metrics.key-gap * 9;
    property <length> pane-x: Metrics.gutter + keys-w + Metrics.gutter;
    property <length> cell-w: Metrics.card-w + Metrics.grid-gap;
    property <length> cell-h: Metrics.card-h + Metrics.text-card * 3.4 + Metrics.grid-gap;
    property <length> grid-top: Metrics.topbar + Metrics.block-gap * 1.8;
    property <length> viewport-h: root.height - grid-top - Metrics.gutter;
    // The focused row is kept on the panel and the grid slides under it.
    property <length> scroll: clamp(
        Math.floor(index / columns) * cell-h - Metrics.top-inset,
        0px,
        max(0px, Math.ceil(results.length / columns) * cell-h - viewport-h));

    background: Theme.bg;
    clip: true;

    // ------------------------------------------------------------- the letters
    VerticalLayout {
        x: Metrics.gutter;
        y: Metrics.topbar;
        width: keys-w;
        spacing: Metrics.block-gap * 0.7;
        alignment: start;

        // What has been typed, as a box rather than as a heading: a viewer
        // should be able to see that the remote is going somewhere.
        Rectangle {
            height: Metrics.root-font * 3.0;
            border-radius: Theme.radius * 0.8;
            background: #ffffff0d;
            border-width: 1px;
            border-color: on-keys ? #ffffff2e : Theme.line;

            Text {
                x: Metrics.root-font * 0.8;
                width: parent.width - Metrics.root-font * 1.6;
                height: 100%;
                text: query == "" ? "Film veya dizi ara" : query;
                color: query == "" ? Theme.dim : Theme.text;
                font-size: Metrics.root-font * 1.06;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }

            // A caret, so an empty box still reads as one that is listening.
            if query != "": Rectangle {
                x: parent.width - Metrics.root-font * 0.8;
                y: parent.height * 0.26;
                width: 2px;
                height: parent.height * 0.48;
                background: Theme.accent;
            }
        }

        Keyboard {
            keys: root.keys;
            key-row: root.key-row;
            key-col: root.key-col;
            active: root.on-keys;
        }
    }

    // ------------------------------------------------------------- the results
    Text {
        x: pane-x;
        y: Metrics.topbar + Metrics.block-gap * 0.3;
        text: note;
        color: Theme.muted;
        font-size: Metrics.text-label;
        font-weight: 660;
    }

    // Before there is anything to show, the pane says what it is for rather
    // than standing empty: half a television of black beside a letter grid
    // reads as a screen that has failed.
    if results.length == 0: Text {
        x: pane-x;
        y: root.height * 0.4;
        width: root.width - pane-x - Metrics.gutter;
        text: query == ""
            ? "Kumandayla harfleri seçin ya da klavyeden yazın"
            : "";
        color: Theme.dim;
        font-size: Metrics.text-meta;
        font-weight: 620;
        wrap: word-wrap;
    }

    Rectangle {
        x: pane-x;
        y: grid-top;
        width: root.width - pane-x - Metrics.gutter;
        height: viewport-h;
        clip: true;
        background: transparent;

        Rectangle {
            x: 0;
            y: -scroll;
            width: 100%;
            height: max(1px, Math.ceil(results.length / columns) * cell-h);
            background: transparent;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in results: GridPoster {
                x: Math.mod(i, columns) * cell-w;
                y: Math.floor(i / columns) * cell-h;
                item: item;
                focused: !on-keys && i == index;
            }
        }
    }
}
