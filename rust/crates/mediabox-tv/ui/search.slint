import { Theme, Metrics } from "theme.slint";
import { Rail, RailModel, KeyRow, KeyCap, Keyboard } from "components.slint";
import { Chrome } from "chrome.slint";

// One line of the list beside the letters: a suggestion, or an earlier search.
export struct SearchEntry {
    text: string,
    detail: string,
    earlier: bool,
}

// Searching, laid out as the reference's search page: the board's frame, the
// query in the search box, and the answer as the board's shelves under it --
// a row per catalogue. The reference drops its suggestions and earlier
// searches down under the box while it is typed into; a television has no
// keyboard of its own, so its letters are in that panel too, and it closes
// when the search is made.
export component Search inherits Rectangle {
    in property <string> query;
    in property <string> note;
    in property <bool> searching;
    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;
    // 0 the letters, 1 the list, 2 the results, 3 the box, 4 the places.
    in property <int> pane;
    in property <bool> editing;

    in property <bool> showing-results;
    in property <[SearchEntry]> entries;
    in property <int> list-index;
    in property <[RailModel]> rails;
    in property <int> rail-row;
    in property <int> rail-col;
    in property <int> place;
    in property <[string]> places;

    // The board's shelf geometry, so a search's rows are the board's rows.
    property <length> content-x: root.width * 0.0547;
    property <length> right-x: root.width * 0.0185;
    property <length> rails-top: root.height * 0.0875;
    property <length> rail-h: root.height * 0.3662;
    property <length> head: root.height * 0.037 - Metrics.focus-room;
    property <length> viewport-h: root.height - rails-top;
    property <length> content-h: max(1px, rail-h * rails.length);
    property <length> scroll: clamp(rail-row * rail-h, 0px, max(0px, content-h - viewport-h));
    property <length> line-h: Metrics.root-font * 2.2;

    background: Theme.catalog-bg;
    clip: true;

    // ------------------------------------------------------------ the results
    if showing-results: Rectangle {
        x: content-x - Metrics.focus-room;
        y: rails-top - Metrics.focus-room;
        width: root.width - self.x - right-x + Metrics.focus-room;
        height: viewport-h + Metrics.focus-room;
        clip: true;

        Rectangle {
            x: 0;
            y: Metrics.focus-room - scroll;
            width: 100%;
            height: content-h;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for rail[r] in rails: Rail {
                x: 0;
                y: r * rail-h;
                width: parent.width;
                height: rail-h;
                rail: rail;
                inset: Metrics.focus-room;
                right-inset: Metrics.focus-room;
                head: head;
                focus-col: rail-col;
                active: pane == 2 && rail-row == r;
            }
        }
    }

    // What the page is waiting for, or why it has nothing.
    if searching || (rails.length == 0 && note != ""): Text {
        x: content-x;
        y: rails-top + Metrics.root-font;
        width: root.width - content-x - right-x;
        text: searching ? "Aranıyor…" : note;
        color: Theme.muted;
        font-size: Metrics.text-meta;
        wrap: word-wrap;
    }

    Chrome {
        width: 100%;
        height: 100%;
        on-search: pane == 3;
        on-places: pane == 4;
        place: place;
        // No place down the left is this page.
        current: -1;
        places: places;
        query: query;
    }

    // --------------------------------------------------------------- the panel
    //
    // Under the search box, over the page: the letters, and beside them the
    // reference's suggestions and earlier searches.
    if editing: Rectangle {
        property <length> keys-w: Metrics.key-w * 10 + Metrics.key-gap * 9;
        property <length> pad: Metrics.root-font * 1.1;
        property <length> list-w: root.width * 0.2;
        width: keys-w + list-w + pad * 3;
        height: keyboard.preferred-height + pad * 2;
        x: (root.width - self.width) / 2;
        y: root.height * 0.0139 + root.height * 0.0389 + Metrics.root-font * 0.5;
        border-radius: Metrics.root-font * 0.9;
        background: #1e1c2f;
        border-width: 1px;
        border-color: #ffffff1a;

        keyboard := Keyboard {
            x: pad;
            y: pad;
            width: keys-w;
            keys: root.keys;
            key-row: root.key-row;
            key-col: root.key-col;
            active: root.pane == 0;
        }

        VerticalLayout {
            x: pad * 2 + keys-w;
            y: pad;
            width: list-w;
            spacing: Metrics.root-font * 0.15;
            alignment: start;

            if entries.length == 0: Text {
                text: query == ""
                    ? "Harfleri seçip Ara’ya basın ya da klavyeden yazıp Enter’a basın"
                    : "Ara’ya basınca kurulu eklentilerin arama katalogları sorulur";
                color: Theme.dim;
                font-size: Metrics.text-label;
                wrap: word-wrap;
            }

            for entry[i] in entries: VerticalLayout {
                spacing: Metrics.root-font * 0.15;

                // A heading where the kind of line changes.
                if i == 0 || entries[i - 1].earlier != entry.earlier: Text {
                    height: Metrics.root-font * 1.8;
                    text: entry.earlier ? "SON ARAMALAR" : "ÖNERİLER";
                    color: #ffffff8c;
                    font-size: Metrics.text-label * 0.86;
                    font-weight: 650;
                    letter-spacing: Metrics.text-label * 0.1;
                    vertical-alignment: bottom;
                }

                Rectangle {
                    property <bool> focused: pane == 1 && i == list-index;
                    height: line-h;
                    border-radius: line-h * 0.24;
                    background: focused ? Theme.focus-fill : transparent;
                    animate background { duration: Theme.focus-in; easing: Theme.ease; }

                    HorizontalLayout {
                        padding-left: Metrics.root-font * 0.7;
                        padding-right: Metrics.root-font * 0.7;
                        spacing: Metrics.root-font * 0.5;

                        Text {
                            text: entry.text;
                            color: focused ? #0b0d12 : Theme.text;
                            font-size: Metrics.text-meta * 0.95;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                            horizontal-stretch: 1;
                        }
                        // In a column of its own, so the kinds and years line up.
                        Text {
                            width: Metrics.root-font * 5.5;
                            text: entry.detail;
                            color: focused ? #3b4250 : Theme.dim;
                            font-size: Metrics.text-label;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }
    }
}
