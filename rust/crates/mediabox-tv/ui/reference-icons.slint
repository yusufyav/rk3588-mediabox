// One of them in the ink it is given, each part a path of its own.
component Part inherits Path {
    in property <length> line;
    in property <brush> ink;
    in property <bool> stroked;
    width: 100%;
    height: 100%;
    viewbox-width: 512;
    viewbox-height: 512;
    // The set's holes are contours drawn the other way round, which the
    // browser's nonzero honours; FemtoVG turns every contour the same way,
    // and filled nonzero they would be solid. Nested as they are, evenodd
    // gives the browser's picture.
    fill-rule: evenodd;
    fill: stroked ? transparent : ink;
    stroke: stroked ? ink : transparent;
    stroke-width: stroked ? line : 0px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component ReferenceIcon inherits Rectangle {
    in property <string> name;
    in property <length> size;
    in property <brush> ink;
    width: size;
    height: size;

    Part { commands: ReferenceIcons.fill0(name); ink: root.ink; }
    Part { commands: ReferenceIcons.fill1(name); ink: root.ink; }
    Part { commands: ReferenceIcons.stroke0(name); ink: root.ink; stroked: true; line: root.size * ReferenceIcons.line(name) / 512; }
    Part { commands: ReferenceIcons.stroke1(name); ink: root.ink; stroked: true; line: root.size * ReferenceIcons.line(name) / 512; }
}
