// One of them in the ink it is given: its line parts over its filled ones.
export component ReferenceIcon inherits Rectangle {
    in property <string> name;
    in property <length> size;
    in property <brush> ink;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 512;
        viewbox-height: 512;
        commands: ReferenceIcons.fill(name);
        fill: ink;
        stroke: transparent;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 512;
        viewbox-height: 512;
        commands: ReferenceIcons.stroke(name);
        fill: transparent;
        stroke: ink;
        stroke-width: root.size * 32 / 512;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
