import { Theme, Metrics } from "theme.slint";
import { KeyRow, KeyCap, Keyboard } from "components.slint";

// Signing in to a Stremio account from the sofa.
//
// One column, top to bottom: the address, the password, the letters, the
// button. A remote has Up and Down and that is the whole navigation model here
// — nothing is reachable only sideways, and nothing is reachable only by going
// back.
//
// The password is drawn from `password-mask`, which is bullets and a length.
// The real text never reaches this file.
export component Account inherits Rectangle {
    in property <string> email;
    in property <string> password-mask;
    /// Whether the password is drawn as itself.
    in property <bool> show;
    // The two halves of each field, split where the caret is. Drawn either
    // side of it, which is how a caret can sit in the middle of a word.
    in property <string> email-before;
    in property <string> email-after;
    in property <string> secret-before;
    in property <string> secret-after;
    // "email" | "password" | "keys" | "submit"
    in property <string> focus-at;
    // Which field the letters are going into, so the one being edited is marked
    // even while the remote is down on the grid.
    in property <string> editing;

    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;
    in property <bool> shifted;

    in property <bool> signed-in;
    in property <string> account-email;
    in property <int> addons;
    in property <bool> busy;
    in property <string> notice;
    in property <string> submit-label;
    in property <bool> submit-ready;

    // Ten columns; the grid's own width, so the column under it matches.
    property <length> keys-w: Metrics.key-w * 10 + Metrics.key-gap * 9;
    property <length> col-w: max(keys-w, Metrics.vw * 0.30);
    property <length> col-x: (root.width - col-w) / 2;
    property <length> field-h: Metrics.root-font * 2.9;

    background: Theme.bg;
    clip: true;

    VerticalLayout {
        x: col-x;
        y: Metrics.topbar + Metrics.block-gap * 0.6;
        width: col-w;
        spacing: Metrics.block-gap * 0.45;
        alignment: start;

        Text {
            text: "Stremio hesabı";
            color: Theme.text;
            font-size: Metrics.title-screen * 0.62;
            font-weight: 760;
        }

        Text {
            width: 100%;
            text: signed-in
                ? "Bu cihaz " + account-email + " hesabının " + addons + " eklentisini kullanıyor."
                : "Hesap bağlı değilken cihaz Stremio'nun varsayılan koleksiyonunu kullanır: afiş ve özet gelir, akış çoğu başlıkta gelmez.";
            color: Theme.muted;
            font-size: Metrics.text-meta * 0.94;
            font-weight: 600;
            wrap: word-wrap;
        }

        // ------------------------------------------------------------ e-posta
        Text {
            text: "E-posta";
            color: focus-at == "email" ? Theme.text : Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 700;
        }

        Rectangle {
            property <bool> focused: focus-at == "email";
            property <bool> active: editing == "email";
            height: field-h;
            border-radius: Theme.radius * 0.7;
            background: focused ? Theme.focus-fill : #ffffff0d;
            border-width: focused || active ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : (active ? #ffffff40 : Theme.line);

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            if email == "": Text {
                x: Metrics.root-font * 0.7;
                width: parent.width - Metrics.root-font * 2.0;
                height: 100%;
                text: "ornek@eposta.com";
                color: focused ? #0a0c1099 : Theme.dim;
                font-size: Metrics.root-font * 1.0;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }

            // The text, with the caret standing between its two halves, so it
            // can sit in the middle of a word rather than only at the end.
            if email != "": HorizontalLayout {
                x: Metrics.root-font * 0.7;
                width: parent.width - Metrics.root-font * 1.4;
                height: 100%;
                alignment: start;
                spacing: 0px;

                Text {
                    text: email-before;
                    color: focused ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.0;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
                // The caret: a thin bar the height of a letter, not of the
                // box. The outer rectangle is only the slot it stands in and
                // must stay transparent — given a background of its own it
                // draws floor to ceiling, which is a rule, not a caret.
                Rectangle {
                    width: active ? 2px : 0px;
                    background: transparent;
                    Rectangle {
                        y: (parent.height - Metrics.root-font * 1.15) / 2;
                        width: 100%;
                        height: Metrics.root-font * 1.15;
                        border-radius: 1px;
                        background: focused ? #0a0c10 : Theme.accent;
                    }
                }
                Text {
                    text: email-after;
                    color: focused ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.0;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        // ------------------------------------------------------------- parola
        Text {
            text: "Parola";
            color: focus-at == "password" ? Theme.text : Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 700;
        }

        Rectangle {
            property <bool> focused: focus-at == "password";
            property <bool> active: editing == "password";
            height: field-h;
            border-radius: Theme.radius * 0.7;
            background: focused ? Theme.focus-fill : #ffffff0d;
            border-width: focused || active ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : (active ? #ffffff40 : Theme.line);

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            // The switch that turns the bullets into letters. Inside the
            // field's own box, reached by walking the caret off its right-hand
            // end, so it costs no extra row.
            Rectangle {
                property <bool> on: focus-at == "show";
                width: Metrics.root-font * 4.0;
                height: parent.height - Metrics.root-font * 0.55;
                x: parent.width - self.width - Metrics.root-font * 0.3;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius * 0.5;
                background: on ? #ffffff : #ffffff14;
                border-width: on ? 0px : 1px;
                border-color: #ffffff2a;
                animate background { duration: Theme.focus-in; easing: Theme.ease; }
                Text {
                    text: show ? "Gizle" : "Göster";
                    color: on ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 0.72;
                    font-weight: 700;
                }
            }

            // Bullets and a length. Whatever was typed is not in this file.
            if password-mask == "": Text {
                x: Metrics.root-font * 0.7;
                width: parent.width - Metrics.root-font * 5.2;
                height: 100%;
                text: "••••••••";
                color: focused ? #0a0c1099 : Theme.dim;
                font-size: Metrics.root-font * 1.0;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }

            if password-mask != "": HorizontalLayout {
                x: Metrics.root-font * 0.7;
                width: parent.width - Metrics.root-font * 5.2;
                height: 100%;
                alignment: start;
                spacing: 0px;

                Text {
                    text: secret-before;
                    color: focused ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.0;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
                // The caret: a thin bar the height of a letter, not of the
                // box. The outer rectangle is only the slot it stands in and
                // must stay transparent — given a background of its own it
                // draws floor to ceiling, which is a rule, not a caret.
                Rectangle {
                    width: active ? 2px : 0px;
                    background: transparent;
                    Rectangle {
                        y: (parent.height - Metrics.root-font * 1.15) / 2;
                        width: 100%;
                        height: Metrics.root-font * 1.15;
                        border-radius: 1px;
                        background: focused ? #0a0c10 : Theme.accent;
                    }
                }
                Text {
                    text: secret-after;
                    color: focused ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.0;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        // ------------------------------------------------------------ letters
        Rectangle { height: Metrics.block-gap * 0.3; }

        Keyboard {
            keys: root.keys;
            key-row: root.key-row;
            key-col: root.key-col;
            active: focus-at == "keys";
        }

        // ------------------------------------------------------------- button
        Rectangle { height: Metrics.block-gap * 0.25; }

        Rectangle {
            property <bool> focused: focus-at == "submit";
            height: field-h;
            border-radius: Theme.radius * 0.7;
            background: focused
                ? (submit-ready ? Theme.accent : Theme.focus-fill)
                : #ffffff12;
            border-width: focused ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : Theme.line-soft;

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            Text {
                width: 100%;
                height: 100%;
                text: submit-label;
                color: focused ? #0a0c10 : (submit-ready ? Theme.text : Theme.muted);
                font-size: Metrics.root-font * 1.02;
                font-weight: 760;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // One line, and it has to stay one line: the column already reaches
        // most of the way down the panel, and a message that wrapped ran off
        // the bottom edge where nobody could read it. `short_reason` in
        // screens/account.rs is what keeps it short enough to say something.
        if notice != "": Text {
            width: 100%;
            height: Metrics.root-font * 1.6;
            text: notice;
            color: busy ? Theme.muted : Theme.tone("warn");
            font-size: Metrics.text-chip;
            font-weight: 660;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}
