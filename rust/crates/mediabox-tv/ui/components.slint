import { Theme, Metrics } from "theme.slint";
import { Dialog, ActionButton, SettingCard } from "kit.slint";
import { ReferenceIcon } from "reference-icons.slint";

// One shelf item, as the interface needs it. Everything expensive — the
// artwork, the progress, the fallback's hue — is decided in Rust and arrives
// already settled, so a redraw never computes anything.
export struct PosterItem {
    id: string,
    kind: string,
    title: string,
    // The year, usually. Drawn under the name on a grid, where there is room.
    subtitle: string,
    // Empty until the image manager has something. The fallback below is drawn
    // underneath either way, so a poster that never arrives is a designed tile
    // rather than a hole.
    art: image,
    // A stable hue derived from the title, so the same film is the same colour
    // on every screen it appears on.
    hue: float,
    // 0 when the title has not been started, or is not the operator's.
    progress: float,
    // Held by this appliance rather than fetched over the network.
    local: bool,
    // Watched, as stremio-core's LibraryItem::watched says it: watched at
    // least once. The reference marks such a poster with a check.
    watched: bool,
    // On "İzlemeye devam edin": the reference marks the focused one with a
    // cross on the poster and its menu mark beside the name.
    dismissable: bool,
}

export struct RailModel {
    title: string,
    source: string,
    // Said in place of the posters when there are none: a catalogue that did
    // not answer keeps its row and says so.
    note: string,
    // "Tümünü Gör" at the end of the heading, or empty for a row without one.
    more: string,
    items: [PosterItem],
}

// One thing this box can be used for.
export struct AppTile {
    // What Rust dispatches on when Ok is pressed. Never shown.
    id: string,
    name: string,
    // An SVG path, stroked rather than filled, in a 24x24 viewbox. Drawn rather
    // than fetched: an appliance has no icon theme to ask and no network to
    // depend on.
    mark: string,
    hue: float,
    ready: bool,
    note: string,
}

// A label and a reading, with an optional verdict. Used by the technical panel,
// the diagnostics screen and the now-playing strip — the same shape in all
// three because it is the same idea in all three.
export struct TechRow {
    label: string,
    value: string,
    tone: string,
}

export struct SettingRow {
    label: string,
    value: string,
    hint: string,
    tone: string,
    // False for a reading or a heading. Focus never lands on one.
    selectable: bool,
    // "header", "reading", "link" (goes somewhere) or "action" (does
    // something).
    kind: string,
    // A mark from the Icons table, or "".
    icon: string,
    // How many rows of each height come before this one, so the screen can
    // place it — and scroll to it — by arithmetic rather than by measuring.
    n-header: int,
    n-reading: int,
    n-card: int,
    n-flat: int,
}

export struct DiagGroup {
    title: string,
    rows: [TechRow],
}

export struct SheetRow {
    label: string,
    hint: string,
    tone: string,
}

export struct KeyCap {
    label: string,
    // How many grid columns this key is wide.
    span: int,
}

export struct KeyRow {
    keys: [KeyCap],
}

export struct NpControl {
    label: string,
    mark: string,
}

// The board's own vital signs. They are not on the home screen any more — they
// are the diagnostics screen's — but the clock and the network state are still
// read off this, because the bar shows them.
export struct VitalsModel {
    time: string,
    date: string,
    cpu-arc: string,
    cpu-text: string,
    memory-arc: string,
    memory-text: string,
    performance-note: string,
    storage-text: string,
    storage-fraction: float,
    network: string,
    machine: string,
    // The two ways this box can be on the network, named separately. A single
    // "Bağlı" cannot say that the cable is out and the radio is carrying it,
    // which on an appliance is exactly the thing worth knowing at a glance.
    eth-up: bool,
    eth-address: string,
    wifi-up: bool,
    wifi-ssid: string,
    wifi-address: string,
    // 0 when there is no link; 1 to 4 otherwise.
    wifi-bars: int,
}

// ------------------------------------------------------------------ the pieces

// The letter grid, drawn once for every screen that takes text.
//
// It was copied into two screens before this, which is how the account form
// and the Wi-Fi password face came to look slightly different from each other
// while both looked wrong. One component, so a change to the keys is a change
// everywhere.
//
// Three things make it readable from a sofa: the focused key is a filled white
// slab rather than a slightly lighter grey, the wide keys are toned apart from
// the letters so the eye can find Boşluk and Sil without reading them, and the
// letters are set large enough to be legible at the back of a room.
export component Keyboard inherits VerticalLayout {
    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;
    /// Whether the remote is on the grid at all. A grid nobody is standing on
    /// draws no focus, rather than a stale one on a screen that has moved on.
    in property <bool> active;

    spacing: Metrics.key-gap;

    for row[r] in keys: HorizontalLayout {
        spacing: Metrics.key-gap;
        alignment: start;
        height: Metrics.key-h;

        for cap[c] in row.keys: Rectangle {
            property <bool> wide: cap.span > 1;
            property <bool> on: active && r == key-row && c == key-col;

            width: Metrics.key-w * cap.span + Metrics.key-gap * (cap.span - 1);
            border-radius: Metrics.key-h * 0.26;
            background: on
                ? #ffffff
                : (wide ? #ffffff16 : #ffffff0b);
            border-width: on ? 0px : 1px;
            border-color: wide ? #ffffff2a : #ffffff1c;

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            // A soft ring under the focused key, so it reads as lifted rather
            // than merely inverted.
            if on: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: parent.border-radius + 3px;
                background: transparent;
                border-width: 2px;
                border-color: Theme.focus-ring;
            }

            Text {
                width: 100%;
                height: 100%;
                text: cap.label;
                color: on ? #0a0c10 : (wide ? #ffffffcc : Theme.text);
                font-size: wide
                    ? Metrics.key-h * 0.30
                    : Metrics.key-h * 0.46;
                font-weight: wide ? 700 : 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Four bars. Shared by the home screen's network panel and the Wi-Fi screen,
// so a radio reads the same in both places.
export component SignalBars inherits HorizontalLayout {
    in property <int> bars;
    in property <length> unit: 3px;
    spacing: unit * 0.5;
    alignment: start;

    for step[i] in [1, 2, 3, 4]: Rectangle {
        width: unit;
        height: unit * (1.2 + 0.8 * i);
        y: parent.height - self.height;
        border-radius: unit / 2;
        background: i <= bars ? Theme.ok : #ffffff30;
    }
}

// One way of being on the network: a mark, a name and an address.
component LinkLine inherits HorizontalLayout {
    in property <bool> up;
    in property <string> name;
    in property <string> address;
    // -1 for the wire, 0..4 for a radio.
    in property <int> bars: -1;

    spacing: Metrics.root-font * 0.42;
    height: Metrics.root-font * 1.5;

    // The mark: a filled dot for the wire, bars for the radio. Both go grey
    // when that way is not carrying anything.
    Rectangle {
        width: Metrics.root-font * 0.85;
        if bars < 0: Rectangle {
            width: Metrics.root-font * 0.44;
            height: self.width;
            x: 0;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: up ? Theme.ok : #ffffff30;
        }
        if bars >= 0: SignalBars {
            bars: bars;
            unit: Metrics.root-font * 0.17;
            x: 0;
            height: parent.height * 0.58;
            y: (parent.height - self.height) / 2;
        }
    }

    Text {
        vertical-alignment: center;
        text: name;
        color: up ? Theme.text : Theme.muted;
        font-size: Metrics.root-font * 0.86;
        font-weight: 700;
        overflow: elide;
        min-width: 0px;
    }

    Rectangle { horizontal-stretch: 1; min-width: Metrics.root-font * 0.2; }

    Text {
        vertical-alignment: center;
        text: address;
        color: up ? Theme.muted : #ffffff44;
        font-size: Metrics.root-font * 0.76;
        font-weight: 600;
        overflow: elide;
        min-width: 0px;
    }
}

// The tile drawn when there is no artwork, and drawn behind it when there is.
//
// Addon posters 404 in practice — often enough that an empty frame would be a
// regular sight — so the name is always painted on a ground of its own and the
// picture covers it when it arrives.
// A poster with no picture, as the reference draws one (MetaItem's
// renderPosterFallback): a grey tile with its type's mark in the middle,
// 80% by 50% of it, colours measured off its library.
export component Fallback inherits Rectangle {
    in property <string> title;
    in property <float> hue;
    in property <string> kind;

    border-radius: Metrics.poster-radius;
    background: #44434c;

    ReferenceIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: kind == "series" ? "series"
            : kind == "channel" ? "channels"
            : kind == "tv" ? "tv"
            : "movies";
        size: min(parent.width * 0.8, parent.height * 0.5);
        ink: #1a1925;
    }
}

// The artwork of one title, with its focus ring. Shared by the shelves and by
// both grids, so a poster is the same object everywhere in the product.
//
// Focus is the reference's, measured off it rather than remembered: the frame
// does not grow. A white ring appears around the outside of it, touching it,
// and the picture inside zooms by 5% behind the same rounded edge. The
// progress bar and the badges stay where they are. An earlier version grew the
// whole card by 7.5%, which the reference does not do and which pushed the
// ring into whatever clipped the shelf.
export component Art inherits Rectangle {
    in property <PosterItem> item;
    in property <bool> focused;
    in property <length> art-w: Metrics.card-w;
    in property <length> art-h: Metrics.card-h;

    width: art-w;
    height: art-h;

    picture := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: art-w * 0.055;
        clip: true;

        // The picture and the name painted under it, as one layer: that is
        // what zooms -- one scale about its centre, as the reference's
        // `transform: scale(1.05)`. Growing its size and moving it to stay
        // centred, as this first did, animated the two apart and the picture
        // slid while it grew.
        Rectangle {
            width: 100%;
            height: 100%;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: focused ? 1.05 : 1.0;

            animate transform-scale { duration: Theme.poster-zoom; easing: ease-out; }

            Fallback {
                width: 100%;
                height: 100%;
                title: item.title;
                hue: item.hue;
                kind: item.kind;
            }

            if item.art.width > 0: Image {
                width: 100%;
                height: 100%;
                source: item.art;
                image-fit: cover;
            }
        }

        // The reference's watched mark: a 1.5rem circle in its accent, 0.5rem
        // in from the corner, a 0.75rem check in it.
        if item.watched: Rectangle {
            property <length> rem: Metrics.vw / 146.6;
            x: rem * 0.5;
            y: rem * 0.5;
            width: rem * 1.5;
            height: self.width;
            border-radius: self.width / 2;
            background: #7b5bf5;
            ReferenceIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "checkmark";
                size: parent.width * 0.5;
                ink: #ffffff;
            }
        }

        // The appliance's own copy, which is certain to play.
        if item.local: Rectangle {
            x: parent.width * 0.045;
            y: parent.width * 0.045;
            width: Metrics.text-chip * 2.6;
            height: Metrics.text-chip * 1.5;
            border-radius: self.height / 3;
            background: Theme.accent;
            Text {
                text: "YEREL";
                color: Theme.accent-ink;
                font-size: Metrics.text-chip * 0.72;
                font-weight: 750;
                letter-spacing: 0.12 * Metrics.text-chip * 0.72;
            }
        }

        // The reference's bar, measured off its board: inside the poster, in
        // from both sides by 7.4% of the width and up from the bottom by 8%,
        // 3% thick, white on a faint white track, ends rounded.
        if item.progress > 0.0: Rectangle {
            x: parent.width * 0.074;
            y: parent.height - parent.width * 0.08 - self.height;
            width: parent.width * 0.852;
            height: max(3px, parent.width * 0.03);
            border-radius: self.height / 2;
            background: #ffffff45;
            Rectangle {
                x: 0;
                width: max(parent.height, parent.width * item.progress);
                height: 100%;
                border-radius: parent.border-radius;
                background: #ffffff;
            }
        }

        // The edge an unfocused poster keeps, so a dark poster on the dark
        // ground still has one.
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: #ffffff14;
            background: transparent;
        }
    }

    // The ring, outside the frame and touching it. Drawn rather than shadowed:
    // one rectangle is cheaper than a blur this board would pay for on every
    // frame.
    if focused: Rectangle {
        x: -Metrics.ring-w;
        y: -Metrics.ring-w;
        width: parent.width + Metrics.ring-w * 2;
        height: parent.height + Metrics.ring-w * 2;
        border-radius: art-w * 0.055 + Metrics.ring-w;
        border-width: Metrics.ring-w;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}

export component Poster inherits Rectangle {
    in property <PosterItem> item;
    in property <bool> focused;

    width: Metrics.card-w;
    // The artwork plus the room the name appears in when focused. Reserved
    // whether or not it is used, so nothing below moves as the remote travels.
    height: Metrics.card-h + Metrics.text-card * 2.6;

    Art {
        x: 0;
        y: 0;
        item: item;
        focused: focused;
    }

    // Every title is named, on two lines. The first version named only the
    // focused one, which reads well on a screen somebody is walking along and
    // badly on a catalogue somebody is scanning — and the catalogue is what
    // this is. The reference names them all.
    Text {
        x: Metrics.card-w * 0.04;
        y: Metrics.card-h + Metrics.vh * 0.016;
        width: Metrics.card-w * 0.92;
        height: Metrics.text-card * 2.6;
        // White, every one, as the reference names them.
        text: item.title;
        color: Theme.text;
        font-size: Metrics.text-card;
        font-weight: focused ? 600 : 500;
        horizontal-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    // On "İzlemeye devam edin", as the reference's focused poster: a cross in
    // its top-left corner and the menu's mark just right of the name, both
    // measured off its board.
    if focused && item.dismissable: Path {
        x: Metrics.card-w * 0.085;
        y: Metrics.card-w * 0.085;
        width: Metrics.card-w * 0.058;
        height: self.width;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M1 1L9 9M9 1L1 9";
        stroke: #ffffffd0;
        stroke-width: max(1.5px, Metrics.card-w * 0.009);
        stroke-line-cap: round;
    }
    if focused && item.dismissable: VerticalLayout {
        x: Metrics.card-w * 1.0;
        y: Metrics.card-h + Metrics.vh * 0.016 + (Metrics.text-card * 1.3 - self.height) / 2;
        width: Metrics.card-w * 0.03;
        height: Metrics.card-w * 0.1;
        alignment: space-between;
        for dot in [0, 1, 2]: Rectangle {
            height: self.width;
            width: Metrics.card-w * 0.022;
            border-radius: self.width / 2;
            background: #9291a0;
        }
    }
}

// The same artwork in a grid, where every title is named: a grid is scanned
// rather than walked, and a page of unlabelled pictures cannot be scanned.
export component GridPoster inherits Rectangle {
    in property <PosterItem> item;
    in property <bool> focused;
    // The poster's width: the shelves' by default, the grid's own where it
    // has one (the reference's Discover is seven to a row).
    in property <length> art-w: Metrics.card-w;
    in property <length> name-size: Metrics.text-card;

    width: art-w;
    height: art-w * 1.461 + name-size * 3.4;

    Art {
        x: 0;
        y: 0;
        art-w: root.art-w;
        art-h: root.art-w * 1.461;
        item: item;
        focused: focused;
    }

    // The name, on up to two lines, as the reference names a grid's posters.
    Text {
        x: 0;
        y: art-w * 1.461 + Metrics.vh * 0.012;
        width: 100%;
        height: name-size * 2.7;
        text: item.title;
        color: Theme.text;
        font-size: name-size;
        font-weight: focused ? 600 : 500;
        horizontal-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }
}

export component Rail inherits Rectangle {
    in property <RailModel> rail;
    in property <int> focus-col;
    in property <bool> active;
    // Where the first poster starts and how far in from the right the heading's
    // "Tümünü Gör" ends: the screen's gutter, unless the screen says otherwise.
    in property <length> inset: Metrics.gutter;
    in property <length> right-inset: Metrics.gutter;
    // The band the heading sits in, above the posters.
    in property <length> head: Metrics.title-rail * 2.0;

    // Head plus artwork plus the room a focused poster grows into. Fixed, so
    // the vertical arithmetic above has nothing to measure.
    height: Metrics.card-h + Metrics.text-card * 2.6 + Metrics.title-rail * 2.6;

    property <bool> on-more: active && rail.more != "" && focus-col == rail.items.length;

    Text {
        x: inset;
        y: 0;
        height: head;
        text: rail.title;
        color: Theme.text;
        font-size: Metrics.title-rail;
        font-weight: 500;
        vertical-alignment: top;
    }

    // The reference's "Tümünü Gör ›" at the right end of the heading. Right
    // past the last poster reaches it.
    if rail.more != "": Rectangle {
        x: parent.width - right-inset - self.width;
        y: -Metrics.title-rail * 0.2;
        width: see-all.preferred-width + Metrics.title-rail * 1.2;
        height: Metrics.title-rail * 1.6;
        border-radius: self.height / 2;
        background: on-more ? Theme.focus-fill : transparent;

        see-all := Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: rail.more + "  ›";
            color: on-more ? #0a0c10 : #9997a7;
            font-size: Metrics.title-rail * 0.72;
            font-weight: 500;
        }
    }

    if rail.items.length == 0 && rail.note != "": Text {
        x: inset;
        y: head;
        text: rail.note;
        color: Theme.dim;
        font-size: Metrics.text-meta;
        font-weight: 620;
    }

    // The window the strip moves behind. It never moves itself.
    track := Rectangle {
        y: head;
        width: 100%;
        height: parent.height - self.y;
        clip: true;
        background: transparent;

        strip := Rectangle {
            property <length> step: Metrics.card-w + Metrics.rail-gap;
            property <length> span: step * rail.items.length;
            // The focused poster parks at the left and the shelf slides under
            // it, which is what makes a long shelf feel like one row rather
            // than a page. A shelf the remote has left stays where it was, as
            // the reference's rows do: rolled back to its start it showed
            // posters whose pictures were not loaded -- they are loaded
            // around where the shelf was left.
            property <length> wanted: clamp(focus-col * step, 0px,
                max(0px, span - track.width + inset + right-inset));

            x: inset - wanted;
            y: 0;
            width: span;
            height: 100%;
            background: transparent;

            animate x { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in rail.items: Poster {
                x: i * parent.step;
                y: Metrics.focus-room;
                item: item;
                focused: active && i == focus-col;
            }
        }
    }
}

// An icon with its name under it, which is what a television's home screen has
// looked like for fifteen years. Smaller than it used to be: this is a shelf at
// the bottom of the home screen now, not the row the product opens on.
export component AppIcon inherits Rectangle {
    in property <AppTile> tile;
    in property <bool> focused;

    // Two lines of room for the name, always. "Filmler ve Diziler" does not fit
    // on one at any width this tile is drawn at, and an elided application name
    // on a launcher — "Filmler ve Di…" — is a tile nobody can read from a sofa.
    width: Metrics.tile-w;
    height: self.width + Metrics.root-font * 0.4 + Metrics.root-font * 0.84 * 2.6
        + (tile.note == "" ? 0px : Metrics.root-font * 0.72 * 1.4);
    background: transparent;
    opacity: tile.ready ? 1.0 : 0.45;

    VerticalLayout {
        spacing: Metrics.root-font * 0.4;
        alignment: start;

        Rectangle {
            height: Metrics.tile-w;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Metrics.tile-w * (focused ? 1.09 : 1.0);
                height: self.width;
                border-radius: self.width * 0.26;
                background: @radial-gradient(circle,
                    Colors.hsv(tile.hue, 0.63, 0.50) 0%,
                    Colors.hsv(tile.hue, 0.59, 0.28) 54%,
                    #10131a 100%);
                border-width: focused ? 3px : 1px;
                border-color: focused ? Theme.focus-ring : #ffffff1a;

                animate width { duration: Theme.focus-in; easing: Theme.ease; }

                Path {
                    x: parent.width * 0.27;
                    y: parent.height * 0.27;
                    width: parent.width * 0.46;
                    height: parent.height * 0.46;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: tile.mark;
                    // Stroked, not filled: these are line marks, and filling
                    // them turns a television icon into an inkblot.
                    fill: transparent;
                    stroke: #ffffff;
                    stroke-width: 1.5px;
                }
            }
        }

        Text {
            text: tile.name;
            color: focused ? Theme.text : Theme.muted;
            font-size: Metrics.root-font * 0.84;
            font-weight: 680;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            height: Metrics.root-font * 0.84 * 2.6;
            min-width: 0px;
        }

        if tile.note != "": Text {
            text: tile.note;
            color: Theme.dim;
            font-size: Metrics.root-font * 0.72;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
            min-width: 0px;
        }
    }
}

// The launcher, as a shelf. The same head as a catalogue rail so it reads as
// one more row of the home screen rather than as a control panel bolted on.
export component AppRail inherits Rectangle {
    in property <[AppTile]> apps;
    in property <int> focus-col;
    in property <bool> active;

    property <length> tile-h: Metrics.tile-w + Metrics.root-font * 0.4
        + Metrics.root-font * 0.84 * 1.3 + Metrics.root-font * 0.72 * 1.4;

    height: tile-h + Metrics.title-rail * 2.0;

    Text {
        x: Metrics.gutter;
        y: 0;
        height: Metrics.title-rail * 2.0;
        text: "Uygulamalar";
        color: active ? Theme.text : Theme.muted;
        font-size: Metrics.title-rail;
        font-weight: 720;
        vertical-alignment: center;
        animate color { duration: Theme.focus-in; easing: Theme.ease; }
    }

    HorizontalLayout {
        x: Metrics.gutter;
        y: Metrics.title-rail * 2.0;
        width: parent.width - Metrics.gutter * 2;
        height: tile-h;
        spacing: Metrics.tile-gap;
        alignment: start;

        for tile[i] in apps: AppIcon {
            tile: tile;
            focused: active && i == focus-col;
        }
    }
}

// The panel every widget is drawn on. Flat translucent fill with a hairline:
// the wallpaper stays visible through it, and a blur over a full-screen layer
// was measured at a quarter of a core on this board.
export component Widget inherits Rectangle {
    border-radius: 18px;
    background: #ffffff0e;
    border-width: 1px;
    border-color: #ffffff14;
}

// One ring. The reading is an arc, so a new value changes one path.
component Dial inherits Rectangle {
    in property <string> arc;
    in property <string> value;
    in property <string> label;

    width: Metrics.dial-d;
    height: self.width + Metrics.root-font * 0.24 + Metrics.root-font * 0.7 * 1.3;
    background: transparent;

    VerticalLayout {
        spacing: Metrics.root-font * 0.24;
        alignment: start;

        Rectangle {
            height: Metrics.dial-d;

            // The track, always whole.
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 2 A 10 10 0 1 1 11.99 2";
                fill: transparent;
                stroke: #ffffff1a;
                stroke-width: Metrics.dial-d * 0.085;
            }

            // The reading.
            if arc != "": Path {
                width: 100%;
                height: 100%;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: arc;
                fill: transparent;
                stroke: Theme.ok;
                stroke-width: Metrics.dial-d * 0.085;
            }

            Text {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                text: value;
                color: Theme.text;
                font-size: Metrics.root-font * 0.82;
                font-weight: 740;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: label;
            color: Theme.muted;
            font-size: Metrics.root-font * 0.7;
            font-weight: 640;
            horizontal-alignment: center;
        }
    }
}

// The column down the left of the home screen.
//
// Nothing here is focusable: it is read, not operated, and a remote should walk
// applications rather than gauges. This is a single-board computer and the
// interface is the only thing anybody will ever see of it, so how the machine
// is doing belongs on its front page rather than three screens deep.
export component Vitals inherits Rectangle {
    in property <VitalsModel> vitals;

    background: transparent;

    VerticalLayout {
        spacing: Metrics.widget-gap;
        alignment: start;

        Widget {
            VerticalLayout {
                padding-top: Metrics.widget-pad-y;
                padding-bottom: Metrics.widget-pad-y;
                padding-left: Metrics.widget-pad-x;
                padding-right: Metrics.widget-pad-x;
                spacing: Metrics.root-font * 0.05;

                Text {
                    text: vitals.time;
                    color: Theme.text;
                    font-size: Metrics.clock-size;
                    font-weight: 780;
                    letter-spacing: -0.03 * Metrics.clock-size;
                }
                Text {
                    text: vitals.date;
                    color: Theme.muted;
                    font-size: Metrics.root-font * 0.82;
                    font-weight: 640;
                    overflow: elide;
                    wrap: no-wrap;
                    min-width: 0px;
                }
            }
        }

        Widget {
            VerticalLayout {
                padding-top: Metrics.widget-pad-y;
                padding-bottom: Metrics.widget-pad-y;
                padding-left: Metrics.widget-pad-x;
                padding-right: Metrics.widget-pad-x;
                spacing: Metrics.root-font * 0.3;

                Text {
                    text: "PERFORMANS";
                    color: Theme.dim;
                    font-size: Metrics.root-font * 0.78;
                    font-weight: 700;
                    letter-spacing: 0.06 * Metrics.root-font * 0.78;
                }

                HorizontalLayout {
                    spacing: Metrics.dial-gap;
                    alignment: start;

                    Dial {
                        arc: vitals.cpu-arc;
                        value: vitals.cpu-text;
                        label: "İşlemci";
                    }
                    Dial {
                        arc: vitals.memory-arc;
                        value: vitals.memory-text;
                        label: "Bellek";
                    }
                }

                Text {
                    text: vitals.performance-note;
                    color: Theme.muted;
                    font-size: Metrics.root-font * 0.76;
                    font-weight: 600;
                    overflow: elide;
                    wrap: no-wrap;
                    min-width: 0px;
                }
            }
        }

        Widget {
            VerticalLayout {
                padding-top: Metrics.widget-pad-y;
                padding-bottom: Metrics.widget-pad-y;
                padding-left: Metrics.widget-pad-x;
                padding-right: Metrics.widget-pad-x;
                spacing: Metrics.root-font * 0.3;

                Text {
                    text: "DEPOLAMA";
                    color: Theme.dim;
                    font-size: Metrics.root-font * 0.78;
                    font-weight: 700;
                    letter-spacing: 0.06 * Metrics.root-font * 0.78;
                }
                Text {
                    text: vitals.storage-text;
                    color: Theme.text;
                    font-size: Metrics.root-font * 1.05;
                    font-weight: 720;
                    overflow: elide;
                    wrap: no-wrap;
                    min-width: 0px;
                }
                Rectangle {
                    height: 5px;
                    border-radius: 999px;
                    background: #ffffff1f;
                    clip: true;

                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(vitals.storage-fraction, 0.0, 1.0);
                        height: 100%;
                        background: Theme.accent;
                    }
                }
            }
        }

        Widget {
            VerticalLayout {
                padding-top: Metrics.widget-pad-y;
                padding-bottom: Metrics.widget-pad-y;
                padding-left: Metrics.widget-pad-x;
                padding-right: Metrics.widget-pad-x;
                spacing: Metrics.root-font * 0.3;

                Text {
                    text: "AĞ";
                    color: Theme.dim;
                    font-size: Metrics.root-font * 0.78;
                    font-weight: 700;
                    letter-spacing: 0.06 * Metrics.root-font * 0.78;
                }

                // Neither way up: say so once, plainly, rather than drawing two
                // grey lines and leaving the viewer to work it out.
                if !vitals.eth-up && !vitals.wifi-up: Text {
                    text: vitals.network;
                    color: Theme.warn;
                    font-size: Metrics.root-font * 1.05;
                    font-weight: 720;
                    overflow: elide;
                    wrap: no-wrap;
                    min-width: 0px;
                }

                if vitals.eth-up || vitals.wifi-up: VerticalLayout {
                    spacing: Metrics.root-font * 0.18;

                    if vitals.eth-up: LinkLine {
                        up: true;
                        name: "Ethernet";
                        address: vitals.eth-address;
                    }
                    if vitals.wifi-up: LinkLine {
                        up: true;
                        name: vitals.wifi-ssid;
                        address: vitals.wifi-address;
                        bars: vitals.wifi-bars;
                    }
                }

                Text {
                    text: vitals.machine;
                    color: Theme.muted;
                    font-size: Metrics.root-font * 0.76;
                    font-weight: 600;
                    overflow: elide;
                    wrap: no-wrap;
                    min-width: 0px;
                }
            }
        }
    }
}

// The bar every screen starts below.
//
// Minimal by instruction and by taste: three places to go, the clock, and
// whether the box is on the network. The machine's readings are on the
// diagnostics screen, where somebody who wants them will look.
export component TopBar inherits Rectangle {
    in property <[string]> items;
    in property <int> focus-col;
    in property <bool> active;
    in property <VitalsModel> vitals;
    // The screen's own name, for everything that is not the home screen.
    in property <string> heading;

    height: Metrics.topbar * 1.9;
    // Taller than the bar itself and transparent past it: a panel would cut the
    // backdrop off with a straight edge.
    background: @linear-gradient(180deg,
        #040508 0%, #040508e0 46%, #04050870 74%, transparent 100%);

    // Two groups, placed rather than laid out. A single HorizontalLayout with a
    // stretching spacer does not stretch when its alignment is `start`, and
    // `start` is what keeps the nav chips together — so the clock ended up
    // beside them instead of at the other end of the panel.
    HorizontalLayout {
        x: Metrics.gutter;
        y: 0;
        width: parent.width * 0.7;
        height: Metrics.topbar;
        spacing: Metrics.gutter * 0.4;
        alignment: start;

        if heading != "": Text {
            text: heading;
            color: Theme.text;
            font-size: Metrics.root-font * 1.16;
            font-weight: 780;
            vertical-alignment: center;
        }

        if heading == "": Text {
            text: "MediaBox";
            color: Theme.text;
            font-size: Metrics.root-font * 1.16;
            font-weight: 820;
            letter-spacing: -0.02 * Metrics.root-font;
            vertical-alignment: center;
        }

        Rectangle { width: Metrics.gutter * 0.5; }

        for label[i] in items: Rectangle {
            property <bool> focused: active && i == focus-col;
            width: caption.preferred-width + Metrics.root-font * 1.5;
            border-radius: Theme.radius * 0.7;
            background: focused ? Theme.focus-fill : transparent;

            caption := Text {
                text: label;
                color: focused ? #0a0c10 : Theme.muted;
                font-size: Metrics.root-font * 0.9;
                font-weight: 660;
                vertical-alignment: center;
            }

            animate background { duration: Theme.focus-in; easing: Theme.ease; }
        }

    }

    HorizontalLayout {
        x: parent.width - self.width - Metrics.gutter;
        y: 0;
        width: network.preferred-width + clock.preferred-width + Metrics.gutter * 0.5;
        height: Metrics.topbar;
        spacing: Metrics.gutter * 0.5;
        alignment: end;

        network := Text {
            text: vitals.network;
            color: Theme.dim;
            font-size: Metrics.root-font * 0.8;
            font-weight: 620;
            vertical-alignment: center;
        }

        clock := Text {
            text: vitals.time;
            color: Theme.text;
            font-size: Metrics.root-font * 1.02;
            font-weight: 760;
            vertical-alignment: center;
        }
    }
}

// A row of two words with a verdict colour. The technical panel, the
// diagnostics groups and the now-playing strip all draw one of these.
export component Reading inherits Rectangle {
    // Named `entry` rather than `row`: `row` is a layout property every
    // Rectangle already has, and shadowing it is a compile error.
    in property <TechRow> entry;
    in property <length> label-w: Metrics.card-w * 0.45;

    height: Metrics.root-font * 1.9;

    Text {
        x: 0;
        width: label-w;
        height: 100%;
        text: entry.label;
        color: Theme.dim;
        font-size: Metrics.text-label;
        font-weight: 640;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
    Text {
        x: label-w + Metrics.root-font * 0.5;
        width: parent.width - self.x;
        height: 100%;
        text: entry.value;
        color: entry.tone == "" ? Theme.text : Theme.tone(entry.tone);
        font-size: Metrics.text-label;
        font-weight: 660;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

// A small rounded label. Everything the product says about a source, a codec or
// a decision is one of these.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    in property <bool> solid: false;

    height: Metrics.text-chip * 2.0;
    width: caption.preferred-width + Metrics.text-chip * 1.5;
    border-radius: self.height / 2;
    background: solid ? Theme.tone(tone) : #ffffff12;
    border-width: solid ? 0px : 1px;
    border-color: #ffffff1c;

    caption := Text {
        text: root.text;
        color: solid ? #0a0c10 : (tone == "" ? Theme.muted : Theme.tone(tone));
        font-size: Metrics.text-chip;
        font-weight: 680;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// A sheet over whatever is on the panel: the power menu, a confirmation.
//
// It has its own focus scope in Rust and the screen behind it does not move,
// which is the whole reason it is a sheet and not a screen. Drawn as the
// settings language's dialog, so a question looks the same wherever it is
// asked.
export component Sheet inherits Dialog {
    in property <string> title;
    in property <string> kind;
    in property <[SheetRow]> rows;
    in property <int> index;

    panel-w: Metrics.sheet-w;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Metrics.t-section;
        font-weight: 750;
        wrap: word-wrap;
    }

    if kind == "confirm": HorizontalLayout {
        padding-top: Metrics.row-gap;
        spacing: Metrics.row-gap * 1.2;
        alignment: start;

        for row[i] in rows: ActionButton {
            label: row.label;
            focused: i == index;
            danger: row.tone == "bad";
        }
    }

    if kind != "confirm": VerticalLayout {
        spacing: Metrics.row-gap;

        for row[i] in rows: SettingCard {
            label: row.label;
            hint: row.hint;
            kind: "action";
            danger: row.tone == "bad";
            focused: i == index;
        }
    }
}

