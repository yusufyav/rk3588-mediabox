import { Theme, Metrics } from "theme.slint";
import { GridPoster, PosterItem } from "components.slint";
import { Chrome } from "chrome.slint";
import { ReferenceIcon } from "reference-icons.slint";

// One of the dropdowns along the top of Discover.
export struct DiscoverFilter {
    label: string,
    value: string,
    options: [string],
    selected: int,
}

// A rounded label in the record: a genre, a name.
component Chip inherits Rectangle {
    in property <string> text;
    property <length> chip-h: Metrics.vh * 0.025;
    height: chip-h;
    width: words.preferred-width + chip-h * 0.9;
    border-radius: chip-h / 2;
    background: #ffffff1f;

    words := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: Theme.text;
        font-size: Metrics.vw * 0.0069;
        font-weight: 500;
    }
}

// A heading and its chips, two to a line: the reference wraps a third name
// onto a line of its own rather than off the edge of the panel.
component Section inherits VerticalLayout {
    in property <string> label;
    in property <[[string]]> lines;
    spacing: Metrics.vh * 0.009;

    Text {
        text: label;
        color: #ffffff80;
        font-size: Metrics.vw * 0.0062;
        font-weight: 600;
        letter-spacing: Metrics.vw * 0.0004;
    }
    for line in lines: HorizontalLayout {
        spacing: Metrics.vw * 0.004;
        alignment: start;
        for item in line: Chip { text: item; }
    }
}

// A round button under the record.
component RoundButton inherits Rectangle {
    in property <string> mark;
    in property <bool> focused;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> label;
    width: label == "" ? self.height : words.preferred-width + self.height * 1.4;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.35;
    background: focused ? Theme.focus-fill : #ffffff1f;
    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        alignment: center;
        spacing: root.height * 0.2;
        VerticalLayout {
            alignment: center;
            ReferenceIcon {
                name: mark;
                size: root.height * 0.42;
                ink: focused ? #0a0c10 : #ffffffd9;
            }
        }
        words := Text {
            text: label;
            visible: label != "";
            color: focused ? #0a0c10 : Theme.text;
            font-size: root.height * 0.25;
            font-weight: 400;
            vertical-alignment: center;
        }
    }
}

// One stop in the reference's group of two -- the library and watched
// marks share one pill (its ActionsGroup), each a round stop in it.
component GroupStop inherits Rectangle {
    in property <string> mark;
    in property <bool> focused;
    in property <bool> enabled: true;
    width: self.height;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.35;
    background: focused ? Theme.focus-fill : transparent;
    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    ReferenceIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: mark;
        size: root.height * 0.42;
        ink: focused ? #0a0c10 : #ffffffd9;
    }
}

// Discover, laid out as the reference's and measured off a 4K screenshot of
// it: the board's frame, three dropdowns along the top, seven posters to a
// row, and the focused title's record down the right-hand side, full height,
// with its buttons along the bottom.
export component Discover inherits Rectangle {
    in property <[DiscoverFilter]> filters;
    in property <int> filter;
    in property <bool> on-filters;
    // The open dropdown's highlighted option, or -1.
    in property <int> picker;

    in property <[PosterItem]> items;
    in property <int> index;
    in property <int> columns;
    in property <bool> loading;
    in property <bool> ended;
    // Said in place of the grid, or under it: nothing here, a page that failed.
    in property <string> note;
    in property <bool> on-grid;

    // 0 the grid and filters, 1 the places, 2 the search box, 3 the buttons.
    in property <int> zone;
    in property <int> place;
    in property <[string]> places;
    in property <int> button;

    // The record of the focused title.
    in property <image> art;
    in property <image> logo;
    // A logo is on its way: neither it nor the name is drawn meanwhile.
    in property <bool> logo-pending;
    in property <string> title;
    in property <[string]> facts;
    in property <bool> imdb;
    // Its lines, broken in Rust: the reference sets it with more room
    // between lines than Slint's Text has a property for.
    in property <[string]> summary;
    // Chips, as the lines they wrap into.
    in property <[[string]]> genres;
    in property <[[string]]> cast;
    in property <[[string]]> directors;
    in property <bool> has-trailer;
    in property <bool> known;
    in property <bool> in-library;
    in property <bool> watched;
    in property <bool> series;

    // Measured off a 4K capture of the reference's desktop Discover, which
    // the viewer compared this against: the first poster 5.86% in and 15.3%
    // down, 8.70% of the width across, one every 10.47% across and 30.7%
    // down; the record from 80.2% across and 6.67% down, its content 1.7% in.
    property <length> grid-x: root.width * 0.0586;
    property <length> grid-top: root.height * 0.153;
    property <length> art-w: root.width * 0.087;
    property <length> cell-w: root.width * 0.1047;
    property <length> cell-h: root.height * 0.307;
    property <length> panel-x: root.width * 0.802;
    property <length> panel-y: root.height * 0.0667;
    property <length> pad: root.width * 0.017;
    property <length> viewport-h: root.height - grid-top;
    property <int> rows: Math.ceil(items.length / columns) + (loading ? 1 : 0);
    // Kept on the row the remote was last on whichever zone it is in, as
    // the reference's page does not scroll when the focus leaves the grid;
    // the posters are loaded around that same row.
    property <length> scroll: clamp(Math.floor(index / columns) * cell-h - cell-h * 0.1,
                0px,
                max(0px, rows * cell-h - viewport-h));

    background: Theme.catalog-bg;
    clip: true;

    // ---------------------------------------------------------------- the grid
    Rectangle {
        x: grid-x - Metrics.focus-room;
        y: grid-top - Metrics.focus-room;
        width: panel-x - self.x;
        height: viewport-h + Metrics.focus-room;
        clip: true;

        if items.length == 0: Text {
            x: Metrics.focus-room;
            y: Metrics.root-font * 2;
            width: parent.width - Metrics.focus-room * 2;
            text: loading ? "Katalog yükleniyor…" : note;
            color: Theme.dim;
            font-size: Metrics.text-meta;
            wrap: word-wrap;
        }

        Rectangle {
            x: Metrics.focus-room;
            y: Metrics.focus-room - scroll;
            width: columns * cell-w;
            height: max(1px, rows * cell-h);

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in items: GridPoster {
                x: Math.mod(i, columns) * cell-w;
                y: Math.floor(i / columns) * cell-h;
                art-w: root.art-w;
                name-size: root.width * 0.0078;
                item: item;
                focused: on-grid && i == index;
            }

            // The next page on its way: a row of empty frames where it lands.
            if loading && items.length > 0: Rectangle {
                y: Math.ceil(items.length / columns) * cell-h;
                width: columns * cell-w;
                height: art-w * 1.461;

                for slot in [0, 1, 2, 3, 4, 5, 6]: Rectangle {
                    x: slot * cell-w;
                    width: art-w;
                    height: art-w * 1.461;
                    border-radius: art-w * 0.055;
                    background: #ffffff0a;
                }
            }

            if !loading && items.length > 0 && note != "": Text {
                y: Math.ceil(items.length / columns) * cell-h;
                width: columns * cell-w;
                text: note;
                color: Theme.dim;
                font-size: Metrics.text-meta * 0.9;
                horizontal-alignment: center;
            }
        }
    }

    // -------------------------------------------------------------- the record
    //
    // The reference's panel: full height from under the search box, its own
    // backdrop dimmed behind it, the logo centred, then the facts, what it is
    // about, genres, cast and directors, and its buttons along the bottom.
    Rectangle {
        x: panel-x;
        y: panel-y;
        width: root.width - self.x;
        height: root.height - self.y;
        border-radius: root.width * 0.009;
        // The reference's --modal-background-color; the grey it reads as is
        // the backdrop over it at 30%.
        background: #0f0d20;
        clip: true;

        // The reference's backdrop behind its record: blur(10px) at 30%.
        // The picture comes decoded a few dozen pixels wide, and drawn over
        // the panel it is that blur.
        if art.width > 0: Image {
            width: 100%;
            height: 100%;
            source: art;
            image-fit: cover;
            opacity: 0.3;
        }

        if title != "": VerticalLayout {
            x: pad;
            y: root.height * 0.024;
            width: parent.width - pad * 2;
            spacing: root.height * 0.024;
            alignment: start;

            // The logo's room, and under it the capture's extra 0.8% before
            // the facts.
            VerticalLayout {
                padding-bottom: root.height * 0.008;
                if logo.width > 0: Image {
                    source: logo;
                    image-fit: contain;
                    height: root.height * 0.077;
                }
                if logo.width == 0 && logo-pending: Rectangle {
                    height: root.height * 0.077;
                }
                if logo.width == 0 && !logo-pending: Text {
                    text: title;
                    color: Theme.text;
                    font-size: root.width * 0.014;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Runtime, year, and the rating with IMDb's badge beside it, spread
            // across the panel as the reference spreads them.
            HorizontalLayout {
                alignment: space-between;
                for fact[i] in facts: HorizontalLayout {
                    spacing: root.width * 0.003;
                    Text {
                        text: fact;
                        color: Theme.text;
                        font-size: root.width * 0.0098;
                        font-weight: 500;
                    }
                    // The capture's badge: 1.67% by 1.3%.
                    if imdb && i == facts.length - 1: VerticalLayout {
                    alignment: center;
                    Rectangle {
                    width: root.width * 0.0167;
                    height: root.height * 0.013;
                    border-radius: root.width * 0.001;
                    background: #f5c518;
                    badge := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "IMDb";
                        color: #0a0c10;
                        font-size: root.height * 0.0095;
                        font-weight: 800;
                    }
                    }
                    }
                }
            }

            // A line every 2.45% of the height, as the capture sets it.
            if summary.length > 0: VerticalLayout {
                for line in summary: Text {
                    height: root.height * 0.0245;
                    text: line;
                    color: #ffffffd9;
                    font-size: root.width * 0.0068;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            if genres.length > 0: Section { label: "TÜRÜ"; lines: genres; }
            if cast.length > 0: Section { label: "OYUNCULAR"; lines: cast; }
            if directors.length > 0: Section { label: "YÖNETMENLER"; lines: directors; }
        }

        // The buttons, along the bottom: trailer, library, watched and the
        // way into the title.
        if title != "": HorizontalLayout {
            x: pad;
            y: parent.height - self.height - root.height * 0.035;
            width: parent.width - pad * 2;
            // The capture's buttons: 4.86% of the height.
            height: root.height * 0.0486;
            spacing: root.width * 0.0045;
            alignment: start;

            // The reference's marks, which say what pressing does: add to
            // the library or take out of it, mark watched or not.
            RoundButton {
                mark: "trailer";
                enabled: has-trailer;
                focused: zone == 3 && button == 0;
            }
            Rectangle {
                width: self.height * 2;
                border-radius: self.height / 2;
                background: #ffffff1f;
                HorizontalLayout {
                    GroupStop {
                        mark: in-library ? "remove-from-library" : "add-to-library";
                        enabled: known;
                        focused: zone == 3 && button == 1;
                    }
                    GroupStop {
                        mark: watched ? "eye-off" : "eye";
                        enabled: known;
                        focused: zone == 3 && button == 2;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            RoundButton {
                mark: "play";
                label: "Göster";
                focused: zone == 3 && button == 3;
            }
        }
    }

    Chrome {
        width: 100%;
        height: 100%;
        on-search: zone == 2;
        on-places: zone == 1;
        place: place;
        current: 1;
        places: places;
    }

    // ------------------------------------------------------------ the filters
    //
    // The reference's three dropdowns, value only, a caret at the right. Last
    // in the file, so an open list is drawn over the grid.
    HorizontalLayout {
        x: root.width * 0.051;
        y: root.height * 0.0833;
        height: root.height * 0.0417;
        spacing: root.width * 0.0109;
        alignment: start;

        for f[i] in filters: Rectangle {
            property <bool> focused: on-filters && i == filter;
            width: root.width * 0.1026;
            border-radius: self.height * 0.28;
            background: focused ? Theme.focus-fill : #1e1c2f;
            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            Text {
                x: parent.height * 0.42;
                width: parent.width - parent.height * 1.3;
                height: 100%;
                text: f.value;
                color: focused ? #0a0c10 : Theme.text;
                font-size: parent.height * 0.3;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
            Path {
                x: parent.width - parent.height * 0.62;
                y: parent.height * 0.44;
                width: parent.height * 0.2;
                height: parent.height * 0.12;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M0 0L10 0L5 6z";
                fill: focused ? #0a0c10 : #ffffffb0;
            }

            // The open list, under its own filter. Nine lines at most, kept
            // around the highlighted one.
            if focused && picker >= 0: Rectangle {
                property <length> line-h: Metrics.root-font * 2.3;
                property <int> shown: min(f.options.length, 9);
                property <int> first: max(0, min(picker - 4, f.options.length - shown));
                x: 0;
                y: parent.height + Metrics.root-font * 0.3;
                width: max(parent.width, Metrics.root-font * 14);
                height: shown * line-h + Metrics.root-font * 0.8;
                border-radius: parent.border-radius;
                background: #1e1c2f;
                border-width: 1px;
                border-color: #ffffff1f;
                clip: true;

                for option[k] in f.options: Rectangle {
                    x: Metrics.root-font * 0.4;
                    y: Metrics.root-font * 0.4 + (k - first) * line-h;
                    width: parent.width - Metrics.root-font * 0.8;
                    height: line-h;
                    visible: k >= first && k < first + shown;
                    border-radius: parent.border-radius * 0.7;
                    background: k == picker ? #ffffff26 : transparent;

                    Text {
                        x: Metrics.root-font * 0.7;
                        width: parent.width - Metrics.root-font * 1.4;
                        height: 100%;
                        text: (k == f.selected ? "✓  " : "") + option;
                        color: Theme.text;
                        font-size: Metrics.text-meta * 0.85;
                        font-weight: k == f.selected ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }
}
