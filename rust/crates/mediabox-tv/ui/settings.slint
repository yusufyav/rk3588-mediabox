import { Theme, Metrics } from "theme.slint";
import { SettingRow, VitalsModel } from "components.slint";
import { CoolingPane, CoolingView } from "cooling.slint";
import { OutputPane, OutputView } from "output.slint";
import {
    SettingNav, SideNav, PageHeader, SettingCard, ReadingRow, SectionHeader,
    Backdrop, StatusCorner,
} from "kit.slint";

// What the box can be told, from the sofa.
//
// Seven categories down the left; the chosen one's contents on the right, as
// cards for what can be done and plain rows for what is only true. A card that
// leads to a page of its own — an account, the display — opens it on the same
// right-hand side, and the column on the left turns into where that page is.
//
// All of it is laid out in Rust's order (src/screens/settings.rs) and placed
// here by arithmetic rather than measured, so where the focused row is — and
// therefore how far the list scrolls — is known without asking the layout.
export component Settings inherits Rectangle {
    in property <[SettingNav]> sections;
    in property <int> section;
    in property <bool> on-sections;
    in property <[SettingRow]> rows;
    in property <int> row-index;
    // The page on screen, "" for a category's own list; its mark; and the
    // title and line the right-hand side opens with.
    in property <string> page;
    in property <string> page-icon;
    in property <string> title;
    in property <string> blurb;
    // The fan curve editor and the display editor are pages of their own.
    in property <bool> cooling;
    in property <CoolingView> cooling-view;
    in property <bool> output;
    in property <OutputView> output-view;
    in property <VitalsModel> vitals;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> bottom: root.height - Metrics.safe-y;
    property <bool> editor: cooling || output;

    background: Theme.s-ground;
    clip: true;

    Backdrop {
        width: 100%;
        height: 100%;
    }

    SideNav {
        x: 0;
        y: 0;
        width: Metrics.safe-x + Metrics.nav-w + Metrics.safe-x * 0.5;
        height: root.height;
        items: sections;
        current: section;
        active: on-sections;
        parent-label: page == "" ? "" : sections[section].label;
        page-label: page;
        page-icon: page-icon;
    }

    StatusCorner {
        x: root.width - Metrics.safe-x - self.width;
        y: Metrics.safe-y;
        width: self.preferred-width;
        height: Metrics.t-nav-head * 2.6;
        network: vitals.network;
        time: vitals.time;
    }

    PageHeader {
        x: Metrics.pane-x;
        y: Metrics.safe-y + Metrics.t-nav-head * 0.5;
        width: Metrics.pane-w * 0.68;
        title: root.title;
        blurb: root.blurb;
    }

    if cooling: CoolingPane {
        x: Metrics.pane-x;
        y: top;
        width: Metrics.pane-w;
        height: bottom - top;
        view: cooling-view;
        active-pane: !on-sections;
        titled: false;
    }

    if output: OutputPane {
        x: Metrics.pane-x;
        y: top;
        width: Metrics.pane-w;
        height: bottom - top;
        view: output-view;
        active-pane: !on-sections;
    }

    // The list. It scrolls, by whole rows' worth of arithmetic, only when the
    // focused row would otherwise fall off the bottom; the room above and below
    // it is the focus glow's, so the outline is never cut.
    if !editor: Rectangle {
        property <length> pad: Metrics.glow-w * 3;
        property <length> focus-y: rows.length == 0 ? 0px : y-of(rows[row-index]);
        property <length> focus-h: rows.length == 0 ? 0px : h-of(rows[row-index]);
        property <length> scroll: max(0px, focus-y + focus-h + pad * 2 - self.height);

        x: Metrics.pane-x - pad;
        y: top - pad;
        width: Metrics.list-w + pad * 2;
        height: bottom - top + pad;
        clip: true;

        pure function y-of(r: SettingRow) -> length {
            return r.n-header * Metrics.header-h
                + r.n-reading * Metrics.reading-h
                + r.n-card * (Metrics.set-h + Metrics.row-gap)
                + r.n-flat * (Metrics.set-h-flat + Metrics.row-gap);
        }
        pure function h-of(r: SettingRow) -> length {
            return r.kind == "header" ? Metrics.header-h
                : r.kind == "reading" ? Metrics.reading-h
                : r.hint == "" ? Metrics.set-h-flat
                : Metrics.set-h;
        }

        Rectangle {
            x: pad;
            y: pad - scroll;
            width: Metrics.list-w;
            animate y { duration: Theme.t-row; easing: Theme.ease; }

            for entry[i] in rows: Rectangle {
                x: 0;
                y: y-of(entry);
                width: parent.width;
                height: h-of(entry);

                if entry.kind == "header": SectionHeader {
                    width: 100%;
                    text: entry.label;
                }
                if entry.kind == "reading": ReadingRow {
                    width: 100%;
                    label: entry.label;
                    value: entry.value;
                    tone: entry.tone;
                }
                if entry.kind == "link" || entry.kind == "action": SettingCard {
                    width: 100%;
                    icon: entry.icon;
                    label: entry.label;
                    hint: entry.hint;
                    value: entry.value;
                    tone: entry.tone;
                    kind: entry.kind;
                    focused: !on-sections && i == row-index;
                }
            }
        }
    }
}
