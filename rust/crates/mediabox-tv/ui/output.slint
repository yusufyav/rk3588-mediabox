import { Theme, Metrics } from "theme.slint";
import {
    Icon, FocusRing, ValueBadge, StatusChip, SettingCard, ActionButton, ChoiceRow,
    InfoPanel, InfoLine, Badge, Dialog, StateNote, ChoiceItem, ChoiceSheet, TrialSheet,
} from "kit.slint";

// The display settings, in two faces.
//
// The simple face is what most people need: the resolution, the refresh rate
// and the colour format as three cards, what is on the wire now beside them,
// and a way into the rest. The advanced face is the whole of it — every size
// the display lists, the refresh rates of one, the colour modes at the mode
// chosen, each with what it costs on the link and why a refused one is
// refused — as it was before there was a simple face.
//
// Both are drawn from one OutputView composed in Rust (src/screens/output.rs),
// where the focus, the draft and the trial question live and are tested. This
// file only puts it on the panel.

export struct OutRow {
    title: string,
    sub: string,
    selected: bool,
    open: bool,
    focused: bool,
    now: bool,
    hdr: bool,
    divider: bool,
    refused: bool,
}

export struct OutCell {
    row: int,
    col: int,
    span: bool,
    state: string,
    mhz: string,
    fill: float,
    tick: float,
    ok: bool,
    selected: bool,
    focused: bool,
    hdr: bool,
    now: bool,
}

export struct OutAction {
    label: string,
    enabled: bool,
    focused: bool,
}

export struct OutInfo {
    label: string,
    value: string,
}

// One card of the simple face.
export struct OutSimple {
    icon: string,
    label: string,
    hint: string,
    value: string,
    // "link" opens something, "action" does something.
    kind: string,
    focused: bool,
}

export struct OutputView {
    available: bool,
    message: string,
    // 0 the simple face, 1 the advanced one.
    face: int,
    sink: string,
    wire-size: string,
    wire-rate: string,
    wire-format: string,
    wire-bits: string,
    load: string,
    load-max: string,
    load-fill: float,
    state: string,
    state-tone: string,
    // ---- the simple face
    simple: [OutSimple],
    simple-actions: [OutAction],
    current-title: string,
    current-line: string,
    current-badges: [Badge],
    current-rows: [InfoLine],
    picker-open: bool,
    picker-title: string,
    picker-note: string,
    picker: [ChoiceItem],
    picker-focus: int,
    // ---- the advanced face
    resolutions: [OutRow],
    // The row the remote is on (or the chosen one), and the first computer
    // mode's row, -1 when there is none: for scrolling the list.
    resolution-focus: int,
    divider-at: int,
    resolution-count: string,
    rate-title: string,
    rates: [OutRow],
    colour-title: string,
    auto-colour: string,
    auto-colour-selected: bool,
    auto-colour-focused: bool,
    cells: [OutCell],
    reason: string,
    actions: [OutAction],
    note: string,
    // ---- the dialogs
    sheet: int,
    seconds: int,
    fraction: float,
    // The time left, as a ring's arc in a 24×24 box.
    arc: string,
    // False for the first moment of the question, while the press that asked
    // for the trial may still be arriving; the buttons are drawn but take
    // nothing.
    confirm-ready: bool,
    trial: string,
    previous: string,
    confirm-focus: int,
    edid: [OutInfo],
}

// A reading along the top of the advanced face.
component Reading inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <float> bar: -1;
    border-radius: Metrics.s-radius;
    background: Theme.s-card;
    border-width: 1px;
    border-color: Theme.s-hairline;
    VerticalLayout {
        padding-left: Metrics.card-pad * 0.8;
        padding-right: Metrics.card-pad * 0.8;
        alignment: center;
        spacing: Metrics.t-meta * 0.1;
        Text {
            text: label;
            color: Theme.muted;
            font-size: Metrics.t-meta * 0.82;
            font-weight: 650;
            letter-spacing: Metrics.t-meta * 0.05;
            overflow: elide;
            wrap: no-wrap;
        }
        HorizontalLayout {
            spacing: Metrics.t-meta * 0.45;
            alignment: start;
            Text {
                text: value;
                color: Theme.text;
                font-size: Metrics.t-primary * 1.05;
                font-weight: 750;
                wrap: no-wrap;
            }
            if sub != "": Text {
                text: sub;
                color: Theme.muted;
                font-size: Metrics.t-meta;
                font-weight: 550;
                vertical-alignment: bottom;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        if bar >= 0: Rectangle {
            height: max(3px, Metrics.t-meta * 0.24);
            border-radius: self.height / 2;
            background: Theme.s-line;
            Rectangle {
                x: 0;
                width: parent.width * bar;
                border-radius: parent.border-radius;
                background: bar > 0.98 ? Theme.warn : Theme.ok;
            }
        }
    }
}

// One row of a list in the advanced face: a dot for what is chosen, a title and
// a line under it, and labels on the right.
component ListRow inherits Rectangle {
    in property <OutRow> item;
    in property <bool> active;
    property <bool> lit: item.focused && active;
    border-radius: Metrics.s-radius * 0.75;
    background: lit ? Theme.s-card-hi : (item.open ? Theme.s-current : transparent);
    animate background { duration: Theme.t-focus; easing: Theme.ease; }
    HorizontalLayout {
        padding-left: Metrics.card-pad * 0.5;
        padding-right: Metrics.card-pad * 0.5;
        spacing: Metrics.card-pad * 0.45;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Metrics.t-meta * 0.72;
                height: self.width;
                border-radius: self.width / 2;
                background: item.selected ? Theme.focus : transparent;
                border-width: 2px;
                border-color: item.selected ? Theme.focus : #4a505d;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: item.title;
                color: lit ? #ffffff : (item.refused ? Theme.dim : Theme.text);
                font-size: Metrics.t-primary * 0.9;
                font-weight: 650;
                wrap: no-wrap;
                overflow: elide;
            }
            if item.sub != "": Text {
                text: item.sub;
                color: Theme.muted;
                font-size: Metrics.t-meta * 0.9;
                font-weight: 500;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        if item.now: VerticalLayout {
            alignment: center;
            ValueBadge { text: "ŞU AN"; tone: "good"; font-size: Metrics.t-meta * 0.8; }
        }
        if item.hdr: VerticalLayout {
            alignment: center;
            ValueBadge { text: "HDR"; tone: "hdr"; font-size: Metrics.t-meta * 0.8; }
        }
        if item.refused: VerticalLayout {
            alignment: center;
            ValueBadge { text: "SIĞMAZ"; tone: ""; font-size: Metrics.t-meta * 0.8; }
        }
    }
    FocusRing {
        width: 100%;
        height: 100%;
        radius: parent.border-radius;
        on: lit;
    }
}

// One colour cell: what it is to the draft, what it costs, and a bar of that
// cost against what this board sends at most, with the link's ceiling marked.
component ColourCellBox inherits Rectangle {
    in property <OutCell> cell;
    in property <bool> active;
    property <bool> lit: cell.focused && active;
    border-radius: Metrics.s-radius * 0.7;
    background: lit ? Theme.s-card-hi : (cell.ok ? Theme.s-card : transparent);
    border-width: 1px;
    border-color: cell.selected ? Theme.focus.with-alpha(0.7) : (cell.ok ? Theme.s-line : Theme.s-hairline);
    animate background { duration: Theme.t-focus; easing: Theme.ease; }
    VerticalLayout {
        padding-left: Metrics.card-pad * 0.5;
        padding-right: Metrics.card-pad * 0.5;
        padding-top: Metrics.t-meta * 0.35;
        padding-bottom: Metrics.t-meta * 0.45;
        spacing: Metrics.t-meta * 0.3;
        HorizontalLayout {
            spacing: Metrics.t-meta * 0.3;
            Text {
                text: (cell.span ? cell.state + " · 12 bit kapta" : cell.state)
                    + (cell.now && cell.selected ? " · şu an" : "");
                color: lit ? #ffffff : (cell.selected ? Theme.focus : (cell.ok ? Theme.text : Theme.dim));
                font-size: Metrics.t-meta * 0.92;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: no-wrap;
                overflow: elide;
                min-width: 0px;
            }
            if cell.hdr: VerticalLayout {
                alignment: center;
                ValueBadge { text: "HDR"; tone: "hdr"; font-size: Metrics.t-meta * 0.78; }
            }
        }
        HorizontalLayout {
            spacing: Metrics.t-meta * 0.5;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: max(3px, Metrics.t-meta * 0.24);
                    border-radius: self.height / 2;
                    background: #0a0d12;
                    Rectangle {
                        x: 0;
                        width: parent.width * cell.fill;
                        border-radius: parent.border-radius;
                        background: cell.ok ? (cell.selected ? Theme.focus : #5d6879) : #7f2d2d;
                    }
                    Rectangle {
                        x: parent.width * cell.tick - 1px;
                        y: -Metrics.t-meta * 0.18;
                        width: 2px;
                        height: parent.height + Metrics.t-meta * 0.36;
                        background: Theme.muted;
                    }
                }
            }
            Text {
                text: cell.mhz;
                color: Theme.muted;
                font-size: Metrics.t-meta * 0.85;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
    FocusRing {
        width: 100%;
        height: 100%;
        radius: parent.border-radius;
        on: lit;
    }
}

// A card on the advanced face: a title along the top and its contents.
component Panel inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    out property <length> head-h: Metrics.t-primary * 2.2;
    border-radius: Metrics.s-radius;
    background: #10131bd9;
    border-width: 1px;
    border-color: Theme.s-hairline;

    // One row: the caption gives way (elides) before the title does, so a
    // narrow panel never draws one over the other.
    HorizontalLayout {
        x: Metrics.card-pad * 0.8;
        y: 0;
        width: parent.width - Metrics.card-pad * 1.6;
        height: head-h;
        spacing: Metrics.t-meta * 0.6;
        Text {
            text: title;
            color: Theme.text;
            font-size: Metrics.t-primary;
            font-weight: 700;
            vertical-alignment: center;
            wrap: no-wrap;
        }
        Text {
            text: caption;
            color: Theme.muted;
            font-size: Metrics.t-meta * 0.9;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
            min-width: 0px;
        }
    }
    @children
}

// ------------------------------------------------------------------ the faces

component SimpleFace inherits Rectangle {
    in property <OutputView> view;
    in property <bool> active-pane;

    property <length> gap: Metrics.row-gap;
    property <length> info-x: Metrics.list-w + Metrics.card-pad * 1.6;

    VerticalLayout {
        x: 0;
        y: 0;
        width: Metrics.list-w;
        spacing: gap;
        alignment: start;

        for card[i] in view.simple: VerticalLayout {
            spacing: 0px;
            // The way into the advanced face stands apart from the three
            // settings above it.
            if i == 3: Rectangle { height: gap * 1.4; }
            SettingCard {
                icon: card.icon;
                label: card.label;
                hint: card.hint;
                value: card.value;
                kind: card.kind;
                focused: active-pane && card.focused;
            }
        }

        HorizontalLayout {
            padding-top: gap * 1.6;
            spacing: gap * 1.4;
            alignment: start;
            for act[i] in view.simple-actions: ActionButton {
                label: act.label;
                enabled: act.enabled;
                focused: active-pane && act.focused;
                primary: i == 0;
            }
            if view.state != "": VerticalLayout {
                alignment: center;
                StatusChip {
                    text: view.state;
                    tone: view.state-tone == "accent" ? "warn" : view.state-tone;
                    font-size: Metrics.t-meta;
                }
            }
        }

        Text {
            text: view.note;
            color: Theme.muted;
            font-size: Metrics.t-meta;
            wrap: word-wrap;
        }
    }

    if root.width - info-x > Metrics.t-primary * 9: InfoPanel {
        x: info-x;
        y: 0;
        width: root.width - info-x;
        caption: "Mevcut çıkış";
        icon: "monitor";
        title: view.current-title;
        line: view.current-line;
        badges: view.current-badges;
        rows: view.current-rows;
    }
}

component AdvancedFace inherits Rectangle {
    in property <OutputView> view;
    in property <bool> active-pane;

    property <length> gap: Metrics.row-gap * 1.3;
    property <length> read-h: Metrics.t-primary * 3.0;
    property <length> act-h: max(Metrics.button-h, Metrics.t-meta * 3.6);
    property <length> main-y: read-h + gap;
    property <length> main-h: root.height - main-y - gap - act-h;
    property <length> res-w: root.width * 0.28;
    property <length> rate-w: root.width * 0.22;
    property <length> pad: Metrics.card-pad * 0.5;
    property <length> row-h: Metrics.t-primary * 2.35;
    property <length> row-gap: Metrics.row-gap * 0.35;

    // -------------------------------------------------------------- readings

    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: read-h;
        spacing: gap;
        Reading {
            horizontal-stretch: 1;
            label: "ŞU AN GİDEN";
            value: view.wire-size;
            sub: view.wire-rate;
        }
        Reading {
            horizontal-stretch: 1;
            label: "RENK";
            value: view.wire-format;
            sub: view.wire-bits;
        }
        Reading {
            horizontal-stretch: 1;
            label: "HAT YÜKÜ";
            value: view.load;
            sub: view.load-max;
            bar: view.load-fill;
        }
        VerticalLayout {
            alignment: center;
            StatusChip {
                text: view.state;
                tone: view.state-tone == "accent" ? "warn" : view.state-tone;
                font-size: Metrics.t-secondary;
            }
        }
    }

    // ----------------------------------------------------------- resolutions

    Panel {
        x: 0;
        y: main-y;
        width: res-w;
        height: main-h;
        title: "Çözünürlük";
        caption: view.resolution-count;
        clip: true;

        // The list scrolls to keep the row the remote is on in view: once it
        // would fall below the bottom, the rows above move up by whole rows.
        Rectangle {
            property <length> pitch: row-h + row-gap;
            property <length> divider-h: Metrics.t-meta * 1.9;
            property <length> focus-bottom: (view.resolution-focus + 1) * pitch
                + (view.divider-at >= 0 && view.resolution-focus >= view.divider-at ? divider-h : 0px)
                + Metrics.glow-w * 2;
            x: pad;
            y: parent.head-h;
            width: parent.width - pad * 2;
            height: parent.height - self.y - pad;
            clip: true;
            VerticalLayout {
                y: min(Metrics.glow-w, parent.height - focus-bottom);
                x: Metrics.glow-w;
                width: parent.width - Metrics.glow-w * 2;
                spacing: row-gap;
                alignment: start;
                animate y { duration: Theme.t-row; easing: Theme.ease; }
                for row in view.resolutions: VerticalLayout {
                    spacing: 0px;
                    if row.divider: Text {
                        height: divider-h - row-gap;
                        text: "BİLGİSAYAR MODLARI";
                        color: Theme.muted;
                        font-size: Metrics.t-meta * 0.8;
                        font-weight: 700;
                        letter-spacing: Metrics.t-meta * 0.06;
                        vertical-alignment: bottom;
                    }
                    ListRow { height: row-h; item: row; active: active-pane; }
                }
            }
        }
    }

    // ---------------------------------------------------------------- rates

    Panel {
        x: res-w + gap;
        y: main-y;
        width: rate-w;
        height: main-h;
        title: "Yenileme";
        caption: view.rate-title;
        clip: true;

        VerticalLayout {
            x: pad + Metrics.glow-w;
            y: parent.head-h + Metrics.glow-w;
            width: parent.width - pad * 2 - Metrics.glow-w * 2;
            spacing: row-gap;
            alignment: start;
            for row in view.rates: ListRow { height: row-h; item: row; active: active-pane; }
        }
    }

    // --------------------------------------------------------------- colours

    Panel {
        property <length> inner-x: pad + Metrics.card-pad * 0.3;
        property <length> inner-w: self.width - inner-x * 2;
        property <length> label-w: Metrics.t-meta * 5.8;
        property <length> col-gap: Metrics.t-meta * 0.5;
        property <length> col-w: (inner-w - label-w - col-gap * 2) / 2;
        property <length> chip-y: self.head-h;
        property <length> chip-h: row-h;
        property <length> heads-y: chip-y + chip-h + Metrics.row-gap;
        property <length> heads-h: Metrics.t-meta * 1.4;
        property <length> grid-y: heads-y + heads-h;
        property <length> cell-h: Metrics.t-meta * 3.5;
        property <length> cell-gap: Metrics.row-gap * 0.6;
        x: res-w + gap + rate-w + gap;
        y: main-y;
        width: root.width - self.x;
        height: main-h;
        title: "Renk";
        caption: view.colour-title;

        // Otomatik.
        auto-chip := Rectangle {
            property <bool> lit: view.auto-colour-focused && active-pane;
            x: inner-x;
            y: chip-y;
            width: inner-w;
            height: chip-h;
            border-radius: Metrics.s-radius * 0.7;
            background: lit ? Theme.s-card-hi : Theme.s-card;
            border-width: 1px;
            border-color: Theme.s-line;
            animate background { duration: Theme.t-focus; easing: Theme.ease; }
            HorizontalLayout {
                padding-left: Metrics.card-pad * 0.5;
                padding-right: Metrics.card-pad * 0.6;
                spacing: Metrics.card-pad * 0.45;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Metrics.t-meta * 0.72;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: view.auto-colour-selected ? Theme.focus : transparent;
                        border-width: 2px;
                        border-color: view.auto-colour-selected ? Theme.focus : #4a505d;
                    }
                }
                Text {
                    text: "Otomatik";
                    color: auto-chip.lit ? #ffffff : Theme.text;
                    font-size: Metrics.t-primary * 0.9;
                    font-weight: 650;
                    vertical-alignment: center;
                }
                Text {
                    text: view.auto-colour;
                    color: Theme.muted;
                    font-size: Metrics.t-meta * 0.85;
                    font-weight: 550;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
            }
            FocusRing {
                width: 100%;
                height: 100%;
                radius: parent.border-radius;
                on: auto-chip.lit;
            }
        }

        // The grid: a format per row, a depth per column.
        Text {
            x: inner-x + label-w + col-gap;
            y: heads-y;
            height: heads-h;
            text: "8 BIT";
            color: Theme.muted;
            font-size: Metrics.t-meta * 0.84;
            font-weight: 650;
            vertical-alignment: center;
        }
        Text {
            x: inner-x + label-w + col-gap * 2 + col-w;
            y: heads-y;
            height: heads-h;
            text: "10 BIT";
            color: Theme.muted;
            font-size: Metrics.t-meta * 0.84;
            font-weight: 650;
            vertical-alignment: center;
        }
        for name[i] in ["RGB", "YCbCr 4:4:4", "YCbCr 4:2:2", "YCbCr 4:2:0"]: Text {
            x: inner-x;
            y: grid-y + i * (cell-h + cell-gap);
            width: label-w;
            height: cell-h;
            text: name;
            color: Theme.muted;
            font-size: Metrics.t-meta * 0.92;
            font-weight: 650;
            vertical-alignment: center;
            overflow: elide;
        }
        for cell in view.cells: ColourCellBox {
            x: inner-x + label-w + col-gap + (cell.span ? 0 : cell.col * (col-w + col-gap));
            y: grid-y + cell.row * (cell-h + cell-gap);
            width: cell.span ? col-w * 2 + col-gap : col-w;
            height: cell-h;
            cell: cell;
            active: active-pane;
        }

        // What is under the focus.
        Rectangle {
            x: inner-x;
            y: grid-y + 4 * (cell-h + cell-gap) + Metrics.row-gap * 0.3;
            width: inner-w;
            height: 1px;
            background: Theme.s-hairline;
        }
        Text {
            x: inner-x;
            y: grid-y + 4 * (cell-h + cell-gap) + Metrics.row-gap;
            width: inner-w;
            height: parent.height - self.y - pad;
            text: view.reason;
            color: Theme.muted;
            font-size: Metrics.t-meta;
            font-weight: 500;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }

    // --------------------------------------------------------------- actions

    HorizontalLayout {
        x: 0;
        y: root.height - act-h;
        width: root.width;
        height: act-h;
        spacing: gap;
        alignment: start;
        for act[i] in view.actions: VerticalLayout {
            alignment: center;
            ActionButton {
                label: act.label;
                enabled: act.enabled;
                focused: active-pane && act.focused;
                primary: i == 0;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: view.note;
            color: Theme.muted;
            font-size: Metrics.t-meta;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

// --------------------------------------------------------------- the dialogs

component EdidDialog inherits Dialog {
    in property <OutputView> view;
    panel-w: Metrics.dialog-w * 1.3;

    Text {
        text: "EDID bilgileri";
        color: Theme.text;
        font-size: Metrics.t-section;
        font-weight: 750;
    }
    VerticalLayout {
        spacing: 0px;
        for kv in view.edid: Rectangle {
            height: Metrics.t-meta * 1.95;
            Text {
                x: 0;
                width: parent.width * 0.4;
                height: parent.height;
                text: kv.label;
                color: Theme.muted;
                font-size: Metrics.t-meta;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width * 0.42;
                width: parent.width * 0.58;
                height: parent.height;
                text: kv.value;
                color: Theme.text;
                font-size: Metrics.t-meta;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.s-hairline;
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        ActionButton { label: "Kapat"; focused: true; }
    }
}

export component OutputPane inherits Rectangle {
    in property <OutputView> view;
    in property <bool> active-pane;

    if !view.available: StateNote {
        x: 0;
        y: 0;
        width: min(root.width, Metrics.list-w);
        kind: view.message == "Ekran okunuyor…" ? "busy" : "unavailable";
        title: view.message == "Ekran okunuyor…" ? "Ekran okunuyor" : "Ekran ayarlanamıyor";
        message: view.message == "Ekran okunuyor…" ? "" : view.message;
    }

    if view.available && view.face == 0: SimpleFace {
        width: 100%;
        height: 100%;
        view: view;
        active-pane: active-pane && view.sheet == 0 && !view.picker-open;
    }

    if view.available && view.face == 1: AdvancedFace {
        width: 100%;
        height: 100%;
        view: view;
        active-pane: active-pane && view.sheet == 0;
    }

    // The dialogs cover the whole panel rather than this pane: a question
    // about what the television is showing is the only thing on it.
    // A list opened from the simple face: the resolutions, the refresh rates
    // of the one chosen, or the colour formats at it.
    if view.picker-open && view.sheet == 0: ChoiceSheet {
        x: -root.x;
        y: -root.y;
        width: Metrics.vw;
        height: Metrics.vh;
        title: view.picker-title;
        items: view.picker;
        focus-at: view.picker-focus;
        note: view.picker-note;
    }

    if view.sheet == 1: TrialSheet {
        x: -root.x;
        y: -root.y;
        width: Metrics.vw;
        height: Metrics.vh;
        title: "Bu görüntü kalsın mı?";
        new-label: "Yeni mod";
        new-value: view.trial;
        old-label: "Önceki mod";
        old-value: view.previous;
        seconds: view.seconds;
        arc: view.arc;
        ready: view.confirm-ready;
        focus-at: view.confirm-focus;
        message: "Yanıt verilmezse " + view.seconds + " saniye sonra önceki moda dönülür. Süreyi denetim düzlemi tutar; ekran görüntü alamasa ya da arayüz kapansa bile geri dönülür.";
    }

    if view.sheet == 2: EdidDialog {
        x: -root.x;
        y: -root.y;
        width: Metrics.vw;
        height: Metrics.vh;
        view: view;
    }
}
