// The scene of this id as Slint draws it; the mechanism's, for one there is
// none for.
component DrawnEmblem inherits Rectangle {
    in property <string> id;
    in property <float> d;
    in property <float> d-far;
    in property <float> d-near;
    in property <color> tint;
    in property <float> presence;
    if id == "media": MediaEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "playback": PlaybackEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "account": AccountEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "picture": PictureEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "output": OutputEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "audio": AudioEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "links": LinksEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "wifi": WifiEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "ethernet": EthernetEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "remote": RemoteEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "cec": CecEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "live": LiveEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "device": DeviceEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "cooling": CoolingEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "system": SystemEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "diagnostics": DiagnosticsEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "storage": StorageEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
    if id == "services": ServicesEmblem { width: 100%; height: 100%; d: root.d; d-far: root.d-far; d-near: root.d-near; tint: root.tint; presence: root.presence; }
}

// The deck: the scenes near the camera, the one it stands at and the one it
// left. At rest that is one.
export component EmblemDeck inherits Rectangle {
    in property <QuietDeck> deck;
    in property <color> tint;
    in property <float> presence: 1;
    // It stands in its place, at this size: what Slint draws is kept.
    in property <bool> standing;
    in property <length> box: self.width;
    // How large the scenes are, in the middle of this: the mechanism alone
    // grows with its flight, and they do not (nor do their textures).
    in property <length> side: self.width;
    // The mechanism is one of them; not where the home screen has its own.
    in property <bool> mechanism: true;
    in property <float> owed;
    in property <length> panel-w;
    in property <length> panel-h;

    for n in 3: Rectangle {
        width: 100%;
        height: 100%;
        property <string> id: QuietDecks.id(deck, n);
        property <int> at: QuietDecks.at(deck, n);
        property <bool> near: id != "" && QuietDecks.near(deck, n);
        property <float> d: at - deck.cam;
        property <float> d-far: at - deck.cam-far;
        property <float> d-near: at - deck.cam-near;
        // 0 unless the GPU draws this one (src/spatial).
        property <int> spatial: Spatial.on && id != "" && id != "settings" ? Spatial.kind("emblem/" + id, Spatial.epoch) : 0;
        if near && id == "settings" && mechanism: SettingsScene {
            width: 100%;
            height: 100%;
            tint: root.tint;
            d: d + root.owed;
            d-far: d-far + root.owed;
            d-near: d-near + root.owed;
            presence: root.presence;
            kept: standing;
            box: root.box;
        }
        if near && spatial != 0: SpatialScene {
            name: "emblem/" + id;
            kind: spatial;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.side;
            height: root.side;
            d: d;
            d-far: d-far;
            d-near: d-near;
            tint: root.tint;
            presence: root.presence;
            panel-w: root.panel-w;
            panel-h: root.panel-h;
        }
        // Kept at rest: a focus moving through the rows beside it draws it no
        // more than the heading.
        if near && id != "settings" && spatial == 0: Still {
            keep: root.standing && !QuietDecks.moving(deck);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.side;
            height: root.side;
            DrawnEmblem {
                width: 100%;
                height: 100%;
                id: id;
                d: d;
                d-far: d-far;
                d-near: d-near;
                tint: root.tint;
                presence: root.presence;
            }
        }
    }
}
