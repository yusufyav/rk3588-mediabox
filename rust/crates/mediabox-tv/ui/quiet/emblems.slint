import { Quiet } from "core.slint";
import { QuietMotion, QuietDeck, QuietDecks } from "motion.slint";
import { Still } from "materials.slint";
import { SceneBase, Plane, SettingsScene } from "scenes.slint";
import { Spatial, SpatialScene } from "spatial.slint";

// The settings' emblems: a scene for each category and each page, by its own
// id (src/screens/settings.rs, `Group::id`, `Page::id`; never by its place in
// the column or its name on the screen), and the deck they change on.
//
// The same language as the home screen's scenes (scenes.slint): three planes
// in a 650-unit box, each told its own camera offset, every motion a function
// of it, so a scene at rest asks for nothing. What moves along a line -- a
// packet, a pulse, a wave -- is there only while the camera is: it stands for
// the subject, and is never a reading of the machine.
//
// The solid ones are the GPU's (src/spatial/emblem.rs): media, links, remote,
// live, diagnostics, picture, output, audio, cooling, device, system and
// storage. Theirs here are what is drawn where the GPU cannot.

component EmblemBase inherits SceneBase {
    // The way a thing has gone along a line: none or all of it at rest.
    out property <float> go: clamp(1 - abs(root.d) * 1.15, 0, 1);
    public pure function swell(p: float) -> float { return 4 * p * (1 - p); }
}

// A stroke in the box.
component Ink inherits Path {
    width: 100%;
    height: 100%;
    viewbox-width: 650;
    viewbox-height: 650;
    fill: transparent;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// A stroke about its own middle, which it turns about.
component Wheel inherits Path {
    in property <length> vu;
    in property <float> cx;
    in property <float> cy;
    in property <float> r;
    x: (cx - r) * vu;
    y: (cy - r) * vu;
    width: 2 * r * vu;
    height: 2 * r * vu;
    viewbox-x: -100;
    viewbox-y: -100;
    viewbox-width: 200;
    viewbox-height: 200;
    fill: transparent;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// A point of light on its way.
component Pulse inherits Rectangle {
    in property <length> vu;
    in property <float> at-x;
    in property <float> at-y;
    in property <color> ink;
    width: max(3px, 15 * vu);
    height: self.width;
    x: at-x * vu - self.width / 2;
    y: at-y * vu - self.height / 2;
    border-radius: self.width / 2;
    background: ink;
}

// Medya: iki film makarası, karşılıklı döner; öndeki şerit aralarından akar.
component MediaEmblem inherits EmblemBase {
    Plane {
        width: 100%;
        height: 100%;
        d: root.d-far;
        layer: 0.5;
        Wheel {
            vu: root.vu;
            cx: 468;
            cy: 180;
            r: 128;
            transform-rotation: root.d-far * -80deg;
            stroke: root.ink.with-alpha(0.36 * root.f-far);
            stroke-width: root.fine;
            commands: "M97 0A97 97 0 1 1 -97 0A97 97 0 1 1 97 0ZM90 0A90 90 0 1 1 -90 0A90 90 0 1 1 90 0ZM14 0A14 14 0 1 1 -14 0A14 14 0 1 1 14 0ZM19 -56A19 19 0 1 1 -19 -56A19 19 0 1 1 19 -56ZM72.3 -17.3A19 19 0 1 1 34.3 -17.3A19 19 0 1 1 72.3 -17.3ZM51.9 45.3A19 19 0 1 1 13.9 45.3A19 19 0 1 1 51.9 45.3ZM-13.9 45.3A19 19 0 1 1 -51.9 45.3A19 19 0 1 1 -13.9 45.3ZM-34.3 -17.3A19 19 0 1 1 -72.3 -17.3A19 19 0 1 1 -34.3 -17.3Z";
        }
    }
    Plane {
        width: 100%;
        height: 100%;
        d: root.d;
        Wheel {
            vu: root.vu;
            cx: 285;
            cy: 350;
            r: 205;
            transform-rotation: root.d * 65deg;
            fill: root.tint.with-alpha(0.04 * root.f-main);
            stroke: root.glow.with-alpha(0.6 * root.f-main);
            stroke-width: root.line;
            commands: "M97 0A97 97 0 1 1 -97 0A97 97 0 1 1 97 0ZM90 0A90 90 0 1 1 -90 0A90 90 0 1 1 90 0ZM14 0A14 14 0 1 1 -14 0A14 14 0 1 1 14 0ZM21 -56A21 21 0 1 1 -21 -56A21 21 0 1 1 21 -56ZM74.3 -17.3A21 21 0 1 1 32.3 -17.3A21 21 0 1 1 74.3 -17.3ZM53.9 45.3A21 21 0 1 1 11.9 45.3A21 21 0 1 1 53.9 45.3ZM-11.9 45.3A21 21 0 1 1 -53.9 45.3A21 21 0 1 1 -11.9 45.3ZM-32.3 -17.3A21 21 0 1 1 -74.3 -17.3A21 21 0 1 1 -32.3 -17.3Z";
        }
    }
    Plane {
        width: 100%;
        height: 100%;
        d: root.d-near;
        layer: 1.7;
        Ink {
            transform-rotation: root.d-near * 46deg;
            stroke: root.glow.with-alpha(0.4 * root.f-near);
            stroke-width: root.fine;
            commands: "M499.2 428A228 228 0 0 1 261.2 576.8M531.2 439.6A262 262 0 0 1 257.6 610.6M502.4 446.8L515.2 452.5M486.8 476.1L498.7 483.5M467.3 503L478 512M444.3 526.9L453.6 537.3M418.1 547.3L425.9 558.9M389.3 563.9L395.5 576.5M358.5 576.4L362.9 589.7M326.3 584.4L328.8 598.2M293.3 587.9L293.8 601.8";
        }
    }
}

