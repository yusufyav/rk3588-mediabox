            commands: "M369 325A44 44 0 1 1 281 325A44 44 0 1 1 369 325ZM351 325A26 26 0 1 1 299 325A26 26 0 1 1 351 325Z";
        }
        Pulse { vu: root.vu; at-x: 325 + -175 * root.go; at-y: 325 + -120 * root.go; ink: root.glow.with-alpha(root.swell(root.go) * root.f-main); }
        Pulse { vu: root.vu; at-x: 325 + 165 * root.go; at-y: 325 + -165 * root.go; ink: root.glow.with-alpha(root.swell(root.go) * root.f-main); }
        Pulse { vu: root.vu; at-x: 325 + 235 * root.go; at-y: 325 + 70 * root.go; ink: root.glow.with-alpha(root.swell(root.go) * root.f-main); }
        Pulse { vu: root.vu; at-x: 325 + -25 * root.go; at-y: 325 + 220 * root.go; ink: root.glow.with-alpha(root.swell(root.go) * root.f-main); }
        Pulse { vu: root.vu; at-x: 325 + -215 * root.go; at-y: 325 + 105 * root.go; ink: root.glow.with-alpha(root.swell(root.go) * root.f-main); }
