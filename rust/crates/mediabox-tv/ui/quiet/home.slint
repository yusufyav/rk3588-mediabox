import { AppTile, VitalsModel } from "../components.slint";
import { PointerTarget, PointerPanArea, PanState } from "../pointer.slint";
import { Quiet } from "core.slint";
import { QuietMotion, QuietCurves, QuietCam, QuietReach } from "motion.slint";
import { QuietGround, LivingFocus, Kept, Still } from "materials.slint";
import { Scene } from "scenes.slint";
import { Overline, KeyCap, QuietBar } from "controls.slint";

// Where the settings' emblem stands (settings.slint, `SettingsEmblem`), so
// the home screen can take its scene back from there.
export global QuietPlaces {
    out property <length> stage-x: 1201px * Quiet.u;
    out property <length> stage-y: 150px * Quiet.u;
    out property <length> stage-size: 650px * Quiet.u;
    // Smaller, beside an editor's heading (`QuietCam.shrink`).
    public pure function emblem-x(shrink: float) -> length { return Quiet.px((1592px + 132px * shrink) * Quiet.u); }
    public pure function emblem-y(shrink: float) -> length { return Quiet.px((196px - 80px * shrink) * Quiet.u); }
    public pure function emblem-size(shrink: float) -> length { return Quiet.px((228px - 132px * shrink) * Quiet.u); }
}

// The chosen application's name, set as large as the reference sets it, and
// smaller only for a name that would otherwise run into the scene -- down to
// about half, and past that on two lines rather than smaller still. What it
// is and what it says are `AboutBlock`, which follows it a beat later.
//
// How large that is, measured (`NameFit`): the text it measures is there with
// no opacity rather than `visible: false`, which is a clip the renderer pays
// for (kit.slint, `NetGlyph`).
component NameFit inherits Rectangle {
    in property <string> name;
    property <float> u: Quiet.u;
    measure := Text {
        opacity: 0;
        text: root.name;
        font-size: Quiet.t-display;
        font-weight: 560;
        letter-spacing: -108px * u * 0.06;
    }
    out property <float> fit: max(0.52, min(1, root.width / max(1px, measure.preferred-width)));
    // With a pixel's grace: at a fractional scale the fitted width lands a
    // hair over the column and a name that fits was set on two lines.
    out property <bool> two-lines: measure.preferred-width * fit > root.width + 1px;
    out property <length> name-h: two-lines ? 2 * 108px * u * fit * 1.42 : 121px * u;
}

component NameBlock inherits Rectangle {
    in property <AppTile> tile;
    in property <float> d;
    property <float> u: Quiet.u;
    // The one chosen, which its word's strength follows (QuietMotion.word).
    in property <bool> here: true;
    property <bool> snap: true;
    property <float> lead;
    animate lead { duration: snap ? 0ms : QuietMotion.t-wash; easing: QuietCurves.ease; }
    init => {
        lead = here ? 1 : 0;
        snap = false;
    }
    changed here => { lead = here ? 1 : 0; }
    property <float> f: QuietMotion.word(d, lead);

    size := NameFit {
        width: root.width;
        height: 0;
        name: tile.name;
    }

    if f > 0: Rectangle {
        x: 0;
        // Toward where it is going: up when the list moves down, and back.
        // Whole device pixels, as the renderer sets type.
        y: Quiet.px(d * 64px * u * QuietMotion.travel);
        width: parent.width;
        // Two of the font's own lines (its line height is about 1.4 of its
        // size), from the top.
        height: size.name-h;
        // Kept: over 92 device pixels the renderer has no atlas of glyphs
        // and flattens every outline again for every frame (femtovg,
        // `draw_glyph_run`).
        // With room around the column: a glyph's outline may stand past it.
        property <length> room: Quiet.px(16px * u);
        Kept {
            x: -room;
            y: -room;
            width: parent.width + 2 * room;
            height: parent.height + 2 * room;
            fade: f;
            Text {
                x: room;
                y: room;
                width: parent.width - 2 * room;
                height: parent.height - 2 * room;
                text: tile.name;
                color: Quiet.ink;
                font-size: Quiet.t-display * size.fit;
                font-weight: 560;
                letter-spacing: -108px * u * size.fit * 0.06;
                vertical-alignment: size.two-lines ? top : center;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

component AboutBlock inherits Rectangle {
    in property <AppTile> tile;
    in property <float> d;
    property <float> u: Quiet.u;
    // The one chosen, which its word's strength follows (QuietMotion.word).
    in property <bool> here: true;
    property <bool> snap: true;
    property <float> lead;
    animate lead { duration: snap ? 0ms : QuietMotion.t-wash; easing: QuietCurves.ease; }
    init => {
        lead = here ? 1 : 0;
        snap = false;
    }
    changed here => { lead = here ? 1 : 0; }
    property <float> f: QuietMotion.word(d, lead);

    if f > 0: Rectangle {
        x: 0;
        y: Quiet.px(d * 34px * u * QuietMotion.travel);
        width: parent.width;
        height: Quiet.px(words.preferred-height + 4px * u);
        Kept {
            width: 100%;
            height: 100%;
            fade: f;
            words := VerticalLayout {
                y: 0;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                if tile.about != "": HorizontalLayout {
                    padding-left: 4px * u;
                    alignment: start;
                    Text {
                        width: 400px * u;
                        max-height: 4 * 21px * u * 1.35;
                        text: tile.about;
                        color: #a5b1ba;
                        font-size: 21px * u;
                        letter-spacing: -21px * u * 0.012;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
                if tile.about != "" && tile.note != "": Rectangle { height: 22px * u; }
                if tile.note != "": HorizontalLayout {
                    padding-left: 4px * u;
                    Text {
                        text: tile.note;
                        color: Quiet.warm-dim;
                        font-size: 15px * u;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// The home screen, quietly: the applications down the left, the chosen one
// named large in the middle and its scene on the right, and how the box is
// doing at the top.
//
// Up and Down (or Left and Right) walk the same list the classic launcher's
// row is (src/main.rs, `act_on_home`); Ok opens it; a pointer lights and
// takes a row through the same focus (`quiet-home`: the "home" zone's
// tiles, on a column that scrolls). Everything that moves here follows
// `focus-col` and nothing else: the list, the names and the light answer it
// at once, and the camera behind them catches up.
export component QuietHome inherits Rectangle {
    in property <[AppTile]> apps;
    in property <VitalsModel> vitals;
    in property <int> focus-col;
    // The screen the panel showed before this one (src/main.rs, `show`):
    // back from the settings, their emblem flies home into its scene.
    in property <string> came-from;

    property <float> u: Quiet.u;
    // How many there are, assigned when the number changes: the model is
    // replaced on every poll of the control plane, and nothing that moves
    // should be told it changed when it did not (QuietGround).
    property <int> count;
    property <int> listed: apps.length;
    changed listed => { count = listed; }
    property <int> focus-row: max(0, min(focus-col, count - 1));
    property <AppTile> chosen: count > 0 ? apps[focus-row] : { name: "", ready: true };
    property <color> aura: Quiet.aura(chosen.id);

    property <length> list-x: 123px * u;
    property <length> list-w: 490px * u;
    property <length> list-y: 268px * u;
    // Every row keeps the reference's height and type, however many
    // applications there are: a launcher that grew past what the column
    // holds scrolls (the focused row kept in view, a hand and a wheel
    // through the same surface every list has) rather than closing its rows
    // up into something nobody can read or hit.
    property <length> pitch: 83px * u;
    property <length> row-h: pitch - 7px * u;
    property <length> view-h: 860px * u - list-y;
    property <length> content-h: count * pitch;

    property <length> spot-x: 739px * u;
    // Up to where the scene begins.
    property <length> spot-w: 540px * u;

    // ---- the camera (the window's QuietRig): which row it goes to, and how.
    //
    // A launcher that changed under the focus -- an application added above
    // it, one removed, the list reordered -- keeps the same application
    // chosen under another row: nothing moved for the person, and the camera
    // is simply there.
    in property <QuietCam> camera;
    callback travel(int);
    callback land(int, bool);
    callback fly(float, bool);
    callback rest();
    callback replayed();
    in-out property <string> stood-before;
    property <string> id: chosen.id;
    property <string> last-id;
    function follow() {
        if focus-row != camera.row {
            if id == last-id {
                root.land(focus-row, false);
            } else {
                root.travel(focus-row);
            }
        }
        last-id = id;
        stood-before = id;
    }
    init => {
        count = listed;
        about-y = about-at;
        about-snap = false;
        last-id = id;
        // Back from the settings: their emblem flies home into its scene,
        // from wherever its own flight had got to.
        if (came-from == "settings" || came-from == "diagnostics") && id == "settings" && stood-before == "settings"
            && focus-row == camera.row {
            root.fly(0, false);
        } else {
            root.land(focus-row, true);
        }
        stood-before = id;
    }
    changed focus-row => { follow(); }
    changed id => { follow(); }
    property <int> replay: QuietMotion.replay;
    changed replay => { root.replayed(); }
    property <bool> moving: QuietMotion.on;
    changed moving => { if !moving { root.rest(); } }

    clip: true;

    QuietGround {
        width: 100%;
        height: 100%;
        aura: count > 0 ? root.aura : Quiet.aura("");
    }

    // ---- the scene: one per application near the camera, none at rest but
    // the chosen one.
    stage := Rectangle {
        property <float> fly: camera.flight;
        x: QuietPlaces.stage-x + (QuietPlaces.emblem-x(camera.shrink) - QuietPlaces.stage-x) * fly;
        y: QuietPlaces.stage-y + (QuietPlaces.emblem-y(camera.shrink) - QuietPlaces.stage-y) * fly;
        width: QuietPlaces.stage-size + (QuietPlaces.emblem-size(camera.shrink) - QuietPlaces.stage-size) * fly;
        height: self.width;

        for tile[i] in apps: Rectangle {
            width: 100%;
            height: 100%;
            if QuietReach.scene(camera, i): Scene {
                property <float> extra: i == focus-row ? camera.arrive : 0;
                width: 100%;
                height: 100%;
                id: tile.id;
                mark: tile.mark;
                d: i - camera.cam + extra;
                d-far: i - camera.cam-far + extra * 0.6;
                d-near: i - camera.cam-near + extra * 1.4;
                presence: 0.9 - 0.35 * stage.fly;
            }
        }
    }

    QuietBar {
        x: 0;
        y: 0;
        width: 100%;
        height: 104px * u;
        vitals: root.vitals;
        details: true;
    }

    // ---- the applications
    Overline {
        x: list-x;
        y: 227px * u;
        height: 15px * u;
        text: "UYGULAMALAR";
    }
    Text {
        x: list-x + list-w - self.width;
        y: 227px * u;
        height: 15px * u;
        width: self.preferred-width;
        text: Quiet.two(min(focus-col + 1, count)) + " / " + Quiet.two(count);
        color: #6f808c;
        font-size: 12px * u;
        letter-spacing: 12px * u * 0.15;
        vertical-alignment: center;
    }

    // The column: a window onto the rows, as tall as the reference's.
    Rectangle {
        x: Quiet.px(list-x);
        y: Quiet.px(list-y);
        width: list-w;
        height: view-h;
        clip: true;

        pan := PanState {
            surface: "quiet-home";
            remote: clamp(focus-row * pitch - (view-h - pitch) / 2, 0px, max(0px, content-h - view-h));
            limit: max(0px, content-h - view-h);
            remote-duration: QuietMotion.t-move;
        }

        PointerPanArea { surface: "quiet-home"; }

        Rectangle {
            x: 0;
            y: -Quiet.px(pan.value);
            width: parent.width;
            height: max(content-h, parent.height);
            animate y { duration: pan.duration; easing: QuietCurves.ease; }

            // The one chosen: the Living Focus, warmed toward the chosen
            // application's light. No edge, no bar: the lift and the brighter
            // name are the focus.
            LivingFocus {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                shown: count > 0;
                to-y: focus-row * pitch;
                to-h: row-h;
                tint: Quiet.warm.mix(root.aura, 0.65);
            }

            // Kept: drawn when the focus moves, not while the scene does.
            // Up to two windows of it: past that the rows out of the window,
            // which the renderer leaves out, are most of them, and their
            // texture would grow with the launcher to more than GL has.
            Still {
                keep: content-h <= view-h * 2;
                y: 0;
                width: 100%;
                height: Quiet.px(content-h);
                for tile[i] in apps: Rectangle {
                    property <bool> here: i == focus-col;
                    x: 0;
                    y: i * pitch;
                    width: parent.width;
                    height: row-h;
                    border-radius: self.height / 2;
                    background: target.lit && !here ? Quiet.hover : transparent;
                    animate background { duration: QuietMotion.t-wash; easing: QuietCurves.ease; }

                    Path {
                        x: 19px * u;
                        y: (parent.height - self.height) / 2;
                        width: 26px * u;
                        height: 26px * u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Quiet.mark(tile.id, tile.mark);
                        fill: transparent;
                        stroke: here ? Quiet.warm-hi : Quiet.app;
                        stroke-width: 1.45px * u;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        opacity: tile.ready ? 1.0 : 0.5;
                    }
                    Text {
                        x: 66px * u;
                        width: parent.width - self.x - 60px * u;
                        height: parent.height;
                        text: tile.name;
                        color: here ? Quiet.warm-hi : Quiet.app;
                        opacity: tile.ready ? 1.0 : 0.5;
                        font-size: 22px * u;
                        font-weight: 520;
                        letter-spacing: -22px * u * 0.025;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                        animate color { duration: QuietMotion.t-wash; easing: QuietCurves.ease; }
                    }
                    Text {
                        x: parent.width - 19px * u - self.width;
                        width: self.preferred-width;
                        height: parent.height;
                        text: Quiet.two(i + 1);
                        color: here ? Quiet.warm-dim : Quiet.faint;
                        opacity: tile.ready ? 1.0 : 0.5;
                        font-size: 11px * u;
                        letter-spacing: 11px * u * 0.08;
                        vertical-alignment: center;
                    }

                    target := PointerTarget {
                        zone: "quiet-home";
                        index: i;
                        veil: false;
                    }
                }
            }
        }

        // More above or below the window: a hairline fades in at that edge.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: Quiet.hairline;
            background: @linear-gradient(90deg, #dfc9a560 0%, #dfc9a500 100%);
            opacity: pan.value > 1px ? 1 : 0;
            animate opacity { duration: QuietMotion.t-move; }
        }
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: Quiet.hairline;
            background: @linear-gradient(90deg, #dfc9a560 0%, #dfc9a500 100%);
            opacity: pan.value < content-h - view-h - 1px ? 1 : 0;
            animate opacity { duration: QuietMotion.t-move; }
        }
    }

    if count == 0: Text {
        x: list-x + 19px * u;
        y: list-y;
        height: row-h;
        text: "Uygulama yok";
        color: Quiet.faint;
        font-size: 22px * u;
        vertical-alignment: center;
    }

    // ---- the one chosen, named
    //
    // Kinetic typography: the ordinal rolls like a counter, the name moves
    // toward where the list went while the next one comes from where it came
    // from, and what it says follows a beat later -- each one only a short
    // distance, the chosen word legible from the first frames and the one
    // it replaces out of its way (`QuietMotion.word`).
    if count > 0: HorizontalLayout {
        x: spot-x;
        y: 294px * u;
        height: 15px * u;
        spacing: 14px * u;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px * u;
                height: Quiet.hairline;
                background: Quiet.warm;
            }
        }
        HorizontalLayout {
            // The counter: the numbers either side of the camera, in a
            // window one line tall.
            Rectangle {
                width: digits.preferred-width;
                clip: true;
                digits := Overline {
                    opacity: 0;
                    text: Quiet.two(count);
                }
                for tile[i] in apps: Rectangle {
                    property <float> d: i - camera.cam-type;
                    if QuietReach.words(camera, i, false): Overline {
                        y: d * parent.height * 1.1;
                        width: parent.width;
                        height: parent.height;
                        text: Quiet.two(i + 1);
                        color: Quiet.warm;
                        opacity: QuietMotion.fade(d, 0.8);
                    }
                }
            }
            Overline {
                text: " / " + Quiet.two(count) + "  —  SEÇİLİ UYGULAMA";
                color: Quiet.warm;
            }
        }
    }

    names := Rectangle {
        x: Quiet.px(spot-x - 4px * u);
        y: Quiet.px(330px * u);
        width: spot-w;
        height: 860px * u - self.y;
        for tile[i] in apps: Rectangle {
            property <float> d: i - camera.cam-type;
            if QuietReach.words(camera, i, false): NameBlock {
                here: i == focus-row;
                width: spot-w;
                height: parent.height;
                tile: tile;
                d: d;
            }
        }
    }
    // What the chosen one is, under however many lines its name took.
    chosen-measure := NameFit {
        width: spot-w;
        height: 0;
        name: chosen.name;
    }
    property <length> about-at: names.y + chosen-measure.name-h + 16px * u;
    property <length> about-y;
    animate about-y { duration: about-snap ? 0ms : QuietMotion.t-type-late; easing: QuietCurves.glide; }
    property <bool> about-snap: true;
    changed about-at => { about-y = about-at; }
    Rectangle {
        x: Quiet.px(spot-x - 4px * u);
        y: Quiet.px(about-y);
        width: spot-w;
        height: 860px * u - self.y;
        for tile[i] in apps: Rectangle {
            property <float> d: i - camera.cam-late;
            if QuietReach.words(camera, i, true): AboutBlock {
                here: i == focus-row;
                width: spot-w;
                height: parent.height;
                tile: tile;
                d: d;
            }
        }
    }

    // ---- what the keys do here
    Still {
        x: Quiet.px(spot-x - 8px * u);
        y: Quiet.px(882px * u);
        width: Quiet.px(480px * u);
        height: Quiet.px(36px * u);
        HorizontalLayout {
            x: spot-x - parent.x;
            y: 886px * u - parent.y;
            height: 27px * u;
            spacing: 13px * u;
            alignment: start;
            HorizontalLayout {
                spacing: 5px * u;
                KeyCap { mark: "M12 19V5 M6 11l6-6 6 6"; }
                KeyCap { mark: "M12 5v14 M6 13l6 6 6-6"; }
            }
            Text {
                text: "Uygulama seç";
                color: #aeb9bf;
                font-size: 13px * u;
                font-weight: 550;
                vertical-alignment: center;
            }
            Rectangle { width: 6px * u; }
            KeyCap { mark: "M19 5v7a3 3 0 0 1-3 3H6 M10 11l-4 4 4 4"; }
            Text {
                text: chosen.id == "settings" ? "Ayarlar'a gir" : "Uygulamayı aç";
                color: #82929d;
                font-size: 13px * u;
                vertical-alignment: center;
            }
        }
    }
}
