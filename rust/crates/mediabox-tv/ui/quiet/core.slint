import { Metrics } from "../theme.slint";

// Quiet OS's core: the design unit, the palette, the type helpers and each
// application's colour of light. Nothing here moves (motion.slint) or draws
// (materials.slint, scenes.slint); everything else in ui/quiet/ reads it.
//
// Laid out on a 1920 x 1080 design and scaled by one factor, so 1440p and 4K
// are the same picture larger, and nothing is placed by measuring.

export global Quiet {
    // One design pixel, on this panel.
    out property <float> u: min(Metrics.vw / 1920px, Metrics.vh / 1080px);
    // A hairline that stays one device pixel wide or more at every scale.
    out property <length> hairline: 1px * max(1, u);

    out property <color> ink: #f1f0ee;
    out property <color> muted: #a5afba;
    out property <color> dim: #6e7c89;
    out property <color> faint: #65717c;
    out property <color> label: #8b99a5;
    out property <color> hair: #d0dce224;
    out property <color> warm: #dfc9a5;
    out property <color> warm-hi: #f2e5d0;
    out property <color> warm-dim: #bbaa92;
    out property <color> app: #aeb7bf;
    out property <color> hover: #d6e0e80c;
    // The focus everywhere in Quiet OS: the surface lifting, warm and soft.
    out property <color> lift: #dfc9a51d;
    out property <color> current: #dfc9a518;
    out property <color> good: #84a89a;

    // Where a page's content stands under `QuietFrame`: the settings' own
    // content column (QuietSettings), so every screen of the family lines up.
    out property <length> content-x: 708px * u;
    out property <length> content-w: 868px * u;
    out property <length> content-top: 430px * u;

    // ---- the type scale, in design pixels at 1080p
    out property <length> t-display: 108px * u;
    out property <length> t-title: 68px * u;
    out property <length> t-heading: 32px * u;
    out property <length> t-row: 20px * u;
    out property <length> t-body: 17px * u;
    out property <length> t-small: 14px * u;
    out property <length> t-over: 12px * u;

    // ---- Adaptive Atmosphere
    //
    // Each application's colour of light: what the ground, the focus and the
    // scene behind it are tinted toward while it is the one chosen. Muted
    // and low in chroma on purpose -- the ground stays Quiet OS's dark slate
    // and the light is only ever a fraction of it (`QuietMotion.glow`).
    public pure function aura(id: string) -> color {
        return id == "media" ? #d8c39f       // champagne
             : id == "livetv" ? #4f84b4      // ocean blue
             : id == "browser" ? #4fb0a6     // turquoise
             : id == "settings" ? #a9b5bf    // titanium
             : id == "kodi" ? #9a82c9        // amethyst
             : #8a9fad;                      // everything else: the slate's own
    }

    // Ayarlar' mark, drawn for this face: a gear of eight even teeth round a
    // hub, on the 24-unit grid every mark uses. The shared mark (state.rs)
    // is uneven at this size; the classic face keeps its own.
    out property <string> gear: "M10.38 4.98L10.63 2.80L13.37 2.80L13.62 4.98A7.2 7.2 0 0 1 15.82 5.89L17.53 4.52L19.48 6.47L18.11 8.18A7.2 7.2 0 0 1 19.02 10.38L21.20 10.63L21.20 13.37L19.02 13.62A7.2 7.2 0 0 1 18.11 15.82L19.48 17.53L17.53 19.48L15.82 18.11A7.2 7.2 0 0 1 13.62 19.02L13.37 21.20L10.63 21.20L10.38 19.02A7.2 7.2 0 0 1 8.18 18.11L6.47 19.48L4.52 17.53L5.89 15.82A7.2 7.2 0 0 1 4.98 13.62L2.80 13.37L2.80 10.63L4.98 10.38A7.2 7.2 0 0 1 5.89 8.18L4.52 6.47L6.47 4.52L8.18 5.89A7.2 7.2 0 0 1 10.38 4.98ZM15.00 12.00A3.0 3.0 0 1 1 9.00 12.00A3.0 3.0 0 1 1 15.00 12.00Z";

    public pure function mark(id: string, shared: string) -> string {
        return id == "settings" ? gear : shared;
    }

    public pure function two(n: int) -> string {
        return n < 10 ? "0" + n : "" + n;
    }

    // A verdict, said quietly: the word is always there, the colour only
    // tints it.
    public pure function tone(name: string) -> color {
        return name == "good" ? #9bbfae
             : name == "warn" ? #dcc08a
             : name == "bad"  ? #e0a092
             : #adb8bf;
    }
}
