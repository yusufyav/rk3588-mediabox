import { Theme, Metrics } from "theme.slint";
import { GridPoster, PosterItem, TitlePreview } from "components.slint";

// Everything the box can show, as a grid.
//
// The home screen is for browsing and this screen is for finding: four
// sections across the top and a poster grid under them, every title named.
export component Library inherits Rectangle {
    in property <[string]> tabs;
    in property <[string]> notes;
    in property <int> tab;
    in property <bool> on-tabs;

    in property <[PosterItem]> items;
    in property <int> index;
    in property <int> columns;

    // What the remote is on, beside the grid. The reference puts the record of
    // the focused title down the right of the same screen, and it is the thing
    // that makes a wall of posters navigable: a year, a rating and two lines of
    // what it is, without opening anything.
    in property <image> art;
    in property <string> title;
    in property <string> facts;
    in property <string> summary;
    in property <[string]> genres;

    property <length> tabs-h: Metrics.root-font * 3.4;
    property <length> grid-top: Metrics.topbar + tabs-h + Metrics.block-gap;
    property <length> cell-w: Metrics.card-w + Metrics.grid-gap;
    property <length> cell-h: Metrics.card-h + Metrics.text-card * 3.4 + Metrics.grid-gap;
    property <length> viewport-h: root.height - grid-top - Metrics.gutter * 0.5;
    property <length> panel-w: max(240px, min(620px, root.width * 0.3));
    property <length> grid-w: root.width - Metrics.gutter * 2 - panel-w - Metrics.block-gap;
    property <length> scroll: on-tabs
        ? 0px
        : clamp(Math.floor(index / columns) * cell-h - Metrics.top-inset * 0.4,
                0px,
                max(0px, Math.ceil(items.length / columns) * cell-h - viewport-h));

    background: Theme.bg;
    clip: true;

    // The sections.
    HorizontalLayout {
        x: Metrics.gutter;
        y: Metrics.topbar;
        width: root.width - Metrics.gutter * 2;
        height: tabs-h;
        spacing: Metrics.root-font * 0.5;
        alignment: start;

        for label[i] in tabs: Rectangle {
            property <bool> chosen: i == tab;
            property <bool> focused: on-tabs && chosen;
            width: caption.preferred-width + Metrics.root-font * 2.0;
            border-radius: Theme.radius * 0.8;
            background: focused ? Theme.focus-fill : (chosen ? #ffffff16 : transparent);
            border-width: focused ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : (chosen ? Theme.line : transparent);

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            caption := Text {
                text: label;
                color: focused ? #0a0c10 : (chosen ? Theme.text : Theme.muted);
                font-size: Metrics.root-font * 1.02;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: notes[tab];
            color: Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 640;
            vertical-alignment: center;
        }
    }

    // The grid.
    // Widened by the ring's room on every side, so a focused poster on the
    // edge of the grid keeps its whole ring.
    Rectangle {
        x: Metrics.gutter - Metrics.focus-room;
        y: grid-top - Metrics.focus-room;
        width: grid-w + Metrics.focus-room * 2;
        height: viewport-h + Metrics.focus-room;
        clip: true;
        background: transparent;

        if items.length == 0: Text {
            x: 0;
            y: Metrics.root-font * 2;
            text: "Bu bölümde henüz bir şey yok";
            color: Theme.dim;
            font-size: Metrics.text-meta;
            font-weight: 640;
        }

        Rectangle {
            x: Metrics.focus-room;
            y: Metrics.focus-room - scroll;
            width: 100%;
            height: max(1px, Math.ceil(items.length / columns) * cell-h);
            background: transparent;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in items: GridPoster {
                x: Math.mod(i, columns) * cell-w;
                y: Math.floor(i / columns) * cell-h;
                item: item;
                focused: !on-tabs && i == index;
            }
        }
    }

    // The record of whatever the remote is on.
    if title != "": TitlePreview {
        x: root.width - Metrics.gutter - panel-w;
        y: grid-top;
        width: panel-w;
        art: root.art;
        title: root.title;
        facts: root.facts;
        summary: root.summary;
        genres: root.genres;
    }
}
