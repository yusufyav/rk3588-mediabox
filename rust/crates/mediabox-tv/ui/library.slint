import { Theme, Metrics } from "theme.slint";
import { GridPoster, PosterItem } from "components.slint";
import { Chrome } from "chrome.slint";

// The account's library, laid out as the reference's library page and
// measured off its own stylesheet at its 1920-pixel layout (a rem is 15 px):
//
// - the board's column of places and search box;
// - 1.5rem in and down from them, the type dropdown, 15rem by 2.75rem, then
//   the orders as pill chips 1rem apart, the chosen one in the reference's
//   blue, the rest faded;
// - the grid 1.5rem under them, nine across, a poster 8.42% of the width with
//   its name under it, one every 10.37% across and 30.9% down;
// - Ok on a poster is its menu, where the reference opens it from the poster.
export component Library inherits Rectangle {
    // The dropdown's sections, the one showing, and its list when it is down.
    in property <[string]> tabs;
    in property <int> tab;
    in property <int> type-open: -1;
    // The orders, the chosen one, and whether the section showing has them.
    in property <[string]> sorts;
    in property <int> sort;
    in property <bool> sortable;
    // 0 the filters, 1 the grid, 2 the menu, 3 the places, 4 the search box.
    in property <int> zone;
    // On the filters: 0 the dropdown, then the chips.
    in property <int> filter;
    in property <[string]> actions;
    in property <int> action;
    in property <int> place;
    in property <[string]> places;

    in property <[PosterItem]> items;
    in property <int> index;
    in property <int> columns;

    // Measured off a 4K capture of the reference's desktop library: its rem
    // there is 2.75rem = 3.33% of the height, so W/146.6; the dropdown 5.13%
    // in and 8.52% down, 8.8% by 3.33%; the chips 2.4rem after it; the grid
    // the same as its Discover's.
    property <length> rem: root.width / 146.6;
    property <length> filters-x: root.width * 0.0513;
    property <length> filters-y: root.height * 0.0852;
    property <length> filters-h: root.height * 0.0333;
    property <length> grid-x: root.width * 0.0586;
    property <length> grid-top: root.height * 0.153;
    property <length> art-w: root.width * 0.087;
    property <length> cell-w: root.width * 0.1047;
    property <length> cell-h: root.height * 0.307;
    property <length> viewport-h: root.height - grid-top;
    property <bool> on-grid: zone == 1 || zone == 2;
    // Kept on the row the remote was last on whichever zone it is in, as
    // the reference's page does not scroll when the focus leaves the grid;
    // the posters are loaded around that same row.
    property <length> scroll: clamp(Math.floor(index / columns) * cell-h - cell-h * 0.1,
                0px,
                max(0px, Math.ceil(items.length / columns) * cell-h - viewport-h));

    background: Theme.catalog-bg;
    clip: true;

    // ---------------------------------------------------------------- the grid
    grid := Rectangle {
        x: grid-x - Metrics.focus-room;
        y: grid-top - Metrics.focus-room;
        width: root.width - self.x;
        height: viewport-h + Metrics.focus-room;
        clip: true;

        if items.length == 0: Text {
            x: Metrics.focus-room;
            y: rem * 3;
            width: root.width - grid-x * 2;
            text: "Boş Kitaplık";
            color: Theme.text;
            font-size: rem * 2;
            horizontal-alignment: center;
        }

        Rectangle {
            x: Metrics.focus-room;
            y: Metrics.focus-room - scroll;
            width: columns * cell-w;
            height: max(1px, Math.ceil(items.length / columns) * cell-h);

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in items: GridPoster {
                x: Math.mod(i, columns) * cell-w;
                y: Math.floor(i / columns) * cell-h;
                art-w: root.art-w;
                name-size: root.width * 0.0078;
                item: item;
                focused: on-grid && i == index;
            }
        }
    }

    // ---------------------------------------------------------------- the menu
    //
    // Over the focused poster's lower half, as the reference's menu opens
    // from the poster's corner; kept on the screen at the right edge.
    if zone == 2 && actions.length > 0: Rectangle {
        property <length> line-h: rem * 3.2;
        property <length> poster-x: grid-x + Math.mod(index, columns) * cell-w;
        property <length> poster-y: grid-top + Math.floor(index / columns) * cell-h - scroll;
        width: rem * 16;
        height: actions.length * line-h;
        x: min(poster-x + art-w * 0.45, root.width - self.width - rem);
        y: min(poster-y + art-w * 1.461 * 0.55, root.height - self.height - rem);
        border-radius: rem * 0.75;
        background: #1e1c2f;
        border-width: 1px;
        border-color: #ffffff1f;
        drop-shadow-blur: rem;
        drop-shadow-color: #00000080;
        clip: true;

        for label[k] in actions: Rectangle {
            y: k * parent.line-h;
            height: parent.line-h;
            background: k == action ? Theme.focus-fill : transparent;
            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            Text {
                x: rem * 1.5;
                width: parent.width - rem * 3;
                height: 100%;
                text: label;
                color: k == action ? #0a0c10 : Theme.text;
                font-size: rem;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }
    }

    Chrome {
        width: 100%;
        height: 100%;
        on-search: zone == 4;
        on-places: zone == 3;
        place: place;
        current: 2;
        places: places;
    }

    // ------------------------------------------------------------ the filters
    //
    // Last in the file, so the dropdown's list is drawn over the grid.
    HorizontalLayout {
        x: filters-x;
        y: filters-y;
        height: filters-h;
        spacing: rem * 2.4;
        alignment: start;

        // The reference's dropdown: #1d1c2e, its caret turned up while its
        // list is down. The remote on it is a light ring, the reference's
        // focus outline, rather than a white fill.
        types := Rectangle {
            property <bool> focused: zone == 0 && filter == 0;
            property <bool> open: type-open >= 0;
            width: root.width * 0.088;
            border-radius: open ? 0px : self.height * 0.28;
            border-top-left-radius: self.height * 0.28;
            border-top-right-radius: self.height * 0.28;
            background: #1d1c2e;
            border-width: (focused && !open) ? max(2px, rem * 0.1) : 0px;
            border-color: #e8e8ec;

            Text {
                x: rem;
                width: parent.width - rem * 3;
                height: 100%;
                text: tabs[tab];
                color: Theme.text;
                font-size: rem;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
            Path {
                x: parent.width - rem * 1.6;
                y: (parent.height - self.height) / 2;
                width: rem * 0.6;
                height: rem * 0.36;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: types.open ? "M0 6L10 6L5 0z" : "M0 0L10 0L5 6z";
                fill: #ffffffb0;
            }

            // The list, right under the box and as wide, #0f0d20; the section
            // showing has the reference's green dot at its right.
            if open: Rectangle {
                property <length> line-h: root.height * 0.0363;
                x: 0;
                y: parent.height;
                width: parent.width;
                height: tabs.length * line-h + rem * 0.3;
                border-bottom-left-radius: types.height * 0.28;
                border-bottom-right-radius: types.height * 0.28;
                background: #0f0d20;
                clip: true;

                for option[k] in tabs: Rectangle {
                    y: k * parent.line-h;
                    height: parent.line-h;
                    background: k == type-open ? #ffffff14 : transparent;

                    Text {
                        x: rem * 0.9;
                        width: parent.width - rem * 3;
                        height: 100%;
                        text: option;
                        color: Theme.text;
                        font-size: rem;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    if k == tab: Rectangle {
                        x: parent.width - rem * 1.3;
                        y: (parent.height - self.height) / 2;
                        width: rem * 0.4;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: #22b365;
                    }
                }
            }
        }

        // The orders, as the reference's chips.
        if sortable: HorizontalLayout {
            spacing: rem;

            for label[k] in sorts: Rectangle {
                property <bool> focused: zone == 0 && filter == k + 1;
                property <bool> chosen: k == sort;
                width: words.preferred-width + rem * 3.5;
                border-radius: self.height / 2;
                background: chosen ? #1245a6 : (focused ? #ffffff0d : transparent);
                opacity: focused || chosen ? 1.0 : 0.6;
                border-width: focused ? max(2px, rem * 0.1) : 0px;
                border-color: #e8e8ec;

                words := Text {
                    width: 100%;
                    height: 100%;
                    text: label;
                    color: Theme.text;
                    font-size: rem;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                }
            }
        }
    }
}
