import { Theme, Metrics } from "theme.slint";
import { GridPoster, PosterItem, TitlePreview } from "components.slint";

// The account's library, as a grid.
//
// The home screen is for browsing and this screen is for finding: the sections
// across the top with the order at their end, a poster grid under them, every
// title named, and beside it the focused title's record and what can be done
// with it.
export component Library inherits Rectangle {
    in property <[string]> tabs;
    in property <[string]> notes;
    in property <int> tab;
    in property <bool> on-tabs;
    // The remote is on the order at the end of the tabs.
    in property <bool> on-sort;
    in property <bool> sortable;
    in property <string> sort;
    in property <[string]> sorts;
    // The order's list when it is down: the highlighted one, or -1.
    in property <int> sort-open: -1;
    // What can be done with the focused title, and whether the remote is there.
    in property <[string]> actions;
    in property <bool> on-actions;
    in property <int> action;

    in property <[PosterItem]> items;
    in property <int> index;
    in property <int> columns;

    // What the remote is on, beside the grid. The reference puts the record of
    // the focused title down the right of the same screen, and it is the thing
    // that makes a wall of posters navigable: a year, a rating and two lines of
    // what it is, without opening anything.
    in property <image> art;
    in property <string> title;
    in property <string> facts;
    in property <string> summary;
    in property <[string]> genres;

    property <length> tabs-h: Metrics.root-font * 3.4;
    property <length> grid-top: Metrics.topbar + tabs-h + Metrics.block-gap;
    property <length> cell-w: Metrics.card-w + Metrics.grid-gap;
    property <length> cell-h: Metrics.card-h + Metrics.text-card * 3.4 + Metrics.grid-gap;
    property <length> viewport-h: root.height - grid-top - Metrics.gutter * 0.5;
    property <length> panel-w: max(240px, min(620px, root.width * 0.3));
    property <length> grid-w: root.width - Metrics.gutter * 2 - panel-w - Metrics.block-gap;
    property <length> scroll: on-tabs
        ? 0px
        : clamp(Math.floor(index / columns) * cell-h - Metrics.top-inset * 0.4,
                0px,
                max(0px, Math.ceil(items.length / columns) * cell-h - viewport-h));

    background: Theme.bg;
    clip: true;

    // The grid.
    // Widened by the ring's room on every side, so a focused poster on the
    // edge of the grid keeps its whole ring.
    Rectangle {
        x: Metrics.gutter - Metrics.focus-room;
        y: grid-top - Metrics.focus-room;
        width: grid-w + Metrics.focus-room * 2;
        height: viewport-h + Metrics.focus-room;
        clip: true;
        background: transparent;

        if items.length == 0: Text {
            x: 0;
            y: Metrics.root-font * 2;
            text: "Bu bölümde henüz bir şey yok";
            color: Theme.dim;
            font-size: Metrics.text-meta;
            font-weight: 640;
        }

        Rectangle {
            x: Metrics.focus-room;
            y: Metrics.focus-room - scroll;
            width: 100%;
            height: max(1px, Math.ceil(items.length / columns) * cell-h);
            background: transparent;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for item[i] in items: GridPoster {
                x: Math.mod(i, columns) * cell-w;
                y: Math.floor(i / columns) * cell-h;
                item: item;
                // One focus on the panel: not while the remote is on the actions.
                focused: !on-tabs && !on-actions && i == index;
            }
        }
    }

    // The record of whatever the remote is on, and what can be done with it.
    if title != "": VerticalLayout {
        x: root.width - Metrics.gutter - panel-w;
        y: grid-top;
        width: panel-w;
        spacing: Metrics.root-font * 0.8;
        alignment: start;

        TitlePreview {
            art: root.art;
            title: root.title;
            facts: root.facts;
            summary: root.summary;
            genres: root.genres;
        }

        VerticalLayout {
            spacing: Metrics.root-font * 0.3;
            for label[i] in actions: Rectangle {
                property <bool> focused: on-actions && i == action;
                height: Metrics.root-font * 2.3;
                border-radius: Theme.radius * 0.6;
                background: focused ? Theme.focus-fill : #ffffff0d;
                border-width: focused ? 2px : 0px;
                border-color: Theme.focus-ring;
                animate background { duration: Theme.focus-in; easing: Theme.ease; }

                Text {
                    x: Metrics.root-font * 0.9;
                    width: parent.width - Metrics.root-font * 1.8;
                    height: 100%;
                    text: label;
                    color: focused ? #0a0c10 : Theme.text;
                    font-size: Metrics.text-meta * 0.9;
                    font-weight: 650;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // The sections, last in the file so the order's list is drawn over the grid.
    HorizontalLayout {
        x: Metrics.gutter;
        y: Metrics.topbar;
        width: root.width - Metrics.gutter * 2;
        height: tabs-h;
        spacing: Metrics.root-font * 0.5;
        alignment: start;

        for label[i] in tabs: Rectangle {
            property <bool> chosen: i == tab;
            property <bool> focused: on-tabs && !on-sort && chosen;
            width: caption.preferred-width + Metrics.root-font * 2.0;
            border-radius: Theme.radius * 0.8;
            background: focused ? Theme.focus-fill : (chosen ? #ffffff16 : transparent);
            border-width: focused ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : (chosen ? Theme.line : transparent);

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            caption := Text {
                text: label;
                color: focused ? #0a0c10 : (chosen ? Theme.text : Theme.muted);
                font-size: Metrics.root-font * 1.02;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: notes[tab];
            color: Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 640;
            vertical-alignment: center;
        }

        // The order, the reference's dropdown. Only the account's library has
        // one; the other sections are in the order they come in.
        sort-chip := Rectangle {
            property <bool> focused: on-tabs && on-sort;
            width: sort-words.preferred-width + Metrics.root-font * 2.0;
            opacity: sortable ? 1.0 : 0.35;
            border-radius: Theme.radius * 0.8;
            background: focused ? Theme.focus-fill : #ffffff10;
            border-width: focused ? 2px : 1px;
            border-color: focused ? Theme.focus-ring : #ffffff1a;
            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            sort-words := Text {
                width: 100%;
                height: 100%;
                text: "Sıra: " + sort + "  ▾";
                color: sort-chip.focused ? #0a0c10 : Theme.text;
                font-size: Metrics.root-font * 0.92;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            if sort-open >= 0: Rectangle {
                property <length> line-h: Metrics.root-font * 2.3;
                x: parent.width - self.width;
                y: parent.height + Metrics.root-font * 0.3;
                width: max(parent.width, Metrics.root-font * 14);
                height: sorts.length * line-h + Metrics.root-font * 0.8;
                border-radius: Theme.radius * 0.7;
                background: #141a29;
                border-width: 1px;
                border-color: #ffffff1f;

                for option[k] in sorts: Rectangle {
                    x: Metrics.root-font * 0.4;
                    y: Metrics.root-font * 0.4 + k * line-h;
                    width: parent.width - Metrics.root-font * 0.8;
                    height: line-h;
                    border-radius: Theme.radius * 0.5;
                    background: k == sort-open ? #ffffff26 : transparent;

                    Text {
                        x: Metrics.root-font * 0.7;
                        width: parent.width - Metrics.root-font * 1.4;
                        height: 100%;
                        text: (option == sort ? "✓  " : "") + option;
                        color: Theme.text;
                        font-size: Metrics.text-meta * 0.92;
                        font-weight: option == sort ? 750 : 560;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
