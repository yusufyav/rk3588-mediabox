import { Theme, Metrics } from "theme.slint";
import { Quiet } from "quiet/core.slint";
import { QuietFrame } from "quiet/settings.slint";
import { TechRow, DiagGroup, VitalsModel, SocView } from "components.slint";
import { SocPanel } from "quiet/instruments.slint";
import { SettingNav, SideNav, PageHeader, ReadingRow, Backdrop, StatusCorner } from "kit.slint";

// What the machine is doing, in one place and out of the way.
//
// The settings screens' own shape, because it is opened from them and is the
// same kind of place: the groups down the left, the chosen group's readings on
// the right. A list and its readings always fit, whatever the panel is and
// however many readings a group turns out to have — a grid of cards sized by
// guesswork clipped its own contents in the first run of this screen.
//
// Nothing here is operated. The remote moves between groups and that is all,
// so the focus is always on the column.
export component Diagnostics inherits Rectangle {
    in property <[DiagGroup]> groups;
    in property <[SettingNav]> nav;
    in property <int> group;
    in property <SocView> soc;
    in property <VitalsModel> vitals;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Theme.quiet ? Quiet.content-top : Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> row-h: Metrics.reading-h * 0.84;
    // Quiet OS draws the machine's group beside the SoC it is about: the
    // panel takes the height of the page and the rows the width left.
    property <bool> machine: Theme.quiet && group == 0 && soc.known;
    property <length> panel-w: 600px * Metrics.qu;

    background: Theme.s-ground;
    clip: true;

    // Quiet OS: the settings' own frame, the groups as its categories.
    if Theme.quiet: QuietFrame {
        width: 100%;
        height: 100%;
        vitals: root.vitals;
        crumb: "Ayarlar  /  Tanılama";
        column: "TANILAMA";
        items: root.nav;
        current: root.group;
        active: true;
        pointer-zone: "diagnostics-groups";
        emblem: !root.machine;
        overline: "AYARLAR  /  TANILAMA";
        title: groups.length > 0 ? groups[group].title : "Tanılama";
        blurb: "Salt okunur · teknik ayrıntılar";
    }
    if !Theme.quiet: Backdrop {
        width: 100%;
        height: 100%;
    }

    if !Theme.quiet: SideNav {
        x: 0;
        y: 0;
        width: Metrics.safe-x + Metrics.nav-w + Metrics.safe-x * 0.5;
        height: root.height;
        heading: "Tanılama";
        heading-icon: "bars";
        items: nav;
        current: group;
        active: true;
        pointer-zone: "diagnostics-groups";
        back-zone: "back";
    }

    if !Theme.quiet: StatusCorner {
        x: root.width - Metrics.safe-x - self.width;
        y: Metrics.safe-y;
        width: self.preferred-width;
        height: Metrics.t-nav-head * 2.6;
        network: vitals.network;
        time: vitals.time;
        eth-up: vitals.eth-up;
        wifi-up: vitals.wifi-up;
        wifi-bars: vitals.wifi-bars;
    }

    if !Theme.quiet: PageHeader {
        x: Metrics.pane-x;
        y: Metrics.safe-y + Metrics.t-nav-head * 0.5;
        width: Metrics.pane-w * 0.68;
        title: groups.length > 0 ? groups[group].title : "Tanılama";
        blurb: "Salt okunur · teknik ayrıntılar";
    }

    if machine: SocPanel {
        x: root.width - 100px * Metrics.qu - panel-w;
        y: 232px * Metrics.qu;
        width: panel-w;
        height: root.height - self.y - 30px * Metrics.qu;
        soc: root.soc;
    }
    Rectangle {
        x: Theme.quiet ? Quiet.content-x : Metrics.pane-x;
        y: top;
        width: machine ? root.width - 100px * Metrics.qu - panel-w - 60px * Metrics.qu - self.x
            : Theme.quiet ? Quiet.content-w : Metrics.list-w;
        height: root.height - top - Metrics.safe-y;
        clip: true;

        VerticalLayout {
            spacing: 0px;
            alignment: start;
            for reading in groups[group].rows: ReadingRow {
                height: row-h;
                label: reading.label;
                value: reading.value;
                tone: reading.tone;
            }
        }
    }
}
