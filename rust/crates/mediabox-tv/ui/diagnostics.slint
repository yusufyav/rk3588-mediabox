import { Theme, Metrics } from "theme.slint";
import { TechRow, DiagGroup, VitalsModel } from "components.slint";
import { SettingNav, SideNav, PageHeader, ReadingRow, Backdrop, StatusCorner } from "kit.slint";

// What the machine is doing, in one place and out of the way.
//
// The settings screens' own shape, because it is opened from them and is the
// same kind of place: the groups down the left, the chosen group's readings on
// the right. A list and its readings always fit, whatever the panel is and
// however many readings a group turns out to have — a grid of cards sized by
// guesswork clipped its own contents in the first run of this screen.
//
// Nothing here is operated. The remote moves between groups and that is all,
// so the focus is always on the column.
export component Diagnostics inherits Rectangle {
    in property <[DiagGroup]> groups;
    in property <[SettingNav]> nav;
    in property <int> group;
    in property <VitalsModel> vitals;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> row-h: Metrics.reading-h * 0.84;

    background: Theme.s-ground;
    clip: true;

    Backdrop {
        width: 100%;
        height: 100%;
    }

    SideNav {
        x: 0;
        y: 0;
        width: Metrics.safe-x + Metrics.nav-w + Metrics.safe-x * 0.5;
        height: root.height;
        heading: "Tanılama";
        heading-icon: "bars";
        items: nav;
        current: group;
        active: true;
    }

    StatusCorner {
        x: root.width - Metrics.safe-x - self.width;
        y: Metrics.safe-y;
        width: self.preferred-width;
        height: Metrics.t-nav-head * 2.6;
        network: vitals.network;
        time: vitals.time;
    }

    PageHeader {
        x: Metrics.pane-x;
        y: Metrics.safe-y + Metrics.t-nav-head * 0.5;
        width: Metrics.pane-w * 0.68;
        title: groups.length > 0 ? groups[group].title : "Tanılama";
        blurb: "Salt okunur · teknik ayrıntılar";
    }

    Rectangle {
        x: Metrics.pane-x;
        y: top;
        width: Metrics.list-w;
        height: root.height - top - Metrics.safe-y;
        clip: true;

        VerticalLayout {
            spacing: 0px;
            alignment: start;
            for reading in groups[group].rows: ReadingRow {
                height: row-h;
                label: reading.label;
                value: reading.value;
                tone: reading.tone;
            }
        }
    }
}
