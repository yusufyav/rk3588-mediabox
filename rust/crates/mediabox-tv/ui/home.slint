import { Theme, Metrics } from "theme.slint";
import { AppIcon, AppTile, Vitals, VitalsModel } from "components.slint";

// The home screen of the appliance, which is not a media screen.
//
// MediaBox is an environment for this board rather than a player with a menu,
// so the first screen is what the box can be used for and how the box itself is
// doing: a grid of applications, and a column of the machine's own vital signs.
// The film and series catalogue is one of those applications and lives behind
// its own tile.
//
// This was got wrong once, in this very milestone: the catalogue was printed
// straight onto this screen and the operating system's home became a video
// shop's front page. The web interface's own source carries that warning in a
// comment above the same layout, and the two surfaces are meant to be the same
// product seen from two rooms.
//
// The launcher and nothing under it. "Devam Et" is inside the catalogue, with
// the rest of what the account carries, so this screen asks the network for
// nothing and is there the moment the interface is.
export component Home inherits Rectangle {
    in property <[AppTile]> apps;
    in property <VitalsModel> vitals;
    in property <int> focus-col;

    property <length> pad-top: max(14px, min(60px, Metrics.vh * 0.026));
    property <length> home-gap: max(14px, min(56px, Metrics.vw * 0.018));
    property <length> main-gap: max(10px, min(40px, Metrics.vh * 0.016));
    property <length> vitals-w: max(190px, min(560px, Metrics.vw * 0.175));
    property <length> main-x: Metrics.gutter + vitals-w + home-gap;
    property <length> main-w: max(Metrics.card-w, root.width - main-x - Metrics.gutter);

    property <length> tile-h: Metrics.tile-w + Metrics.root-font * 0.4
        + Metrics.root-font * 0.84 * 2.6 + Metrics.root-font * 0.72 * 1.4;

    background: Theme.bg;
    clip: true;

    // Drawn rather than fetched. A photograph would be a file to ship, decode
    // and keep, and the one measurement that matters here is that a
    // full-screen layer is the expensive thing on this board — so this is four
    // gradients the renderer paints and never thinks about again. The same
    // three tints, in the same places, as the web interface's own wallpaper.
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(175deg, #0d1119 0%, #080a10 52%, #05070b 100%);
    }
    Rectangle {
        x: root.width * 0.18;
        y: -root.height * 0.32;
        width: root.width * 1.2;
        height: root.height * 0.8;
        background: @radial-gradient(circle, #5e4aa86b 0%, #5e4aa800 62%);
    }
    Rectangle {
        x: -root.width * 0.33;
        y: -root.height * 0.35;
        width: root.width * 0.9;
        height: root.height * 0.7;
        background: @radial-gradient(circle, #20609466 0%, #20609400 64%);
    }
    Rectangle {
        x: -root.width * 0.1;
        y: root.height * 0.58;
        width: root.width * 1.2;
        height: root.height * 0.9;
        background: @radial-gradient(circle, #b258603d 0%, #b2586000 62%);
    }

    // The machine, down the side. Nothing here is focusable: it is read, not
    // operated, and a remote should walk applications rather than gauges.
    Vitals {
        x: Metrics.gutter;
        y: Metrics.topbar + pad-top;
        width: vitals-w;
        height: root.height - self.y - Metrics.gutter;
        vitals: root.vitals;
    }

    // The applications.
    HorizontalLayout {
        x: main-x;
        y: Metrics.topbar + pad-top;
        width: main-w;
        height: tile-h;
        spacing: Metrics.tile-gap;
        alignment: start;

        for tile[i] in apps: AppIcon {
            tile: tile;
            focused: i == focus-col;
        }
    }
}
