import { Theme, Metrics } from "theme.slint";
import { Rail, RailModel, PosterItem, AppTile, AppIcon, Vitals, VitalsModel } from "components.slint";

// The bar every screen starts below. It does not scroll with the shelves, so
// where the viewer is in the product is always on the panel.
component TopBar inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    in property <int> focus-col;
    in property <bool> active;

    // Taller than the bar itself, and transparent past it. A panel would cut
    // the backdrop off with a straight edge; a gradient only as tall as the
    // text left the shelf that scrolls underneath showing through the words.
    height: Metrics.topbar * 1.9;
    background: @linear-gradient(180deg,
        #040508 0%, #040508fa 42%, #040508c4 68%, #04050861 86%, transparent 100%);

    HorizontalLayout {
        y: 0;
        height: Metrics.topbar;
        padding-left: Metrics.gutter;
        padding-right: Metrics.gutter;
        spacing: Metrics.gutter * 0.5;
        alignment: start;

        for label[i] in items: Rectangle {
            property <bool> focused: active && i == focus-col;
            width: text.preferred-width + Metrics.root-font * 1.6;
            border-radius: Theme.radius * 0.7;
            background: focused ? Theme.focus-ring : transparent;

            text := Text {
                text: label;
                color: focused ? #0a0c10 : (i == selected ? Theme.text : Theme.muted);
                font-size: Metrics.root-font * 0.92;
                font-weight: 640;
                vertical-alignment: center;
            }

            animate background { duration: Theme.focus-in; easing: Theme.ease; }
        }
    }
}

export component Home inherits Rectangle {
    // Two layers and a mix, so a new backdrop arrives by fading rather than by
    // replacing. The image manager only ever swaps the layer that is fading in,
    // and the fade is the only thing animated: no blur, no filter.
    in property <image> art-a;
    in property <image> art-b;
    in property <float> fade;

    in property <string> hero-title;
    in property <string> hero-meta;
    in property <string> hero-summary;

    in property <[string]> nav;
    in property <[RailModel]> rails;

    // What this box can be used for, and how it is doing. The two things the
    // web interface's home screen has that this one did not: without them the
    // television's front page was a catalogue, and the box's own applications
    // were reachable from a phone but not from the sofa.
    in property <[AppTile]> apps;
    in property <VitalsModel> vitals;

    // Row 0 is the bar, row 1 is the launcher; 2.. are the shelves.
    in property <int> focus-row;
    in property <int> focus-col;

    in property <string> notice;

    property <length> rail-h: Metrics.card-h + Metrics.text-card * 2.6 + Metrics.title-rail * 2.6;
    property <length> viewport-h: root.height - Metrics.topbar;

    // One launcher tile, and the row it sits on. The note under a tile that is
    // not installed is part of the tile, so the row is as tall as the tallest
    // thing on it whether anything is missing or not.
    property <length> tile-h: Metrics.tile-w + Metrics.root-font * 0.5
        + Metrics.root-font * 0.9 * 1.3 + Metrics.root-font * 0.76 * 1.4;
    property <length> launcher-h: tile-h + Metrics.main-gap;

    // The right-hand column: everything that is not the machine's own vitals.
    property <length> main-x: Metrics.gutter + Metrics.vitals-w + Metrics.home-gap;
    property <length> main-w: max(Metrics.card-w, root.width - main-x - Metrics.gutter);

    // The hero takes what is left once the launcher and the first shelf have
    // their room. That is the whole shape of the screen: a cinema still, with
    // the box's applications and something to choose already in reach under it.
    property <length> hero-h: max(rail-h * 0.55,
        viewport-h - rail-h - launcher-h - Metrics.home-pad-top);
    property <length> content-h: hero-h + launcher-h + rail-h * rails.length;

    // The hero is kept until the remote goes past the first shelf. Scrolling it
    // away the moment focus lands would mean the backdrop is never seen: the
    // launcher is where every session starts.
    property <length> scroll: focus-row <= 2
        ? 0px
        : clamp(hero-h + launcher-h + (focus-row - 2) * rail-h - Metrics.top-inset,
                0px,
                max(0px, content-h - viewport-h));

    background: Theme.bg;
    clip: true;

    // The backdrop reaches under the bar, which is why it is drawn first and
    // full height rather than inside the scrolling column.
    Rectangle {
        width: 100%;
        height: root.height * 0.78;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: art-a;
            image-fit: cover;
            opacity: 1.0 - fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }
        Image {
            width: 100%;
            height: 100%;
            source: art-b;
            image-fit: cover;
            opacity: fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }

        // Two scrims, across and down. The picture has to survive being read
        // over, and a single flat wash either kills the image or loses the text.
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg,
                #07080b 0%, #07080beb 26%, #07080b57 62%, #07080b1a 100%);
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg,
                #07080b 0%, #07080be6 14%, #07080b57 52%, #07080b85 84%, #07080b 100%);
        }
    }

    // The machine's own vitals, down the left and out of the scroll: they are
    // read rather than operated, and a gauge that slides away when the remote
    // moves is a gauge nobody can use.
    Vitals {
        x: Metrics.gutter;
        y: Metrics.topbar + Metrics.home-pad-top;
        width: Metrics.vitals-w;
        height: root.height - self.y - Metrics.gutter;
        vitals: root.vitals;
    }

    // Everything that scrolls.
    column := Rectangle {
        x: 0;
        y: Metrics.topbar - scroll;
        width: 100%;
        height: content-h;
        background: transparent;

        animate y { duration: Theme.glide; easing: Theme.ease; }

        // The hero.
        VerticalLayout {
            x: main-x;
            y: hero-h * 0.22;
            width: min(main-w * 0.86, 980px);
            spacing: Metrics.root-font * 0.55;
            alignment: start;

            Text {
                text: hero-title;
                color: Theme.text;
                font-size: Metrics.title-hero;
                font-weight: 820;
                letter-spacing: -0.038 * Metrics.title-hero;
                wrap: word-wrap;
                overflow: elide;
            }

            if hero-meta != "": Text {
                text: hero-meta;
                color: Theme.muted;
                font-size: Metrics.text-meta;
                font-weight: 620;
                overflow: elide;
            }

            if hero-summary != "": Text {
                text: hero-summary;
                color: Theme.muted;
                font-size: Metrics.text-meta * 0.98;
                wrap: word-wrap;
                overflow: elide;
                max-height: Metrics.text-meta * 3.2;
            }
        }

        // The launcher. One row rather than a wrapping grid: the focus model is
        // a row and a column, and a grid that reflowed would move a tile out
        // from under the remote when an application finished installing.
        HorizontalLayout {
            x: main-x;
            y: hero-h;
            width: main-w;
            height: tile-h;
            spacing: Metrics.tile-gap-x;
            alignment: start;

            for tile[i] in apps: AppIcon {
                tile: tile;
                focused: focus-row == 1 && i == focus-col;
            }
        }

        for rail[r] in rails: Rail {
            x: main-x - Metrics.gutter;
            y: hero-h + launcher-h + r * rail-h;
            width: main-w + Metrics.gutter;
            rail: rail;
            focus-col: focus-col;
            active: focus-row == r + 2;
        }
    }

    TopBar {
        x: 0;
        y: 0;
        width: 100%;
        height: Metrics.topbar * 1.9;
        items: nav;
        selected: 0;
        focus-col: focus-col;
        active: focus-row == 0;
    }

    // What went wrong, if anything did, without taking the screen away from
    // shelves that are working.
    if notice != "": Rectangle {
        x: Metrics.gutter;
        y: root.height - self.height - Metrics.gutter * 0.6;
        width: label.preferred-width + Metrics.root-font * 2;
        height: Metrics.root-font * 2.4;
        border-radius: Theme.radius * 0.7;
        background: #151a23e0;
        border-width: 1px;
        border-color: Theme.line;

        label := Text {
            text: notice;
            color: Theme.warn;
            font-size: Metrics.text-chip;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
