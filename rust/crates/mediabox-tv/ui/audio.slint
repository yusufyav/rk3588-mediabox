import { PointerTarget } from "pointer.slint";
import { QuietChoice } from "quiet/controls.slint";
import { LivingFocus } from "quiet/materials.slint";
import { SoundBand } from "quiet/instruments.slint";
import { Theme, Metrics } from "theme.slint";
import {
    SettingCard, InfoPanel, InfoLine, Badge, StateNote, ChoiceItem, ChoiceSheet,
} from "kit.slint";

export struct AudioCard {
    icon: string,
    label: string,
    hint: string,
    value: string,
    kind: string,
    focused: bool,
    enabled: bool,
}

// The sound page: the display page's shape. Cards for what can be chosen, the
// device and its receiver as they are now beside them, a short list for the
// choices, and the volume as a bar under its card.
//
// Drawn from one AudioView composed in Rust (src/screens/audio.rs), where the
// focus and the lists live and are tested.

export struct AudioView {
    available: bool,
    message: string,
    cards: [AudioCard],
    note: string,
    current-title: string,
    current-line: string,
    current-badges: [Badge],
    current-rows: [InfoLine],
    picker-open: bool,
    picker-title: string,
    picker: [ChoiceItem],
    picker-focus: int,
    volume: int,
    muted: bool,
    volume-focused: bool,
    device-icon: string,
    speakers: int,
    source: string,
    form: string,
    bitstream: bool,
    receiver-volume: bool,
}

export component AudioPane inherits Rectangle {
    in property <AudioView> view;
    in property <bool> active-pane;

    property <length> gap: Metrics.stack-gap;
    property <length> info-x: Metrics.list-w + Metrics.card-pad * 1.6;
    // Quiet OS: the way the sound goes, along the top; the settings under it.
    property <length> band-h: Theme.quiet ? 204px * Metrics.qu : 0px;
    property <length> top: Theme.quiet ? band-h + 14px * Metrics.qu : 0px;
    property <length> lit-y;
    property <length> lit-h;

    if Theme.quiet && view.available: SoundBand {
        x: 0;
        y: 0;
        width: root.width;
        height: band-h;
        source: view.source;
        form: view.form;
        bitstream: view.bitstream;
        icon: view.device-icon;
        device: view.current-line == "" ? view.current-title : view.current-title + "  ·  " + view.current-line;
        volume: view.volume;
        muted: view.muted;
        receiver-volume: view.receiver-volume;
        speakers: view.speakers;
    }
    if Theme.quiet && view.available: LivingFocus {
        x: 0;
        y: root.top;
        width: Metrics.list-w;
        height: root.height - root.top;
        shown: active-pane && !view.picker-open;
        to-y: lit-y;
        to-h: lit-h;
    }

    if !view.available: StateNote {
        x: 0;
        y: 0;
        width: min(root.width, Metrics.list-w);
        kind: "unavailable";
        title: "Ses okunamıyor";
        message: view.message;
    }

    if view.available: VerticalLayout {
        x: 0;
        y: root.top;
        width: Metrics.list-w;
        spacing: gap;
        alignment: start;

        for card[i] in view.cards: slot := VerticalLayout {
            spacing: Theme.quiet ? Metrics.row-gap : gap * 0.5;
            property <bool> here: card.focused;
            function lift() {
                if here {
                    root.lit-h = one.height;
                    root.lit-y = slot.y + one.y;
                }
            }
            init => { lift(); }
            changed here => { lift(); }
            // The volume stands apart from the choices above it.
            if i == 4: Rectangle { height: gap * 0.6; }
            one := SettingCard {
                glide: Theme.quiet;
                icon: card.icon;
                label: card.label;
                hint: card.hint;
                value: card.value;
                kind: card.kind;
                enabled: card.enabled;
                focused: active-pane && card.focused && !view.picker-open;
                pointer-zone: card.enabled ? "editor-cards" : "";
                pointer-index: i;
            }
            // The level, drawn: a bar the remote's Left and Right move.
            if i == 4: Rectangle {
                height: Theme.quiet ? max(2px, 3px * Metrics.qu) : max(4px, Metrics.focus-w * 1.6);
                border-radius: self.height / 2;
                background: Theme.quiet ? #ffffff14 : Theme.s-line;
                Rectangle {
                    x: 0;
                    width: parent.width * view.volume / 100;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: view.muted ? Theme.dim : (view.volume-focused && active-pane ? Theme.focus : (Theme.quiet ? #9aa6ad : #c9ced8));
                    animate width { duration: Theme.t-focus; easing: Theme.ease; }
                }
                // Its lower and upper halves are Left and Right on the volume
                // card: a step down or up, as the remote's. Taller than the
                // bar, so a thin line can be hit.
                PointerTarget {
                    x: 0;
                    y: -Metrics.row-gap * 0.5;
                    width: parent.width / 2;
                    height: parent.height + Metrics.row-gap;
                    zone: "editor-volume";
                    index: 0;
                }
                PointerTarget {
                    x: parent.width / 2;
                    y: -Metrics.row-gap * 0.5;
                    width: parent.width / 2;
                    height: parent.height + Metrics.row-gap;
                    zone: "editor-volume";
                    index: 1;
                }
            }
        }

        Text {
            text: view.note;
            color: Theme.muted;
            font-size: Metrics.t-meta;
            wrap: word-wrap;
        }
    }

    if view.available && root.width - info-x > Metrics.t-primary * 9: InfoPanel {
        x: info-x;
        y: root.top;
        width: root.width - info-x;
        caption: "Şu an";
        icon: "speaker";
        title: view.current-title;
        line: view.current-line;
        badges: view.current-badges;
        rows: view.current-rows;
        fit-content: true;
    }

    if view.picker-open && Theme.quiet: QuietChoice {
        x: -root.x;
        y: -root.y;
        width: Metrics.vw;
        height: Metrics.vh;
        title: view.picker-title;
        items: view.picker;
        focus-at: view.picker-focus;
        pointer-zone: "editor-picker";
    }
    if view.picker-open && !Theme.quiet: ChoiceSheet {
        x: -root.x;
        y: -root.y;
        width: Metrics.vw;
        height: Metrics.vh;
        title: view.picker-title;
        items: view.picker;
        focus-at: view.picker-focus;
        pointer-zone: "editor-picker";
    }
}
