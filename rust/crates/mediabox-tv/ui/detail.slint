import { Theme, Metrics } from "theme.slint";
import { ReferenceIcon } from "reference-icons.slint";

// One source the viewer can choose.
//
// Two strings, and both of them the addon's own: the reference draws the
// stream's `name` down the left of the row and its `title` down the right,
// verbatim, line breaks and pictograms included. Every attempt to improve on
// that here — parsing the name into chips, promoting the release, hiding the
// provider — produced a column that said less than the addon did and looked
// nothing like the product it is meant to be the same as.
export struct SourceRow {
    name: string,
    title: string,
    meta: string,
    playable: bool,
}

// One episode in a series' column, as the reference lists them: its picture,
// "3. Title", when it came out, and whether it was watched or how far.
export struct EpisodeRow {
    title: string,
    date: string,
    watched: bool,
    upcoming: bool,
    progress: float,
    art: image,
}

// An episode, as the reference's video row, off its stylesheet: an 8rem by
// 5rem still with the progress along its foot, then the numbered title and,
// under it, the date faded and the reference's flags -- "İZLENDİ" on yellow
// with an eye, "YAKLAŞAN" on green.
component EpisodeLine inherits Rectangle {
    in property <EpisodeRow> entry;
    in property <bool> focused;
    // The remote is on the row's watched button rather than on the row.
    in property <bool> marking;
    property <length> rem: Metrics.vw / 128;

    border-radius: rem * 0.75;
    background: focused ? #ffffff1f : transparent;
    border-width: focused ? max(2px, rem * 0.15) : 0px;
    border-color: Theme.focus-ring;
    clip: true;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        padding: rem * 0.5;

        Rectangle {
            width: rem * 8;
            border-radius: rem * 0.3;
            background: #ffffff0d;
            clip: true;

            if entry.art.width > 0: Image {
                width: 100%;
                height: 100%;
                source: entry.art;
                image-fit: cover;
                opacity: 0.9;
            }
            if entry.progress > 0.0: Rectangle {
                x: rem * 0.5;
                y: parent.height - rem * 0.9;
                width: parent.width - rem;
                height: rem * 0.4;
                background: #ffffff33;
                Rectangle {
                    x: 0;
                    width: max(3px, parent.width * entry.progress);
                    height: 100%;
                    background: #7b5bf5;
                }
            }
        }

        VerticalLayout {
            padding-left: rem * 1.5;
            padding-right: rem * 0.5;
            alignment: center;
            spacing: rem * 0.6;

            Text {
                text: entry.title;
                color: Theme.text;
                font-size: rem;
                wrap: word-wrap;
                overflow: elide;
                max-height: rem * 2.5;
            }
            HorizontalLayout {
                height: rem * 1.6;
                spacing: rem * 0.5;

                Text {
                    text: entry.date;
                    color: #ffffff70;
                    font-size: rem * 0.8;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    wrap: no-wrap;
                }
                if entry.upcoming && !entry.watched: Rectangle {
                    horizontal-stretch: 0;
                    border-radius: rem * 0.3;
                    background: #22b365;
                    HorizontalLayout {
                        padding-left: rem * 0.5;
                        padding-right: rem * 0.5;
                        Text {
                            text: "YAKLAŞAN";
                            color: #0c0b11;
                            font-size: rem * 0.8;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
                if entry.watched: Rectangle {
                    horizontal-stretch: 0;
                    border-radius: rem * 0.3;
                    background: #f6c700;
                    HorizontalLayout {
                        padding-left: rem * 0.5;
                        padding-right: rem * 0.5;
                        spacing: rem * 0.25;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: rem * 1.15;
                                height: rem * 1.15;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z";
                                fill: #0c0b11;
                            }
                        }
                        Text {
                            text: "İZLENDİ";
                            color: #0c0b11;
                            font-size: rem * 0.8;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // The watched button, on the focused row only: Right reaches it, Ok
        // turns the episode watched or not, as the reference's row menu does.
        Rectangle {
            width: focused ? Metrics.vh * 0.05 : 0px;
            visible: focused;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: parent.width;
                border-radius: self.height / 2;
                background: marking ? Theme.focus-fill : #ffffff1a;
                border-width: marking ? 2px : 0px;
                border-color: Theme.focus-ring;

                Path {
                    x: parent.width * 0.2;
                    y: parent.height * 0.2;
                    width: parent.width * 0.6;
                    height: parent.height * 0.6;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: entry.watched
                        ? "M12 5C6.5 5 2.7 9.4 1.5 12c1.2 2.6 5 7 10.5 7s9.3-4.4 10.5-7C21.3 9.4 17.5 5 12 5zM12 8.5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7z"
                        : "M12 5C6.5 5 2.7 9.4 1.5 12c1.2 2.6 5 7 10.5 7s9.3-4.4 10.5-7C21.3 9.4 17.5 5 12 5zM12 7c4.2 0 7.3 3.1 8.4 5-1.1 1.9-4.2 5-8.4 5s-7.3-3.1-8.4-5C4.7 10.1 7.8 7 12 7z";
                    fill: marking ? #0a0c10 : (entry.watched ? Theme.badge-good : #ffffffb0);
                }
            }
        }
    }
}

// A rounded label: a genre, a name, a director. The reference's own shape —
// white text on a faint white fill, ends fully rounded.
component Pill inherits Rectangle {
    in property <string> text;

    height: Metrics.vh * 0.03;
    width: caption.preferred-width + self.height * 0.9;
    border-radius: self.height / 2;
    background: #ffffff1c;

    caption := Text {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.text;
        font-size: Metrics.vw * 0.0078;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
        wrap: no-wrap;
    }
}

// A heading over a row of pills or a paragraph: TÜRÜ, OYUNCULAR, ÖZET.
component SectionLabel inherits Text {
    color: #ffffff8c;
    font-size: Metrics.vh * 0.0125;
    font-weight: 500;
    letter-spacing: Metrics.vh * 0.0012;
    height: Metrics.vh * 0.028;
    vertical-alignment: center;
}

// A named row of pills.
//
// Placed rather than laid out. A HorizontalLayout of pills inside a column has
// no preferred height of its own here, and the first version drew every
// heading underneath the pills that belonged to it.
component ChipSection inherits Rectangle {
    in property <string> label;
    in property <[string]> items;

    property <length> label-h: Metrics.vh * 0.032;
    height: label-h + Metrics.vh * 0.037;
    background: transparent;

    SectionLabel {
        x: 0;
        y: 0;
        width: 100%;
        height: label-h;
        text: label;
    }

    HorizontalLayout {
        x: 0;
        y: label-h;
        width: 100%;
        height: Metrics.vh * 0.03;
        spacing: Metrics.vw * 0.008;
        alignment: start;

        for item in items: Pill { text: item; }
    }
}

// One thing that can be done with the title, along the bottom of the record.
// One mark in the reference's group of two: the library and watched buttons
// share one pill, each a round stop in it, its mark faded until the remote
// is on it.
component GroupStop inherits Rectangle {
    in property <string> mark;
    in property <string> cut;
    in property <bool> focused;
    in property <bool> enabled: true;

    width: self.height;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.38;
    background: focused ? Theme.focus-fill : transparent;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    // The reference's mark, by name.
    ReferenceIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: mark;
        size: parent.height * 0.46;
        ink: focused ? #0a0c10 : #ffffffb3;
    }
}

// Round, marked and named — the reference's shape, and the shape that survives
// being read from a sofa.
component Action inherits Rectangle {
    in property <string> label;
    in property <string> mark;
    // Drawn over the mark in the button's own colour, which is how a shape
    // gets a hole in it without a second element knowing the theme.
    in property <string> cut;
    in property <bool> focused;
    in property <bool> enabled: true;

    height: Metrics.vh * 0.056;
    // The reference's trailer button carries its word; its library and
    // watched buttons are marks alone.
    width: label == "" ? self.height : caption.preferred-width + self.height * 1.9;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.38;
    background: focused ? Theme.focus-fill : #ffffff14;
    border-width: focused ? 2px : 1px;
    border-color: focused ? Theme.focus-ring : #ffffff33;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        padding-left: label == "" ? 0px : root.height * 0.42;
        padding-right: label == "" ? 0px : root.height * 0.5;
        spacing: root.height * 0.24;
        alignment: center;

        // The reference's mark, by name.
        VerticalLayout {
            alignment: center;
            ReferenceIcon {
                name: mark;
                size: Metrics.vh * 0.026;
                ink: focused ? #0a0c10 : Theme.text;
            }
        }

        caption := Text {
            visible: label != "";
            text: label;
            color: focused ? #0a0c10 : Theme.text;
            font-size: Metrics.vh * 0.0145;
            font-weight: 500;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// One row of the source column, as the reference's stream row, off its
// stylesheet: what the addon calls itself in a 7rem column at 1.1rem, and
// what it says about the file beside it, line for line as the addon wrote
// it, three lines at most; the green play mark on the row the remote is on.
component SourceLine inherits Rectangle {
    // `entry` rather than `row`: every Rectangle already has a `row`, for grid
    // layout, and a property cannot shadow it.
    in property <SourceRow> entry;
    in property <bool> focused;
    property <length> rem: Metrics.vw / 128;

    border-radius: rem * 0.75;
    background: focused ? #ffffff1f : transparent;
    border-width: focused ? max(2px, rem * 0.15) : 0px;
    border-color: Theme.focus-ring;
    clip: true;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        padding-left: rem;
        padding-right: rem;
        padding-top: rem * 0.5;
        padding-bottom: rem * 0.5;
        spacing: rem * 0.5;

        Text {
            width: rem * 7;
            text: entry.name;
            color: Theme.text;
            font-size: rem * 1.1;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: entry.meta == "" ? entry.title : entry.title + "\n" + entry.meta;
            color: Theme.text;
            font-size: rem;
            wrap: no-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
        if focused: VerticalLayout {
            alignment: center;
            Rectangle {
                width: rem * 3;
                height: rem * 3;
                border-radius: self.height / 2;
                background: #22b365;
                Path {
                    x: parent.width * 0.36;
                    y: parent.height * 0.3;
                    width: parent.width * 0.36;
                    height: parent.height * 0.4;
                    viewbox-width: 9;
                    viewbox-height: 10;
                    commands: "M0 0L9 5L0 10z";
                    fill: Theme.text;
                }
            }
        }
    }
}

// The title's page.
//
// Two columns, the way the reference lays it out: the record down the left over
// the backdrop, and the sources down the right as a column of this screen
// rather than behind a button. Choosing where a film comes from is most of what
// this screen is for.
export component Detail inherits Rectangle {
    in property <image> art-a;
    in property <image> art-b;
    in property <float> fade;
    in property <image> poster;
    in property <image> logo;
    // A logo is on its way: neither it nor the name is drawn meanwhile.
    in property <bool> logo-pending;

    in property <string> title;
    in property <[string]> facts;
    // Whether the rating on the end of `facts` is IMDb's, which is drawn as
    // their badge rather than as a fourth word.
    in property <bool> imdb;
    in property <string> summary;
    in property <[string]> genres;
    in property <[string]> cast;
    in property <[string]> directors;

    in property <[string]> actions;
    in property <[string]> marks;
    in property <[string]> cuts;
    in property <[bool]> enabled;
    in property <int> focus-col;
    in property <bool> on-sources;

    in property <[SourceRow]> sources;
    in property <string> sources-note;
    in property <[string]> providers;
    in property <int> provider;
    in property <bool> on-filter;
    in property <bool> filter-open;
    in property <int> filter-focus;
    in property <int> source-focus;

    // A series: its seasons and episodes, in the column the sources use until
    // an episode is chosen. The heading names the episode over its sources.
    in property <bool> show-episodes;
    in property <bool> on-episodes;
    in property <[string]> seasons;
    in property <int> season-index;
    in property <bool> on-seasons;
    in property <[EpisodeRow]> episodes;
    in property <int> episode-focus;
    in property <bool> on-mark;
    in property <string> episode-heading;

    // The measurements are the reference's own, read off a 4K screenshot of
    // its detail page and kept as fractions of the panel: the source column
    // runs from 76.5% of the width to the edge and from 7.7% of the height to
    // the bottom; the record starts 7.6% down and 3.15% in.
    property <length> column-x: root.width * 0.765;
    property <length> column-w: root.width - column-x;
    property <length> record-x: root.width * 0.0315;
    property <length> record-w: column-x - record-x - root.width * 0.02;
    property <length> panel-pad: Metrics.vh * 0.018;

    // The interface's own background, as the reference's page has its own
    // under a backdrop that has not loaded yet.
    background: Theme.catalog-bg;
    clip: true;

    // ---------------------------------------------------------- the backdrop
    //
    // One veil over the whole frame and nothing else. Measured off the
    // reference: its backdrop comes out at #5a5a64 where the wall behind the
    // actors is white, which is a flat blue-black at 57% over the picture. The
    // version this replaced darkened a band in the middle of the screen to 4%
    // and left the column the text sits in completely unveiled, because the
    // rectangle carrying the gradient had no x of its own and Slint centres a
    // child that does not give one.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        if fade < 0.999: Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: art-a;
            image-fit: cover;
            opacity: 1.0 - fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }
        if fade > 0.001: Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: art-b;
            image-fit: cover;
            opacity: fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #070a1a9d;
        }
        // Enough under the action row to keep it off a bright frame, and no
        // more: the reference's own footer shading.
        Rectangle {
            x: 0;
            y: parent.height * 0.72;
            width: 100%;
            height: parent.height * 0.28;
            background: @linear-gradient(180deg, #05070e00 0%, #05070e8c 100%);
        }
    }

    // The way back. The reference puts a chevron here and nothing else — no
    // brand, no clock — and this screen is the film's, not the box's.
    Path {
        x: root.width * 0.018;
        y: root.height * 0.03;
        width: Metrics.vh * 0.024;
        height: Metrics.vh * 0.024;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M15.5 3.2L6.7 12l8.8 8.8";
        stroke: Theme.text;
        stroke-width: 2.1px;
    }

    // ------------------------------------------------------------ the record
    VerticalLayout {
        x: record-x;
        y: root.height * 0.076;
        width: record-w;
        spacing: Metrics.vh * 0.019;
        alignment: start;

        // The title's own logo when the catalogue has one, and its name set
        // large when it does not. The reference leads with the logo and it is
        // the single thing that makes a page look like the film rather than
        // like a database row.
        // The reference's facts are centred 25.2% down, 1.9% further under the
        // logo than the gap between the blocks under them.
        VerticalLayout {
            padding-bottom: Metrics.vh * 0.019;
            if logo.width > 0: Image {
                source: logo;
                image-fit: contain;
                horizontal-alignment: left;
                height: Metrics.vh * 0.118;
            }
            if logo.width == 0 && logo-pending: Rectangle {
                height: Metrics.vh * 0.118;
            }
            if logo.width == 0 && !logo-pending: Text {
                text: title;
                color: Theme.text;
                font-size: Metrics.vh * 0.052;
                font-weight: 800;
                letter-spacing: -0.03 * Metrics.vh * 0.052;
                wrap: word-wrap;
                overflow: elide;
                max-height: Metrics.vh * 0.12;
            }
        }

        // How long, when, and what it scored — in the reference's order, with
        // the rating wearing IMDb's badge rather than their name.
        // Spread as the reference spreads them -- 100 min, 2011, 7.8 -- with
        // IMDb's badge beside the rating rather than spaced off like a fact.
        if facts.length > 0: HorizontalLayout {
            height: Metrics.vh * 0.04;
            spacing: Metrics.vw * 0.024;
            alignment: start;

            for fact[i] in facts: HorizontalLayout {
                spacing: Metrics.vw * 0.011;
                Text {
                    text: fact;
                    color: Theme.text;
                    font-size: Metrics.vw * 0.01;
                    font-weight: 500;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
                // The reference's badge: 1.87% of the width by 1.62% of the height.
                if imdb && i == facts.length - 1: Rectangle {
                    width: Metrics.vw * 0.0187;
                    height: Metrics.vh * 0.0162;
                    y: (parent.height - self.height) / 2;
                    border-radius: Metrics.vh * 0.003;
                    background: #f5c518;

                    badge := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "IMDb";
                        color: #0a0c10;
                        font-size: Metrics.vh * 0.0098;
                        font-weight: 800;
                    }
                }
            }
        }

        if genres.length > 0: ChipSection {
            label: "TÜRÜ";
            items: genres;
        }
        if cast.length > 0: ChipSection {
            label: "OYUNCULAR";
            items: cast;
        }
        if directors.length > 0: ChipSection {
            label: "YÖNETMENLER";
            items: directors;
        }

        // The heading sits on its paragraph, as the reference's does.
        if summary != "": VerticalLayout {
            spacing: Metrics.vh * 0.006;
            SectionLabel {
                text: "ÖZET";
            }
            Text {
                text: summary;
                color: Theme.text;
                font-size: Metrics.vw * 0.0078;
                font-weight: 400;
                wrap: word-wrap;
                overflow: elide;
                max-height: Metrics.vh * 0.1;
            }
        }
    }

    // The actions, along the bottom of the record.
    HorizontalLayout {
        x: record-x;
        y: root.height - self.height - Metrics.vh * 0.04;
        width: record-w;
        height: Metrics.vh * 0.056;
        spacing: Metrics.vw * 0.011;
        alignment: start;

        // "Fragman" in words, then the library and watched marks together in
        // one pill, as the reference groups them.
        if actions.length > 0: Action {
            label: actions[0];
            mark: marks[0];
            cut: cuts[0];
            enabled: enabled[0];
            // One focus on the panel: not while the remote is in the column.
            focused: !on-sources && !on-episodes && focus-col == 0;
        }
        if actions.length > 1: Rectangle {
            width: self.height * (actions.length - 1);
            border-radius: self.height / 2;
            background: #ffffff14;
            border-width: 1px;
            border-color: #ffffff33;

            HorizontalLayout {
                for label[i] in actions: GroupStop {
                    visible: label == "";
                    width: label == "" ? self.height : 0px;
                    mark: marks[i];
                    cut: cuts[i];
                    enabled: enabled[i];
                    focused: !on-sources && !on-episodes && i == focus-col;
                }
            }
        }
    }

    // ----------------------------------------------------------- the sources
    // The reference's column: to the edge and the bottom, rounded only where
    // it meets the picture, the backdrop darkened under it rather than a card
    // laid over it.
    Rectangle {
        x: column-x;
        y: root.height * 0.077;
        width: column-w;
        height: root.height - self.y;
        border-top-left-radius: root.width * 0.009;
        background: #00000073;
        clip: true;

        // The reference's first line over the streams: the way back and the
        // episode's "S1E3 Title" where there is an episode, then the addon
        // dropdown in the rest of the line.
        property <length> rem: Metrics.vw / 128;
        property <length> head-h: rem * 3;
        property <length> title-w: episode-heading == "" ? 0px : (self.width - panel-pad * 2) * 0.5;

        if !show-episodes && episode-heading != "": HorizontalLayout {
            x: panel-pad;
            y: panel-pad;
            width: title-w;
            height: head-h;
            spacing: rem * 0.75;

            VerticalLayout {
                alignment: center;
                Path {
                    width: rem * 1.5;
                    height: rem * 1.5;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M15 5L8 12l7 7";
                    stroke: Theme.text;
                    stroke-width: 2px;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: episode-heading;
                color: Theme.text;
                font-size: rem;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            visible: !show-episodes;

            // The addon dropdown. Walked with Left and Right, the way the
            // reference's dropdown is opened and picked through.
            select := Rectangle {
                x: panel-pad + title-w + (title-w > 0 ? rem * 0.5 : 0px);
                y: panel-pad;
                width: parent.width - self.x - panel-pad;
                height: head-h;
                border-radius: self.height * 0.28;
                background: (on-sources && on-filter) ? Theme.focus-fill : #ffffff0d;

                animate background { duration: Theme.focus-in; easing: Theme.ease; }

                HorizontalLayout {
                    padding-left: rem;
                    padding-right: rem;
                    spacing: rem * 0.5;

                    Text {
                        text: providers[provider];
                        color: (on-sources && on-filter) ? #0a0c10 : Theme.text;
                        font-size: rem;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: rem * 0.7;
                            height: rem * 0.42;
                            viewbox-width: 10;
                            viewbox-height: 6;
                            commands: providers.length <= 1 ? "" : "M0 0L10 0L5 6z";
                            fill: (on-sources && on-filter) ? #0a0c10 : Theme.text;
                        }
                    }
                }
            }

            if sources-note != "": Text {
                x: panel-pad;
                y: panel-pad + head-h + rem * 0.6;
                text: sources-note;
                color: #ffffff8c;
                font-size: Metrics.vh * 0.0135;
                font-weight: 500;
            }

            list := Rectangle {
                // Three lines of the addon's name at 1.1rem and the padding: the
                // reference's row at its tallest, so no row is cut short.
                property <length> row-h: rem * 5.2;
                x: panel-pad;
                y: panel-pad + head-h + (sources-note == "" ? rem : rem * 2.6);
                width: parent.width - panel-pad * 2;
                height: parent.height - self.y;
                clip: true;
                background: transparent;

                VerticalLayout {
                    x: 0;
                    // The focused row is kept on the panel and the list slides
                    // under it, which is what makes forty releases usable with
                    // five keys.
                    y: -clamp(source-focus * (list.row-h + rem * 0.5)
                                - list.height * 0.4,
                              0px,
                              max(0px, sources.length * (list.row-h + rem * 0.5)
                                         - list.height));
                    width: 100%;
                    height: max(1px, sources.length * (list.row-h + rem * 0.5));
                    spacing: rem * 0.5;
                    alignment: start;

                    animate y { duration: Theme.glide; easing: Theme.ease; }

                    for source[i] in sources: SourceLine {
                        entry: source;
                        height: list.row-h;
                        focused: on-sources && !on-filter && !filter-open && i == source-focus;
                    }
                }
            }

            if filter-open: Rectangle {
                x: select.x;
                y: panel-pad + head-h + rem * 0.3;
                width: select.width;
                height: providers.length * Metrics.vh * 0.052 + Metrics.vh * 0.012;
                border-radius: Metrics.vh * 0.008;
                background: #141a29;
                border-width: 1px;
                border-color: #ffffff1f;

                VerticalLayout {
                    x: 0;
                    y: Metrics.vh * 0.006;
                    width: 100%;
                    spacing: 0px;
                    alignment: start;

                    for name[i] in providers: Rectangle {
                        height: Metrics.vh * 0.052;
                        background: i == filter-focus ? #ffffff1f : transparent;

                        HorizontalLayout {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            padding-left: Metrics.vh * 0.016;
                            padding-right: Metrics.vh * 0.016;

                            Text {
                                text: name;
                                color: Theme.text;
                                font-size: Metrics.vh * 0.018;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                                horizontal-stretch: 1;
                            }
                            // Which one the column is showing.
                            Rectangle {
                                width: Metrics.vh * 0.01;
                                height: 100%;

                                if i == provider: Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: Metrics.vh * 0.01;
                                    height: Metrics.vh * 0.01;
                                    border-radius: self.height / 2;
                                    background: #6fd97f;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------ the episodes
        if show-episodes: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            // The season bar: the reference's "‹ Önceki", the season with its
            // caret, "Sonraki ›". Left and Right walk the seasons from the
            // season, which is where the remote stands.
            bar := Rectangle {
                property <length> rem: Metrics.vw / 128;
                property <bool> focused: on-episodes && on-seasons;
                x: panel-pad;
                y: panel-pad;
                width: parent.width - panel-pad * 2;
                height: rem * 3;

                Rectangle {
                    x: 0;
                    width: bar.rem * 6.5;
                    opacity: season-index > 0 ? 1.0 : 0.5;
                    HorizontalLayout {
                        padding: bar.rem * 0.5;
                        spacing: bar.rem * 0.5;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: bar.rem * 1.5;
                                height: self.width;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M15 5L8 12l7 7";
                                stroke: Theme.text;
                                stroke-width: 2px;
                            }
                        }
                        Text {
                            text: "Önceki";
                            color: Theme.text;
                            font-size: bar.rem;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: season-label.preferred-width + bar.rem * 4;
                    border-radius: self.height / 2;
                    background: bar.focused ? Theme.focus-fill : transparent;
                    animate background { duration: Theme.focus-in; easing: Theme.ease; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: bar.rem * 0.6;
                        season-label := Text {
                            text: seasons.length > 0 ? seasons[season-index] : "";
                            color: bar.focused ? #0a0c10 : Theme.text;
                            font-size: bar.rem;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: bar.rem * 0.7;
                                height: self.width * 0.6;
                                viewbox-width: 10;
                                viewbox-height: 6;
                                commands: "M0 0L10 0L5 6z";
                                fill: bar.focused ? #0a0c10 : Theme.text;
                            }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - self.width;
                    width: bar.rem * 6.5;
                    opacity: season-index + 1 < seasons.length ? 1.0 : 0.5;
                    HorizontalLayout {
                        padding: bar.rem * 0.5;
                        spacing: bar.rem * 0.5;
                        Text {
                            text: "Sonraki";
                            color: Theme.text;
                            font-size: bar.rem;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: bar.rem * 1.5;
                                height: self.width;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M9 5l7 7-7 7";
                                stroke: Theme.text;
                                stroke-width: 2px;
                            }
                        }
                    }
                }
            }

            episode-list := Rectangle {
                property <length> row-h: Metrics.vw / 128 * 6;
                property <length> gap: Metrics.vw / 128 * 0.5;
                x: panel-pad;
                y: panel-pad + Metrics.vw / 128 * 3.75;
                width: parent.width - panel-pad * 2;
                height: parent.height - self.y;
                clip: true;

                if episodes.length == 0: Text {
                    x: 0;
                    y: Metrics.vh * 0.01;
                    width: parent.width;
                    text: sources-note != "" ? sources-note : "Bölümler yükleniyor…";
                    color: #ffffff8c;
                    font-size: Metrics.vh * 0.0145;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    x: 0;
                    y: -clamp(episode-focus * (episode-list.row-h + episode-list.gap)
                                - episode-list.height * 0.4,
                              0px,
                              max(0px, episodes.length * (episode-list.row-h + episode-list.gap)
                                         - episode-list.height));
                    width: 100%;
                    height: max(1px, episodes.length * (episode-list.row-h + episode-list.gap));
                    spacing: episode-list.gap;
                    alignment: start;

                    animate y { duration: Theme.glide; easing: Theme.ease; }

                    for episode[i] in episodes: EpisodeLine {
                        entry: episode;
                        height: episode-list.row-h;
                        focused: on-episodes && !on-seasons && i == episode-focus;
                        marking: on-mark;
                    }
                }
            }
        }
    }
}
