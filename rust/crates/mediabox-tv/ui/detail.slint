import { Theme, Metrics } from "theme.slint";

// One source the viewer can choose.
//
// Two strings, and both of them the addon's own: the reference draws the
// stream's `name` down the left of the row and its `title` down the right,
// verbatim, line breaks and pictograms included. Every attempt to improve on
// that here — parsing the name into chips, promoting the release, hiding the
// provider — produced a column that said less than the addon did and looked
// nothing like the product it is meant to be the same as.
export struct SourceRow {
    name: string,
    title: string,
    meta: string,
    playable: bool,
}

// A rounded label: a genre, a name, a director. The reference's own shape —
// white text on a faint white fill, ends fully rounded.
component Pill inherits Rectangle {
    in property <string> text;

    height: Metrics.vh * 0.037;
    width: caption.preferred-width + self.height * 0.9;
    border-radius: self.height / 2;
    background: #ffffff1c;

    caption := Text {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.text;
        font-size: Metrics.vh * 0.0155;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
        wrap: no-wrap;
    }
}

// A heading over a row of pills or a paragraph: TÜRÜ, OYUNCULAR, ÖZET.
component SectionLabel inherits Text {
    color: #ffffff8c;
    font-size: Metrics.vh * 0.0125;
    font-weight: 500;
    letter-spacing: Metrics.vh * 0.0012;
    height: Metrics.vh * 0.028;
    vertical-alignment: center;
}

// A named row of pills.
//
// Placed rather than laid out. A HorizontalLayout of pills inside a column has
// no preferred height of its own here, and the first version drew every
// heading underneath the pills that belonged to it.
component ChipSection inherits Rectangle {
    in property <string> label;
    in property <[string]> items;

    property <length> label-h: Metrics.vh * 0.032;
    height: label-h + Metrics.vh * 0.037;
    background: transparent;

    SectionLabel {
        x: 0;
        y: 0;
        width: 100%;
        height: label-h;
        text: label;
    }

    HorizontalLayout {
        x: 0;
        y: label-h;
        width: 100%;
        height: Metrics.vh * 0.037;
        spacing: Metrics.vw * 0.008;
        alignment: start;

        for item in items: Pill { text: item; }
    }
}

// One thing that can be done with the title, along the bottom of the record.
// Round, marked and named — the reference's shape, and the shape that survives
// being read from a sofa.
component Action inherits Rectangle {
    in property <string> label;
    in property <string> mark;
    // Drawn over the mark in the button's own colour, which is how a shape
    // gets a hole in it without a second element knowing the theme.
    in property <string> cut;
    in property <bool> focused;
    in property <bool> enabled: true;

    height: Metrics.vh * 0.056;
    width: caption.preferred-width + self.height * 1.9;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.38;
    background: focused ? Theme.focus-fill : #ffffff14;
    border-width: focused ? 2px : 1px;
    border-color: focused ? Theme.focus-ring : #ffffff33;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        padding-left: root.height * 0.42;
        padding-right: root.height * 0.5;
        spacing: root.height * 0.24;
        alignment: center;

        Rectangle {
            width: Metrics.vh * 0.026;

            Path {
                x: 0;
                width: 100%;
                height: Metrics.vh * 0.026;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: mark;
                fill: focused ? #0a0c10 : Theme.text;
            }
            if cut != "": Path {
                x: 0;
                width: 100%;
                height: Metrics.vh * 0.026;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: cut;
                fill: focused ? Theme.focus-fill : #1b2029;
            }
        }

        caption := Text {
            text: label;
            color: focused ? #0a0c10 : Theme.text;
            font-size: Metrics.vh * 0.0165;
            font-weight: 500;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// One row of the source column: what the addon calls itself down the left, and
// what it says about the file down the right.
component SourceLine inherits Rectangle {
    // `entry` rather than `row`: every Rectangle already has a `row`, for grid
    // layout, and a property cannot shadow it.
    in property <SourceRow> entry;
    in property <bool> focused;
    in property <length> name-w;

    border-radius: Metrics.vh * 0.008;
    background: focused ? #ffffff26 : transparent;
    border-width: focused ? 2px : 0px;
    border-color: Theme.focus-ring;
    clip: true;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        padding-left: Metrics.vh * 0.018;
        padding-right: Metrics.vh * 0.018;
        padding-top: Metrics.vh * 0.014;
        padding-bottom: Metrics.vh * 0.014;
        spacing: Metrics.vh * 0.016;

        Text {
            width: name-w;
            text: entry.name;
            color: Theme.text;
            font-size: Metrics.vh * 0.0155;
            font-weight: 400;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
        // The release on one line and what the addon says about it under it,
        // which is the reference's own arrangement: a release name is long and
        // the same for pages at a time, and the line that tells two of them
        // apart — how big, how many are sharing it, where it came from — is
        // the one that must not be pushed off the row.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 0px;

            Text {
                text: entry.title;
                color: Theme.text;
                font-size: Metrics.vh * 0.0155;
                font-weight: 400;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
            if entry.meta != "": Text {
                text: entry.meta;
                color: Theme.text;
                font-size: Metrics.vh * 0.0155;
                font-weight: 400;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
        }
    }
}

// The title's page.
//
// Two columns, the way the reference lays it out: the record down the left over
// the backdrop, and the sources down the right as a column of this screen
// rather than behind a button. Choosing where a film comes from is most of what
// this screen is for.
export component Detail inherits Rectangle {
    in property <image> art-a;
    in property <image> art-b;
    in property <float> fade;
    in property <image> poster;
    in property <image> logo;

    in property <string> title;
    in property <[string]> facts;
    // Whether the rating on the end of `facts` is IMDb's, which is drawn as
    // their badge rather than as a fourth word.
    in property <bool> imdb;
    in property <string> summary;
    in property <[string]> genres;
    in property <[string]> cast;
    in property <[string]> directors;

    in property <[string]> actions;
    in property <[string]> marks;
    in property <[string]> cuts;
    in property <[bool]> enabled;
    in property <int> focus-col;
    in property <bool> on-sources;

    in property <[SourceRow]> sources;
    in property <string> sources-note;
    in property <[string]> providers;
    in property <int> provider;
    in property <bool> on-filter;
    in property <bool> filter-open;
    in property <int> filter-focus;
    in property <int> source-focus;

    // The measurements are the reference's own, read off it and kept as
    // fractions of the panel: the source column is 23% of the width, the record
    // starts 13.8% down and is inset 4.8% from the left.
    property <length> column-w: max(300px, min(980px, root.width * 0.232));
    property <length> column-x: root.width - column-w - Metrics.gutter * 0.6;
    property <length> record-x: max(Metrics.gutter, root.width * 0.048);
    property <length> record-w: column-x - record-x - Metrics.gutter * 0.6;
    property <length> panel-pad: Metrics.vh * 0.018;

    background: Theme.bg;
    clip: true;

    // ---------------------------------------------------------- the backdrop
    //
    // One veil over the whole frame and nothing else. Measured off the
    // reference: its backdrop comes out at #5a5a64 where the wall behind the
    // actors is white, which is a flat blue-black at 57% over the picture. The
    // version this replaced darkened a band in the middle of the screen to 4%
    // and left the column the text sits in completely unveiled, because the
    // rectangle carrying the gradient had no x of its own and Slint centres a
    // child that does not give one.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        if fade < 0.999: Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: art-a;
            image-fit: cover;
            opacity: 1.0 - fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }
        if fade > 0.001: Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: art-b;
            image-fit: cover;
            opacity: fade;
            animate opacity { duration: Theme.crossfade; easing: Theme.ease; }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #070a1a9d;
        }
        // Enough under the action row to keep it off a bright frame, and no
        // more: the reference's own footer shading.
        Rectangle {
            x: 0;
            y: parent.height * 0.72;
            width: 100%;
            height: parent.height * 0.28;
            background: @linear-gradient(180deg, #05070e00 0%, #05070e8c 100%);
        }
    }

    // The way back. The reference puts a chevron here and nothing else — no
    // brand, no clock — and this screen is the film's, not the box's.
    Path {
        x: record-x;
        y: Metrics.vh * 0.055;
        width: Metrics.vh * 0.03;
        height: Metrics.vh * 0.03;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M15.5 3.2L6.7 12l8.8 8.8";
        stroke: Theme.text;
        stroke-width: 2.1px;
    }

    // ------------------------------------------------------------ the record
    VerticalLayout {
        x: record-x;
        y: root.height * 0.138;
        width: record-w * 0.75;
        spacing: Metrics.vh * 0.019;
        alignment: start;

        // The title's own logo when the catalogue has one, and its name set
        // large when it does not. The reference leads with the logo and it is
        // the single thing that makes a page look like the film rather than
        // like a database row.
        if logo.width > 0: Image {
            source: logo;
            image-fit: contain;
            horizontal-alignment: left;
            height: Metrics.vh * 0.12;
        }
        if logo.width == 0: Text {
            text: title;
            color: Theme.text;
            font-size: Metrics.vh * 0.052;
            font-weight: 800;
            letter-spacing: -0.03 * Metrics.vh * 0.052;
            wrap: word-wrap;
            overflow: elide;
            max-height: Metrics.vh * 0.12;
        }

        // How long, when, and what it scored — in the reference's order, with
        // the rating wearing IMDb's badge rather than their name.
        if facts.length > 0: HorizontalLayout {
            height: Metrics.vh * 0.04;
            spacing: Metrics.vw * 0.013;
            alignment: start;

            for fact in facts: Text {
                text: fact;
                color: Theme.text;
                font-size: Metrics.vh * 0.023;
                font-weight: 600;
                vertical-alignment: center;
                wrap: no-wrap;
            }
            if imdb: Rectangle {
                width: badge.preferred-width + Metrics.vh * 0.018;
                height: Metrics.vh * 0.028;
                y: (parent.height - self.height) / 2;
                border-radius: Metrics.vh * 0.005;
                background: #f5c518;

                badge := Text {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    text: "IMDb";
                    color: #0a0c10;
                    font-size: Metrics.vh * 0.016;
                    font-weight: 800;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if genres.length > 0: ChipSection {
            label: "TÜRÜ";
            items: genres;
        }
        if cast.length > 0: ChipSection {
            label: "OYUNCULAR";
            items: cast;
        }
        if directors.length > 0: ChipSection {
            label: "YÖNETMENLER";
            items: directors;
        }

        if summary != "": SectionLabel {
            text: "ÖZET";
        }
        if summary != "": Text {
            text: summary;
            color: Theme.text;
            font-size: Metrics.vh * 0.0165;
            font-weight: 400;
            wrap: word-wrap;
            overflow: elide;
            max-height: Metrics.vh * 0.1;
        }
    }

    // The actions, along the bottom of the record.
    HorizontalLayout {
        x: record-x;
        y: root.height - self.height - Metrics.vh * 0.05;
        width: record-w;
        height: Metrics.vh * 0.056;
        spacing: Metrics.vw * 0.011;
        alignment: start;

        for label[i] in actions: Action {
            label: label;
            mark: marks[i];
            cut: cuts[i];
            enabled: enabled[i];
            focused: !on-sources && i == focus-col;
        }
    }

    // ----------------------------------------------------------- the sources
    Rectangle {
        x: column-x;
        y: root.height * 0.138;
        width: column-w;
        height: root.height - self.y - Metrics.gutter * 0.5;
        border-radius: Theme.radius;
        background: #21242ed4;
        clip: true;

        // The provider filter. Walked with Left and Right, the way the
        // reference's dropdown is opened and picked through.
        Rectangle {
            x: panel-pad;
            y: panel-pad;
            width: parent.width - panel-pad * 2;
            height: Metrics.vh * 0.052;
            border-radius: Metrics.vh * 0.008;
            background: (on-sources && on-filter) ? Theme.focus-fill : #ffffff0f;
            border-width: (on-sources && on-filter) ? 2px : 0px;
            border-color: Theme.focus-ring;

            animate background { duration: Theme.focus-in; easing: Theme.ease; }

            HorizontalLayout {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                padding-left: Metrics.vh * 0.016;
                padding-right: Metrics.vh * 0.016;
                spacing: Metrics.vh * 0.01;

                Text {
                    text: providers[provider];
                    color: (on-sources && on-filter) ? #0a0c10 : Theme.text;
                    font-size: Metrics.vh * 0.018;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                }
                // The reference's dropdown caret, and it points the way the
                // remote moves: Left and Right walk the providers.
                Path {
                    width: Metrics.vh * 0.014;
                    height: 100%;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: providers.length <= 1 ? ""
                        : (filter-open ? "M4 16l8-9 8 9z" : "M4 8l8 9 8-9z");
                    fill: (on-sources && on-filter) ? #0a0c10 : #ffffffb0;
                }
            }
        }

        if sources-note != "": Text {
            x: panel-pad;
            y: panel-pad + Metrics.vh * 0.052 + Metrics.vh * 0.008;
            text: sources-note;
            color: #ffffff8c;
            font-size: Metrics.vh * 0.0135;
            font-weight: 500;
        }

        list := Rectangle {
            property <length> row-h: Metrics.vh * 0.096;
            x: panel-pad;
            y: panel-pad + Metrics.vh * (sources-note == "" ? 0.064 : 0.082);
            width: parent.width - panel-pad * 2;
            height: parent.height - self.y;
            clip: true;
            background: transparent;

            VerticalLayout {
                x: 0;
                // The focused row is kept on the panel and the list slides
                // under it, which is what makes forty releases usable with
                // five keys.
                y: -clamp(source-focus * (list.row-h + Metrics.vh * 0.004)
                            - list.height * 0.4,
                          0px,
                          max(0px, sources.length * (list.row-h + Metrics.vh * 0.004)
                                     - list.height));
                width: 100%;
                height: max(1px, sources.length * (list.row-h + Metrics.vh * 0.004));
                spacing: Metrics.vh * 0.004;
                alignment: start;

                animate y { duration: Theme.glide; easing: Theme.ease; }

                for source[i] in sources: SourceLine {
                    entry: source;
                    height: list.row-h;
                    name-w: (list.width - Metrics.vh * 0.052) * 0.38;
                    focused: on-sources && !on-filter && !filter-open && i == source-focus;
                }
            }
        }

        if filter-open: Rectangle {
            x: panel-pad;
            y: panel-pad + Metrics.vh * 0.052 + Metrics.vh * 0.006;
            width: parent.width - panel-pad * 2;
            height: providers.length * Metrics.vh * 0.052 + Metrics.vh * 0.012;
            border-radius: Metrics.vh * 0.008;
            background: #141a29;
            border-width: 1px;
            border-color: #ffffff1f;

            VerticalLayout {
                x: 0;
                y: Metrics.vh * 0.006;
                width: 100%;
                spacing: 0px;
                alignment: start;

                for name[i] in providers: Rectangle {
                    height: Metrics.vh * 0.052;
                    background: i == filter-focus ? #ffffff1f : transparent;

                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        padding-left: Metrics.vh * 0.016;
                        padding-right: Metrics.vh * 0.016;

                        Text {
                            text: name;
                            color: Theme.text;
                            font-size: Metrics.vh * 0.018;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                            horizontal-stretch: 1;
                        }
                        // Which one the column is showing.
                        Rectangle {
                            width: Metrics.vh * 0.01;
                            height: 100%;

                            if i == provider: Rectangle {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                width: Metrics.vh * 0.01;
                                height: Metrics.vh * 0.01;
                                border-radius: self.height / 2;
                                background: #6fd97f;
                            }
                        }
                    }
                }
            }
        }
    }
}
