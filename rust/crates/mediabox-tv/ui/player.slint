import { Theme, Metrics } from "theme.slint";
// The subtitle face: Stremio's own (stremio-core `subtitles_font: "Roboto"`),
// carried in the binary so a board draws it whatever fonts it has, in the four
// styles a subtitle file can ask for. Apache 2.0, ui/fonts/Roboto-LICENSE.txt.
import "fonts/Roboto-Regular.ttf";
import "fonts/Roboto-Italic.ttf";
import "fonts/Roboto-Bold.ttf";
import "fonts/Roboto-BoldItalic.ttf";

// One stretch of a subtitle line in one style: an SRT's <i> -- a voice off
// screen, a song, a thought -- is a stretch of its own.
export struct CaptionRun {
    text: string,
    italic: bool,
    bold: bool,
}

// One line of the subtitle on screen, as the file broke it.
export struct CaptionLine {
    runs: [CaptionRun],
}

// How the subtitle looks: "Filmler ve Diziler > Ayarlar > Altyazı", set from
// Rust (`prefs.rs`). Every default is the subtitle as it was drawn before
// there was a choice -- 4 % of the panel's short side, white, a black outline
// 5 % of the letter, nothing behind it, its last line 5 % above the bottom --
// so a box that never opened the screen draws exactly what it drew.
export global CaptionStyle {
    in property <float> scale: 1.0;
    in property <color> ink: #ffffff;
    // The outline, as a fraction of the letter's size; 0 is none.
    in property <float> edge: 0.05;
    // A band behind each line, when there is one.
    in property <bool> banded: false;
    in property <color> band: #00000000;
    // How far above the bottom of the picture the last line sits.
    in property <float> lift: 0.05;
}

// One stretch of a subtitle, white with a black outline.
//
// The outline is Stremio's own (stremio-video `withHTMLSubtitles`): the text
// eight times in black, moved a little in each direction, under the text in
// white. Not a `stroke`: femtovg draws a stroked text as paths, glyph by
// glyph, and on the board that path left white spikes off the letters -- the
// junction of an "h", the foot of an "H". Every one of these nine is drawn the
// way any text on the interface is, from the glyph atlas.
component CaptionStretch {
    in property <string> text;
    in property <bool> italic;
    in property <bool> bold;
    in property <length> size;
    // Stremio's 0.15rem against a 4vmin line: about 5 % of the letter, by
    // default (`CaptionStyle.edge`).
    property <length> o: max(1px, self.size * CaptionStyle.edge);
    preferred-width: face.preferred-width;
    preferred-height: face.preferred-height;
    min-width: face.preferred-width;
    min-height: face.preferred-height;

    if CaptionStyle.edge > 0: Rectangle {
        for d in [
            { x: -1, y: -1 }, { x: 0, y: -1 }, { x: 1, y: -1 }, { x: -1, y: 0 },
            { x: 1, y: 0 }, { x: -1, y: 1 }, { x: 0, y: 1 }, { x: 1, y: 1 },
        ]: Text {
            x: d.x * root.o;
            y: d.y * root.o;
            text: root.text;
            font-family: "Roboto";
            font-size: root.size;
            font-italic: root.italic;
            font-weight: root.bold ? 700 : 400;
            color: #000000;
            wrap: no-wrap;
        }
    }

    face := Text {
        x: 0;
        y: 0;
        text: root.text;
        font-family: "Roboto";
        font-size: root.size;
        font-italic: root.italic;
        font-weight: root.bold ? 700 : 400;
        color: CaptionStyle.ink;
        wrap: no-wrap;
    }
}

// The subtitle's lines over a picture `frame-w` by `frame-h`: the film's
// own panel, or the settings screen's preview of it, drawn by the same
// element so the preview is what the film will show, at its scale.
export component CaptionBlock inherits VerticalLayout {
    in property <[CaptionLine]> lines;
    in property <length> frame-w;
    in property <length> frame-h;
    property <length> size: min(frame-w, frame-h) * 0.04 * CaptionStyle.scale;
    property <length> pad-x: CaptionStyle.banded ? size * 0.3 : 0px;
    property <length> pad-y: CaptionStyle.banded ? size * 0.06 : 0px;

    for line in lines: HorizontalLayout {
        alignment: center;
        Rectangle {
            background: CaptionStyle.banded ? CaptionStyle.band : transparent;
            border-radius: CaptionStyle.banded ? root.size * 0.12 : 0px;
            HorizontalLayout {
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                padding-top: root.pad-y;
                padding-bottom: root.pad-y;
                for run in line.runs: CaptionStretch {
                    text: run.text;
                    italic: run.italic;
                    bold: run.bold;
                    size: root.size;
                }
            }
        }
    }
}

// One row of an open panel: what it is, what else is known about it, and
// whether it is the one in use.
export struct MenuRow {
    label: string,
    detail: string,
    active: bool,
}

// One button of the row along the bottom of a film.
//
// Two layers, because the reference's marks are two: a filled shape and a
// drawn line. Either may be empty — a play triangle is only a fill, an expand
// arrow is only a line, a television with a picture in it is both.
component FilmButton inherits Rectangle {
    in property <string> fill;
    in property <string> line;
    in property <bool> focused;

    property <length> size: Metrics.vh * 0.030;

    width: size * 2.1;
    height: size * 2.1;
    border-radius: Metrics.vh * 0.012;
    // The focus is the reference's own: a white rounded square under the mark,
    // and the mark itself turns to the ground colour inside it.
    background: focused ? #ffffff : transparent;

    animate background { duration: Theme.focus-in; easing: Theme.ease; }

    if fill != "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: size;
        height: size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: fill;
        fill: focused ? #05070c : #ffffff;
    }
    if line != "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: size;
        height: size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: line;
        fill: transparent;
        stroke: focused ? #05070c : #ffffff;
        stroke-width: size / 11;
    }
}

// The line along the bottom of a film.
//
// Measured off the reference this appliance is held to — Stremio's own Android
// player, photographed on the television and read off at 3840x2160: the film's
// name at 81.5% of the height, the position line at 87.2%, the row of marks at
// 93.7%, and the two times on the right of it. Nothing here is invented and
// nothing is a box: the film is underneath and the less of this there is, the
// more of the film there is.
//
// The line is also the control. Left and Right on it move a tick that
// accelerates the longer they are held — ten seconds a press at first, ten
// minutes a press after a second and a half — and Ok goes there.
export component Player inherits Rectangle {
    in property <string> title;
    in property <string> note;
    /// Non-empty while the film is opening, before there is a single frame.
    ///
    /// Not drawn as words any more — the opening screen below is a picture —
    /// but still a string, because it is set and cleared on the Rust side and
    /// what it says is worth having in a log. The controls are closed at
    /// exactly the moment it matters, which is why the screen it drives sits
    /// outside them.
    in property <string> waiting;
    /// The film's backdrop and its name as a picture, for the opening screen.
    /// Either may be empty; see the fallback below.
    in property <image> art;
    in property <image> logo;
    in property <string> elapsed;
    in property <string> duration;
    in property <float> progress;
    /// The row's marks, as two layers each; see FilmButton.
    in property <[string]> marks;
    in property <[string]> lines;
    /// Where a hairline goes, as an index in `marks` to draw one after.
    in property <[int]> rules;
    in property <int> focus-index;
    /// 0 = the line, 1 = the marks. Named `lane` because a Rectangle already
    /// has a `row`, which belongs to a grid.
    in property <int> lane;
    /// The time the tick is sitting on, while it is being moved.
    in property <string> scrub;
    /// Whether the controls are up at all.
    in property <bool> open;

    /// "" | "subtitles" | "audio" | "speed" | "player"
    in property <string> menu;
    in property <string> menu-title;
    in property <[MenuRow]> menu-rows;
    /// The tracks the highlighted language has, as the reference's second
    /// column.
    in property <[MenuRow]> menu-tracks;
    in property <int> menu-focus;
    in property <int> menu-track-focus;
    in property <int> menu-column;
    in property <string> menu-side-label;
    in property <string> menu-side-value;
    /// What the scale button last did, named under the picture for a moment;
    /// also where an automatic subtitle timing says it has been put on.
    in property <string> pill;
    /// The subtitle line on screen now. The player hands its frames to this
    /// interface and draws nothing itself, so the line is drawn here.
    in property <string> caption;
    /// The same, line by line and styled.
    in property <[CaptionLine]> caption-lines;
    /// How the subtitle that is on was timed, under the delay on the
    /// subtitle panel: "Otomatik eşitleme · +1,82 sn · %97".
    in property <string> menu-note;
    /// The language column goes on above or below the rows drawn.
    in property <bool> menu-above;
    in property <bool> menu-below;

    background: transparent;

    property <length> pad: max(Metrics.gutter, root.width * 0.036);
    property <bool> on-line: lane == 0;
    property <length> mark-gap: root.width * 0.0443;

    // Enough shadow under the row to read it on a bright frame, and not a
    // pixel more.
    Rectangle {
        x: 0;
        y: root.height - self.height;
        width: 100%;
        height: root.height * 0.30;
        opacity: open ? 1.0 : 0.0;
        background: @linear-gradient(180deg, #00000000 0%, #000000bf 58%, #000000f2 100%);
        animate opacity { duration: Theme.glide; easing: Theme.ease; }
    }

    // The film is opening.
    //
    // Measured off the reference frame by frame, on its own box, with the
    // press sent from the outside so the clock starts on a known millisecond:
    // from the press there is 6.5 s with no picture in it, and the reference
    // spends all of it on the film itself. The panel is the film's own
    // backdrop at full strength with the title's logo beating in the middle.
    // No spinner, no percentage and no sentence anywhere.
    //
    // The beat is the part worth copying exactly. Its period measured 0.75 s
    // across nine cycles (0.745 s peak to peak, 0.754 s trough to trough),
    // which is eighty to the minute — a heartbeat rather than a blinking
    // light — and the logo's brightness swings to about a fifth at the bottom
    // of it. It stops the instant the first frame lands, because that is when
    // `waiting` is cleared.
    //
    // A film whose catalogue entry has no logo falls back to its name, in the
    // same place and beating the same way, so the screen is never blank.
    if waiting != "": opening := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000;

        property <bool> beat: false;
        init => { self.beat = true; }
        // Half a period each way.
        Timer {
            interval: 375ms;
            running: true;
            triggered => { opening.beat = !opening.beat; }
        }

        Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: root.art;
            image-fit: cover;
        }

        if root.logo.width > 0: Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.width * 0.18;
            height: root.height * 0.14;
            source: root.logo;
            image-fit: contain;
            opacity: opening.beat ? 1.0 : 0.2;
            animate opacity { duration: 375ms; easing: ease-in-out; }
        }
        if root.logo.width <= 0 && root.title != "": Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 100%;
            horizontal-alignment: center;
            text: root.title;
            color: #ffffff;
            font-size: Metrics.vh * 0.052;
            font-weight: 800;
            opacity: opening.beat ? 1.0 : 0.2;
            animate opacity { duration: 375ms; easing: ease-in-out; }
        }
    }

    // The subtitle, the way Stremio draws it (stremio-video
    // `withHTMLSubtitles`, stremio-core's default settings): Roboto at its
    // regular weight, 4 % of the panel's short side, white with a black
    // outline and no band behind it, its bottom 5 % above the picture's
    // edge; lines as the file broke them, each stretch in its own style.
    // Kodi's defaults are the same shape (an outlined face, no box, 4.95 %
    // up). Above the row while the controls are up. Each of those is a
    // default the viewer can change (`CaptionStyle`); the pill and the row
    // still push it up by what they always did.
    if caption != "" && waiting == "": CaptionBlock {
        property <float> bottom: 1 - CaptionStyle.lift;
        x: root.width * 0.05;
        width: root.width * 0.9;
        // As tall as its lines: outside a layout it would be the whole
        // panel, and its lines would sit off the bottom of it.
        height: self.preferred-height;
        y: (open ? root.height * min(0.76, bottom) : pill != "" ? root.height * (bottom - 0.06) : root.height * bottom) - self.height;
        frame-w: root.width;
        frame-h: root.height;
        lines: caption-lines;
    }

    if open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;

        // ---------------------------------------------------------- the name
        Text {
            x: pad;
            y: root.height * 0.805;
            text: note != "" ? note : title;
            color: note != "" ? Theme.film : #ffffffde;
            font-size: Metrics.vh * 0.021;
            font-weight: 600;
            wrap: no-wrap;
            overflow: elide;
            width: root.width * 0.6;
        }

        // ---------------------------------------------------------- the line
        line := Rectangle {
            x: pad;
            y: root.height * 0.872;
            width: root.width - pad * 2;
            height: Metrics.vh * 0.004;
            border-radius: self.height / 2;
            background: #ffffff3d;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * clamp(progress, 0.0, 1.0);
                height: 100%;
                border-radius: self.height / 2;
                background: Theme.film;
            }
        }

        // The knob. The reference carries one and it is how a position is read
        // at a glance from across a room; it grows when the line has the
        // remote, because then it is a control and not a reading.
        Rectangle {
            x: line.x + line.width * clamp(progress, 0.0, 1.0) - self.width / 2;
            y: line.y + line.height / 2 - self.height / 2;
            width: root.on-line ? Metrics.vh * 0.028 : Metrics.vh * 0.019;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.film;
            animate width { duration: Theme.focus-in; easing: Theme.ease; }
        }

        // --------------------------------------------------------- the marks
        for mark[i] in marks: FilmButton {
            x: pad - self.width / 2 + i * mark-gap;
            y: root.height * 0.937 - self.height / 2;
            fill: mark;
            line: lines[i];
            focused: !root.on-line && i == focus-index;
        }

        // The hairlines between the groups.
        for at[r] in rules: Rectangle {
            x: pad - self.width / 2 + at * mark-gap + mark-gap / 2;
            y: root.height * 0.937 - self.height / 2;
            width: 2px;
            height: Metrics.vh * 0.026;
            background: #ffffff4d;
        }

        // ---------------------------------------------------------- the time
        //
        // One reading, the reference's own: where the film is and how long it
        // is, with a slash between them. While a scrub is running the first of
        // the two is the scrub's time, because that is what the viewer is
        // moving and what they are looking at.
        Text {
            x: root.width - pad - self.width;
            y: root.height * 0.937 - self.height / 2;
            text: (scrub != "" ? scrub : elapsed) + "  /  " + duration;
            color: scrub != "" ? Theme.film : #ffffffde;
            font-size: Metrics.vh * 0.021;
            font-weight: 600;
            vertical-alignment: center;
            height: Metrics.vh * 0.08;
            wrap: no-wrap;
        }
    }

    // What the scale button last did, or that a subtitle's timing was put
    // right. Outside the controls, so the second is said for a moment even
    // while nobody is looking at the row.
    if pill != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height * 0.937 - self.height / 2;
        width: pill-text.preferred-width + Metrics.vh * 0.06;
        height: Metrics.vh * 0.05;
        border-radius: self.height / 2;
        background: #1c1f28e6;

        HorizontalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            padding-left: Metrics.vh * 0.012;
            padding-right: Metrics.vh * 0.02;
            spacing: Metrics.vh * 0.01;
            alignment: center;

            Rectangle {
                width: Metrics.vh * 0.028;
                height: Metrics.vh * 0.028;
                y: (parent.height - self.height) / 2;
                border-radius: Metrics.vh * 0.006;
                background: Theme.film;

                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Metrics.vh * 0.016;
                    height: Metrics.vh * 0.016;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M8 5l11.5 7L8 19z";
                    fill: #ffffff;
                }
            }
            pill-text := Text {
                text: pill;
                color: #ffffff;
                font-size: Metrics.vh * 0.019;
                font-weight: 600;
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }
    }

    // ---------------------------------------------------------- the panels
    //
    // One shape for all four, the reference's own: a dark rounded sheet over
    // the picture with its name in the corner, the list down it, and — on the
    // two panels that have one — the delay beside the list.
    if menu != "": Rectangle {
        x: menu == "speed" ? (root.width - self.width) / 2 : root.width * 0.15;
        y: (root.height - self.height) / 2;
        width: menu == "speed" ? root.width * 0.25 : root.width * 0.7;
        height: min(root.height * 0.74,
                    Metrics.vh * 0.1
                        + max(menu-rows.length, menu-tracks.length) * Metrics.vh * 0.058);
        border-radius: Metrics.vh * 0.016;
        background: #10121be8;
        clip: true;

        Text {
            x: Metrics.vh * 0.03;
            y: Metrics.vh * 0.028;
            text: menu-title;
            color: #ffffff;
            font-size: Metrics.vh * 0.024;
            font-weight: 700;
        }

        property <bool> grouped: menu == "subtitles" || menu == "audio" || menu == "settings";
        // The settings panel's second column is the settings themselves, each
        // with what it is set to: wider than a column of tracks.
        property <bool> sectioned: menu == "settings";

        // More of the list above or below: a small mark at the column's
        // edge, the way a television list says it scrolls.
        if menu-above: Path {
            x: Metrics.vh * 0.03 + (grouped ? parent.width * 0.28 : parent.width - Metrics.vh * 0.06) / 2 - self.width / 2;
            y: Metrics.vh * 0.066;
            width: Metrics.vh * 0.02;
            height: Metrics.vh * 0.012;
            viewbox-width: 24;
            viewbox-height: 14;
            commands: "M2 12L12 2l10 10";
            fill: transparent;
            stroke: #ffffff80;
            stroke-width: 2px;
        }
        if menu-below: Path {
            x: Metrics.vh * 0.03 + (grouped ? parent.width * 0.28 : parent.width - Metrics.vh * 0.06) / 2 - self.width / 2;
            y: parent.height - Metrics.vh * 0.022;
            width: Metrics.vh * 0.02;
            height: Metrics.vh * 0.012;
            viewbox-width: 24;
            viewbox-height: 14;
            commands: "M2 2l10 10L22 2";
            fill: transparent;
            stroke: #ffffff80;
            stroke-width: 2px;
        }

        // The languages.
        VerticalLayout {
            x: Metrics.vh * 0.03;
            y: Metrics.vh * 0.085;
            width: grouped ? parent.width * 0.28 : parent.width - Metrics.vh * 0.06;
            spacing: 0px;
            alignment: start;

            for entry[i] in menu-rows: Rectangle {
                height: Metrics.vh * 0.058;
                border-radius: Metrics.vh * 0.008;
                background: (menu-column == 0 && i == menu-focus) ? #ffffff1f : transparent;

                HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    padding-left: Metrics.vh * 0.014;
                    padding-right: Metrics.vh * 0.014;

                    Text {
                        text: entry.label;
                        color: entry.active ? Theme.film : #ffffff;
                        font-size: Metrics.vh * 0.019;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                        horizontal-stretch: 1;
                    }
                    // What a settings row is doing now: the film's frame
                    // rate and the mode it is on, the sound leaving the box.
                    if entry.detail != "" && !grouped: Text {
                        text: entry.detail;
                        color: #ffffff99;
                        font-size: Metrics.vh * 0.016;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                        wrap: no-wrap;
                        max-width: parent.width * 0.5;
                    }
                    Rectangle {
                        width: Metrics.vh * 0.028;
                        height: 100%;

                        if entry.active: Path {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: Metrics.vh * 0.024;
                            height: Metrics.vh * 0.024;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M4.6 12.4l4.8 4.8 10-10";
                            fill: transparent;
                            stroke: Theme.film;
                            stroke-width: 2.2px;
                        }
                    }
                }
            }
        }

        // What that language is carried by: one row a track, the reference's
        // own second column.
        if grouped: VerticalLayout {
            x: parent.width * 0.32;
            y: Metrics.vh * 0.085;
            width: sectioned ? parent.width * 0.68 - Metrics.vh * 0.03 : parent.width * 0.32;
            spacing: 0px;
            alignment: start;

            for entry[i] in menu-tracks: Rectangle {
                height: Metrics.vh * 0.058;
                border-radius: Metrics.vh * 0.008;
                background: (menu-column == 1 && i == menu-track-focus) ? #ffffff1f : transparent;

                HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    padding-left: Metrics.vh * 0.014;
                    padding-right: Metrics.vh * 0.014;

                    Text {
                        text: entry.label;
                        color: entry.active ? Theme.film : #ffffffde;
                        font-size: Metrics.vh * 0.019;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                        horizontal-stretch: 1;
                    }
                    // What the setting is set to: "Açık", "Türkçe",
                    // "24 fps → 3840x2160p24".
                    if sectioned && entry.detail != "": Text {
                        text: entry.detail;
                        color: #ffffff99;
                        font-size: Metrics.vh * 0.016;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                        wrap: no-wrap;
                        max-width: parent.width * 0.55;
                    }
                    Rectangle {
                        width: Metrics.vh * 0.028;
                        height: 100%;

                        if entry.active: Path {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: Metrics.vh * 0.024;
                            height: Metrics.vh * 0.024;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M4.6 12.4l4.8 4.8 10-10";
                            fill: transparent;
                            stroke: Theme.film;
                            stroke-width: 2.2px;
                        }
                    }
                }
            }
        }

        if menu-note != "" && menu-side-label != "": Text {
            x: parent.width * 0.66 + Metrics.vh * 0.014;
            y: Metrics.vh * 0.085 + Metrics.vh * 0.066;
            width: parent.width * 0.3 - Metrics.vh * 0.028;
            text: menu-note;
            color: #ffffff99;
            font-size: Metrics.vh * 0.016;
            wrap: word-wrap;
        }

        // The delay, beside the list, on the panels that have one.
        if menu-side-label != "": Rectangle {
            x: parent.width * 0.66;
            y: Metrics.vh * 0.085;
            width: parent.width * 0.3;
            height: Metrics.vh * 0.058;
            border-radius: Metrics.vh * 0.008;
            background: menu-column == 2 ? #ffffff1f : transparent;

            HorizontalLayout {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                padding-left: Metrics.vh * 0.014;
                padding-right: Metrics.vh * 0.014;

                Text {
                    text: menu-side-label;
                    color: #ffffff;
                    font-size: Metrics.vh * 0.019;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: no-wrap;
                }
                Text {
                    text: menu-side-value;
                    color: menu-column == 2 ? Theme.film : #ffffffde;
                    font-size: Metrics.vh * 0.019;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    wrap: no-wrap;
                }
            }
        }
    }
}
