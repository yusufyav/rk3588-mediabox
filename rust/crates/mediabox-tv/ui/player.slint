import { Theme, Metrics } from "theme.slint";
import { NpControl } from "components.slint";

// What is drawn on top of a film.
//
// Not a screen. The display controller puts the film's window under this one
// and this surface carries alpha, so everything here is an overlay on a moving
// picture: the parts that are not drawn are the film. That is why there is no
// background, no wallpaper and no bar — a film with a home screen behind its
// letterbox is what this replaced.
//
// It appears when a key is pressed and goes away by itself, the way it does on
// every other television: a viewer who is watching should be watching.
export component Player inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> note;
    in property <string> elapsed;
    in property <string> duration;
    in property <float> progress;
    in property <[NpControl]> controls;
    in property <int> focus-index;
    /// Whether the controls are up. False is the ordinary state of a film.
    in property <bool> open;

    background: transparent;

    // The film is bright and white text on it is unreadable without something
    // between. Only under the controls, and only while they are up.
    Rectangle {
        y: root.height - self.height;
        width: 100%;
        height: root.height * 0.42;
        opacity: open ? 1.0 : 0.0;
        background: @linear-gradient(180deg,
            #00000000 0%, #0000007a 42%, #000000d6 78%, #000000ee 100%);
        animate opacity { duration: Theme.glide; easing: Theme.ease; }
    }

    // Every side named against the root rather than against itself: a
    // geometry binding that reads its own preferred size is a cycle, and Slint
    // resolves a cycle to zero — which is a control bar that is drawn, is
    // reported as drawn, and has no height.
    VerticalLayout {
        x: Metrics.gutter;
        width: root.width - Metrics.gutter * 2;
        y: root.height * 0.60;
        height: root.height * 0.40 - Metrics.gutter;
        spacing: Metrics.root-font * 0.55;
        alignment: end;
        opacity: open ? 1.0 : 0.0;
        // Out of the way when it is down, so a stray focus ring cannot sit on
        // a film for an hour.
        visible: open;

        animate opacity { duration: Theme.glide; easing: Theme.ease; }

        Text {
            text: title == "" ? "MediaBox" : title;
            color: Theme.text;
            font-size: Metrics.title-screen * 0.72;
            font-weight: 820;
            letter-spacing: -0.03 * Metrics.title-screen;
            wrap: no-wrap;
            overflow: elide;
        }

        if subtitle != "" || note != "": Text {
            text: note != "" ? note : subtitle;
            color: note != "" ? Theme.accent : Theme.muted;
            font-size: Metrics.text-meta * 0.9;
            font-weight: 680;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: Metrics.root-font * 0.8;
            height: Metrics.root-font * 1.6;

            Text {
                text: elapsed;
                color: Theme.text;
                font-size: Metrics.text-label;
                font-weight: 700;
                vertical-alignment: center;
                width: Metrics.root-font * 4.2;
            }

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: #ffffff33;
                clip: true;
                horizontal-stretch: 1;

                Rectangle {
                    x: 0;
                    width: parent.width * clamp(progress, 0.0, 1.0);
                    height: 100%;
                    background: Theme.accent;
                    animate width { duration: Theme.glide; easing: Theme.ease; }
                }
            }

            Text {
                text: duration;
                color: Theme.muted;
                font-size: Metrics.text-label;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: Metrics.root-font * 4.2;
            }
        }

        HorizontalLayout {
            spacing: Metrics.root-font * 0.7;
            alignment: start;

            for control[i] in controls: Rectangle {
                property <bool> focused: i == focus-index;
                width: max(Metrics.card-w * 0.5, caption.preferred-width + Metrics.root-font * 1.4);
                height: Metrics.card-w * 0.36;
                border-radius: Theme.radius;
                background: focused ? Theme.focus-fill : #00000099;
                border-width: focused ? 2px : 1px;
                border-color: focused ? Theme.focus-ring : #ffffff2e;

                animate background { duration: Theme.focus-in; easing: Theme.ease; }

                VerticalLayout {
                    alignment: center;
                    spacing: Metrics.text-chip * 0.4;

                    Rectangle {
                        height: Metrics.root-font * 1.3;
                        Path {
                            x: (parent.width - self.width) / 2;
                            width: Metrics.root-font * 1.3;
                            height: 100%;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: control.mark;
                            fill: focused ? #0a0c10 : Theme.text;
                        }
                    }
                    caption := Text {
                        text: control.label;
                        color: focused ? #0a0c10 : Theme.text;
                        font-size: Metrics.text-chip;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }
}
