import { Theme, Metrics } from "theme.slint";

// The line along the bottom of a film.
//
// Not a panel and not a card. The display controller puts the film's window
// under this one and this surface carries alpha, so anything drawn here sits on
// a moving picture — and the less of it there is, the more of the film there
// is. So: one hairline rule across the width, the position set large above its
// left end, the film's name above that, and the actions as words underneath.
// No box, no buttons, no transport glyphs. What marks the focus is a filled
// block in front of the word, the way the rest of this interface marks a row.
//
// The rule is also the control. Left and Right on it move a tick that
// accelerates the longer they are held — ten seconds a press at first, ten
// minutes a press after a second and a half — and Ok goes there. Four buttons
// that move a film thirty seconds at a time cannot reach the middle of a two
// hour one, which is what this replaced.
export component Player inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> note;
    in property <string> elapsed;
    in property <string> duration;
    in property <float> progress;
    in property <[string]> actions;
    in property <int> focus-index;
    /// 0 = the rule, 1 = the words. Named `lane` because a Rectangle
    /// already has a `row`, which belongs to a grid.
    in property <int> lane;
    /// The time the tick is sitting on, while it is being moved.
    in property <string> scrub;
    /// Whether the controls are up at all.
    in property <bool> open;

    background: transparent;

    property <length> pad: Metrics.gutter;
    property <bool> on-rule: lane == 0;

    // Enough shadow under the words to read them on a bright frame, and not a
    // pixel more. It stops well above the rule so the picture is not boxed in.
    Rectangle {
        y: root.height - self.height;
        width: 100%;
        height: root.height * 0.34;
        opacity: open ? 1.0 : 0.0;
        background: @linear-gradient(180deg, #00000000 0%, #000000b0 62%, #000000e6 100%);
        animate opacity { duration: Theme.glide; easing: Theme.ease; }
    }

    if open: Rectangle {
        x: root.pad;
        y: root.height * 0.70;
        width: root.width - root.pad * 2;
        height: root.height * 0.30 - root.pad * 0.6;

        // ---------------------------------------------------------- the name
        Text {
            x: 0;
            y: 0;
            text: title;
            color: Theme.muted;
            font-size: Metrics.text-label;
            font-weight: 760;
            letter-spacing: 0.14 * Metrics.text-label;
            wrap: no-wrap;
            overflow: elide;
            width: parent.width * 0.7;
        }

        if note != "" || subtitle != "": Text {
            x: parent.width - self.width;
            y: 0;
            text: note != "" ? note : subtitle;
            color: note != "" ? Theme.accent : Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 760;
            letter-spacing: 0.14 * Metrics.text-label;
            horizontal-alignment: right;
            wrap: no-wrap;
            width: parent.width * 0.3;
        }

        // ------------------------------------------------------- the reading
        //
        // The position is the biggest thing on the screen after the film. It is
        // what somebody looks at when they press a key, and it is also what the
        // tick is being moved towards, so while a scrub is running this is the
        // scrub's own time and the film's time goes small beside it.
        clock := Text {
            x: 0;
            y: parent.height * 0.20;
            text: scrub != "" ? scrub : elapsed;
            color: scrub != "" ? Theme.accent : Theme.text;
            font-size: Metrics.title-screen * 0.82;
            font-weight: 840;
            letter-spacing: -0.035 * Metrics.title-screen;
        }

        if scrub != "": Text {
            x: clock.width + Metrics.root-font * 0.7;
            y: parent.height * 0.20 + Metrics.title-screen * 0.36;
            text: elapsed;
            color: Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 700;
        }

        Text {
            x: parent.width - self.width;
            y: parent.height * 0.20 + Metrics.title-screen * 0.36;
            text: duration;
            color: Theme.dim;
            font-size: Metrics.text-label;
            font-weight: 700;
            horizontal-alignment: right;
        }

        // ---------------------------------------------------------- the rule
        rule := Rectangle {
            x: 0;
            y: parent.height * 0.62;
            width: parent.width;
            height: 2px;
            background: #ffffff2b;

            Rectangle {
                x: 0;
                width: parent.width * clamp(progress, 0.0, 1.0);
                height: 100%;
                background: root.on-rule ? Theme.accent : #ffffff7a;
                animate background { duration: Theme.focus-in; easing: Theme.ease; }
            }
        }

        // The tick. It rises out of the rule rather than sitting on it, and it
        // is a straight edge: everything else in this interface is rounded, so
        // the one thing that has to be read as a position is not.
        Rectangle {
            x: rule.x + rule.width * clamp(progress, 0.0, 1.0) - self.width / 2;
            y: rule.y - (root.on-rule ? Metrics.root-font * 0.62 : Metrics.root-font * 0.30);
            width: root.on-rule ? 4px : 2px;
            height: root.on-rule ? Metrics.root-font * 1.5 : Metrics.root-font * 0.8;
            background: root.on-rule ? Theme.accent : #ffffffb0;
            animate height, width, y { duration: Theme.focus-in; easing: Theme.ease; }
        }

        // --------------------------------------------------------- the words
        HorizontalLayout {
            x: 0;
            y: parent.height * 0.62 + Metrics.root-font * 1.1;
            height: Metrics.root-font * 1.7;
            spacing: Metrics.root-font * 1.6;
            alignment: start;

            for label[i] in actions: HorizontalLayout {
                property <bool> focused: !root.on-rule && i == focus-index;
                spacing: Metrics.text-chip * 0.6;

                // The mark is the interface's own: a filled block, the same one
                // that runs down the left of a focused row elsewhere.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Metrics.text-chip * 0.34;
                    height: focused ? Metrics.text-chip * 1.05 : 0px;
                    background: Theme.accent;
                    animate height { duration: Theme.focus-in; easing: Theme.ease; }
                }

                Text {
                    text: label;
                    color: focused ? Theme.text : Theme.muted;
                    font-size: Metrics.text-chip * 1.15;
                    font-weight: focused ? 820 : 680;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }
    }
}
