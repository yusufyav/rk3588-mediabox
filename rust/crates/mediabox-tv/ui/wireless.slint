import { Theme, Metrics } from "theme.slint";
import { KeyRow, KeyCap, Keyboard, VitalsModel } from "components.slint";
import {
    SettingCard, SectionHeader, PageHeader, SideNav, StatusCorner, Backdrop, FocusRing, Icon,
} from "kit.slint";

// One network in the Wi-Fi list.
export struct WifiRow {
    ssid: string,
    // 1 to 4. A number in dBm is not something anyone should have to read
    // from a sofa.
    bars: int,
    secured: bool,
    remembered: bool,
    connected: bool,
}

// One device in the Bluetooth list.
export struct BtRow {
    name: string,
    // Under the name: what it is, or -- on the focused row -- what Ok does.
    under: string,
    connected: bool,
    // The heading this row opens ("Eşleşmiş aygıtlar"), "" when it continues
    // one; and how many headings come before it, so it is placed by
    // arithmetic.
    header: string,
    n-header: int,
}

// Four bars, as many lit as the signal earns.
component Bars inherits Rectangle {
    in property <int> bars;
    in property <bool> focused;
    property <length> w: Metrics.t-secondary * 0.24;
    property <length> gap: w * 0.65;
    width: w * 4 + gap * 3;
    height: Metrics.t-secondary * 1.05;

    for step[i] in [1, 2, 3, 4]: Rectangle {
        x: i * (w + gap);
        width: w;
        height: parent.height * (0.28 + 0.24 * i);
        y: parent.height - self.height;
        border-radius: w / 2;
        background: step <= bars ? (focused ? Theme.text : #d6dae2) : #ffffff26;
    }
}

// A network or a device, in the settings' own card: its name, a line under
// it when there is one, and on the right what it is now.
component RadioCard inherits Rectangle {
    in property <bool> focused;
    in property <string> title;
    in property <string> under;
    in property <string> status;
    in property <bool> lock;
    in property <int> bars: -1;

    height: under == "" ? Metrics.set-h-flat : Metrics.set-h;
    border-radius: Metrics.s-radius;
    background: focused ? Theme.s-card-hi : Theme.s-card;
    border-width: 1px;
    border-color: focused ? transparent : Theme.s-line;
    animate background { duration: Theme.t-focus; easing: Theme.ease; }

    HorizontalLayout {
        padding-left: Metrics.card-pad;
        padding-right: Metrics.card-pad;
        spacing: Metrics.card-pad * 0.75;

        VerticalLayout {
            alignment: center;
            spacing: Metrics.t-primary * 0.12;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: title;
                color: focused ? #ffffff : Theme.text;
                font-size: Metrics.t-primary;
                font-weight: focused ? 650 : 600;
                overflow: elide;
                wrap: no-wrap;
            }
            if under != "": Text {
                text: under;
                color: focused ? #b9bfcb : Theme.muted;
                font-size: Metrics.t-secondary;
                font-weight: 500;
                overflow: elide;
                wrap: no-wrap;
            }
        }
        if status != "": VerticalLayout {
            alignment: center;
            Text {
                text: status;
                color: Theme.ok;
                font-size: Metrics.t-secondary;
                font-weight: 600;
                wrap: no-wrap;
            }
        }
        if lock: VerticalLayout {
            alignment: center;
            Icon {
                name: "lock";
                size: Metrics.icon * 0.85;
                ink: focused ? Theme.text : Theme.muted;
            }
        }
        if bars >= 0: VerticalLayout {
            alignment: center;
            Bars {
                bars: bars;
                focused: focused;
            }
        }
    }

    FocusRing {
        width: 100%;
        height: 100%;
        on: focused;
    }
}

// The settings' frame around a radio's list: the column with the way back,
// the heading, the clock in the corner.
component Frame inherits Rectangle {
    in property <string> page;
    in property <string> page-icon;
    in property <string> title;
    in property <string> blurb;
    in property <VitalsModel> vitals;

    Backdrop {
        width: 100%;
        height: 100%;
    }
    SideNav {
        x: 0;
        y: 0;
        width: Metrics.safe-x + Metrics.nav-w + Metrics.safe-x * 0.5;
        height: root.height;
        items: [];
        current: 0;
        active: false;
        parent-label: "Bağlantılar";
        page-label: root.page;
        page-icon: root.page-icon;
    }
    StatusCorner {
        x: root.width - Metrics.safe-x - self.width;
        y: Metrics.safe-y;
        width: self.preferred-width;
        height: Metrics.t-nav-head * 2.6;
        network: vitals.network;
        time: vitals.time;
    }
    PageHeader {
        x: Metrics.pane-x;
        y: Metrics.safe-y + Metrics.t-nav-head * 0.5;
        width: Metrics.pane-w * 0.68;
        title: root.title;
        blurb: root.blurb;
    }
    @children
}

export component WifiScreen inherits Rectangle {
    /// False until the daemon has answered once. Nothing below states a fact
    /// about the radio while this is false.
    in property <bool> known;
    in property <bool> present;
    in property <bool> powered;
    in property <string> summary;
    in property <[WifiRow]> networks;
    in property <int> index;
    in property <bool> busy;
    /// Busy *with a scan*, as opposed to a join or a power switch.
    in property <bool> scanning;
    in property <string> notice;
    in property <VitalsModel> vitals;

    // "list" | "password"
    in property <string> face;
    in property <string> target;
    in property <string> password-mask;
    in property <bool> show;
    // "field" | "keys" | "join"
    in property <string> focus-at;
    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> step: Metrics.set-h-flat + Metrics.row-gap;
    property <length> lead: step * 2 + Metrics.header-h;

    background: Theme.s-ground;
    clip: true;

    if face == "list": Frame {
        width: 100%;
        height: 100%;
        page: "Wi-Fi";
        page-icon: "wifi";
        title: "Wi-Fi";
        blurb: notice != "" ? notice : summary;
        vitals: root.vitals;

        Rectangle {
            property <length> pad: Metrics.glow-w * 3;
            property <length> focus-y: index < 2 ? index * step : lead + (index - 2) * step;
            property <length> scroll: max(0px, focus-y + step + pad * 2 - self.height);

            x: Metrics.pane-x - pad;
            y: top - pad;
            width: Metrics.list-w + pad * 2;
            height: root.height - Metrics.safe-y - top + pad;
            clip: true;

            Rectangle {
                x: pad;
                y: pad - scroll;
                width: Metrics.list-w;
                animate y { duration: Theme.t-row; easing: Theme.ease; }

                SettingCard {
                    y: 0;
                    width: 100%;
                    label: "Wi-Fi";
                    kind: "action";
                    toggle: known && present ? (powered ? 1 : 0) : -1;
                    value: !known ? "…" : (present ? "" : "Bu kartta yok");
                    enabled: !known || present;
                    focused: index == 0;
                }
                SettingCard {
                    y: step;
                    width: 100%;
                    label: scanning ? "Aranıyor…" : "Ağları ara";
                    kind: "action";
                    enabled: !known || powered;
                    focused: index == 1;
                }
                SectionHeader {
                    y: step * 2;
                    width: 100%;
                    text: "Ağlar";
                }
                for row[i] in networks: RadioCard {
                    y: lead + i * step;
                    width: 100%;
                    title: row.ssid;
                    under: "";
                    status: row.connected ? "Bağlı" : "";
                    lock: row.secured;
                    bars: row.bars;
                    focused: index == i + 2;
                }
                if known && networks.length == 0 && !busy: Text {
                    y: lead + Metrics.row-gap;
                    text: powered ? "Ağ bulunamadı" : "Wi-Fi kapalı";
                    color: Theme.muted;
                    font-size: Metrics.t-secondary;
                }
            }
        }
    }

    if face == "password": VerticalLayout {
        padding: Metrics.gutter;
        // The shared bar draws the name of the screen; this clears it rather
        // than printing a second title underneath the first.
        padding-top: Metrics.topbar + Metrics.vh * 0.012;
        spacing: Metrics.vh * 0.016;

        if notice != "": Rectangle {
            height: Metrics.vh * 0.052;
            border-radius: Theme.radius * 0.5;
            background: #ffffff12;
            Text {
                text: notice;
                color: Theme.text;
                font-size: Metrics.text-chip;
                font-weight: 600;
            }
        }

        // --------------------------------------------------------- password
        //
        // One column, centred, everything in it the width of the grid. Laid
        // out full-bleed it put a full-width field and a full-width button
        // around a keyboard a third as wide, which read as three unrelated
        // things stacked up.
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
            width: Metrics.key-w * 10 + Metrics.key-gap * 9;
            alignment: center;
            spacing: Metrics.vh * 0.014;

            Text {
                text: target;
                color: Theme.text;
                font-size: Metrics.root-font * 1.25;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // The field and, beside it, the switch that turns the bullets
            // back into letters. Right from the field reaches it.
            HorizontalLayout {
                spacing: Metrics.vh * 0.012;
                height: Metrics.vh * 0.08;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius * 0.6;
                    background: focus-at == "field" ? Theme.focus-fill : #ffffff0f;
                    border-width: focus-at == "field" ? 2px : 1px;
                    border-color: focus-at == "field" ? Theme.focus-ring : Theme.line-soft;
                    HorizontalLayout {
                        padding-left: Metrics.vh * 0.02;
                        padding-right: Metrics.vh * 0.02;
                        Text {
                            vertical-alignment: center;
                            text: password-mask == "" ? "Parola" : password-mask;
                            color: focus-at == "field"
                                ? #0a0c10
                                : (password-mask == "" ? #ffffff66 : Theme.text);
                            font-size: Metrics.root-font * 1.1;
                            font-weight: 700;
                        }
                    }
                }

                Rectangle {
                    width: Metrics.vh * 0.22;
                    border-radius: Theme.radius * 0.6;
                    background: focus-at == "show" ? Theme.focus-fill : #ffffff0f;
                    border-width: focus-at == "show" ? 2px : 1px;
                    border-color: focus-at == "show" ? Theme.focus-ring : Theme.line-soft;
                    Text {
                        text: show ? "Gizle" : "Göster";
                        color: focus-at == "show" ? #0a0c10 : Theme.text;
                        font-size: Metrics.root-font * 0.95;
                        font-weight: 700;
                    }
                }
            }

            Keyboard {
                keys: root.keys;
                key-row: root.key-row;
                key-col: root.key-col;
                active: focus-at == "keys";
            }

            Rectangle {
                height: Metrics.vh * 0.075;
                border-radius: Theme.radius * 0.6;
                background: focus-at == "join" ? Theme.focus-fill : #ffffff0f;
                border-width: focus-at == "join" ? 2px : 1px;
                border-color: focus-at == "join" ? Theme.focus-ring : Theme.line-soft;
                Text {
                    text: busy ? "Bağlanıyor…" : "Bağlan";
                    color: focus-at == "join" ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.05;
                    font-weight: 700;
                }
            }
            }
        }
    }
}

export component BluetoothScreen inherits Rectangle {
    /// As on WifiScreen.
    in property <bool> known;
    in property <bool> present;
    in property <bool> powered;
    in property <string> summary;
    in property <[BtRow]> devices;
    in property <int> index;
    in property <bool> busy;
    in property <string> notice;
    in property <VitalsModel> vitals;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> flat: Metrics.set-h-flat + Metrics.row-gap;
    property <length> card: Metrics.set-h + Metrics.row-gap;

    pure function y-of(r: BtRow, i: int) -> length {
        return flat * 2 + (r.n-header + (r.header != "" ? 1 : 0)) * Metrics.header-h + i * card;
    }

    background: Theme.s-ground;
    clip: true;

    Frame {
        width: 100%;
        height: 100%;
        page: "Bluetooth";
        page-icon: "bluetooth";
        title: "Bluetooth";
        blurb: notice != "" ? notice : summary;
        vitals: root.vitals;

        Rectangle {
            property <length> pad: Metrics.glow-w * 3;
            property <length> focus-y: index < 2 ? index * flat
                : devices.length == 0 ? 0px : y-of(devices[index - 2], index - 2);
            property <length> scroll: max(0px, focus-y + card + pad * 2 - self.height);

            x: Metrics.pane-x - pad;
            y: top - pad;
            width: Metrics.list-w + pad * 2;
            height: root.height - Metrics.safe-y - top + pad;
            clip: true;

            Rectangle {
                x: pad;
                y: pad - scroll;
                width: Metrics.list-w;
                animate y { duration: Theme.t-row; easing: Theme.ease; }

                SettingCard {
                    y: 0;
                    width: 100%;
                    label: "Bluetooth";
                    kind: "action";
                    toggle: known && present ? (powered ? 1 : 0) : -1;
                    value: !known ? "…" : (present ? "" : "Bu kartta yok");
                    enabled: !known || present;
                    focused: index == 0;
                }
                SettingCard {
                    y: flat;
                    width: 100%;
                    label: busy ? "Aranıyor…" : "Aygıt ara";
                    kind: "action";
                    enabled: !known || powered;
                    focused: index == 1;
                }
                for row[i] in devices: Rectangle {
                    y: y-of(row, i) - (row.header != "" ? Metrics.header-h : 0px);
                    width: 100%;
                    height: (row.header != "" ? Metrics.header-h : 0px) + Metrics.set-h;

                    if row.header != "": SectionHeader {
                        y: 0;
                        width: 100%;
                        text: row.header;
                    }
                    RadioCard {
                        y: row.header != "" ? Metrics.header-h : 0px;
                        width: 100%;
                        height: Metrics.set-h;
                        title: row.name;
                        under: row.under;
                        status: row.connected ? "Bağlı" : "";
                        focused: index == i + 2;
                    }
                }
                if known && devices.length == 0 && !busy: Text {
                    y: flat * 2 + Metrics.row-gap;
                    text: powered ? "Aygıt yok" : "Bluetooth kapalı";
                    color: Theme.muted;
                    font-size: Metrics.t-secondary;
                }
            }
        }
    }
}
