import { Theme, Metrics } from "theme.slint";
import { Quiet } from "quiet/core.slint";
import { LivingFocus } from "quiet/materials.slint";
import { QuietFrame } from "quiet/settings.slint";
import { QuietGround } from "quiet/materials.slint";
import { SignalField, BluetoothField } from "quiet/instruments.slint";
import { KeyRow, KeyCap, Keyboard, VitalsModel } from "components.slint";
import { PointerTarget, PointerPanArea, PanState } from "pointer.slint";
import {
    SettingCard, SectionHeader, PageHeader, SideNav, StatusCorner, Backdrop, FocusRing, Icon,
    ActionButton, InfoLine, SettingNav,
} from "kit.slint";

// One row of the Wi-Fi list or of "Kayıtlı ağlar", top to bottom, in the
// order of Android's network_provider_settings.xml.
export struct WifiRow {
    // "toggle" | "card" | "note" | "header"
    kind: string,
    label: string,
    under: string,
    // 1 to 4, or -1 for none. A number in dBm is not something anyone should
    // have to read from a sofa.
    bars: int,
    secured: bool,
    on: bool,
    focused: bool,
    // "5GHz", "2.4/5GHz" beside the name.
    tag: string,
    // The (i) that opens the network's page, and whether the remote is on it.
    info: bool,
    info-focused: bool,
    // A glyph at the card's left: what a Bluetooth device is. "" for none.
    icon: string,
    // How many rows of each height come before this one, so it is placed by
    // arithmetic.
    flats: int,
    talls: int,
    notes: int,
    heads: int,
    // Its place among the rows the remote stops on, which is how a pointer
    // names it; -1 for a row the remote passes over.
    slot: int,
}

// A scan running: Android's indeterminate circular progress
// (progress_indeterminate_material). Each 1333 ms cycle the head of the arc
// runs ahead to three quarters of the circle in the first half and the tail
// catches it up in the second, the trim offset turning a quarter meanwhile;
// the whole ring turns 720 degrees every 4444 ms. Head and tail ease as
// fast-out-slow-in, drawn here as smoothstep.
//
// The arc is a child of the spinner's own box: Slint applies no transform to
// a component's root element, so a rotation set on a root Path was dropped
// (and said so at build time) and the ring never turned.
component Spinner inherits Rectangle {
    in property <length> size: Metrics.icon;
    in property <brush> ink: Theme.muted;
    property <float> p: mod(animation-tick(), 1333ms) / 1333ms;
    property <float> head-p: min(p * 2, 1);
    property <float> tail-p: max(p * 2 - 1, 0);
    property <float> head: 0.75 * head-p * head-p * (3 - 2 * head-p);
    property <float> tail: 0.75 * tail-p * tail-p * (3 - 2 * tail-p);
    property <float> offset: 0.25 * p;
    // At least a dot, as the stroke's round cap draws it.
    property <angle> a0: (tail + offset) * 360deg;
    property <angle> a1: max((head + offset) * 360deg, a0 + 4deg);
    // The whole ring's turn.
    out property <angle> turn: mod(animation-tick(), 4444ms) / 4444ms * 720deg - 90deg;
    width: size;
    height: size;

    arc := Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M " + (12 + 9 * cos(root.a0)) + " " + (12 + 9 * sin(root.a0))
            + " A 9 9 0 " + (root.a1 - root.a0 > 180deg ? "1" : "0") + " 1 "
            + (12 + 9 * cos(root.a1)) + " " + (12 + 9 * sin(root.a1));
        fill: transparent;
        stroke: root.ink;
        stroke-width: max(1.6px, root.size * 0.075);
        stroke-line-cap: round;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.turn;
    }
}

// Four bars, as many lit as the signal earns.
component Bars inherits Rectangle {
    in property <int> bars;
    in property <bool> focused;
    property <length> w: Metrics.t-secondary * 0.24;
    property <length> gap: w * 0.65;
    width: w * 4 + gap * 3;
    height: Metrics.t-secondary * 1.05;

    if Theme.quiet: Path {
        // Quiet OS: the radio's fronts, the same four steps.
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.height * 1.25;
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: #ffffff26;
        stroke-width: 2px * Metrics.qu;
        stroke-line-cap: round;
        commands: "M9.9 17.1a3 3 0 0 1 4.2 0M7.4 13.6a6.6 6.6 0 0 1 9.2 0M4.9 10.2a10.2 10.2 0 0 1 14.2 0M2.4 6.8a13.8 13.8 0 0 1 19.2 0";
    }
    if Theme.quiet && bars > 0: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.height * 1.25;
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: focused ? #f2e5d0 : #c9d0d4;
        stroke-width: 2px * Metrics.qu;
        stroke-line-cap: round;
        commands: "M9.9 17.1a3 3 0 0 1 4.2 0" + (bars > 1 ? "M7.4 13.6a6.6 6.6 0 0 1 9.2 0" : "")
            + (bars > 2 ? "M4.9 10.2a10.2 10.2 0 0 1 14.2 0" : "") + (bars > 3 ? "M2.4 6.8a13.8 13.8 0 0 1 19.2 0" : "")
            + "M0 24M24 0M24 24M0 0";
    }
    for step[i] in Theme.quiet ? [] : [1, 2, 3, 4]: Rectangle {
        x: i * (w + gap);
        width: w;
        height: parent.height * (0.28 + 0.24 * i);
        y: parent.height - self.height;
        border-radius: w / 2;
        background: step <= bars ? (focused ? Theme.text : #d6dae2) : #ffffff26;
    }
}

// A network or a device, in the settings' own card: its name, a line under
// it when there is one, and on the right what it is now.
component RadioCard inherits Rectangle {
    in property <bool> focused;
    in property <string> title;
    in property <string> under;
    in property <string> status;
    in property <bool> lock;
    in property <int> bars: -1;
    in property <string> tag;
    in property <bool> info;
    in property <bool> info-focused;
    in property <string> icon;
    // Pointed at, where the list gives it zones: the card, and its (i).
    in property <string> pointer-zone;
    in property <string> info-zone;
    in property <int> pointer-index;
    // As SettingCard's: the list draws the travelling capsule.
    in property <bool> glide;
    property <bool> lit: focused && !info-focused;

    height: under == "" ? Metrics.set-h-flat : Metrics.set-h;

    // First, so the (i) drawn later is over it and takes its own click.
    if pointer-zone != "": PointerTarget {
        radius: root.border-radius;
        zone: root.pointer-zone;
        index: root.pointer-index;
    }
    border-radius: Theme.quiet ? self.height / 2 : Metrics.s-radius;
    // Quiet OS: a row on a hairline, lifting into the warm capsule when the
    // remote is on it, as the settings list's rows do.
    background: Theme.quiet ? (lit && !glide ? Theme.s-card-hi : transparent) : (lit ? Theme.s-card-hi : Theme.s-card);
    border-width: Theme.quiet ? 0px : 1px;
    border-color: lit ? transparent : Theme.s-line;
    animate background { duration: Theme.t-focus; easing: Theme.ease; }

    if Theme.quiet: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: focused ? transparent : Theme.s-hairline;
    }

    HorizontalLayout {
        padding-left: Metrics.card-pad;
        padding-right: Metrics.card-pad;
        spacing: Metrics.card-pad * 0.75;

        if icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: icon;
                size: Metrics.icon * 1.05;
                ink: lit ? #ffffff : Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Metrics.t-primary * 0.12;
            horizontal-stretch: 1;
            min-width: 0px;
            HorizontalLayout {
                spacing: Metrics.card-pad * 0.4;
                alignment: start;
                Text {
                    text: title;
                    color: lit ? (Theme.quiet ? #f2e5d0 : #ffffff) : (Theme.quiet ? #e2e5e7 : Theme.text);
                    font-size: Metrics.t-primary;
                    font-weight: Theme.quiet ? 520 : (lit ? 650 : 600);
                    letter-spacing: Theme.quiet ? -Metrics.t-primary * 0.02 : 0px;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
                if tag != "": Rectangle {
                    width: tag-text.preferred-width + Metrics.t-secondary * 0.8;
                    height: Metrics.t-secondary * 1.45;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.quiet ? self.height / 2 : self.height * 0.22;
                    background: Theme.quiet ? #ffffff0d : #ffffff1f;
                    tag-text := Text {
                        text: tag;
                        color: Theme.muted;
                        font-size: Metrics.t-secondary * (Theme.quiet ? 0.75 : 0.82);
                        font-weight: 600;
                        letter-spacing: Theme.quiet ? Metrics.t-secondary * 0.04 : 0px;
                    }
                }
            }
            if under != "": Text {
                text: under;
                color: focused ? #b9bfcb : Theme.muted;
                font-size: Metrics.t-secondary;
                font-weight: 500;
                overflow: elide;
                wrap: no-wrap;
            }
        }
        if status != "": VerticalLayout {
            alignment: center;
            Text {
                text: status;
                color: Theme.ok;
                font-size: Metrics.t-secondary;
                font-weight: 600;
                wrap: no-wrap;
            }
        }
        if lock: VerticalLayout {
            alignment: center;
            Icon {
                name: "lock";
                size: Metrics.icon * 0.85;
                ink: focused ? Theme.text : Theme.muted;
            }
        }
        if bars >= 0: VerticalLayout {
            alignment: center;
            Bars {
                bars: bars;
                focused: lit;
            }
        }
        if info: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Metrics.icon * 1.6;
                height: Metrics.icon * 1.6;
                border-radius: self.width / 2;
                background: info-focused ? Theme.s-card-hi : transparent;
                Icon {
                    name: "info";
                    size: Metrics.icon * 1.05;
                    ink: info-focused ? (Theme.quiet ? #f2e5d0 : #ffffff) : Theme.muted;
                }
                FocusRing {
                    width: 100%;
                    height: 100%;
                    radius: parent.width / 2;
                    on: info-focused && !Theme.quiet;
                }
                if info-zone != "": PointerTarget {
                    zone: root.info-zone;
                    index: root.pointer-index;
                }
            }
        }
    }

    FocusRing {
        width: 100%;
        height: 100%;
        on: lit && !Theme.quiet;
    }
}

// The settings' frame around a radio's list: the column with the way back,
// the heading, the clock in the corner.
component Frame inherits Rectangle {
    in property <string> page;
    in property <string> page-icon;
    in property <string> title;
    in property <string> blurb;
    in property <VitalsModel> vitals;
    // The settings' categories, and the one this radio is a page of: Quiet
    // OS keeps them down the left, as the settings screen does.
    in property <[SettingNav]> sections;
    in property <int> section;
    // The screen draws its own instrument where the emblem stands.
    in property <bool> instrument;
    // The emblem, by its own id, where it does not.
    in property <string> scene;

    // Quiet OS: the settings' own frame (quiet/settings.slint), the list in its
    // content column.
    if Theme.quiet: QuietFrame {
        width: 100%;
        height: 100%;
        vitals: root.vitals;
        crumb: "Ayarlar  /  Bağlantılar  /  " + root.page;
        column: "KATEGORİLER";
        items: root.sections;
        current: root.section;
        active: false;
        pointer-zone: "settings-sections";
        emblem: !root.instrument;
        scene: root.scene;
        page-label: root.page;
        page-icon: root.page-icon;
        overline: "AYARLAR  /  BAĞLANTILAR";
        title: root.title;
        blurb: root.blurb;
    }
    if !Theme.quiet: Backdrop {
        width: 100%;
        height: 100%;
    }
    if !Theme.quiet: SideNav {
        x: 0;
        y: 0;
        width: Metrics.safe-x + Metrics.nav-w + Metrics.safe-x * 0.5;
        height: root.height;
        items: [];
        current: 0;
        active: false;
        parent-label: "Bağlantılar";
        page-label: root.page;
        page-icon: root.page-icon;
        back-zone: "back";
    }
    if !Theme.quiet: StatusCorner {
        x: root.width - Metrics.safe-x - self.width;
        y: Metrics.safe-y;
        width: self.preferred-width;
        height: Metrics.t-nav-head * 2.6;
        network: vitals.network;
        time: vitals.time;
        eth-up: vitals.eth-up;
        wifi-up: vitals.wifi-up;
        wifi-bars: vitals.wifi-bars;
    }
    if !Theme.quiet: PageHeader {
        x: Metrics.pane-x;
        y: Metrics.safe-y + Metrics.t-nav-head * 0.5;
        width: Metrics.pane-w * 0.68;
        title: root.title;
        blurb: root.blurb;
    }
    @children
}

// A network's facts, as Android's details page lists them: a name, and its
// value beside it.
component Facts inherits Rectangle {
    in property <[InfoLine]> rows;
    // Quiet OS: readings on hairlines, as the settings list draws them.
    border-radius: Metrics.s-radius;
    background: Theme.quiet ? transparent : Theme.s-card;
    border-width: Theme.quiet ? 0px : 1px;
    border-color: Theme.s-line;
    height: body.preferred-height;

    body := VerticalLayout {
        padding-left: Theme.quiet ? 0px : Metrics.card-pad;
        padding-right: Theme.quiet ? 0px : Metrics.card-pad;
        padding-top: Theme.quiet ? 0px : Metrics.card-pad * 0.5;
        padding-bottom: Theme.quiet ? 0px : Metrics.card-pad * 0.5;
        for r in rows: HorizontalLayout {
            spacing: Metrics.card-pad * 0.6;
            height: Theme.quiet ? Metrics.reading-h : Metrics.t-primary * 2.1;
            if Theme.quiet: Rectangle {
                width: 0px;
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: root.width;
                    height: 1px;
                    background: Theme.s-hairline;
                }
            }
            Text {
                text: r.label;
                color: Theme.muted;
                font-size: Metrics.t-secondary;
                vertical-alignment: center;
                wrap: no-wrap;
            }
            Text {
                text: r.value;
                color: Theme.text;
                font-size: Metrics.t-secondary;
                font-weight: 600;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
                min-width: 0px;
            }
        }
    }
}

// A radio's list: the switch, the headings, the cards, each row placed by
// how many rows of each height come before it. The Wi-Fi list and the
// Bluetooth list are both this.
component RadioList inherits Rectangle {
    in property <bool> known;
    in property <bool> present;
    in property <[WifiRow]> rows;
    in property <int> focus-flats;
    in property <int> focus-talls;
    in property <int> focus-notes;
    in property <int> focus-heads;
    in property <bool> focus-tall;
    // The rows' zone and the networks' (i) zone, by the row's slot.
    in property <string> rows-zone;
    in property <string> info-zone;
    property <bool> glide-on;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Theme.quiet ? Quiet.content-top : Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> col-x: Theme.quiet ? Quiet.content-x : Metrics.pane-x;
    property <length> col-w: Theme.quiet ? Quiet.content-w : Metrics.list-w;
    property <length> flat-step: Metrics.set-h-flat + Metrics.stack-gap;
    property <length> tall-step: Metrics.set-h + Metrics.stack-gap;
    property <length> note-step: Metrics.t-secondary * 2.4;

    Rectangle {
        property <length> pad: Metrics.glow-w * 3;
        property <length> focus-y: focus-flats * flat-step + focus-talls * tall-step + focus-notes * note-step + focus-heads * Metrics.header-h;
        property <length> view-h: self.height;
        property <length> content-h: rows.length == 0 ? 0px : row-y(rows[rows.length - 1]) + row-h(rows[rows.length - 1]);
        pure function row-y(row: WifiRow) -> length {
            return row.flats * flat-step + row.talls * tall-step + row.notes * note-step + row.heads * Metrics.header-h;
        }
        pure function row-h(row: WifiRow) -> length {
            return row.kind == "header" ? Metrics.header-h
                : (row.kind == "note" ? note-step : (row.under != "" ? Metrics.set-h : Metrics.set-h-flat));
        }
        // The remote's focus scrolls it; a pointer's hand and wheel too.
        pan := PanState {
            surface: root.rows-zone;
            remote: max(0px, focus-y + (focus-tall ? tall-step : flat-step) + pad * 2 - view-h);
            limit: max(0px, content-h + pad * 2 - view-h);
            remote-duration: Theme.t-row;
        }
        property <length> scroll: pan.value;

        x: col-x - pad;
        y: top - pad;
        width: col-w + pad * 2;
        height: root.height - Metrics.safe-y - top + pad;
        clip: true;

        if root.rows-zone != "": PointerPanArea { surface: root.rows-zone; }

        Rectangle {
            x: pad;
            y: pad - scroll;
            width: col-w;
            animate y { duration: pan.duration; easing: Theme.ease; }

            // Quiet OS: the focus is one capsule travelling from row to
            // row, as on the settings list; only over a row, not over a
            // heading's "Yenile" or a network's (i), which light their own.
            if Theme.quiet: LivingFocus {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                shown: root.glide-on;
                to-y: focus-y;
                to-h: focus-tall ? Metrics.set-h : Metrics.set-h-flat;
            }

            for row in rows: Rectangle {
                // Which row the remote is on, and whether it is one the
                // capsule lifts: a card or the switch, not its (i).
                property <int> focus-kind: !row.focused ? 0
                    : ((row.kind == "card" || row.kind == "toggle") && !row.info-focused ? 1 : 2);
                init => { if focus-kind > 0 { root.glide-on = focus-kind == 1; } }
                changed focus-kind => { if focus-kind > 0 { root.glide-on = focus-kind == 1; } }
                y: row-y(row);
                width: 100%;
                height: row-h(row);

                // A group's title, small and grey, as the reference screen
                // draws it: "Kayıtlı ağlar", "Diğer ağlar" with "Yenile" or
                // the spinner at its right.
                if row.kind == "header": Rectangle {
                    width: 100%;
                    height: 100%;
                    Text {
                        x: Theme.quiet ? Metrics.card-pad : Metrics.card-pad * 0.4;
                        y: parent.height - self.height - (Theme.quiet ? 12px * Metrics.qu : Metrics.row-gap * 0.5);
                        text: row.label;
                        color: Theme.quiet ? #80919a : Theme.muted;
                        font-size: Theme.quiet ? 14px * Metrics.qu : Metrics.t-secondary;
                        font-weight: 600;
                        letter-spacing: Theme.quiet ? 14px * Metrics.qu * 0.04 : 0px;
                    }
                    if row.tag != "" && !row.on: Rectangle {
                        x: parent.width - self.width;
                        y: parent.height - self.height - Metrics.row-gap * 0.2;
                        width: refresh.preferred-width + Metrics.card-pad;
                        height: Metrics.t-secondary * 1.9;
                        border-radius: self.height / 2;
                        background: row.focused ? Theme.s-card-hi : transparent;
                        refresh := Text {
                            text: row.tag;
                            color: row.focused ? #ffffff : Theme.accent;
                            font-size: Metrics.t-secondary;
                            font-weight: 650;
                        }
                        FocusRing {
                            width: 100%;
                            height: 100%;
                            radius: parent.height / 2;
                            on: row.focused;
                        }
                        // "Yenile": a new search. Not while one runs, when
                        // the spinner stands here and Ok does nothing.
                        if row.slot >= 0: PointerTarget {
                            zone: root.rows-zone;
                            index: row.slot;
                        }
                    }
                    // Measured off the reference recording: the ring is
                    // about 1.7 times the heading's text, near white.
                    if row.on: Spinner {
                        x: parent.width - self.width - Metrics.card-pad * 0.5;
                        y: parent.height - self.height - Metrics.row-gap * 0.1;
                        size: Metrics.t-secondary * 1.7;
                        ink: Theme.text;
                    }
                }

                if row.kind == "toggle": SettingCard {
                    width: 100%;
                    label: row.label;
                    kind: "action";
                    toggle: known && present ? (row.on ? 1 : 0) : -1;
                    value: !known ? "…" : (present ? "" : "Bu kartta yok");
                    enabled: !known || present;
                    focused: row.focused;
                    glide: Theme.quiet;
                    pointer-zone: row.slot >= 0 ? root.rows-zone : "";
                    pointer-index: row.slot;
                }
                if row.kind == "card": RadioCard {
                    width: 100%;
                    height: parent.height;
                    title: row.label;
                    under: row.under;
                    status: "";
                    lock: row.secured;
                    bars: row.bars;
                    focused: row.focused;
                    tag: row.tag;
                    info: row.info;
                    info-focused: row.info-focused;
                    glide: Theme.quiet;
                    icon: row.icon;
                    pointer-zone: row.slot >= 0 ? root.rows-zone : "";
                    info-zone: row.info ? root.info-zone : "";
                    pointer-index: row.slot;
                }
                if row.kind == "note": Text {
                    x: Metrics.card-pad * 0.4;
                    text: row.label;
                    color: Theme.muted;
                    font-size: Metrics.t-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component WifiScreen inherits Rectangle {
    /// False until the daemon has answered once. Nothing below states a fact
    /// about the radio while this is false.
    in property <bool> known;
    in property <bool> present;
    in property <bool> powered;
    in property <bool> busy;
    in property <string> notice;
    in property <VitalsModel> vitals;
    in property <[SettingNav]> sections;
    in property <int> section;

    // "list" | "saved" | "details" | "password"
    in property <string> face;
    // The list face and "Kayıtlı ağlar".
    in property <string> title;
    in property <[WifiRow]> rows;
    in property <int> focus-flats;
    in property <int> focus-talls;
    in property <int> focus-notes;
    in property <int> focus-heads;
    in property <bool> focus-tall;
    // A network's page.
    in property <string> details-status;
    in property <[string]> buttons;
    in property <int> button;
    in property <[InfoLine]> facts;
    in property <[InfoLine]> net-facts;
    // The password dialog, and "Ağ ekleyin".
    in property <string> target;
    in property <bool> adding;
    in property <string> ssid-text;
    in property <bool> secure;
    in property <string> password-mask;
    in property <bool> show;
    // "ssid" | "security" | "field" | "show" | "keys" | "join"
    in property <string> focus-at;
    in property <[KeyRow]> keys;
    in property <int> key-row;
    in property <int> key-col;

    property <length> head-h: Metrics.t-page * 1.3 + Metrics.t-secondary * 1.5;
    property <length> top: Theme.quiet ? Quiet.content-top : Metrics.safe-y + head-h + Metrics.row-gap * 3.4;
    property <length> col-x: Theme.quiet ? Quiet.content-x : Metrics.pane-x;
    property <length> col-w: Theme.quiet ? Quiet.content-w : Metrics.list-w;
    property <length> flat-step: Metrics.set-h-flat + Metrics.stack-gap;
    property <length> tall-step: Metrics.set-h + Metrics.stack-gap;
    property <length> note-step: Metrics.t-secondary * 2.4;

    background: Theme.s-ground;
    clip: true;

    if face == "list" || face == "saved": Frame {
        width: 100%;
        height: 100%;
        page: "Wi-Fi";
        page-icon: "wifi";
        title: root.title;
        blurb: notice;
        vitals: root.vitals;
        sections: root.sections;
        section: root.section;
        instrument: true;

        if Theme.quiet: SignalField {
            x: 1604px * Metrics.qu;
            y: 196px * Metrics.qu;
            width: 204px * Metrics.qu;
            height: 204px * Metrics.qu;
            known: root.known;
            on: root.present && root.powered;
            linked: vitals.wifi-up;
            bars: vitals.wifi-bars;
            ssid: vitals.wifi-ssid;
        }
        RadioList {
            width: 100%;
            height: 100%;
            known: root.known;
            present: root.present;
            rows: root.rows;
            focus-flats: root.focus-flats;
            focus-talls: root.focus-talls;
            focus-notes: root.focus-notes;
            focus-heads: root.focus-heads;
            focus-tall: root.focus-tall;
            rows-zone: "wifi-rows";
            info-zone: "wifi-info";
        }
    }

    // A network's page: WifiNetworkDetailsFragment's header, its buttons and
    // its facts.
    if face == "details": Frame {
        width: 100%;
        height: 100%;
        page: "Wi-Fi";
        page-icon: "wifi";
        title: root.target;
        blurb: notice != "" ? notice : details-status;
        scene: "wifi";
        vitals: root.vitals;
        sections: root.sections;
        section: root.section;

        VerticalLayout {
            x: col-x;
            y: top;
            width: col-w;
            height: self.preferred-height;
            spacing: Metrics.row-gap * 1.6;
            alignment: start;

            HorizontalLayout {
                spacing: Metrics.row-gap * 1.2;
                alignment: start;
                for label[i] in buttons: ActionButton {
                    label: label;
                    focused: i == button;
                    pointer-zone: "wifi-buttons";
                    pointer-index: i;
                }
            }
            if facts.length > 0: Facts { rows: facts; }
            if net-facts.length > 0: SectionHeader { text: "Ağ ayrıntıları"; }
            if net-facts.length > 0: Facts { rows: net-facts; }
        }
    }

    if face == "password" && Theme.quiet: QuietGround {
        width: 100%;
        height: 100%;
        strength: 0.4;
    }
    if face == "password": VerticalLayout {
        padding: Metrics.gutter;
        // The shared bar draws the name of the screen; this clears it rather
        // than printing a second title underneath the first.
        padding-top: Metrics.topbar + Metrics.vh * 0.012;
        spacing: Metrics.vh * 0.016;

        if notice != "": Rectangle {
            height: Metrics.vh * 0.052;
            border-radius: Theme.radius * 0.5;
            background: #ffffff12;
            Text {
                text: notice;
                color: Theme.text;
                font-size: Metrics.text-chip;
                font-weight: 600;
            }
        }

        // --------------------------------------------------------- password
        //
        // One column, centred, everything in it the width of the grid. Laid
        // out full-bleed it put a full-width field and a full-width button
        // around a keyboard a third as wide, which read as three unrelated
        // things stacked up.
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
            width: Metrics.key-w * 10 + Metrics.key-gap * 9;
            alignment: center;
            spacing: Metrics.vh * 0.014;

            Text {
                text: adding ? "Ağ ekleyin" : target;
                color: Theme.text;
                font-size: Metrics.root-font * 1.25;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // "Ağ adı" and "Güvenlik", as AddNetworkFragment asks them.
            if adding: Rectangle {
                height: Metrics.vh * 0.08;
                border-radius: Theme.quiet ? self.height / 2 : Theme.radius * 0.6;
                background: focus-at == "ssid" ? Theme.focus-fill : (Theme.quiet ? #ffffff08 : #ffffff0f);
                border-width: focus-at == "ssid" ? 2px : 1px;
                border-color: focus-at == "ssid" ? Theme.focus-ring : Theme.line-soft;
                HorizontalLayout {
                    padding-left: Metrics.vh * 0.02;
                    padding-right: Metrics.vh * 0.02;
                    Text {
                        vertical-alignment: center;
                        text: ssid-text == "" ? "Ağ adı" : ssid-text;
                        color: focus-at == "ssid"
                            ? #0a0c10
                            : (ssid-text == "" ? #ffffff66 : Theme.text);
                        font-size: Metrics.root-font * 1.1;
                        font-weight: 700;
                    }
                }
                PointerTarget { zone: "wifi-form"; index: 0; }
            }
            if adding: Rectangle {
                height: Metrics.vh * 0.07;
                border-radius: Theme.quiet ? self.height / 2 : Theme.radius * 0.6;
                background: focus-at == "security" ? Theme.focus-fill : (Theme.quiet ? #ffffff08 : #ffffff0f);
                border-width: focus-at == "security" ? 2px : 1px;
                border-color: focus-at == "security" ? Theme.focus-ring : Theme.line-soft;
                HorizontalLayout {
                    padding-left: Metrics.vh * 0.02;
                    padding-right: Metrics.vh * 0.02;
                    Text {
                        vertical-alignment: center;
                        text: "Güvenlik";
                        color: focus-at == "security" ? #0a0c10 : Theme.muted;
                        font-size: Metrics.root-font * 0.95;
                        font-weight: 600;
                    }
                    Text {
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        text: secure ? "‹  WPA/WPA2/WPA3-Personal  ›" : "‹  Yok  ›";
                        color: focus-at == "security" ? #0a0c10 : Theme.text;
                        font-size: Metrics.root-font * 0.95;
                        font-weight: 700;
                    }
                }
                PointerTarget { zone: "wifi-form"; index: 1; }
            }

            // The field and, beside it, the switch that turns the bullets
            // back into letters. Right from the field reaches it.
            if !adding || secure: HorizontalLayout {
                spacing: Metrics.vh * 0.012;
                height: Metrics.vh * 0.08;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.quiet ? self.height / 2 : Theme.radius * 0.6;
                    background: focus-at == "field" ? Theme.focus-fill : (Theme.quiet ? #ffffff08 : #ffffff0f);
                    border-width: focus-at == "field" ? 2px : 1px;
                    border-color: focus-at == "field" ? Theme.focus-ring : Theme.line-soft;
                    HorizontalLayout {
                        padding-left: Metrics.vh * 0.02;
                        padding-right: Metrics.vh * 0.02;
                        Text {
                            vertical-alignment: center;
                            text: password-mask == "" ? "Şifre" : password-mask;
                            color: focus-at == "field"
                                ? #0a0c10
                                : (password-mask == "" ? #ffffff66 : Theme.text);
                            font-size: Metrics.root-font * 1.1;
                            font-weight: 700;
                        }
                    }
                    PointerTarget { zone: "wifi-form"; index: 2; }
                }

                Rectangle {
                    width: Metrics.vh * 0.22;
                    border-radius: Theme.quiet ? self.height / 2 : Theme.radius * 0.6;
                    background: focus-at == "show" ? Theme.focus-fill : (Theme.quiet ? #ffffff08 : #ffffff0f);
                    border-width: focus-at == "show" ? 2px : 1px;
                    border-color: focus-at == "show" ? Theme.focus-ring : Theme.line-soft;
                    Text {
                        text: show ? "Gizle" : "Göster";
                        color: focus-at == "show" ? #0a0c10 : Theme.text;
                        font-size: Metrics.root-font * 0.95;
                        font-weight: 700;
                    }
                    PointerTarget { zone: "wifi-form"; index: 3; }
                }
            }

            Keyboard {
                keys: root.keys;
                key-row: root.key-row;
                key-col: root.key-col;
                active: focus-at == "keys";
                pointer-zone: "wifi-keys";
            }

            Rectangle {
                height: Metrics.vh * 0.075;
                border-radius: Theme.quiet ? self.height / 2 : Theme.radius * 0.6;
                background: focus-at == "join" ? Theme.focus-fill : (Theme.quiet ? #ffffff08 : #ffffff0f);
                border-width: focus-at == "join" ? 2px : 1px;
                border-color: focus-at == "join" ? Theme.focus-ring : Theme.line-soft;
                Text {
                    text: busy ? "Bağlanıyor…" : (adding ? "Kaydet" : "Bağlan");
                    color: focus-at == "join" ? #0a0c10 : Theme.text;
                    font-size: Metrics.root-font * 1.05;
                    font-weight: 700;
                }
                PointerTarget { zone: "wifi-form"; index: 4; }
            }
            }
        }
    }
}

export component BluetoothScreen inherits Rectangle {
    /// As on WifiScreen.
    in property <bool> known;
    in property <bool> present;
    in property <string> summary;
    in property <bool> powered;
    in property <bool> scanning;
    in property <int> linked;
    in property <int> paired;
    in property <string> notice;
    in property <VitalsModel> vitals;
    in property <[SettingNav]> sections;
    in property <int> section;
    in property <[WifiRow]> rows;
    in property <int> focus-flats;
    in property <int> focus-talls;
    in property <int> focus-notes;
    in property <int> focus-heads;
    in property <bool> focus-tall;

    background: Theme.s-ground;
    clip: true;

    Frame {
        width: 100%;
        height: 100%;
        page: "Bluetooth";
        page-icon: "bluetooth";
        title: "Bluetooth";
        blurb: notice != "" ? notice : summary;
        vitals: root.vitals;
        sections: root.sections;
        section: root.section;
        instrument: true;

        if Theme.quiet: BluetoothField {
            x: 1604px * Metrics.qu;
            y: 196px * Metrics.qu;
            width: 204px * Metrics.qu;
            height: 240px * Metrics.qu;
            known: root.known;
            on: root.present && root.powered;
            scanning: root.scanning;
            linked: root.linked;
            paired: root.paired;
        }
        RadioList {
            width: 100%;
            height: 100%;
            known: root.known;
            present: root.present;
            rows: root.rows;
            focus-flats: root.focus-flats;
            focus-talls: root.focus-talls;
            focus-notes: root.focus-notes;
            focus-heads: root.focus-heads;
            focus-tall: root.focus-tall;
            rows-zone: "bt-rows";
        }
    }
}
