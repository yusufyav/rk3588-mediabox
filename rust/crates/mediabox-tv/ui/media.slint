import { Theme, Metrics } from "theme.slint";
import { Rail, RailModel } from "components.slint";
import { Chrome } from "chrome.slint";

// The catalogue: what is behind the "Filmler ve Diziler" tile, laid out as
// the reference's board and measured off a 4K screenshot of it:
//
// - a column of places down the left, marks only, the current one in the
//   accent: centred 2.06% in, the first at 9.86% down, one every 7.05%;
// - the search box across the top, centred, 23% of the width, 3.9% high;
// - a shelf per catalogue, the first poster 5.47% in, the heading's top 8.75%
//   down, a shelf every 36.6% of the height, "Tümünü Gör ›" at the right end
//   of each heading.
export component Media inherits Rectangle {
    in property <[RailModel]> rails;
    in property <int> focus-row;
    in property <int> focus-col;
    // Each shelf's own remembered column. A shelf is scrolled to its own,
    // which is where its artwork is loaded: scrolled to the focused shelf's
    // column instead, every other shelf slid to posters it held no picture
    // for, and a walk to the end of one and down emptied the rest.
    in property <[int]> columns;
    // 0 the shelves, 1 the places, 2 the search box.
    in property <int> zone;
    in property <int> place;
    in property <[string]> places;
    // The focused poster's menu: its lines, and the one the remote is on
    // (-1 while it is shut).
    in property <[string]> menu;
    in property <int> menu-line: -1;

    property <length> content-x: root.width * 0.0547;
    property <length> right-x: root.width * 0.0185;
    property <length> rails-top: root.height * 0.0875;
    property <length> rail-h: root.height * 0.3662;
    // The heading's band: the reference's posters start 3.7% of the height
    // under the heading's top.
    property <length> head: root.height * 0.037 - Metrics.focus-room;
    property <length> viewport-h: root.height - rails-top;
    property <length> content-h: max(1px, rail-h * rails.length);
    property <length> scroll: clamp(focus-row * rail-h, 0px, max(0px, content-h - viewport-h));

    background: Theme.catalog-bg;
    clip: true;

    // ------------------------------------------------------------ the shelves
    //
    // Clipped at the column of places, so a shelf scrolled along passes under
    // it rather than over it.
    Rectangle {
        x: content-x - Metrics.focus-room;
        y: rails-top - Metrics.focus-room;
        // Nine posters and the margin after them, as the reference's row
        // ends; nothing of a tenth peeks in at the edge.
        width: root.width - self.x - right-x + Metrics.focus-room;
        height: viewport-h + Metrics.focus-room;
        clip: true;

        Rectangle {
            x: 0;
            y: Metrics.focus-room - scroll;
            width: 100%;
            height: content-h;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for rail[r] in rails: Rail {
                x: 0;
                y: r * rail-h;
                width: parent.width;
                height: rail-h;
                rail: rail;
                inset: Metrics.focus-room;
                right-inset: Metrics.focus-room;
                head: head;
                focus-col: r < columns.length ? columns[r] : 0;
                active: zone == 0 && focus-row == r;
            }
        }
    }

    // --------------------------------------------------------------- the menu
    //
    // The reference's, measured off its board: just right of the focused
    // poster's name, 0.96 of a poster in from its left, 80% of one wide,
    // a line every 0.29 of its width, #0f0d20 with a faint violet edge.
    if menu-line >= 0 && rails.length > focus-row: Rectangle {
        property <length> step: Metrics.card-w + Metrics.rail-gap;
        property <length> x0: content-x - Metrics.focus-room;
        property <length> track-w: root.width - x0 - right-x + Metrics.focus-room;
        property <length> span: step * rails[focus-row].items.length;
        property <int> column: focus-row < columns.length ? columns[focus-row] : 0;
        property <length> wanted: clamp(column * step, 0px,
            max(0px, span - track-w + Metrics.focus-room * 2));
        property <length> poster-x: x0 + Metrics.focus-room - wanted + column * step;
        property <length> poster-y: rails-top - scroll + focus-row * rail-h + head + Metrics.focus-room;
        property <length> line-h: Metrics.card-w * 0.29;
        x: poster-x + Metrics.card-w * 0.96;
        y: poster-y + Metrics.card-h + Metrics.card-w * 0.37;
        width: Metrics.card-w * 0.8;
        height: menu.length * line-h;
        border-radius: Metrics.card-w * 0.04;
        background: #0f0d20;
        border-width: 1px;
        border-color: #7b5bf540;
        drop-shadow-blur: Metrics.card-w * 0.05;
        drop-shadow-color: #7b5bf533;

        for label[k] in menu: Rectangle {
            y: k * parent.line-h;
            height: parent.line-h;
            border-radius: parent.border-radius;
            background: k == menu-line ? #ffffff1a : transparent;
            Text {
                x: Metrics.card-w * 0.13;
                height: 100%;
                text: label;
                color: Theme.text;
                font-size: Metrics.card-w * 0.09;
                vertical-alignment: center;
            }
        }
    }

    Chrome {
        width: 100%;
        height: 100%;
        on-search: zone == 2;
        on-places: zone == 1;
        place: place;
        current: 0;
        places: places;
    }
}
