import { Theme, Metrics } from "theme.slint";
import { Rail, RailModel } from "components.slint";

// The catalogue: what is behind the "Filmler ve Diziler" tile.
//
// A shelf per catalogue, every poster named, the unfinished titles first — the
// shape the reference uses and the shape anybody who has used a streaming box
// already knows. The line above the shelves is what the focused title is, so
// scanning a row tells you something without opening anything.
export component Media inherits Rectangle {
    in property <[RailModel]> rails;
    in property <int> focus-row;
    in property <int> focus-col;

    in property <string> title;
    in property <string> facts;
    in property <string> summary;

    property <length> rail-h: Metrics.card-h + Metrics.text-card * 2.6 + Metrics.title-rail * 2.6;
    property <length> head-h: Metrics.title-screen * 1.25 + Metrics.text-meta * 3.0;
    property <length> top: Metrics.topbar + Metrics.block-gap * 0.4;
    property <length> viewport-h: root.height - top - head-h;
    property <length> content-h: max(1px, rail-h * rails.length);
    property <length> scroll: clamp(max(0, focus-row - 1) * rail-h - Metrics.top-inset * 0.25,
                                    0px,
                                    max(0px, content-h - viewport-h));

    background: Theme.bg;
    clip: true;

    // A quiet ground rather than a photograph. The posters are the picture on
    // this screen, and a full-screen still behind two hundred of them is both
    // noise and, at this size, the most expensive thing the renderer does.
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(175deg, #0d1119 0%, #080a10 58%, #05070b 100%);
    }
    Rectangle {
        x: root.width * 0.3;
        y: -root.height * 0.3;
        width: root.width;
        height: root.height * 0.7;
        background: @radial-gradient(circle, #5e4aa845 0%, #5e4aa800 62%);
    }

    // What the remote is on. Fixed above the shelves rather than scrolling with
    // them: it is the answer to "what is this one", and an answer that slides
    // off the top of the panel as you walk along a row is no answer.
    VerticalLayout {
        x: Metrics.gutter;
        y: top;
        width: min(root.width * 0.62, 1300px);
        height: head-h;
        spacing: Metrics.root-font * 0.3;
        alignment: start;

        Text {
            text: title;
            color: Theme.text;
            font-size: Metrics.title-screen;
            font-weight: 800;
            letter-spacing: -0.03 * Metrics.title-screen;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: facts;
            color: Theme.accent;
            font-size: Metrics.text-meta * 0.9;
            font-weight: 700;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: summary;
            color: Theme.muted;
            font-size: Metrics.text-meta * 0.9;
            wrap: word-wrap;
            overflow: elide;
            max-height: Metrics.text-meta * 2.2;
        }
    }

    // The shelves.
    Rectangle {
        x: 0;
        y: top + head-h;
        width: 100%;
        height: viewport-h;
        clip: true;
        background: transparent;

        Rectangle {
            x: 0;
            y: -scroll;
            width: 100%;
            height: content-h;
            background: transparent;

            animate y { duration: Theme.glide; easing: Theme.ease; }

            for rail[r] in rails: Rail {
                x: 0;
                y: r * rail-h;
                width: root.width;
                rail: rail;
                focus-col: focus-col;
                // Row 0 is the bar; the shelves start at 1.
                active: focus-row == r + 1;
            }
        }
    }
}
