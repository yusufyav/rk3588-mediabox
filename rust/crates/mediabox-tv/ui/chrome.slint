import { Theme, Metrics } from "theme.slint";
import { Icon } from "kit.slint";
import { ReferenceIcon } from "reference-icons.slint";

// The account, as the reference's profile mark at the top right shows it.
// Set from Rust for every page that draws the frame.
export global AccountChip {
    in-out property <bool> signed;
    in-out property <string> email;
    // 0 not on it, 1 the mark, 2 the button in its menu.
    in-out property <int> focus;
}

// The reference's frame around "Filmler ve Diziler": its places down the
// left, marks only, and its search box across the top. The board, Discover
// and the library each draw it; measured off a 4K screenshot of the board.
export component Chrome inherits Rectangle {
    in property <bool> on-search;
    in property <bool> on-places;
    // The place the remote is on, and the place this screen is.
    in property <int> place;
    in property <int> current;
    in property <[string]> places;
    // What is in the search box, on the search page; the placeholder until
    // something is.
    in property <string> query;

    // ------------------------------------------------------- the search box
    Rectangle {
        property <bool> focused: on-search && AccountChip.focus == 0;
        width: root.width * 0.2307;
        height: root.height * 0.0389;
        x: (root.width - self.width) / 2;
        y: root.height * 0.0139;
        border-radius: self.height / 2;
        background: focused ? Theme.focus-fill : #28253c;
        animate background { duration: Theme.focus-in; easing: Theme.ease; }

        Text {
            x: parent.height * 0.62;
            width: parent.width - parent.height * 1.8;
            height: 100%;
            text: query == "" ? "Arayın" : query;
            color: query != "" ? (parent.focused ? #0a0c10 : Theme.text)
                : (parent.focused ? #3b4250 : #918f9b);
            font-size: parent.height * 0.36;
            vertical-alignment: center;
        }
        // The reference's search mark; its box carries a cross once it has
        // a query.
        if query == "": ReferenceIcon {
            x: parent.width - parent.height * 0.62 - self.width;
            y: (parent.height - self.height) / 2;
            name: "search";
            size: parent.height * 0.5;
            ink: parent.focused ? #0a0c10 : #d9d8df;
        }
        if query != "": Icon {
            x: parent.width - parent.height * 0.62 - self.width;
            y: (parent.height - self.height) / 2;
            name: "close";
            size: parent.height * 0.44;
            ink: parent.focused ? #0a0c10 : #d9d8df;
        }
    }

    // ------------------------------------------------------ the places, left
    //
    // The product's own mark at the top rather than the reference's: a play
    // mark in the accent.
    Rectangle {
        x: root.width * 0.0206 - self.width / 2;
        y: root.height * 0.0181;
        width: root.width * 0.0169;
        height: self.width;
        border-radius: self.width * 0.28;
        background: Theme.film;

        Path {
            x: parent.width * 0.3;
            y: parent.height * 0.26;
            width: parent.width * 0.46;
            height: parent.height * 0.48;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M1 0L10 5L1 10z";
            fill: #ffffff;
        }
    }

    // Each place as the reference's tab button, off its stylesheet: a
    // 4.8rem box, rounded 0.75rem, the mark 2.2rem with its name under it in
    // 0.8rem. The name shows on the place the remote is on, over a faint
    // fill; the page this is wears the accent.
    for mark[i] in places: Rectangle {
        property <bool> focused: on-places && i == place;
        property <length> rem: root.width / 128;
        // The measured centre of the mark: 2.06% in, 9.86% down, one every
        // 7.05%. The box is laid out around it, name and all.
        property <length> mark-y: root.height * (0.0986 + 0.0705 * i);
        width: rem * 4.8;
        height: rem * 4.8;
        x: root.width * 0.0206 - self.width / 2;
        y: mark-y - rem * 1.67;
        border-radius: rem * 0.75;
        background: focused ? #ffffff14 : transparent;
        animate background { duration: Theme.focus-in; easing: Theme.ease; }

        // The reference's own marks, 2.2rem.
        ReferenceIcon {
            x: (parent.width - self.width) / 2;
            y: parent.rem * 0.57;
            name: mark;
            size: parent.rem * 2.2;
            // The board is where this is; the others are where it could go.
            ink: i == current ? Theme.film : #60606a;
        }
        if focused: Text {
            x: 0;
            y: parent.rem * (0.57 + 2.2 + 0.5);
            width: parent.width;
            text: mark == "home" ? "Pano"
                : mark == "discover" ? "Keşfet"
                : mark == "library" ? "Kitaplık"
                : mark == "settings" ? "Ayarlar"
                : "";
            color: i == current ? Theme.film : #ffffff99;
            font-size: parent.rem * 0.8;
            font-weight: 500;
            horizontal-alignment: center;
            wrap: no-wrap;
        }
    }

    // ------------------------------------------------------ the account, right
    //
    // The reference's profile mark, 3.75% down and 96.25% across with its
    // caret beside it. Anonymous, it is a grey figure; signed in, the figure
    // on the accent. The remote reaches it with Right from the search box,
    // and on it the reference's menu drops down: who is signed in -- or
    // "İsimsiz kullanıcı" -- and the one button, its LOG_OUT or its
    // "LOG_IN / SIGN_UP".
    property <length> chip-rem: root.width / 128;
    account-mark := Rectangle {
        property <bool> focused: on-search && AccountChip.focus == 1;
        width: chip-rem * 2.6;
        height: self.width;
        x: root.width * 0.9625 - self.width / 2;
        y: root.height * 0.0375 - self.height / 2;
        border-radius: self.width / 2;
        background: AccountChip.signed ? Theme.film : #ffffff2e;
        border-width: focused ? max(2px, chip-rem * 0.15) : 0px;
        border-color: Theme.focus-ring;

        ReferenceIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "person";
            size: parent.width * 0.62;
            ink: AccountChip.signed ? #ffffff : #d9d8df;
        }
    }
    Path {
        x: root.width * 0.982 - self.width / 2;
        y: root.height * 0.0375 - self.height / 2;
        width: chip-rem * 0.7;
        height: chip-rem * 0.42;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M0 0L10 0L5 6z";
        fill: #ffffffb0;
    }

    if on-search && AccountChip.focus > 0: Rectangle {
        width: chip-rem * 22;
        height: chip-rem * 7;
        x: root.width - self.width - chip-rem * 1.2;
        y: account-mark.y + account-mark.height + chip-rem;
        border-radius: chip-rem * 0.75;
        background: #1e1c2f;
        border-width: 1px;
        border-color: #ffffff1f;
        drop-shadow-blur: chip-rem;
        drop-shadow-color: #00000080;

        HorizontalLayout {
            padding-top: chip-rem * 1.5;
            padding-bottom: chip-rem * 1.5;
            padding-left: chip-rem;
            padding-right: chip-rem;
            spacing: chip-rem;

            Rectangle {
                width: chip-rem * 4;
                height: self.width;
                border-radius: self.width / 2;
                background: AccountChip.signed ? Theme.film : #ffffffe6;
                ReferenceIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "person";
                    size: parent.width * 0.6;
                    ink: AccountChip.signed ? #ffffff : #3b3a46;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: chip-rem * 0.5;
                Text {
                    text: AccountChip.signed ? AccountChip.email : "İsimsiz kullanıcı";
                    color: Theme.text;
                    font-size: chip-rem;
                    overflow: elide;
                    wrap: no-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    button := Rectangle {
                        property <bool> focused: AccountChip.focus == 2;
                        width: label.preferred-width + chip-rem * 2;
                        height: chip-rem * 2.2;
                        border-radius: self.height / 2;
                        background: focused ? Theme.focus-fill : #ffffff14;
                        animate background { duration: Theme.focus-in; easing: Theme.ease; }
                        label := Text {
                            width: 100%;
                            height: 100%;
                            text: AccountChip.signed ? "Oturumu kapat" : "Oturum aç / Kaydol";
                            color: button.focused ? #0a0c10 : Theme.text;
                            font-size: chip-rem * 0.9;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
