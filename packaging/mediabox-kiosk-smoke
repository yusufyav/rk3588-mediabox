#!/bin/sh
#
# Is the television actually showing the product?
#
# The unit reporting "running" says nothing about what is on the panel, so every
# check here is against something the appliance itself reports: the journal the
# shell wrote on this start, the display controller's own state, and the
# process table. A screenshot is not evidence and neither is a green unit.
set -eu
UNIT=mediabox-tv-ui.service
BIN="${MEDIABOX_TV_BIN:-/opt/rk3588-mediabox/bin/mediabox-tv}"
SETTLE="${MEDIABOX_UI_SETTLE:-12}"
fails=0
ok()  { printf '  PASS  %-24s %s\n' "$1" "$2"; }
bad() { printf '  FAIL  %-24s %s\n' "$1" "$2"; fails=$((fails + 1)); }
echo '== native shell smoke'
# Anchored to the restart rather than to "now minus the settle time": the
# platform and GPU lines are printed in the first second the unit is up, and a
# window measured backwards from the end of the sleep starts after them. It
# failed a working shell that way -- "split path absent" on a television that
# was showing the home screen.
since=$(date '+%Y-%m-%d %H:%M:%S')
systemctl restart "$UNIT"
sleep "$SETTLE"
state=$(systemctl show "$UNIT" -p SubState --value)
[ "$state" = running ] && ok unit "$state" || bad unit "$state"
pid=$(pgrep -f -- "$BIN" | head -1 || true)
[ -n "$pid" ] && ok interface "pid $pid" || bad interface 'not running'
log=$(journalctl -u "$UNIT" --since "$since" --no-pager 2>/dev/null || true)
# The split render/scanout path, without naming either device. What matters is
# that the interface found *a* render node with the vendor GBM backend behind it
# and *a* display device to scan out on -- the numbers differ between boards and
# between boots, and a check that spells them out fails a working appliance.
split=$(printf '%s\n' "$log" | sed -n 's/.*split-kms \(.*\)/\1/p' | tail -1)
case "$split" in
  *gbm=armsoc*display=*) ok platform "${split%% audio=*}" ;;
  *)                     bad platform 'split path absent' ;;
esac
# And that the three things that follow from the chosen output resolved. The
# audio endpoint and the CEC adapter belong to the connector the display stage
# picked; a board with two HDMI sockets has a different answer for each.
PLATFORM=/opt/rk3588-mediabox/bin/mediabox-platform
selected=$("$PLATFORM" output 2>/dev/null || true)
[ -n "$selected" ] && ok output "$selected" || bad output 'no output selected'
card=$("$PLATFORM" alsa-card 2>/dev/null || true)
[ -n "$card" ] && ok audio "$card" || bad audio 'no sound card for this output'
adapter=$("$PLATFORM" cec-device 2>/dev/null || true)
if [ -n "$adapter" ]; then
  ok cec "$adapter"
elif "$PLATFORM" inspect 2>/dev/null | grep -q 'cec *unavailable'; then
  # DisplayPort carries no CEC. A capability this output does not have is not a
  # fault of the appliance.
  ok cec 'none on this output'
else
  bad cec 'no adapter for this output'
fi
printf '%s\n' "$log" | grep -q 'EGL_VENDOR=ARM.*GL_RENDERER=Mali-G610' && ok gpu 'ARM / Mali-G610' || bad gpu 'vendor GPU absent'
printf '%s\n' "$log" | grep -q 'present dma-buf=active' && ok scanout 'PRIME FB active' || bad scanout 'no PRIME FB'
printf '%s\n' "$log" | grep -q 'first_data_ms=' && ok home 'real data loaded' || bad home 'data absent'
# The plane that is actually scanning out, not whichever one the file happens
# to list first. A board with one connector puts the live plane at the top and
# `head -1` reads it by luck; a board with three does not, and every idle plane
# reads crtc-pos=0x0 with crtc=(null). Ask for a plane that is attached to a
# CRTC instead of trusting the order.
mode=$(awk '
  /^[^\t]/ { inplane = ($0 ~ /^plane\[/); attached = 0 }
  inplane && /^\tcrtc=/ { attached = ($0 !~ /\(null\)/) }
  inplane && attached && /^\tcrtc-pos=/ {
    if (match($0, /[0-9]+x[0-9]+/)) { print substr($0, RSTART, RLENGTH); exit }
  }
' /sys/kernel/debug/dri/0/state 2>/dev/null)
native=$(printf '%s\n' "$log" | sed -n 's/.*native=\([0-9]*x[0-9]*\).*/\1/p' | tail -1)
[ -n "$mode" ] && [ "$mode" = "$native" ] && ok 'native mode' "$mode" || bad 'native mode' "KMS=${mode:-none} app=${native:-none}"
if pgrep -x sway >/dev/null || pgrep -f 'chromium.*mediabox-ui/chromium' >/dev/null; then bad compositor 'still present'; else ok compositor 'none'; fi

# The framebuffer cache. Each of the GBM surface's buffers should need exactly
# one PRIME import and one ADDFB2 for the life of the process; a number that
# keeps climbing is the per-frame import path that used to cost four ioctls on
# the display device every frame.
buffers=$(printf '%s\n' "$log" | grep -c 'scanout-buffer n=' || true)
[ "$buffers" -ge 1 ] && [ "$buffers" -le 4 ] \
  && ok 'scanout buffers' "$buffers imported once" \
  || bad 'scanout buffers' "${buffers:-0} imports in ${SETTLE}s"

# The remote is not a power button. This is the fault that opened this
# milestone: the HDMI block's CEC input device carried udev's power-switch tag,
# systemd-logind watched it, and a code from the television restarted the
# appliance. Three locks, each checked -- and checked on every one of these
# devices, because a board with two HDMI transmitters registers two of them and
# the one that is not driving the panel carries the same KEY_POWER as the one
# that is. Checking only the first passes a board whose second remote can still
# turn the appliance off.
cec_events=$(grep -l 'dw_hdmi_qp' /sys/class/input/event*/device/name 2>/dev/null \
  | sed 's#/sys/class/input/\(event[0-9]*\)/.*#\1#')
if [ -n "$cec_events" ]; then
  found=$(printf '%s\n' $cec_events | wc -w | tr -d ' ')
  tagged=""
  for cec_event in $cec_events; do
    case "$(udevadm info "/dev/input/$cec_event" 2>/dev/null | sed -n 's/^E: CURRENT_TAGS=//p')" in
      *power-switch*) tagged="$tagged $cec_event" ;;
    esac
  done
  [ -z "$tagged" ] && ok 'cec power tag' "$found untagged" \
                   || bad 'cec power tag' "still tagged:$tagged"
  # What logind is holding open, not what it once said. logind watches a button
  # by opening the evdev node, and taking the tag away does not make it let go
  # of one it already opened — so the open descriptor is the fact, and it needs
  # no guess about which slice of the journal counts as current.
  logind_pid=$(systemctl show systemd-logind.service -p MainPID --value)
  held=""
  for cec_event in $cec_events; do
    for fd in /proc/${logind_pid:-0}/fd/*; do
      [ "$(readlink "$fd" 2>/dev/null)" = "/dev/input/$cec_event" ] || continue
      held="$held $cec_event"
      break
    done
  done
  [ -z "$held" ] && ok 'logind buttons' "none of $found held" \
                 || bad 'logind buttons' "holding:$held"
else
  bad 'cec power tag' 'no dw_hdmi_qp input device'
fi
power_key=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager HandlePowerKey 2>/dev/null | awk '{print $2}' | tr -d '"')
reboot_key=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager HandleRebootKey 2>/dev/null | awk '{print $2}' | tr -d '"')
[ "$power_key" = ignore ] && [ "$reboot_key" = ignore ] \
  && ok 'logind keys' 'power/reboot ignored' \
  || bad 'logind keys' "power=${power_key:-?} reboot=${reboot_key:-?}"
[ "$(systemctl is-enabled ctrl-alt-del.target 2>&1)" = masked ] \
  && ok 'ctrl-alt-del' masked \
  || bad 'ctrl-alt-del' "$(systemctl is-enabled ctrl-alt-del.target 2>&1)"

# There is no terminal on the television. Two halves, and both are needed: the
# framebuffer console must be off the panel, and the framebuffer behind it must
# be empty — the DRM core restores the fbdev's mode when the last master closes,
# which is the moment a film ends, and it shows whatever is in that memory.
fbcon=ok
for vtcon in /sys/class/vtconsole/vtcon*; do
  [ -e "$vtcon/name" ] || continue
  case "$(cat "$vtcon/name")" in
    *"frame buffer device"*)
      [ "$(cat "$vtcon/bind")" = 0 ] || fbcon="bound"
      ;;
  esac
done
[ "$fbcon" = ok ] && ok 'framebuffer console' 'off the panel' \
  || bad 'framebuffer console' "$fbcon"

if [ -c /dev/fb0 ]; then
  dirty=$(python3 -c 'print(sum(1 for b in open("/dev/fb0","rb").read() if b))' 2>/dev/null || echo unknown)
  [ "$dirty" = 0 ] && ok 'framebuffer content' 'empty' || bad 'framebuffer content' "$dirty bytes set"
else
  ok 'framebuffer content' 'no fbdev'
fi

# The other product's prefix is not in this product's binaries.
#
# MediaBox has its own Rockchip media runtime. If a playback binary still
# resolves libraries out of /opt/rk3588-screenbridge, the isolation this
# appliance depends on has come undone -- and on a board carrying both products
# that means one of them decides what the other decodes with.
foreign=0
for p in /opt/rk3588-mediabox/player/bin/mpv /opt/rk3588-mediabox/kodi/lib/kodi/kodi-gbm; do
  [ -x "$p" ] || continue
  ldd "$p" 2>/dev/null | grep -q '/opt/rk3588-screenbridge' && foreign=$((foreign + 1))
done
[ "$foreign" -eq 0 ] && ok 'media runtime' 'MediaBox owns it' \
  || bad 'media runtime' "$foreign binaries resolve the ScreenBridge prefix"

# Nothing left over from a previous film.
orphans=$(pgrep -c -x mpv 2>/dev/null || true)
[ "${orphans:-0}" -eq 0 ] && ok 'orphan players' none || bad 'orphan players' "$orphans mpv"

echo "== native shell smoke $([ "$fails" -eq 0 ] && echo PASS || echo FAIL)"
[ "$fails" -eq 0 ]
