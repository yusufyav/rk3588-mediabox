#!/bin/sh
#
# Is the television actually showing the product?
#
# The unit reporting "running" says nothing about what is on the panel, so every
# check here is against something the appliance itself reports: the journal the
# shell wrote on this start, the display controller's own state, and the
# process table. A screenshot is not evidence and neither is a green unit.
set -eu
UNIT=mediabox-tv-ui.service
BIN="${MEDIABOX_TV_BIN:-/opt/rk3588-mediabox/bin/mediabox-tv}"
SETTLE="${MEDIABOX_UI_SETTLE:-12}"
fails=0
ok()  { printf '  PASS  %-24s %s\n' "$1" "$2"; }
bad() { printf '  FAIL  %-24s %s\n' "$1" "$2"; fails=$((fails + 1)); }
echo '== native shell smoke'
# Anchored to the restart rather than to "now minus the settle time": the
# platform and GPU lines are printed in the first second the unit is up, and a
# window measured backwards from the end of the sleep starts after them. It
# failed a working shell that way -- "split path absent" on a television that
# was showing the home screen.
since=$(date '+%Y-%m-%d %H:%M:%S')
systemctl restart "$UNIT"
sleep "$SETTLE"
state=$(systemctl show "$UNIT" -p SubState --value)
[ "$state" = running ] && ok unit "$state" || bad unit "$state"
pid=$(pgrep -f -- "$BIN" | head -1 || true)
[ -n "$pid" ] && ok interface "pid $pid" || bad interface 'not running'
log=$(journalctl -u "$UNIT" --since "$since" --no-pager 2>/dev/null || true)
printf '%s\n' "$log" | grep -q 'split-kms.*gbm=armsoc.*display=/dev/dri/card0' && ok platform 'renderD128 -> card0' || bad platform 'split path absent'
printf '%s\n' "$log" | grep -q 'EGL_VENDOR=ARM.*GL_RENDERER=Mali-G610' && ok gpu 'ARM / Mali-G610' || bad gpu 'vendor GPU absent'
printf '%s\n' "$log" | grep -q 'present dma-buf=active' && ok scanout 'PRIME FB active' || bad scanout 'no PRIME FB'
printf '%s\n' "$log" | grep -q 'first_data_ms=' && ok home 'real data loaded' || bad home 'data absent'
mode=$(sed -n 's/.*crtc-pos=\([0-9]*x[0-9]*\).*/\1/p' /sys/kernel/debug/dri/0/state 2>/dev/null | head -1)
native=$(printf '%s\n' "$log" | sed -n 's/.*native=\([0-9]*x[0-9]*\).*/\1/p' | tail -1)
[ -n "$mode" ] && [ "$mode" = "$native" ] && ok 'native mode' "$mode" || bad 'native mode' "KMS=${mode:-none} app=${native:-none}"
if pgrep -x sway >/dev/null || pgrep -f 'chromium.*mediabox-ui/chromium' >/dev/null; then bad compositor 'still present'; else ok compositor 'none'; fi

# The framebuffer cache. Each of the GBM surface's buffers should need exactly
# one PRIME import and one ADDFB2 for the life of the process; a number that
# keeps climbing is the per-frame import path that used to cost four ioctls on
# the display device every frame.
buffers=$(printf '%s\n' "$log" | grep -c 'scanout-buffer n=' || true)
[ "$buffers" -ge 1 ] && [ "$buffers" -le 4 ] \
  && ok 'scanout buffers' "$buffers imported once" \
  || bad 'scanout buffers' "${buffers:-0} imports in ${SETTLE}s"

# The remote is not a power button. This is the fault that opened this
# milestone: the HDMI block's CEC input device carried udev's power-switch tag,
# systemd-logind watched it, and a code from the television restarted the
# appliance. Three locks, each checked.
cec_event=$(grep -l 'dw_hdmi_qp' /sys/class/input/event*/device/name 2>/dev/null | head -1 | sed 's#/sys/class/input/\(event[0-9]*\)/.*#\1#')
if [ -n "$cec_event" ]; then
  tags=$(udevadm info "/dev/input/$cec_event" 2>/dev/null | sed -n 's/^E: CURRENT_TAGS=//p')
  case "$tags" in
    *power-switch*) bad 'cec power tag' "$cec_event still tagged$tags" ;;
    *)              ok  'cec power tag' "$cec_event untagged" ;;
  esac
  # Since logind's own last start, not since boot: the rule is applied while
  # the appliance is running, and what logind was watching before it was
  # applied is history rather than a fault.
  logind_since=$(systemctl show systemd-logind.service -p ActiveEnterTimestamp --value)
  if journalctl --no-pager -u systemd-logind.service \
      ${logind_since:+--since "$logind_since"} 2>/dev/null \
      | grep -q "Watching system buttons on /dev/input/$cec_event"; then
    bad 'logind buttons' "watching $cec_event"
  else
    ok 'logind buttons' "not watching $cec_event"
  fi
else
  bad 'cec power tag' 'no dw_hdmi_qp input device'
fi
power_key=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager HandlePowerKey 2>/dev/null | awk '{print $2}' | tr -d '"')
reboot_key=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager HandleRebootKey 2>/dev/null | awk '{print $2}' | tr -d '"')
[ "$power_key" = ignore ] && [ "$reboot_key" = ignore ] \
  && ok 'logind keys' 'power/reboot ignored' \
  || bad 'logind keys' "power=${power_key:-?} reboot=${reboot_key:-?}"
[ "$(systemctl is-enabled ctrl-alt-del.target 2>&1)" = masked ] \
  && ok 'ctrl-alt-del' masked \
  || bad 'ctrl-alt-del' "$(systemctl is-enabled ctrl-alt-del.target 2>&1)"

# Nothing left over from a previous film.
orphans=$(pgrep -c -x mpv 2>/dev/null || true)
[ "${orphans:-0}" -eq 0 ] && ok 'orphan players' none || bad 'orphan players' "$orphans mpv"

echo "== native shell smoke $([ "$fails" -eq 0 ] && echo PASS || echo FAIL)"
[ "$fails" -eq 0 ]
