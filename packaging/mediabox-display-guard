#!/bin/sh
#
# Nobody leaves the television to a blank console.
#
# Kodi can end for reasons this box did not ask for: the person chose Exit, a
# playback fault brought it down, the unit was restarted. When it does, DRM
# master is released and nothing takes it -- the panel falls to a Linux login
# prompt, which is what a person sees as "the box crashed".
#
# This runs as kodi.service's ExecStopPost, and it has exactly one decision to
# make: did somebody ask for this, or did Kodi just end?
#
#   asked for -- the control plane stopped Kodi in order to start something
#                else, and that something is already on its way up. Nothing to
#                do, and doing something would be worse than nothing.
#
#   just ended -- nobody is coming. Put the interface back, now.
#
# `systemctl stop` does not return until this script has, so whatever it does
# it has to do in milliseconds.
set -eu

LOCK="${MEDIABOX_TRANSITION_LOCK:-/run/mediabox/display-transition.lock}"
RECOVER="${MEDIABOX_DISPLAY_RECOVER:-/opt/rk3588-mediabox/bin/mediabox-display-recover}"

# The question, asked of the control plane's own gate.
#
# mediaboxd-rs holds an advisory lock on that file for exactly as long as a
# display handover runs -- see rust/crates/mediaboxd-rs/src/transition.rs. So
# "is a transition running" is one non-blocking flock away, with no round trip
# to the daemon, no second guess about what it is doing, and no way to hang on
# a daemon that is busy or gone.
#
# It has to be non-blocking and it has to stay that way. Waiting for the lock
# here is precisely the deadlock b34a48a fixed: the control plane is inside
# `systemctl stop kodi`, and `systemctl stop` is waiting for this script.
#
# Reading it wrong is safe in one direction only, and that is the direction it
# fails in: a lock we cannot test reads as "nobody asked", which queues a
# recovery that the daemon serialises behind any real transition anyway.
busy=0
flock -n -E 9 "$LOCK" true >/dev/null 2>&1 || busy=$?
[ "$busy" -eq 9 ] && exit 0

# Nobody asked. The interface goes back, and it does not wait for a clock to
# say so: there is no grace period here because there is nothing to be graceful
# about -- the display has no owner and every millisecond of that is black
# screen. This replaced a 150-turn poll that cost a flat 15 s of sleep plus
# ~450 systemctl invocations, measured on the appliance at 20.758 s of nothing
# between Kodi going inactive and the interface being asked for.
#
# systemd-run and not `setsid ... &`, because a background child is still in
# kodi.service's cgroup and KillMode=mixed takes the cgroup down with the unit:
# measured, the detached half was killed before it could look, and a Kodi that
# had been killed outright left the television on nothing. A transient unit has
# a cgroup of its own and outlives the stop. --no-block is what keeps this from
# being the same deadlock in a different shape.
#
# After=kodi.service is what keeps the successor from racing the teardown. The
# kernel releases DRM master when the last descriptor closes, which is when the
# unit's processes are reaped and not when this script returns; ordering the
# transient start after kodi.service's own stop job is the real state condition
# that a sleep used to approximate.
systemd-run --no-block --quiet --collect \
  --unit=mediabox-display-recover \
  --property=After=kodi.service \
  "$RECOVER" || true

exit 0
