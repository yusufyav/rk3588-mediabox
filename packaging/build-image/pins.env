# What every aarch64 build of MediaBox is made from. One place, read by
# scripts/build-container.sh, scripts/build-gstreamer-runtime.sh and
# scripts/build-mppvideodec.sh.
#
# Nothing here is "latest": the base image by digest, Debian by a
# snapshot.debian.org date, rustup by version and sha256. The Rust toolchain
# is rust/rust-toolchain.toml.

# Debian trixie, amd64, the image the GStreamer runtime has been built in.
MEDIABOX_BUILD_BASE_IMAGE="debian@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1"
# Every Debian package, the cross compiler and glibc among them.
MEDIABOX_BUILD_SNAPSHOT="20261101T000000Z"
# rustup-init for x86_64-unknown-linux-gnu, from static.rust-lang.org.
MEDIABOX_RUSTUP_VERSION="1.29.3"
MEDIABOX_RUSTUP_SHA256="b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55"
