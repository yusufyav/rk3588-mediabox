[Unit]
Description=Web browser on the television (sway + Chromium kiosk)
Documentation=https://github.com/yusufyav/rk3588-mediabox
After=mediaboxd-rs.service
Wants=mediaboxd-rs.service
# Kodi and this unit both want DRM master and only one may have it. The
# ordering below is advisory; the real interlock is mediaboxd-rs, which stops
# one before starting the other. Nothing here is enabled at boot for the same
# reason: whoever owns the display decides, not systemd's default target, and
# a console session at tty1 is never taken over on its own.
Conflicts=kodi.service mediabox-tv-ui.service
# Hardware this box does not own alone.
#
# rk3588-screenbridge is a second product for this silicon and may be installed
# on the same board. Its daemon owns DRM master, the HDMI TX PCM and the RGA and
# MPP devices while it is capturing, and DRM master cannot be held twice: two
# processes reaching for it is not a degraded picture, it is whichever one lost
# failing in a way that reads as a broken appliance.
#
# So the two are declared incompatible and ordered. `Conflicts=` alone would let
# systemd start this unit while the other was still letting go; the `After=`
# beside it is what makes the stop happen first, which is the documented way to
# get a transition rather than a race. Neither line does anything on a board
# where that product is not installed.
#
# This is deliberately not a role manager. Which application owns the television
# is mediaboxd-rs's decision and stays there; this is only the interlock that
# makes the decision land safely when the other product is on the board too.
Conflicts=screenbridge-daemon.service
After=screenbridge-daemon.service

[Service]
Type=simple
# The compositor acquires DRM master through libseat, which on this appliance means
# running as root — the same arrangement Kodi already has, and for the same
# reason. Chromium then refuses its own setuid sandbox, so it is disabled and
# the loss is made up for by the confinement below plus the fact that this
# browser has no address bar and no extensions. Unlike the product UI this one
# does reach the open web, which is the whole point of it; the confinement
# below and a profile of its own are what keep that contained.
User=root
RuntimeDirectory=mediabox-browser
RuntimeDirectoryMode=0700
StateDirectory=mediabox-browser
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mediabox-browser
Environment=HOME=/var/lib/mediabox-browser
# A real login session, which is what libseat needs to be handed the DRM
# device: without one it falls back to a seatd session that never becomes
# active, and the compositor cannot create a GBM device at all.
PAMName=login
# Its own virtual terminal, so bringing the UI up does not take the console
# somebody may be using at tty1 until the display genuinely changes hands.
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-force
# And bring that terminal forward, which is the half that was missing.
#
# libseat hands over the DRM device only once the session is *active*, and a
# session is active only while its VT is the foreground one. The unit gets
# tty8, tty1 keeps the getty, and nothing was moving the console between them:
# sway sat waiting and gave up, every time, with
#
#     [wlr] Timeout waiting session to become active
#     [wlr] failed to add backend 'drm'
#     [sway] Unable to create backend
#
# measured on the Plus, where the session was formed correctly throughout —
# VTNr=8, Seat=seat0, Type=wayland, State=online — and only Active stayed "no".
# Switching to tty8 by hand at that moment let the backend come up and Chromium
# start, which is what pinned it down. This is not a property of one board: the
# unit asks for a terminal of its own, so it has to ask for it to be shown.
ExecStartPre=/usr/bin/chvt 8
# The mode this board's cable can carry is *not* measured here, although sway
# is told it: `mediabox-hdmi-prepare` writes it into /run/mediabox, and this
# unit is confined out of that directory on purpose -- the control plane's
# socket lives there and a browser has no business writing to it. The
# interface runs that step before every start of its own and this unit is only
# ever started by the interface handing the display over, so the file is there
# by the time sway reads it. If it is not, sway's `include` of a missing file
# is not an error and the compositor falls back to choosing for itself.
# And back to tty1 on the way out, so stopping the browser does not leave the
# console parked on an empty terminal. Tolerant: a failure here must not turn
# an ordinary stop into a failed unit.
ExecStopPost=-/usr/bin/chvt 1
# The private Mali runtime is the one Kodi uses; wlroots needs it for a
# GPU-accelerated compositor. The media runtime is deliberately still not on
# this line: the decoder reaches it through the RPATH in the VA-API driver
# below, so the compositor's GL stack cannot be shadowed by a library that
# happens to share a name with one of Rockchip's.
Environment=LD_LIBRARY_PATH=/opt/rk3588-mediabox/mali-g24p0-runtime/lib
# The video decoder, which is a different device from the GPU above.
#
# This board's VPU is a BSP device: it is /dev/mpp_service, a Rockchip ioctl
# interface, and there is no /dev/video* on it at all. Chromium's accelerated
# decode on Linux is VA-API, so without a VA-API driver its GPU process says
# "vaInitialize failed: unknown libva error", chrome://gpu lists no decode
# profiles, and a 4K page is decoded by the CPU while the line at the top of
# chrome://gpu still reads "Video Decode: Hardware accelerated".
#
# scripts/build-vaapi-driver.sh puts a driver bridging libva onto this
# product's own MPP at the path below. Named rather than searched for: libva
# probes the render node for a driver name and would find none, and Chromium's
# own documentation for this is that the name has to be in the environment
# because the browser cannot auto-detect it from inside its GPU process.
Environment=LIBVA_DRIVER_NAME=rockchip
Environment=LIBVA_DRIVERS_PATH=/opt/rk3588-mediabox/media-runtime/lib/dri
# drm *and* libinput. Naming only the DRM backend gives a compositor that
# lights up the television and has no input devices at all: no keyboard, no
# remote, nothing. The list is explicit so the backend set cannot drift.
Environment=WLR_BACKENDS=drm,libinput
# Without a GPU the compositor should still come up rather than leave the
# television black.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
# Direct scanout hands a fullscreen client's own buffer to the display
# controller. It saves a copy, and it is also how a browser repainting that
# buffer ends up visible as horizontal tearing partway down the screen: the
# scanout is reading it while Chromium is still drawing into it. Compositing
# through wlroots costs one blit per frame and presents whole frames.
Environment=WLR_SCENE_DISABLE_DIRECT_SCANOUT=1
# Damage tracking off: the compositor redraws the whole output every frame
# rather than only the region the client reports as changed.
#
# Chromium under-reports its damage to the Wayland surface on this board, and
# what is left behind is the previous frame: after switching screens the
# television showed the settings panel standing on the home screen's backdrop
# and poster shelf, both of which had been gone from the page for seconds. It
# was verified in both directions — with this set the screen is clean, with it
# unset the remnants come back on an otherwise identical build — and disabling
# Chromium's own partial swap changes nothing, so it is the compositor's
# bookkeeping rather than the browser's.
#
# It is close to free here, which is why it is acceptable: navigation CPU
# measured 83.5% of one core out of eight without it and 79.0% with it, idle
# under 1.5%, and frame time is unchanged at a solid 16.7 ms with no frame over
# 20 ms in either configuration.
Environment=WLR_SCENE_DEBUG_DAMAGE=rerender
# XDG_RUNTIME_DIR is set at exec time rather than with Environment=, because
# the PAM session above sets its own and would win. Pointing it at this unit's
# RuntimeDirectory is what lets ProtectHome stay on: ProtectHome also hides
# /run/user, where the Wayland socket would otherwise have to live.
ExecStart=/usr/bin/env XDG_RUNTIME_DIR=/run/mediabox-browser /usr/bin/sway -c /etc/mediabox/sway-browser.conf
# The browser is launched from the sway config, which exits with it. Stopped
# and started by mediaboxd-rs when the display changes hands, so an ordinary
# stop is never a failure to recover from.
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=mixed
StandardOutput=journal
StandardError=journal

# Confinement. Everything here was checked against a running kiosk: the
# browser needs a JIT, so W^X is deliberately not enforced, and it needs
# netlink to notice the network coming and going.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Devices, as a namespace rather than as a cgroup rule.
#
# This unit asks for PAMName=login, because libseat is handed the DRM device
# only inside a real login session. pam_systemd answers that request by moving
# the processes out of this unit's cgroup and into a login session scope:
#
#     sway and chromium   /user.slice/user-0.slice/session-437.scope
#     this unit           /system.slice/mediabox-browser.service
#
# Everything systemd enforces through the cgroup leaves with them. Measured on
# the Plus, with /dev/loop-control -- a node no line here has ever granted:
# a scope carrying exactly the DeviceAllow list below refuses it with EPERM,
# and the identical open inside the running browser succeeds. So DevicePolicy
# and DeviceAllow, by themselves, were a rule written about a cgroup the
# browser does not live in, and the confinement this section claimed was in
# part not there.
#
# What does survive is the mount namespace: it is built at exec and inherited
# by every child, whatever cgroup that child is moved to afterwards.
# PrivateDevices gives this unit a /dev of its own carrying nothing but the
# kernel's harmless pseudo-devices, and each line below puts back one device
# this browser has a reason to touch. A node not named here does not exist for
# the browser -- not "is refused", does not exist -- which is the same answer
# whether or not the cgroup rule is reaching it.
#
# /dev/dri arrives whole, and one node inside it is taken away again.
#
# The whole directory, because libseat enumerates every DRM device the login
# session owns and hands wlroots the list. Binding only the display's card and
# leaving the NPU's out was measured on the Plus and is not survivable:
#
#     [libseat] Could not stat path '/dev/dri/card1'
#     [wlr] Failed to create GBM device
#     [wlr] Could not initialize renderer
#     [sway] Failed to create renderer
#
# -- sway exits on the first device it cannot stat, and the television stays
# black. So the NPU's card stays visible.
#
# The NPU's *render* node is a different matter and is not settled here. That
# node is the one Chromium looks at: the Ozone layer scans /dev/dri for
# something to run video on, says "Preferred drm_render_node not found" and
# takes what enumeration hands it. Under Weston it took the neural accelerator
# -- "picking rknpu" -- initialised VA-API against it, listed nothing under
# Decoding on chrome://gpu, and a 4K VP9 page fell to the CPU at 571% of one
# core against 131% with the right node, same clip, same second. Under sway it
# takes the display's node, which is the configuration this product ships, so
# the hazard is latent rather than live.
#
# Closing it by naming renderD129 here was tried and rejected: that number is
# what one kernel handed out on one board on one boot, which is what platform
# discovery is for and what tests/run-host-tests.sh refuses in a unit file.
# mediabox-browser-verify asks the running browser which node it actually took,
# which is the question that survives a board with a different enumeration.
PrivateDevices=yes
BindPaths=/dev/dri
BindPaths=/dev/mali0
# Where the GL stack gets its buffers. Measured rather than guessed: a running
# compositor holds nine handles on /dev/dma_heap/system, and without it Mali's
# GBM cannot allocate at all --
#
#     [wlr] Failed to create GBM device
#     [wlr] Could not initialize renderer
#
# on an otherwise complete /dev.
BindPaths=/dev/dma_heap
BindPaths=/dev/input
BindPaths=/dev/snd
# chvt, which this unit runs before and after itself, opens /dev/tty0; the
# session's own terminal is tty8.
BindPaths=/dev/tty0
BindPaths=/dev/tty8
# The video decoder and the 2D block it hands 10-bit frames to. Without the
# first of them the VA-API driver loads, advertises its profiles and then
# fails on the first frame -- which looks exactly like a decoder that is not
# configured, and is not.
BindPaths=/dev/mpp_service
BindPaths=/dev/rga
# The cgroup rule is kept beside it rather than dropped, so that a kernel or a
# systemd that stops moving this unit into a session scope tightens the
# confinement instead of quietly widening it.
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=/dev/mali0 rw
DeviceAllow=/dev/mpp_service rw
DeviceAllow=/dev/rga rw
DeviceAllow=char-input rw
DeviceAllow=char-alsa rw
DeviceAllow=char-tty rw
ReadWritePaths=/var/lib/mediabox-browser /run/mediabox-browser

[Install]
WantedBy=multi-user.target
