[Unit]
Description=Kodi media player (GBM/DRM standalone, RK3588)
After=systemd-udev-settle.service network.target
Wants=systemd-udev-settle.service
# Hardware this box does not own alone.
#
# rk3588-screenbridge is a second product for this silicon and may be installed
# on the same board. Its daemon owns DRM master, the HDMI TX PCM and the RGA and
# MPP devices while it is capturing, and DRM master cannot be held twice: two
# processes reaching for it is not a degraded picture, it is whichever one lost
# failing in a way that reads as a broken appliance.
#
# So the two are declared incompatible and ordered. `Conflicts=` alone would let
# systemd start this unit while the other was still letting go; the `After=`
# beside it is what makes the stop happen first, which is the documented way to
# get a transition rather than a race. Neither line does anything on a board
# where that product is not installed.
#
# This is deliberately not a role manager. Which application owns the television
# is mediaboxd-rs's decision and stays there; this is only the interlock that
# makes the decision land safely when the other product is on the board too.
Conflicts=screenbridge-daemon.service
After=screenbridge-daemon.service

[Service]
# Stopping Kodi is a normal event here, not a fault: the control plane stops it
# whenever the display changes hands. Kodi does not always unwind cleanly when
# it is holding DRM master and is asked to go — measured as
# `Result=signal, ExecMainStatus=6` — which left the unit in "failed" and made
# every later status read look like something had broken.
SuccessExitStatus=6 SIGABRT SIGTERM SIGKILL
Type=simple
# Kodi owns the display and reads the physical input devices directly. It is
# started by systemd, never as a child of another service, so that the context
# it runs in is the same at boot and after every restart: same unit, same user,
# same environment, same access to udev and /dev/input.
#
# This unit is deliberately NOT sandboxed the way mediaboxd is. Kodi discovers
# keyboards and remotes through a udev netlink monitor, so a unit that filtered
# address families would leave it with no input devices at all — which is
# exactly what happened while it was being spawned from inside mediaboxd.
User=root
WorkingDirectory=/var/tmp/kodi-home
Environment=HOME=/var/tmp/kodi-home
Environment=AE_SINK=ALSA
Environment=MEDIABOX_GPU=mali
# The vendor GL user space only. Kodi's FFmpeg is linked statically and the
# Rockchip MPP and RGA libraries it pulls in come from the RPATH the build put
# in kodi-gbm, naming MediaBox's own media runtime — so this line cannot point
# the decoder somewhere else by accident, which is what it used to be able to do
# when it named the other product's prefix.
Environment=LD_LIBRARY_PATH=/opt/rk3588-mediabox/mali-g24p0-runtime/lib
ExecStartPre=/bin/mkdir -p /var/tmp/kodi-home/.kodi/temp /var/tmp/kodi-home/.kodi/userdata
# Give Kodi this appliance's settings the first time it runs, and only then.
#
# Without them Kodi comes up with its own defaults, and its own defaults have
# the control endpoint switched off -- which is how the control plane hands a
# film over. A clean install therefore started Kodi perfectly and could not
# move anything into it: the television showed an empty library while the
# daemon's Player.Open went to a port nobody was listening on. The old deploy
# script seeded this file; the installer did not, and nothing noticed.
#
# `test -f` and not an overwrite: after the first run the file is the user's,
# with whatever they changed in Kodi's own settings screens.
ExecStartPre=/bin/sh -c 'test -f /var/tmp/kodi-home/.kodi/userdata/guisettings.xml || install -m 0644 /opt/rk3588-mediabox/share/kodi/guisettings-appliance.xml /var/tmp/kodi-home/.kodi/userdata/guisettings.xml'

# The sink's EDID and the codec's ELD bypass, both of which are runtime state
# that is lost on every restart. Without them Kodi cannot see that the panel
# does HDR10 and the HDMI codec will not pack an audio bitstream.
ExecStartPre=-/opt/rk3588-mediabox/bin/mediabox-hdmi-prepare
ExecStart=/opt/rk3588-mediabox/kodi/lib/kodi/kodi-gbm --standalone --debug
# Whatever ends Kodi, the television does not end with it: if nothing else has
# taken the display by then, the interface is brought back. Without this the
# panel drops to a console, which is how a person reads "it crashed".
ExecStopPost=-/opt/rk3588-mediabox/bin/mediabox-display-guard

# Kodi exits on Application.Quit; that is a normal stop, not a failure.
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillMode=mixed
StandardInput=null
StandardOutput=append:/var/tmp/kodi-home/kodi-stdout.log
StandardError=inherit

# No [Install] section, and that is the point.
#
# Being a unit and being started at boot are different things. This unit exists
# for the reasons above — an unsandboxed context with udev and /dev/input, a
# stop that does not read as a failure, the HDMI preparation before every
# start — none of which require systemd to bring it up on its own.
#
# Enabled, it was: `WantedBy=multi-user.target` started the player at boot, it
# took DRM master, and a cold box came up in Kodi instead of on the home
# screen. Which process owns the panel is mediaboxd-rs's decision; it claims
# the display for the interface at startup and starts this unit when something
# is actually asked to play.
