[Unit]
Description=MediaBox native Slint appliance shell (Mali GBM + Rockchip KMS)
# The daemon, the media worker and the network. The catalogue is a fan-out over
# third-party hosts through the worker, and on a cold boot this unit used to ask
# for it sixteen milliseconds after starting — before the network was up — take
# the refusal as the answer, and show an empty television until something
# restarted it. The interface retries now; this is so it rarely has to.
After=mediaboxd-rs.service mediabox-media-worker.service network-online.target
Wants=mediaboxd-rs.service network-online.target
Conflicts=kodi.service mediabox-browser.service
# Hardware this box does not own alone.
#
# rk3588-screenbridge is a second product for this silicon and may be installed
# on the same board. Its daemon owns DRM master, the HDMI TX PCM and the RGA and
# MPP devices while it is capturing, and DRM master cannot be held twice: two
# processes reaching for it is not a degraded picture, it is whichever one lost
# failing in a way that reads as a broken appliance.
#
# So the two are declared incompatible and ordered. `Conflicts=` alone would let
# systemd start this unit while the other was still letting go; the `After=`
# beside it is what makes the stop happen first, which is the documented way to
# get a transition rather than a race. Neither line does anything on a board
# where that product is not installed.
#
# This is deliberately not a role manager. Which application owns the television
# is mediaboxd-rs's decision and stays there; this is only the interlock that
# makes the decision land safely when the other product is on the board too.
Conflicts=screenbridge-daemon.service
After=screenbridge-daemon.service

[Service]
Type=simple
User=root
RuntimeDirectory=mediabox-ui
RuntimeDirectoryMode=0700
StateDirectory=mediabox-ui
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mediabox-ui
Environment=HOME=/var/lib/mediabox-ui
# No display device is named here, and that is the change worth noticing. Which
# DRM device sets modes, which one renders, and which connector the television
# is on are discovered at start — see docs/platform/runtime-discovery.md. The
# two variables that used to be on these lines named this board's numbers, and
# on a board whose NPU probes first they name the NPU.
#
# Only the vendor GL user space is on the library path. The interface links
# libEGL and libgbm by their generic sonames, so first match decides the whole
# GL stack; it does not link the media runtime at all, which is the player's
# and Kodi's business and reached through their own RPATHs.
Environment=LD_LIBRARY_PATH=/opt/rk3588-mediabox/mali-g24p0-runtime/lib
ExecStartPre=-/opt/rk3588-mediabox/bin/mediabox-hdmi-prepare
ExecStart=/opt/rk3588-mediabox/bin/mediabox-tv
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=mixed
ExecStopPost=-/opt/rk3588-mediabox/bin/mediabox-ui-reap
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
# The DRM subsystem rather than two device nodes by name: the numbers differ
# between boards and between boots, and a unit that names them confines the
# interface away from the very devices discovery just chose.
DeviceAllow=char-drm rw
DeviceAllow=/dev/mali0 rw
DeviceAllow=/dev/dma_heap/system rw
DeviceAllow=/dev/dma_heap/system-uncached rw
DeviceAllow=/dev/dma_heap/reserved rw
DeviceAllow=char-input rw
ReadWritePaths=/var/lib/mediabox-ui /run/mediabox-ui

[Install]
WantedBy=multi-user.target
