[Unit]
Description=MediaBox native Slint appliance shell (Mali GBM + Rockchip KMS)
After=mediaboxd-rs.service
Wants=mediaboxd-rs.service
Conflicts=kodi.service mediabox-browser.service

[Service]
Type=simple
User=root
RuntimeDirectory=mediabox-ui
RuntimeDirectoryMode=0700
StateDirectory=mediabox-ui
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mediabox-ui
Environment=HOME=/var/lib/mediabox-ui
Environment=MEDIABOX_RENDER_NODE=/dev/dri/renderD128
Environment=MEDIABOX_KMS_NODE=/dev/dri/card0
Environment=LD_LIBRARY_PATH=/opt/rk3588-mediabox/mali-g24p0-runtime/lib:/opt/rk3588-screenbridge/lib
ExecStartPre=-/opt/rk3588-mediabox/bin/mediabox-hdmi-prepare
ExecStart=/opt/rk3588-mediabox/bin/mediabox-tv
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=mixed
ExecStopPost=-/opt/rk3588-mediabox/bin/mediabox-ui-reap
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/mali0 rw
DeviceAllow=/dev/dma_heap/system rw
DeviceAllow=/dev/dma_heap/system-uncached rw
DeviceAllow=/dev/dma_heap/reserved rw
DeviceAllow=char-input rw
ReadWritePaths=/var/lib/mediabox-ui /run/mediabox-ui

[Install]
WantedBy=multi-user.target
