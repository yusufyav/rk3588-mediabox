[Unit]
Description=RK3588 MediaBox Rust control plane
After=network.target systemd-udev-settle.service mediabox-media-worker.service kodi.service
Wants=network.target systemd-udev-settle.service mediabox-media-worker.service
# The display's hardware state comes from the observer and from nowhere else,
# so it runs wherever the control plane does. Not ordered: until it has
# published, the control plane says it does not know the display yet.
Wants=mediabox-display-observer.service

[Service]
Type=simple
# The table of applications this box can put on the television. Adding a
# browser or a screen receiver later is a row in that file, not a change here.
# No --require-cec.
#
# CEC is a capability of the output this box is on, not a property of the
# product. DisplayPort carries none at all, and a board with two HDMI sockets
# has an adapter per socket — so an appliance on a DisplayPort monitor, or one
# with nothing plugged in yet, would be an appliance whose control plane refuses
# to start. It reports CEC as unavailable instead, which `mediaboxctl status`
# shows and the interface draws honestly. Which adapter it holds is resolved
# from the selected output; see docs/platform/runtime-discovery.md.
ExecStart=/opt/rk3588-mediabox/bin/mediaboxd-rs \
  --applications /etc/mediabox-applications.json \
  --http 127.0.0.1:8787 \
  --lan-http 0.0.0.0:8788 \
  --ui-root /opt/rk3588-mediabox/ui \
  --ui-unit mediabox-tv-ui.service \
  --media-endpoint http://127.0.0.1:8790
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
RuntimeDirectory=mediabox
RuntimeDirectoryMode=0750
# /var/lib/mediabox, where the chosen indicator-light mode is remembered. The
# kernel puts the device tree's heartbeat back on every boot; this file is how
# the daemon knows to take it off again.
StateDirectory=mediabox
StateDirectoryMode=0750
UMask=0027

# Kodi and the TV-local UI remain independently managed direct-KMS services.
# This unit only starts and stops them through a fixed systemctl argv, and it
# is the single place that ordering lives.
#
# The LAN listener serves the same UI and the same control endpoint to the
# home network, and admits private-network peers only. The media worker stays
# bound to loopback: anything a browser needs from it is relayed by this
# daemon, so there is never a second authority on the network.
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# AF_NETLINK is here for the radios: every Wi-Fi operation below -- scanning,
# reading the link, bringing the interface up -- is nl80211, which is generic
# netlink. Without it `iw` fails with "Failed to connect to generic netlink"
# and the settings screen reports no networks on a board whose radio is fine.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
# The CEC subsystem rather than one adapter by number: a board with two HDMI
# transmitters has two, and which one is the television's depends on which
# socket the television is in.
DeviceAllow=char-cec rw
# The radios. Switching Wi-Fi or Bluetooth on is a write to /dev/rfkill, and
# with DevicePolicy=closed that node is not there at all: rfkill exits
# non-zero, the daemon reports "powered: null", and the settings screen can
# show the state of a radio it cannot touch. Measured on the Plus.
DeviceAllow=/dev/rfkill rw
# The browser's address drop. This interface chooses a web address and the
# daemon leaves it here for the browser to read once at start; with
# ProtectSystem=strict and nothing else named, that write failed with
# "Read-only file system" and the browser could only ever open its built-in
# home page.
ReadWritePaths=/run/mediabox /var/lib/mediabox-browser
# The board's two indicator lights. ProtectKernelTunables mounts /sys
# read-only, which is right for everything else under it, so the one platform
# device whose brightness this daemon is allowed to write is named here and
# nothing else under /sys is opened up. The leading dash keeps the unit
# startable on a board that has no gpio-leds device at all, where the daemon
# simply reports that there is nothing to control.
ReadWritePaths=-/sys/devices/platform/gpio-leds
# Wi-Fi networks the viewer has joined.
#
# /etc/netplan because that is what configures networking on these boards --
# Armbian's own Ethernet file lives there and netplan renders it into
# systemd-networkd -- and this daemon writes a second file beside it rather
# than introducing a competing network manager. /var/lib/mediabox holds the
# derived keys; the passphrase itself is never written anywhere.
#
# Both are 0600 and both are the daemon's alone. ProtectSystem=strict makes
# /etc read-only, so without the first line a viewer can pick a network, type
# a password and watch it fail with "Read-only file system".
ReadWritePaths=/etc/netplan /var/lib/mediabox
# A wired port's address on trial lives under /run/netplan, so a reboot takes
# it back; netplan generate renders into /run/systemd/network.
ReadWritePaths=-/run/netplan -/run/systemd/network
# The fan's curve for the next boot, and nothing else under /boot.
#
# The kernel's pwm-fan drives the fan; a curve chosen in the settings screen is
# written as a device-tree overlay that the boot loader applies. The daemon
# writes exactly one file, mediabox-fan-curve.dtbo, beside the other user
# overlays -- written next to the old one and renamed over it, which is why the
# directory is named and not the file. armbianEnv.txt stays read-only here: the
# entry that loads the curve is put there once, by mediabox-fan-setup, as root
# at install time. The leading dash keeps the unit startable on a board with no
# user overlay directory, where saving a curve is refused and says why.
ReadWritePaths=-/boot/overlay-user

[Install]
WantedBy=multi-user.target
