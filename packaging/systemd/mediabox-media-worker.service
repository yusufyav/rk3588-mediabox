[Unit]
Description=RK3588 MediaBox local media worker
After=network.target stremio-server.service
Wants=network.target stremio-server.service
Before=mediaboxd-rs.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/rk3588-mediabox
# The product's own FFmpeg comes first, and the reason is not preference.
#
# The worker probes every source with ffprobe before anything can play, and it
# finds it the way any program does: on PATH. Without this line the unit gets
# systemd's default PATH, which does not contain this appliance, so on a clean
# board the probe fails with "ffprobe binary not found" -- and because the probe
# is upstream of everything, the television's own player never gets as far as
# being started. It reads as "the player is broken"; nothing was ever launched.
#
# It worked on the board this release was captured from only because Debian's
# ffmpeg package happened to be installed there, which also meant the appliance
# was probing with a stock FFmpeg instead of the one it ships -- the one built
# against Rockchip MPP and RGA. Naming the prefix fixes the clean install and
# stops the product depending on a package it never asked for.
Environment=PATH=/opt/rk3588-mediabox/media-runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/mediabox-media-worker.env
ExecStart=/usr/bin/python3 -m media.server --bind 127.0.0.1 --port 8790 --streaming-server http://127.0.0.1:11470 --state /var/lib/mediabox-media-worker/stremio-session.json --base-url http://127.0.0.1:8790 --loopback-base-url http://127.0.0.1:8790 --library /etc/mediabox-library.json --allow-file-prefix /opt/rk3588-mediabox/assets/
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
StateDirectory=mediabox-media-worker
StateDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/mediabox-media-worker

[Install]
WantedBy=multi-user.target
