[Unit]
Description=MediaBox display observer (the display's hardware state)
# Watches the selected output -- sysfs, DRM uevents, debugfs, the device tree --
# and publishes one snapshot of it under /run/mediabox-display-observer: the
# generation, the sink's EDID identity, the topology and where audio and CEC
# may go, the kernel's mode list and the offer, and what the driver reports on
# the wire. See rust/crates/mediabox-platform/src/observer.rs.
#
# It is the only source of display hardware state: the control plane reads the
# snapshot (a directory only this unit writes) and takes no hardware facts from
# any client. It decides nothing itself.
#
# Deliberately not ordered against any owner of the display and not a part of
# the display's lifetime: it keeps no descriptor on the DRM device (the DRM
# FDStore handoff is the display's lifetime keeper, and stays that), and
# starting, stopping or crashing it changes nothing on the television.
After=local-fs.target

[Service]
Type=simple
ExecStart=/opt/rk3588-mediabox/bin/mediabox-display-observer
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s

# Its own runtime directory is the only place it writes.
RuntimeDirectory=mediabox-display-observer
RuntimeDirectoryMode=0755
# Kept across a restart of the observer (it is /run: never across a boot), so
# that the generation continues instead of starting again from 1 with the
# same content.
RuntimeDirectoryPreserve=yes
UMask=0022

# Root, with no capabilities at all. debugfs (/sys/kernel/debug, 0700 root) is
# read as its owner, which needs no capability; nothing else it reads is
# privileged. /dev/dri/card* is opened read-only and only under the rules of
# the guarded query (transition lock free, a DRM master present, closed at
# once) -- never kept, never master.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
DevicePolicy=closed
DeviceAllow=char-drm r
ProtectSystem=strict
ReadWritePaths=/run/mediabox-display-observer
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @raw-io @cpu-emulation @obsolete
# No network, and no socket to anybody: AF_NETLINK is the kernel's uevent
# broadcast (a hint to look now; the timer looks anyway).
RestrictAddressFamilies=AF_NETLINK
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
