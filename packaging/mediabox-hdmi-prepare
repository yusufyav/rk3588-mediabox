#!/bin/sh
#
# Make the television's own description of itself available before anything
# draws on it.
#
# Two faults on this appliance had one cause: the HDMI connector came up
# "connected" with no EDID at all. Measured: the connector's `edid` was 0 bytes,
# ALSA published no ELD, and the HDR_PANEL_METADATA blob was empty — so Kodi
# could not learn that the panel does HDR10 and never set HDR_OUTPUT_METADATA
# (the set is what makes a Sony enter HDR), and audio passthrough was packed
# without knowing what the sink accepts, which is silence. Forcing one detect
# produced a 256-byte EDID with the panel's real audio and HDR blocks.
#
# The ELD bypass is the second half: this board carries HDMI audio over I2S, and
# with no ELD the codec refuses to pack a bitstream. Both are runtime state and
# are lost on every restart, which is why they are done here rather than by
# hand.
#
# Everything below acts on *the output this box is on*, which is not a constant.
# This script used to say `card*-HDMI-A-*` and `amixer -c rockchiphdmi1`, and
# both are answers for a board with one HDMI socket. On a board with two, the
# first is every socket including the empty one and the second is the other
# socket's sound card — so the EDID would be forced on a connector nothing is
# attached to while the bitstream went to a television that is not there.
# mediabox-platform resolves the output, and the sound card and CEC adapter that
# belong to it, from the topology; see docs/platform/runtime-discovery.md.
set -eu

PLATFORM="${MEDIABOX_PLATFORM:-/opt/rk3588-mediabox/bin/mediabox-platform}"

connector_path="$("$PLATFORM" connector-path 2>/dev/null || true)"
connector="$("$PLATFORM" output 2>/dev/null || true)"
alsa_card="$("$PLATFORM" alsa-card 2>/dev/null || true)"
alsa_driver="$("$PLATFORM" alsa-driver 2>/dev/null || true)"

if [ -z "$connector" ]; then
  # Nothing is plugged in, or discovery could not decide. Neither is this
  # script's to fix, and neither is a reason to fail the unit that runs it:
  # whoever takes the display next reports it properly.
  echo "mediabox-hdmi-prepare: seçili bir ekran çıkışı yok" >&2
  exit 0
fi

# One forced detect, on the output that is in use.
if [ -n "$connector_path" ] && [ -e "$connector_path/status" ] && [ ! -s "$connector_path/edid" ]; then
  echo detect > "$connector_path/status" 2>/dev/null || true
fi

# There is no terminal on a television.
#
# Run here as well as at boot: this is the moment immediately before the
# interface takes DRM master, and therefore immediately after the DRM core has
# restored the fbdev's mode on the last master's close. See the script for what
# that looks like on the panel.
[ -x /opt/rk3588-mediabox/bin/mediabox-console-off ] \
  && /opt/rk3588-mediabox/bin/mediabox-console-off || true

# The ELD bypass, on the sound card that belongs to this output. Addressed by
# card *id*, never by index: the index is probe order and moves between boots.
if [ -n "$alsa_card" ]; then
  /usr/bin/amixer -c "$alsa_card" cset numid=17 on >/dev/null 2>&1 || true
fi

# The compressed-audio PCM definition, for this output's card.
#
# alsa-lib looks for /usr/share/alsa/cards/<driver>.conf and exposes what it
# finds as `cards.<driver>`, which is what the stock hdmi.conf resolves its
# slave through — so this one file is what makes `hdmi:CARD=<id>,DEV=0` exist,
# and without it Kodi enumerates the sink as PCM-only and compressed output
# cannot be selected at all. The template is rendered for whichever card this
# output actually has rather than installed once under one board's name.
#
# This runs from two units, and only one of them can do it. kodi.service is
# deliberately unsandboxed and writes the file; mediabox-tv-ui.service has
# ProtectSystem=strict, so /usr is read-only under it and the write is refused.
# That division is right — the file is Kodi's, and Kodi's unit is where it gets
# written — but it must not be silent, so the outcome is reported below rather
# than swallowed.
alsa_conf=skipped
template=/opt/rk3588-mediabox/share/alsa/mediabox-hdmi.conf.in
if [ -n "$alsa_driver" ] && [ -f "$template" ]; then
  target="/usr/share/alsa/cards/$alsa_driver.conf"
  rendered="$(sed "s/@ALSA_DRIVER@/$alsa_driver/g" "$template")"
  if [ -f "$target" ] && [ "$rendered" = "$(cat "$target")" ]; then
    alsa_conf=current
  elif printf '%s\n' "$rendered" > "$target" 2>/dev/null; then
    alsa_conf=written
  else
    alsa_conf=unwritable
  fi
fi

# The mode list Kodi is allowed to switch between.
#
# A television box does not change resolution when a film starts. It changes
# *refresh rate*: the interface and the film both come out at the panel's own
# resolution, and only the cadence follows the content. That is what every
# shipping box does, and this appliance did not -- Kodi's whitelist here was
# every mode the sink advertises, 4096x2160 and 1920x1080 and 1280x720
# included, so a 1080p film dropped the television to 1080p and a 4K one
# raised it again, with a resync each way.
#
# So the whitelist is rendered per board instead, from what this output
# actually is:
#
#   * the panel's own shape, taken from the sink's preferred mode, which keeps
#     the DCI 4096x2160 timings out of a 16:9 television;
#   * the largest resolution the link can carry as RGB -- character rate is
#     the pixel clock at eight-bit RGB, so a 300 MHz link takes 4K at 30 Hz
#     and not at 60, and a 600 MHz one takes both. Subsampled chroma is not
#     used to make a timing fit: that is the fault this project already fixed
#     once on the wire.
#   * every refresh rate at that resolution the link can carry, so the film's
#     own cadence is reachable -- 23.976 above all.
#
# Kodi's own format, as it writes it: five digits of width, five of height,
# then %09.5f of the refresh computed from the timing, then `pstd`.
kodi_modes=""
kodi_screenmode=""
if command -v modetest >/dev/null 2>&1; then
  ceiling="$("$PLATFORM" color-modes 2>/dev/null |
             sed -n 's/.*tavan[^0-9]*\([0-9]\+\) kHz.*/\1/p' | head -1)"
  kodi_modes="$(modetest -M rockchip -c 2>/dev/null |
    awk -v want="$connector" -v ceiling="${ceiling:-0}" '
      # Walk into the block for our connector and stop at the next one.
      $0 ~ ("[ \t]" want "[ \t]") { inblock = 1 }
      inblock && /^[0-9]+\t/ && $0 !~ ("[ \t]" want "[ \t]") { inblock = 0 }
      inblock && /^  #[0-9]+ / {
        name = $2; refresh = $3; htot = $7; vtot = $11; clock = $12
        if (name ~ /i$/) next                      # interlaced is not a mode here
        if (clock == 0 || htot == 0 || vtot == 0) next
        if (ceiling > 0 && clock > ceiling) next   # RGB at eight bits, or not at all
        split(name, wh, "x")
        w = wh[1] + 0; h = wh[2] + 0
        hz = (clock * 1000.0) / (htot * vtot)
        if ($0 ~ /preferred/) { pw = w; ph = h }
        n++; W[n] = w; H[n] = h; HZ[n] = hz
        if (w * h > best) { best = w * h }
      }
      END {
        ratio = (ph > 0) ? int((pw * 1000) / ph) : 0
        # The largest area that shares the panel s shape.
        for (i = 1; i <= n; i++) {
          r = int((W[i] * 1000) / H[i])
          if (ratio > 0 && r != ratio) continue
          if (W[i] * H[i] > pick) { pick = W[i] * H[i]; pw2 = W[i]; ph2 = H[i] }
        }
        if (pick == 0) exit
        # Every refresh rate at that size, fastest first, which is the order
        # Kodi writes and the order it prefers.
        for (i = 1; i <= n; i++) {
          if (W[i] != pw2 || H[i] != ph2) continue
          k[++m] = sprintf("%05d%05d%09.5fpstd", W[i], H[i], HZ[i])
          hzv[m] = HZ[i]
        }
        for (i = 1; i < m; i++) for (j = i + 1; j <= m; j++)
          if (hzv[j] > hzv[i]) { t = k[i]; k[i] = k[j]; k[j] = t
                                 tv = hzv[i]; hzv[i] = hzv[j]; hzv[j] = tv }
        out = ""
        for (i = 1; i <= m; i++) out = (i == 1) ? k[i] : out "," k[i]
        print out
      }')"
  kodi_screenmode="${kodi_modes%%,*}"
fi

# And the two settings in Kodi's own profile that name the device.
#
# Kodi reads passthrough capability off the PCM *name* — only a name starting
# with "hdmi" becomes AE_DEVTYPE_HDMI — so the profile has to name the PCM the
# file above defines. A profile pointing at a device that does not exist is the
# one failure that looks like a Kodi bug instead of a missing config file.
kodi_profile=absent
profile=/var/tmp/kodi-home/.kodi/userdata/guisettings.xml
if [ -n "$alsa_card" ] && [ -n "$alsa_driver" ] && [ -f "$profile" ]; then
  kodi_profile=written
  device="ALSA:hdmi:CARD=$alsa_card,DEV=0|$alsa_driver"
  # `#` as the delimiter, not `|`: an ALSA device string has a `|` in it, which
  # ends the s/// expression early and makes sed fail silently under the `||
  # true` below. The symptom was a profile that still named whichever card the
  # box was installed against.
  # `[^>]*>` and not `">`: when Kodi cannot resolve the device it has been
  # given -- which happens whenever the sound cards are re-enumerated while it
  # is running -- it rewrites the setting to its own default *and adds*
  # `default="true"` to it. A pattern anchored on `">` then no longer matches,
  # so the correction here silently stopped correcting and the appliance was
  # left playing PCM into ALSA's "default" device: passthrough still worked,
  # because that is a separate setting, and everything Kodi had to decode went
  # somewhere nobody was listening. That reads as "sound only works on some
  # films", which is exactly how it was reported.
  sed -i \
    -e "s#\(<setting id=\"audiooutput.audiodevice\"\)[^>]*>[^<]*\(</setting>\)#\1>$device\2#" \
    -e "s#\(<setting id=\"audiooutput.passthroughdevice\"\)[^>]*>[^<]*\(</setting>\)#\1>$device\2#" \
    "$profile" || kodi_profile=failed
fi

kodi_whitelist=absent
if [ -n "$kodi_modes" ] && [ -f "$profile" ]; then
  kodi_whitelist=written
  sed -i \
    -e "s#\(<setting id=\"videoscreen.whitelist\"\)[^>]*>[^<]*\(</setting>\)#\1>$kodi_modes\2#" \
    -e "s#\(<setting id=\"videoscreen.screenmode\"\)[^>]*>[^<]*\(</setting>\)#\1>$kodi_screenmode\2#" \
    "$profile" || kodi_whitelist=failed
  grep -q 'id="videoscreen.screenmode"' "$profile" || \
    sed -i "s#</settings>#  <setting id=\"videoscreen.screenmode\">$kodi_screenmode</setting>\n</settings>#" "$profile"
fi

# One line in the journal saying what this board is and what was done to it.
# Anything that did not happen says so by name; a silent preparation step is
# how a wrong sound card survives a deploy.
echo "mediabox-hdmi-prepare: output=$connector card=${alsa_card:-none}" \
     "driver=${alsa_driver:-none} alsa-conf=$alsa_conf kodi-profile=$kodi_profile" \
     "kodi-whitelist=$kodi_whitelist${kodi_screenmode:+ gui=$kodi_screenmode}" >&2

# Put the link back to SDR before an SDR interface is drawn on it.
#
# The colour state belongs to the connector, not to whoever set it, so it
# survives the process that did. Measured after Kodi handed the display back:
# the interface was on screen at 1920x1080p60 while the video port still read
# HDR10[2] BT.2020 limited and the wire was still 4:2:2 10-bit — the television
# stayed in its HDR picture profile and drew an SDR interface through it.
#
# This runs before the interface takes DRM master, which is the only moment
# nobody holds it: modetest can take master, clear the properties that carry
# HDR and a YUV wire to the sink, and drop it again. The interface then sets its
# own mode on top of an SDR, RGB connector. Anything that wants something else —
# Kodi — sets it again for itself when it starts.
#
# `color_format` is the third property and was the one missing. Photographed on
# the appliance after a film: the whole interface washed out to pastel blue and
# pink. Measured at that moment:
#
#   bus_format[2025]: YUV8_1X24           <- the wire was carrying YUV
#   Cluster0-win0 color: BT.601 Limited
#   csc: y2r[0] r2y[1] csc mode[1]        <- RGB->YUV conversion was on
#   connector 203 color_format: value: 1  <- ycbcr444, left behind by Kodi
#
# against RGB888_1X24 and `r2y[0] csc mode[0]` on a clean start. VOP2 was
# converting an RGB interface to YUV in BT.601 while telling the sink BT.709
# limited — two mismatches at once, which is exactly that colour shift.
#
# The connector is matched by name and not by "the first one that says HDMI":
# modetest's object ids are allocated per boot and the first connected HDMI is
# not necessarily the one this box is drawing on.
if [ "${MEDIABOX_HDMI_KEEP_HDR:-0}" != 1 ]; then
  conn=$(/usr/bin/modetest -M rockchip -c 2>/dev/null \
    | awk -v want="$connector" '$3 == "connected" && $4 == want { print $1; exit }')
  if [ -n "${conn:-}" ]; then
    /usr/bin/modetest -M rockchip -w "$conn:Colorspace:0" >/dev/null 2>&1 || true
    /usr/bin/modetest -M rockchip -w "$conn:HDR_OUTPUT_METADATA:0" >/dev/null 2>&1 || true
    # rgb=0 in this driver's enum. Set last, so a refusal of either of the two
    # above does not stop the wire going back to RGB.
    /usr/bin/modetest -M rockchip -w "$conn:color_format:0" >/dev/null 2>&1 || true
  fi
fi
exit 0
