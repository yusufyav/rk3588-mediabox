#!/bin/sh
#
# Make the television's own description of itself available before anything
# draws on it.
#
# Two faults on this appliance had one cause: the HDMI connector came up
# "connected" with no EDID at all. Measured: the connector's `edid` was 0 bytes,
# ALSA published no ELD, and the HDR_PANEL_METADATA blob was empty — so Kodi
# could not learn that the panel does HDR10 and never set HDR_OUTPUT_METADATA
# (the set is what makes a Sony enter HDR), and audio passthrough was packed
# without knowing what the sink accepts, which is silence. Forcing one detect
# produced a 256-byte EDID with the panel's real audio and HDR blocks.
#
# The ELD bypass is the second half: this board carries HDMI audio over I2S, and
# with no ELD the codec refuses to pack a bitstream. Both are runtime state and
# are lost on every restart, which is why they are done here rather than by
# hand.
#
# Everything below acts on *the output this box is on*, which is not a constant.
# This script used to say `card*-HDMI-A-*` and `amixer -c rockchiphdmi1`, and
# both are answers for a board with one HDMI socket. On a board with two, the
# first is every socket including the empty one and the second is the other
# socket's sound card — so the EDID would be forced on a connector nothing is
# attached to while the bitstream went to a television that is not there.
# mediabox-platform resolves the output, and the sound card and CEC adapter that
# belong to it, from the topology; see docs/platform/runtime-discovery.md.
set -eu

PLATFORM="${MEDIABOX_PLATFORM:-/opt/rk3588-mediabox/bin/mediabox-platform}"

connector_path="$("$PLATFORM" connector-path 2>/dev/null || true)"
connector="$("$PLATFORM" output 2>/dev/null || true)"
# Nothing, when the output's transmitter is not firmly known: the sound then
# goes nowhere (below), never to the likely card -- the same rule CEC follows.
alsa_card="$("$PLATFORM" alsa-card 2>/dev/null || true)"
alsa_driver="$("$PLATFORM" alsa-driver 2>/dev/null || true)"

# No mode on the kernel command line. Ever.
#
# This used to write the display's fastest mode into /boot as `video=`, so the
# kernel's fbdev emulation would hold 4K between two applications instead of
# the sink's preferred 1080p. But that argument belongs to whichever display
# was plugged in when it was written, and the kernel applies it to whatever is
# plugged in at the next boot -- before any of this runs. When the new display
# does not list that mode the kernel invents one with the GTF formula, and the
# vendor HDMI driver does not reject it. Measured on the Orange Pi 5 Plus,
# 2026-09-23: `video=HDMI-A-2:2560x1440@144` left by a 1440p monitor, a Sony
# television on the same socket, GTF 807.9 MHz, `can't find frl rate, phy pll
# init failed`, SError in dw_hdmi_qp_setup, kernel panic 1.7 s into every boot.
#
# Without it the kernel takes the mode from the EDID of the display actually
# connected, which is what every other HDMI source does. What the argument was
# for -- no 1080p between two applications -- is done instead by never letting
# the display go: the interface hands its open device to systemd's file
# descriptor store when it stops, so the kernel console's mode never reaches
# the wire (docs/display-pipeline.md, rule 10).
#
# So the only thing left to do with the argument is take it off boards an older
# version put it on -- before looking for a display, because a board that boots
# with nothing connected still boots with the argument, and the next display
# plugged in is the one it would be applied to. mediabox-display-changed runs
# this as root at every boot and after a display change with
# MEDIABOX_HDMI_BOOT_VIDEO=1; every other caller is sandboxed and leaves /boot
# alone.
boot_env="${MEDIABOX_BOOT_ENV:-/boot/armbianEnv.txt}"
video_arg=""
boot_mode=not-asked
if [ "${MEDIABOX_HDMI_BOOT_VIDEO:-0}" != 1 ]; then
  :
elif [ ! -f "$boot_env" ]; then
  boot_mode=unknown
elif ! grep -q '^extraargs=.*video=' "$boot_env"; then
  boot_mode=absent
elif [ ! -w "$boot_env" ]; then
  boot_mode=unwritable
else
  current="$(sed -n 's/^extraargs=//p' "$boot_env" | head -1)"
  video_arg="$(printf '%s\n' "$current" | tr ' ' '\n' | grep '^video=' | tr '\n' ' ' | sed 's/ $//')"
  wanted="$(printf '%s' "$current" | sed "s#video=[^ ]*##g" | tr -s ' ' | sed 's/^ //; s/ $//')"
  if [ "$current" = "$wanted" ]; then
    boot_mode=absent
  else
    # This file decides whether the board boots. One copy kept, one line
    # rewritten, nothing else in it touched, and never half of it on disk: the
    # new file is written and flushed beside the old one and renamed over it.
    before="$(sha256sum "$boot_env" | cut -c1-12)"
    [ -f "$boot_env.mediabox-video" ] || cp -a "$boot_env" "$boot_env.mediabox-video"
    next="$boot_env.mediabox-next"
    if grep -q '^extraargs=' "$boot_env"; then
      awk -v line="extraargs=$wanted" \
        '/^extraargs=/ && !done { print line; done = 1; next } { print }' \
        "$boot_env" >"$next"
    else
      { cat "$boot_env"; printf 'extraargs=%s\n' "$wanted"; } >"$next"
    fi
    chmod --reference="$boot_env" "$next" 2>/dev/null || true
    sync "$next" 2>/dev/null || sync
    mv -f "$next" "$boot_env"
    sync
    boot_mode="removed $before->$(sha256sum "$boot_env" | cut -c1-12)"
  fi
fi

if [ -z "$connector" ]; then
  # Nothing is plugged in, or discovery could not decide. Neither is this
  # script's to fix, and neither is a reason to fail the unit that runs it:
  # whoever takes the display next reports it properly.
  echo "mediabox-hdmi-prepare: seçili bir ekran çıkışı yok boot-video=$boot_mode${video_arg:+ ($video_arg)}" >&2
  exit 0
fi

# One forced detect, on the output that is in use.
if [ -n "$connector_path" ] && [ -e "$connector_path/status" ] && [ ! -s "$connector_path/edid" ]; then
  echo detect > "$connector_path/status" 2>/dev/null || true
fi

# There is no terminal on a television.
#
# Run here as well as at boot: this is the moment immediately before the
# interface takes DRM master, and therefore immediately after the DRM core has
# restored the fbdev's mode on the last master's close. See the script for what
# that looks like on the panel.
[ -x /opt/rk3588-mediabox/bin/mediabox-console-off ] \
  && /opt/rk3588-mediabox/bin/mediabox-console-off || true

# The ELD bypass, on the sound card that belongs to this output. Addressed by
# card *id*, never by index: the index is probe order and moves between boots.
if [ -n "$alsa_card" ]; then
  /usr/bin/amixer -c "$alsa_card" cset numid=17 on >/dev/null 2>&1 || true
fi

# The compressed-audio PCM definition, for this output's card.
#
# alsa-lib looks for /usr/share/alsa/cards/<driver>.conf and exposes what it
# finds as `cards.<driver>`, which is what the stock hdmi.conf resolves its
# slave through — so this one file is what makes `hdmi:CARD=<id>,DEV=0` exist,
# and without it Kodi enumerates the sink as PCM-only and compressed output
# cannot be selected at all. The template is rendered for whichever card this
# output actually has rather than installed once under one board's name.
#
# This runs from two units, and only one of them can do it. kodi.service is
# deliberately unsandboxed and writes the file; mediabox-tv-ui.service has
# ProtectSystem=strict, so /usr is read-only under it and the write is refused.
# That division is right — the file is Kodi's, and Kodi's unit is where it gets
# written — but it must not be silent, so the outcome is reported below rather
# than swallowed.
alsa_conf=skipped
template=/opt/rk3588-mediabox/share/alsa/mediabox-hdmi.conf.in
if [ -n "$alsa_driver" ] && [ -f "$template" ]; then
  target="/usr/share/alsa/cards/$alsa_driver.conf"
  rendered="$(sed "s/@ALSA_DRIVER@/$alsa_driver/g" "$template")"
  if [ -f "$target" ] && [ "$rendered" = "$(cat "$target")" ]; then
    alsa_conf=current
  elif printf '%s\n' "$rendered" > "$target" 2>/dev/null; then
    alsa_conf=written
  else
    alsa_conf=unwritable
  fi
fi

# The mode Kodi starts in and the refresh rates it may change between: the
# display setting, as the daemon works it out.
#
# One setting for everything that owns the television. It is chosen in the
# display settings (or left on Auto) and put on the wire by the interface; the
# daemon keeps it, bound to the display it was chosen on (the SHA-256 of its
# EDID), and writes what it means for the other two owners to
# /run/mediabox/output-plan for the observer's current display generation --
# with what it was made for: the boot, the generation, the connector, the
# transmitter, the EDID, the timing and the source profile:
#
#   kodi_screenmode   the chosen mode, in Kodi's own spelling
#                     (%05d%05d%09.5fpstd, the refresh from the timing);
#   kodi_whitelist    every refresh this display lists at that size that
#                     anything can be sent at, fastest first -- a film changes
#                     the cadence, never the resolution, as a television box
#                     does;
#   browser_mode      the chosen mode, or on Auto the fastest refresh at that
#                     size that is a whole multiple of 60 or 59.94 Hz.
#
# Which modes can be sent, and in what, is the HDMI rules' answer
# (mediabox_platform::output) -- not a rule of this script's. This used to be
# worked out here in awk with a rule of its own, "RGB at eight bits or not at
# all".
#
# The plan is taken only through `mediabox-platform plan`, which prints it if
# it is for this boot, the observer's current generation, and the connector and
# EDID read now -- and otherwise nothing. A plan for another display is never
# used: its mode could be one this display does not list, and its colour lines
# name another sink's HDR. Without a current plan Kodi starts on the mode
# already on the wire (`DESKTOP`) and switches refresh among that size's own
# modes, both read by Kodi from this display.
kodi_modes=""
kodi_screenmode=DESKTOP
plan_state=current
if plan_text="$("$PLATFORM" plan --wait "${MEDIABOX_PLAN_WAIT:-3}" 2>/dev/null)"; then
  kodi_screenmode="$(printf '%s\n' "$plan_text" | sed -n 's/^kodi_screenmode=\([0-9a-z.]*\)$/\1/p')"
  kodi_modes="$(printf '%s\n' "$plan_text" | sed -n 's/^kodi_whitelist=\([0-9a-z.,]*\)$/\1/p')"
else
  plan_state=stale
fi

# The browser's compositor is told its mode by its own unit, from the same
# plan through the same check (`mediabox-platform sway-output`, written into
# the browser's runtime directory as it starts): a file written here, for
# whichever display was plugged in then, is what the browser used to start on.

# And the two settings in Kodi's own profile that name the device.
#
# Kodi reads passthrough capability off the PCM *name* — only a name starting
# with "hdmi" becomes AE_DEVTYPE_HDMI — so the profile has to name the PCM the
# file above defines. A profile pointing at a device that does not exist is the
# one failure that looks like a Kodi bug instead of a missing config file.
#
# When the output's transmitter is not firmly known there is no card to name,
# and naming none is not an answer: Kodi replaces a device it cannot find with
# ALSA's default, which is card 0 -- on a board with two HDMI sockets, possibly
# the other television. So it is given `mediabox_unrouted`, a PCM that discards
# everything (config/alsa/60-mediabox-unrouted.conf): silence, said out loud.
kodi_profile=absent
profile="${MEDIABOX_KODI_PROFILE:-/var/tmp/kodi-home/.kodi/userdata/guisettings.xml}"
device=""
if [ -n "$alsa_card" ] && [ -n "$alsa_driver" ]; then
  device="ALSA:hdmi:CARD=$alsa_card,DEV=0|$alsa_driver"
elif [ -n "$connector" ]; then
  device="ALSA:mediabox_unrouted|MediaBox"
fi
if [ -n "$device" ] && [ -f "$profile" ]; then
  kodi_profile=written
  # `#` as the delimiter, not `|`: an ALSA device string has a `|` in it, which
  # ends the s/// expression early and makes sed fail silently under the `||
  # true` below. The symptom was a profile that still named whichever card the
  # box was installed against.
  # `[^>]*>` and not `">`: when Kodi cannot resolve the device it has been
  # given -- which happens whenever the sound cards are re-enumerated while it
  # is running -- it rewrites the setting to its own default *and adds*
  # `default="true"` to it. A pattern anchored on `">` then no longer matches,
  # so the correction here silently stopped correcting and the appliance was
  # left playing PCM into ALSA's "default" device: passthrough still worked,
  # because that is a separate setting, and everything Kodi had to decode went
  # somewhere nobody was listening. That reads as "sound only works on some
  # films", which is exactly how it was reported.
  sed -i \
    -e "s#\(<setting id=\"audiooutput.audiodevice\"\)[^>]*>[^<]*\(</setting>\)#\1>$device\2#" \
    -e "s#\(<setting id=\"audiooutput.passthroughdevice\"\)[^>]*>[^<]*\(</setting>\)#\1>$device\2#" \
    "$profile" || kodi_profile=failed
fi

kodi_whitelist=absent
if [ -f "$profile" ]; then
  kodi_whitelist=written
  sed -i \
    -e "s#\(<setting id=\"videoscreen.whitelist\"\)[^>]*>[^<]*\(</setting>\)#\1>$kodi_modes\2#" \
    -e "s#\(<setting id=\"videoscreen.screenmode\"\)[^>]*>[^<]*\(</setting>\)#\1>$kodi_screenmode\2#" \
    "$profile" || kodi_whitelist=failed
  grep -q 'id="videoscreen.screenmode"' "$profile" || \
    sed -i "s#</settings>#  <setting id=\"videoscreen.screenmode\">$kodi_screenmode</setting>\n</settings>#" "$profile"
fi

# One line in the journal saying what this board is and what was done to it.
# Anything that did not happen says so by name; a silent preparation step is
# how a wrong sound card survives a deploy.
echo "mediabox-hdmi-prepare: output=$connector card=${alsa_card:-unrouted}" \
     "driver=${alsa_driver:-none} alsa-conf=$alsa_conf kodi-profile=$kodi_profile" \
     "plan=$plan_state kodi-whitelist=$kodi_whitelist gui=$kodi_screenmode" \
     "boot-video=$boot_mode${video_arg:+ ($video_arg)}" >&2

# Put the link back to SDR before an SDR interface is drawn on it.
#
# The colour state belongs to the connector, not to whoever set it, so it
# survives the process that did. Measured after Kodi handed the display back:
# the interface was on screen at 1920x1080p60 while the video port still read
# HDR10[2] BT.2020 limited and the wire was still 4:2:2 10-bit — the television
# stayed in its HDR picture profile and drew an SDR interface through it.
#
# This runs before the interface takes DRM master, which is the only moment
# nobody holds it: modetest can take master, clear the properties that carry
# HDR and a YUV wire to the sink, and drop it again. The interface then sets its
# own mode on top of an SDR, RGB connector. Anything that wants something else —
# Kodi — sets it again for itself when it starts.
#
# `color_format` is the third property and was the one missing. Photographed on
# the appliance after a film: the whole interface washed out to pastel blue and
# pink. Measured at that moment:
#
#   bus_format[2025]: YUV8_1X24           <- the wire was carrying YUV
#   Cluster0-win0 color: BT.601 Limited
#   csc: y2r[0] r2y[1] csc mode[1]        <- RGB->YUV conversion was on
#   connector 203 color_format: value: 1  <- ycbcr444, left behind by Kodi
#
# against RGB888_1X24 and `r2y[0] csc mode[0]` on a clean start. VOP2 was
# converting an RGB interface to YUV in BT.601 while telling the sink BT.709
# limited — two mismatches at once, which is exactly that colour shift.
#
# The connector is matched by name and not by "the first one that says HDMI":
# modetest's object ids are allocated per boot and the first connected HDMI is
# not necessarily the one this box is drawing on.
#
# And only what is not already so. On this driver the first property write after
# boot re-trains the HDMI link without taking the CRTC down, even when it writes
# the value that is already there -- measured on the Plus with an HP X27q at
# 2560x1440p144: every value already 0, the write printed `final tmdsclk =
# 583600000` with no modeset around it, and the monitor stayed black while the
# interface drew on it, on the old code and on the new. The interface then
# starts at the mode already on the connector, so nothing modesets it back. A
# property that is already right is therefore left alone; one Kodi left behind
# is still put back.
#
# And only while nobody holds the display. Everything above this block is
# configuration -- files, mixer controls, a sysfs probe -- and is safe whoever
# is drawing; this is a DRM commit, which needs master and changes the wire
# under whoever has it. mediabox-display-changed runs the rest of this script
# for a browser that stays up across a replug and asks for this part to be
# left out with MEDIABOX_HDMI_CONNECTOR_RESET=0.
MODETEST="${MEDIABOX_MODETEST:-/usr/bin/modetest}"
if [ "${MEDIABOX_HDMI_KEEP_HDR:-0}" != 1 ] && [ "${MEDIABOX_HDMI_CONNECTOR_RESET:-1}" = 1 ]; then
  listing="$("$MODETEST" -M rockchip -c 2>/dev/null || true)"
  conn=$(printf '%s\n' "$listing" \
    | awk -v want="$connector" '$3 == "connected" && $4 == want { print $1; exit }')
  if [ -n "${conn:-}" ]; then
    # name=value for this connector's properties. A blob prints its bytes on
    # the lines after `value:`; set means there are some.
    props="$(printf '%s\n' "$listing" | awk -v id="$conn" '
      /^[0-9]+\t/ { inblock = ($1 == id); next }
      !inblock { next }
      /^\t[0-9]+ [^ ]+:$/ { name = $2; sub(/:$/, "", name); blob = 0; bytes = 0; next }
      /^\t\tflags:.*blob/ { blob = 1; next }
      /^\t\tvalue:/ { if (blob) { val[name] = 0; bytes = 1 } else val[name] = $2; next }
      bytes && /^\t\t\t[0-9a-f]+$/ { val[name] = 1; next }
      END { for (n in val) print n "=" val[n] }')"
    reset() {
      case "$props" in
        *"$1=0"*) ;;
        *) "$MODETEST" -M rockchip -w "$conn:$1:0" >/dev/null 2>&1 || true ;;
      esac
    }
    reset Colorspace
    reset HDR_OUTPUT_METADATA
    # rgb=0 in this driver's enum. Set last, so a refusal of either of the two
    # above does not stop the wire going back to RGB.
    reset color_format
  fi
fi
exit 0
