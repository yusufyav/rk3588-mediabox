#!/bin/sh
#
# The television's web browser, as an application of its own.
#
# Not a tab inside the MediaBox interface: a separate unit with its own profile
# that takes the display when it is launched and gives it back when it exits.
# That is what makes a browser possible at all here — only one process may hold
# DRM master, so browsing means MediaBox stepping aside, exactly as it does for
# Kodi.
#
# Spatial navigation is the part that makes it usable from a sofa: with it the
# arrow keys walk between the links and controls on a page, which is the only
# input a television remote has. A mouse or keyboard plugged in still works,
# because the compositor reads the input devices directly.
set -eu

PROFILE="${MEDIABOX_BROWSER_PROFILE:-/var/lib/mediabox-browser/chromium}"
# The remote-control layer. Most of the web is written for a mouse: its
# posters and buttons are divs that nothing can focus, so on a television they
# are unreachable. This content script gives them a focus ring the four arrows
# can move between, turns OK into a real click and Back into history.back().
# It currently matches nothing — the site it was written for is gone — and is
# loaded so that adding a site is a one-line change to its manifest.
REMOTE_EXTENSION="${MEDIABOX_BROWSER_EXTENSION:-/opt/rk3588-mediabox/browser-remote}"
HOME_URL="${MEDIABOX_BROWSER_HOME:-https://www.youtube.com/}"
# Where a chosen address is left for the next start. The launcher writes it,
# this reads it once, and the browser opens there instead of its home page.
REQUEST="${MEDIABOX_BROWSER_REQUEST:-/var/lib/mediabox-browser/url}"

url="$HOME_URL"
if [ -s "$REQUEST" ]; then
  requested=$(head -c 2000 "$REQUEST" | tr -d '\n\r')
  rm -f "$REQUEST"
  case "$requested" in
    https://*|http://*) url="$requested" ;;
    *) ;;   # anything that is not a plain web address is ignored, not run
  esac
fi

# An ordinary desktop browser, which is what this one is.
#
# It used to claim to be a Chromecast, because youtube.com/tv serves a
# remote-driven interface to something that says it is a television. On this
# build that pair does not give a television interface at all: it gives the
# "Ready to cast" screen and nothing else, measured on the Plus. So the
# television address and the Chromecast string are both gone and the browser
# asks for youtube.com as itself. Spatial navigation below is what makes the
# desktop page reachable from four arrow keys.
AGENT="${MEDIABOX_BROWSER_AGENT:-Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36}"

# Measurement, off unless asked for, bound to loopback. Playing video in a
# browser on this board is a claim that has to be checked rather than assumed.
# This used to need no scale because the compositor was pinned to 1080p for it.
# That pin is gone — it was a statement about one panel — so the scale is
# measured here the same way the product interface measures it.
SCALE="$(/opt/rk3588-mediabox/bin/mediabox-display-scale 1920 1080 2>/dev/null || echo 1)"

debug=""
if [ -n "${MEDIABOX_BROWSER_DEBUG_PORT:-}" ]; then
  debug="--remote-debugging-port=${MEDIABOX_BROWSER_DEBUG_PORT} --remote-allow-origins=*"
fi

# Kiosk, off by default.
#
# Kiosk is a browser with no way to go anywhere: no tabs, no address bar, no
# settings, no way to install anything. That is the right shape for a single
# fixed page and the wrong one for a web browser somebody is meant to use, and
# this is the second. The window is still fullscreen -- sway gives it the whole
# output and draws no decoration -- so nothing of the desktop shows either way,
# and direct scan-out is unaffected: the tab strip is inside the same surface.
#
# MEDIABOX_BROWSER_KIOSK=1 puts it back for an appliance that wants one page.
kiosk=""
case "${MEDIABOX_BROWSER_KIOSK:-0}" in
  1|true|yes|on) kiosk="--kiosk" ;;
esac

# Local Network Access, off.
#
# A page that talks to a service on this same box trips a Chromium dialog in
# the middle of the television — "Access other apps and services on this
# device" — which cannot be dismissed with four arrows and an OK button, so
# whatever is behind it is unusable. The managed policy for this exists only in
# later builds than the one here, so the check is disabled for this browser,
# whose entire job is to talk to this box.
#
# The flag lives in the command below and the note lives here on purpose: a
# comment inside a backslash-continued command is not a comment, it is more
# arguments.

# Hardware video decode, on.
#
# Three feature names, and each one was checked against *this* binary rather
# than copied from a guide: Chromium retires these between releases and a name
# it does not know is accepted in silence and does nothing.
#
#   AcceleratedVideoDecoder                 the decoder itself
#   AcceleratedVideoDecodeLinuxGL           allowed when the context is GL,
#                                           which is what ANGLE-on-Mali is here
#   AcceleratedVideoDecodeLinuxZeroCopyGL   the decoded surface is imported as
#                                           a DMA-BUF instead of being read back
#
# The last one is the difference between a 4K frame crossing the bus once and
# crossing it twice. What makes any of them mean anything is the VA-API driver
# named in the unit; without it these three turn a decoder on that has nothing
# behind it.
#
# Not here, deliberately: --ignore-gpu-blocklist, --enable-gpu-rasterization
# and --enable-zero-copy. Each was measured on this board and each was already
# the browser's own answer -- chrome://gpu reports rasterization "Hardware
# accelerated on all pages" and nothing on this GPU is blocklisted -- so they
# would be three flags that say what the browser already does, and one more
# thing to be wrong later.

# shellcheck disable=SC2086  # $debug and $kiosk are empty or known flags.
/usr/bin/chromium \
  $debug \
  $kiosk \
  --force-device-scale-factor="$SCALE" \
  --no-sandbox \
  --ozone-platform=wayland \
  --user-data-dir="$PROFILE" \
  --user-agent="$AGENT" \
  --enable-spatial-navigation \
  --load-extension="$REMOTE_EXTENSION" \
  --no-first-run \
  --no-default-browser-check \
  --disable-component-update \
  --disable-sync \
  --disable-infobars \
  --disable-features=Translate,TranslateUI,LocalNetworkAccessChecks,LocalNetworkAccess \
  --lang=tr \
  --disable-session-crashed-bubble \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required \
  --hide-scrollbars \
  --enable-features=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL \
  "$url" || true

exec /usr/bin/swaymsg exit
