#!/bin/sh
#
# MediaBox's own player.
#
# It draws on the interface's own video plane, not on a display of its own: the
# film appears inside the application rather than taking the television away
# from it, which is the whole point of having a player of our own. Kodi stays
# for what Kodi is good at; opening a source from the catalogue no longer needs
# it.
#
# This used to be a Wayland client. The interface was a Chromium kiosk inside
# sway then, and mpv drew into that compositor with --vo=dmabuf-wayland. The
# interface is now the product's own binary talking to the display controller
# directly, sway is gone, and with it went the only surface this player had:
# measured, /run/mediabox-ui held no socket at all and every start ended in
#
#     mediabox-player.service: Main process exited, status=2/INVALIDARGUMENT
#
# --vo=mediabox is the replacement. Same decoder, same dma-buf, no compositor:
# the frames go to the interface over a unix socket and the interface puts them
# on the second window of the video port it already owns. See
# packaging/mpv/vo_mediabox.c.
#
# Usage: mediabox-player <url> [start-seconds]
set -eu

URL="${1:?usage: mediabox-player <url> [start-seconds]}"
START="${2:-0}"

# Started by the control plane, which keeps no terminal: without somewhere to
# write, a player that refuses to start refuses silently.
if [ -w /run/mediabox ] || mkdir -p /run/mediabox 2>/dev/null; then
    exec >>/run/mediabox/player.log 2>&1
fi

# No LD_LIBRARY_PATH, and that is the change worth noticing.
#
# The player needs MediaBox's own Rockchip MPP and RGA — the system ffmpeg must
# stay the system ffmpeg — and it used to be handed them here, by pointing this
# process at a directory. That works exactly as long as everyone who ever starts
# the player remembers to do it, and it silently binds whatever is in that
# directory: on a board that also carries rk3588-screenbridge, the line that
# used to be here named *that* product's prefix, and whichever of the two built
# last decided which decoder MediaBox got.
#
# scripts/build-mediabox-player.sh links the binary with an RPATH naming
# $MEDIABOX_MEDIA_PREFIX instead, so the player says where its decoder is and
# nothing out here has to. If it ever cannot find one, the failure is a loud
# missing-library error rather than a silent fall back to software.

# Where the interface listens for frames. It creates this with its own runtime
# directory, so a player that cannot find it is a player started while nothing
# owns the television — which is a refusal to start, not a reason to take the
# display. Nothing here is a compositor: the socket carries dma-buf descriptors
# to the process that already holds DRM master.
MEDIABOX_VIDEO_SOCKET="${MEDIABOX_VIDEO_SOCKET:-/run/mediabox-ui/video.sock}"
export MEDIABOX_VIDEO_SOCKET
if [ ! -S "$MEDIABOX_VIDEO_SOCKET" ]; then
    echo "mediabox-player: arayüz çalışmıyor, $MEDIABOX_VIDEO_SOCKET yok" >&2
    exit 1
fi

# Where the sound goes and in what form: the kept sound setting, on the devices
# found now, as `mediabox-platform audio-args` renders it -- the device (the
# picture's own HDMI card by default, `hdmi:CARD=<id>` so a compressed burst
# can be sent; a USB DAC or the analog output if one was chosen), the formats
# the receiver declares and the setting lets through (`--audio-spdif`), Dolby
# Digital encoding of multichannel sound (`--af=lavcac3enc`), and the volume.
# One argument per line, none with a space in it.
#
# Why it is asked at all: with --no-config mpv autoprobes its output --
# pipewire, then pulse, then ALSA's `default`, which on a board with no
# /etc/asound.conf is card 0. On the Plus card 0 is `rockchipdp0`, and every
# film once played silently on the DisplayPort card while the television was
# on card 2.
#
# If nothing resolves -- no card, or a transmitter that is not firmly known --
# the plan is mpv's null output: a silent film is better than no film, and
# better than a film whose sound plays on another television.
audio="--ao=null"
platform=/opt/rk3588-mediabox/bin/mediabox-platform
if [ -x "$platform" ]; then
    planned="$("$platform" audio-args 2>/dev/null | tr '\n' ' ')" || true
    if [ -n "$planned" ]; then
        audio="$planned"
    fi
fi
# "Oynatımı görüntüye eşitle", Kodi's videoplayer.usedisplayasclock, kept by
# the control plane (OutputStatus::display_sync) and handed over as
# MEDIABOX_PLAYER_DISPLAY_SYNC=1. mpv's display-resample times video to the
# display's refresh and resamples the sound to match it -- what Kodi's
# SYNC_RESAMPLE does -- and, as Kodi does with the setting on
# (VideoPlayerAudio.cpp: allowpassthrough = !usedisplayasclock), the sound is
# decoded to PCM: no passthrough, no Dolby Digital encoding, both of which a
# resampler cannot touch. Off, nothing here changes.
sync=""
if [ "${MEDIABOX_PLAYER_DISPLAY_SYNC:-0}" = 1 ]; then
    sync="--video-sync=display-resample"
    pcm=""
    for arg in $audio; do
        case "$arg" in
            --audio-spdif=*|--af=lavcac3enc*) ;;
            *) pcm="$pcm $arg" ;;
        esac
    done
    audio="${pcm# }"
fi
echo "mediabox-player: ses: $audio${sync:+ (görüntüye eşitli: $sync)}" >&2

# What MPP has to say about a film, at the level a product logs at.
#
# Rockchip's MPP logs through syslog with an identifier of its own, so it
# reaches the journal whatever mpv's own --msg-level is set to, and its
# decoders log one line per stream oddity. Measured on the Ultra on
# 2026-09-20, on one 4K HEVC film: "h265d: Skipping NAL unit 63", a hundred
# and forty-five thousand times -- 99.5% of everything in the journal, which
# left thirteen minutes of history on a box that had been up for two and three
# quarter hours. The fault being diagnosed had happened twenty minutes
# earlier and every record of it was gone.
#
# 3 is MPP's own MPP_LOG_WARN. Warnings and errors still arrive; the running
# commentary does not. Nothing here silences the decoder's real complaints.
export mpp_log_level="${mpp_log_level:-3}"

# A socket the control plane can ask "where have you got to" on, which is what
# makes handing the film to Kodi land on the same second rather than the start.
ipc=""
if [ -n "${MEDIABOX_PLAYER_IPC:-}" ]; then
    ipc="--input-ipc-server=$MEDIABOX_PLAYER_IPC"
fi

# Opened paused when the control plane asks: it reads the film's frame rate,
# has the display matched to it, and lets the film go itself. See
# follow_film in rust/crates/mediaboxd-rs/src/daemon.rs.
hold=""
if [ "${MEDIABOX_PLAYER_HOLD:-}" = 1 ]; then
    hold="--pause"
fi

# The audio track the media core chose for this film, by mpv's numbering. Set,
# the film plays what the plan says it plays; unset, mpv picks the file's
# default track as it always did.
aid=""
case "${MEDIABOX_PLAYER_AID:-}" in
    '' | *[!0-9]*) ;;
    *) aid="--aid=$MEDIABOX_PLAYER_AID" ;;
esac

# Live television (MEDIABOX_PLAYER_LIVE=1, a DVB service from mediabox-dvb's
# FIFO): the transport stream's programme table already says what every
# stream is, so the streams are not probed by decoding them.
#
# That probe is what took the picture away. Measured on the Plus on
# 2026-10-22 with TRT HABER HD (H.264 1080i): lavf's find_stream_info decodes
# in software and leaves the stream's pix_fmt as yuv420p; h264_rkmpp, given a
# known pix_fmt, asks get_format at open (rkmppdec.c), and mpv's zero-copy
# rkmpp method, which uses hw_frames_ctx, cannot answer it for a wrapper
# decoder (avcodec_get_hw_frames_parameters fails: "Hardware decoding of this
# stream is unsupported?"). mpv fell back to software, and --vo=mediabox,
# which takes DRM PRIME only, had no picture. Without the probe the decoder
# opens straight into DRM PRIME: "Using hardware decoding (rkmpp)",
# "VO: [mediabox] 1920x1080 drm_prime[nv12]". Films keep the probe.
#
# And it is decoded ahead, on a thread of its own (--vd-queue-enable). The
# deinterlacing decoder hands frames over in bursts -- measured on the same
# stream with h264_rkmpp -deint 1 at broadcast pace: a median of 3.2 ms
# between frames, then gaps of 37 to 157 ms, the longest at the 25-frame GOP
# boundaries -- and mpv's ordinary decode, two frames ahead, met each gap with
# frames already past their end: dropped (vo.c, "end_time < now"), three at a
# time, 29 to 35 in ten seconds at 50 fps, at 50 Hz and at 60 Hz, with or
# without sound, never late on the panel (vo-delayed-frame-count 0). With the
# queue: 0. Films, 24 frames a second from a decoder that does not burst,
# keep their pipeline as it was.
#
# The queue is bounded to what the longest gap needs (157 ms: 8 frames at
# 50 fps), not mpv's 50 frames / 2 s. Every queued frame is one of MPP's
# fixed pool of buffers; with the default, a start held for the display
# filled the queue, the output's own eight in flight came on top, and on the
# second of three runs the decoder waited for a buffer nobody would give
# back: mpv's core stopped answering, its IPC clients piled up to 1022 open
# descriptors (320 sockets, 644 pipes, 45 dma-bufs) and systemd killed it
# after 90 s.
live=""
if [ "${MEDIABOX_PLAYER_LIVE:-0}" = 1 ]; then
    live="--demuxer-lavf-probe-info=nostreams --vd-queue-enable=yes --vd-queue-max-samples=8 --vd-queue-max-secs=0.5"
    # Nothing played is kept to seek back into: a broadcast has no "back",
    # and the default kept 50 MiB of it -- mpv's RSS climbed with the stream,
    # 38 to 78 MB in the first minute of TRT HABER HD (2026-10-22).
    live="$live --demuxer-max-back-bytes=0"
fi

# At the end of the file the player holds its last frame rather than exiting:
# the control plane reads where it stopped and decides whether that was the
# end of the film or a read that failed short of it, then closes the player
# itself. Exiting at once left nobody to ask (see rust/crates/mediaboxd-rs/
# src/playback.rs).
# shellcheck disable=SC2086  # $ipc, $hold, $aid, $audio, $sync and $live are empty or known flags.
exec /opt/rk3588-mediabox/player/bin/mpv \
    $ipc \
    $hold \
    $aid \
    $audio \
    $sync \
    $live \
    --no-config \
    --input-conf=/opt/rk3588-mediabox/player/share/mediabox-input.conf \
    --scripts=/opt/rk3588-mediabox/player/share/mediabox.lua \
    --fullscreen \
    --vo=mediabox \
    --hwdec=rkmpp \
    --start="$START" \
    --keep-open=yes \
    --osc=no \
    --input-default-bindings=yes \
    --no-ytdl \
    --msg-level=all=warn \
    -- "$URL"
