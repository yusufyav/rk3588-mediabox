#!/bin/sh
#
# MediaBox's own player.
#
# It draws on the interface's own video plane, not on a display of its own: the
# film appears inside the application rather than taking the television away
# from it, which is the whole point of having a player of our own. Kodi stays
# for what Kodi is good at; opening a source from the catalogue no longer needs
# it.
#
# This used to be a Wayland client. The interface was a Chromium kiosk inside
# sway then, and mpv drew into that compositor with --vo=dmabuf-wayland. The
# interface is now the product's own binary talking to the display controller
# directly, sway is gone, and with it went the only surface this player had:
# measured, /run/mediabox-ui held no socket at all and every start ended in
#
#     mediabox-player.service: Main process exited, status=2/INVALIDARGUMENT
#
# --vo=mediabox is the replacement. Same decoder, same dma-buf, no compositor:
# the frames go to the interface over a unix socket and the interface puts them
# on the second window of the video port it already owns. See
# packaging/mpv/vo_mediabox.c.
#
# Usage: mediabox-player <url> [start-seconds]
set -eu

URL="${1:?usage: mediabox-player <url> [start-seconds]}"
START="${2:-0}"

# Started by the control plane, which keeps no terminal: without somewhere to
# write, a player that refuses to start refuses silently.
if [ -w /run/mediabox ] || mkdir -p /run/mediabox 2>/dev/null; then
    exec >>/run/mediabox/player.log 2>&1
fi

# No LD_LIBRARY_PATH, and that is the change worth noticing.
#
# The player needs MediaBox's own Rockchip MPP and RGA — the system ffmpeg must
# stay the system ffmpeg — and it used to be handed them here, by pointing this
# process at a directory. That works exactly as long as everyone who ever starts
# the player remembers to do it, and it silently binds whatever is in that
# directory: on a board that also carries rk3588-screenbridge, the line that
# used to be here named *that* product's prefix, and whichever of the two built
# last decided which decoder MediaBox got.
#
# scripts/build-mediabox-player.sh links the binary with an RPATH naming
# $MEDIABOX_MEDIA_PREFIX instead, so the player says where its decoder is and
# nothing out here has to. If it ever cannot find one, the failure is a loud
# missing-library error rather than a silent fall back to software.

# Where the interface listens for frames. It creates this with its own runtime
# directory, so a player that cannot find it is a player started while nothing
# owns the television — which is a refusal to start, not a reason to take the
# display. Nothing here is a compositor: the socket carries dma-buf descriptors
# to the process that already holds DRM master.
MEDIABOX_VIDEO_SOCKET="${MEDIABOX_VIDEO_SOCKET:-/run/mediabox-ui/video.sock}"
export MEDIABOX_VIDEO_SOCKET
if [ ! -S "$MEDIABOX_VIDEO_SOCKET" ]; then
    echo "mediabox-player: arayüz çalışmıyor, $MEDIABOX_VIDEO_SOCKET yok" >&2
    exit 1
fi

# The sound card that belongs to the picture.
#
# With --no-config mpv autoprobes its output: pipewire, then pulse, then ALSA's
# `default` -- and `default`, on a board with no /etc/asound.conf, is card 0.
# On the Ultra card 0 is `rockchiphdmi1`, the board's only HDMI and the socket
# the film is going out of, so this player had sound by coincidence. On the
# Plus card 0 is `rockchipdp0`: measured, the tone ran on card 0 while the
# television was on card 2, and every film played silently. Kodi was fine on
# the same board, because mediabox-hdmi-prepare pins Kodi's profile to the card
# the selected output resolves to.
#
# So the same question is asked here, of the same resolver. `hdmi:CARD=<id>` is
# the PCM that mediabox-hdmi-prepare renders per board -- plug-wrapped, so a
# 44.1 kHz film reaches a 48 kHz sink -- and `plughw:` is the fallback for a
# board where that file has not been written yet. If nothing resolves, nothing
# is pinned and mpv autoprobes as before: a silent film is better than no film.
audio=""
platform=/opt/rk3588-mediabox/bin/mediabox-platform
if [ -x "$platform" ]; then
    card="$("$platform" alsa-card 2>/dev/null || true)"
    driver="$("$platform" alsa-driver 2>/dev/null || true)"
    if [ -n "$card" ] && [ -n "$driver" ] && [ -f "/usr/share/alsa/cards/$driver.conf" ]; then
        audio="--ao=alsa --audio-device=alsa/hdmi:CARD=$card,DEV=0"
    elif [ -n "$card" ]; then
        audio="--ao=alsa --audio-device=alsa/plughw:CARD=$card,DEV=0"
    else
        echo "mediabox-player: ses kartı çözülemedi, mpv kendi seçecek" >&2
    fi
fi

# A socket the control plane can ask "where have you got to" on, which is what
# makes handing the film to Kodi land on the same second rather than the start.
ipc=""
if [ -n "${MEDIABOX_PLAYER_IPC:-}" ]; then
    ipc="--input-ipc-server=$MEDIABOX_PLAYER_IPC"
fi

# shellcheck disable=SC2086  # $ipc and $audio are empty or known flags.
exec /opt/rk3588-mediabox/player/bin/mpv \
    $ipc \
    $audio \
    --no-config \
    --input-conf=/opt/rk3588-mediabox/player/share/mediabox-input.conf \
    --scripts=/opt/rk3588-mediabox/player/share/mediabox.lua \
    --fullscreen \
    --vo=mediabox \
    --hwdec=rkmpp \
    --start="$START" \
    --keep-open=no \
    --osc=no \
    --input-default-bindings=yes \
    --no-ytdl \
    --msg-level=all=warn \
    -- "$URL"
