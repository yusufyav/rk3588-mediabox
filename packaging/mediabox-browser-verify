#!/bin/sh
#
# Does the television's browser actually reach the video hardware?
#
# The browser answering "Video Decode: Hardware accelerated" on chrome://gpu is
# not the question. That line says a feature is switched on; it says so on this
# board with no decoder behind it at all, which is precisely the state this
# product was in before the driver below existed. The questions worth asking are
# whether a decoder is installed, whether it is *this product's* decoder, whether
# the browser is allowed to open the device, and whether the browser then lists
# any profiles.
#
# Every check reads something the appliance reports about itself. Run it on the
# box, after a deploy or whenever a browser looks like it is decoding in
# software:
#
#     mediabox-browser-verify
#
# With the browser running and a debugging port set on it -- which is what
# MEDIABOX_BROWSER_DEBUG_PORT in a drop-in gives -- the last section asks the
# running browser what it thinks it can decode. Without one the script still
# answers everything else, and says why the last part was skipped.
set -eu

PREFIX="${MEDIABOX_PREFIX:-/opt/rk3588-mediabox}"
MEDIA_PREFIX="${MEDIABOX_MEDIA_PREFIX:-$PREFIX/media-runtime}"
DRIVER="$MEDIA_PREFIX/lib/dri/rockchip_drv_video.so"
UNIT=/etc/systemd/system/mediabox-browser.service
LAUNCHER="$PREFIX/bin/mediabox-browser"
CHROMIUM="${MEDIABOX_CHROMIUM:-/usr/lib/chromium/chromium}"
PORT="${MEDIABOX_BROWSER_DEBUG_PORT:-9222}"

fails=0
ok()  { printf '  PASS  %-26s %s\n' "$1" "$2"; }
bad() { printf '  FAIL  %-26s %s\n' "$1" "$2"; fails=$((fails + 1)); }
skip(){ printf '  SKIP  %-26s %s\n' "$1" "$2"; }

echo '== the decoder this board has'
# A BSP kernel puts the VPU behind a Rockchip ioctl node and does not put it
# behind V4L2 at all. Which of the two it is decides everything else: the V4L2
# path Chromium also carries has nothing to bind to here.
if [ -e /dev/mpp_service ]; then
  ok 'decode device' '/dev/mpp_service'
else
  bad 'decode device' '/dev/mpp_service absent -- not a Rockchip BSP kernel'
fi
if ls /dev/video* >/dev/null 2>&1; then
  skip 'v4l2 nodes' "$(ls -d /dev/video* | tr '\n' ' ')"
else
  ok 'v4l2 nodes' 'none, as expected on this kernel'
fi

echo '== the driver that bridges the two'
if [ -e "$DRIVER" ]; then
  ok 'va driver' "$DRIVER"
else
  bad 'va driver' "missing -- run scripts/build-vaapi-driver.sh"
fi
if [ -e "$DRIVER" ]; then
  # One MPP on this box. A driver linked against the distribution's would be a
  # second decoder stack, which is the thing the media runtime exists to avoid.
  mpp=$(ldd "$DRIVER" 2>/dev/null | sed -n 's/.*librockchip_mpp[^ ]* => \([^ ]*\).*/\1/p' | head -1)
  case "$mpp" in
    "$MEDIA_PREFIX"/*) ok 'links product MPP' "$mpp" ;;
    *)                 bad 'links product MPP' "${mpp:-unresolved}" ;;
  esac
  if ldd "$DRIVER" 2>/dev/null | grep -q rk3588-screenbridge; then
    bad 'screenbridge prefix' 'the other product is on this link line'
  else
    ok 'screenbridge prefix' 'unreferenced'
  fi
  if command -v vainfo >/dev/null 2>&1; then
    info=$(LIBVA_DRIVERS_PATH="$MEDIA_PREFIX/lib/dri" LIBVA_DRIVER_NAME=rockchip \
           vainfo --display drm --device /dev/dri/renderD128 2>&1 || true)
    case "$info" in
      *'va_openDriver() returns 0'*) ok 'libva opens it' "$(printf '%s' "$info" | sed -n 's/^vainfo: Driver version: *//p')" ;;
      *) bad 'libva opens it' "$(printf '%s' "$info" | grep -i error | head -1)" ;;
    esac
    for p in VAProfileH264High VAProfileVP9Profile0; do
      case "$info" in
        *"$p"*) ok "$p" 'VLD' ;;
        *)      bad "$p" 'absent' ;;
      esac
    done
  else
    skip 'libva opens it' 'vainfo is not installed'
  fi
fi

echo '== what the browser is allowed and told'
# DevicePolicy stays closed, so the decode node has to be named. Without the
# line the driver loads, advertises its profiles and fails on the first frame,
# which reads exactly like a decoder that was never configured.
for want in '/dev/mpp_service' '/dev/rga'; do
  if grep -q "^DeviceAllow=$want rw" "$UNIT" 2>/dev/null; then
    ok "unit grants $want" 'rw'
  else
    bad "unit grants $want" 'not in DeviceAllow'
  fi
done
if grep -q '^DevicePolicy=closed' "$UNIT" 2>/dev/null; then
  ok 'device policy' 'still closed'
else
  bad 'device policy' 'no longer closed -- the sandbox was widened'
fi

# And the half of the confinement that actually reaches this browser.
#
# PAMName=login moves these processes into a login session scope of their own,
# and everything systemd enforces through the cgroup stays behind in a cgroup
# they no longer live in -- measured with /dev/loop-control, which a scope
# carrying the list above refuses and the running browser opens. The mount
# namespace is built at exec and inherited whatever happens to the cgroup
# afterwards, so the device list has to be expressed there too or it is a
# comment rather than a rule.
if grep -q '^PrivateDevices=yes' "$UNIT" 2>/dev/null; then
  ok 'private /dev' 'namespace-enforced'
else
  bad 'private /dev' 'PrivateDevices absent -- DeviceAllow alone does not reach this unit'
fi
for want in /dev/dri /dev/mali0 /dev/dma_heap /dev/mpp_service /dev/rga; do
  if grep -q "^BindPaths=$want\$" "$UNIT" 2>/dev/null; then
    ok "unit binds $want" 'present'
  else
    bad "unit binds $want" 'not in BindPaths -- it will not exist for the browser'
  fi
done
# Which render node the browser actually took.
#
# Chromium's Ozone layer scans /dev/dri for something to run video on, reports
# "Preferred drm_render_node not found" and takes what enumeration gives it.
# Measured under a compositor that offered no preference, that was the NPU:
# VA-API came up against the neural accelerator, chrome://gpu listed nothing
# under Decoding, and a 4K VP9 page was decoded by the CPU. The node number is
# a property of one board on one boot, so the question is asked of the running
# browser rather than of the unit file: whichever node it holds has to belong
# to the same driver as the display.
display_drv=''
for card in /sys/class/drm/card[0-9]; do
  [ -e "$card/device/driver" ] || continue
  # The card that has the connectors is the display.
  if ls -d "$card"-* >/dev/null 2>&1; then
    display_drv=$(basename "$(readlink -f "$card/device/driver")")
    break
  fi
done
gpu_pid=$(pgrep -f 'type=gpu-process' 2>/dev/null | head -1 || true)
if [ -z "$display_drv" ]; then
  skip 'render node' 'no display card found in sysfs'
elif [ -z "$gpu_pid" ]; then
  skip 'render node' 'the browser is not running'
else
  held=$(ls -l "/proc/$gpu_pid/fd" 2>/dev/null \
         | grep -oE '/dev/dri/renderD[0-9]+' | head -1 || true)
  if [ -z "$held" ]; then
    skip 'render node' 'the gpu process holds none yet'
  else
    held_drv=$(basename "$(readlink -f "/sys/class/drm/${held#/dev/dri/}/device/driver")" 2>/dev/null || echo unknown)
    if [ "$held_drv" = "$display_drv" ]; then
      ok 'render node' "$held, driver $held_drv"
    else
      bad 'render node' "$held is a $held_drv node, not the display's $display_drv"
    fi
  fi
fi

# What the running browser actually sees, which is the only version that counts.
comp_pid=$(pgrep -x sway 2>/dev/null | head -1 || true)
if [ -n "$comp_pid" ] && [ -r "/proc/$comp_pid/root/dev" ]; then
  mine=$(ls "/proc/$comp_pid/root/dev" 2>/dev/null | wc -l)
  host=$(ls /dev | wc -l)
  if [ "$mine" -lt "$host" ]; then
    ok 'browser /dev' "$mine nodes against $host on the host"
  else
    bad 'browser /dev' "$mine nodes, the same as the host -- the namespace is not applied"
  fi
  if [ -e "/proc/$comp_pid/root/dev/mmcblk0" ]; then
    bad 'browser sees storage' '/dev/mmcblk0 is reachable from the browser'
  else
    ok 'browser sees storage' 'no block devices in its /dev'
  fi
else
  skip 'browser /dev' 'the browser is not running'
fi
echo '== the page goes to the display without a copy'
# Direct scanout is what keeps the compositor out of the picture entirely: the
# client's own buffer is handed to the display controller. Two things have to
# hold, and both were measured into place rather than assumed.
#
# First, nothing may disable it.
if grep -q '^Environment=WLR_SCENE_DISABLE_DIRECT_SCANOUT=1' "$UNIT" 2>/dev/null; then
  bad 'direct scanout' 'the unit disables it'
else
  ok 'direct scanout' 'not disabled by the unit'
fi
# Second, the compositor's scene must hold one node, which means no background
# rectangle. wlroots clears uncovered area to black by itself; an `output bg`
# is a node, and a second node is why scanout was never attempted here.
SWAYCONF="${MEDIABOX_SWAY_CONF:-/etc/mediabox/sway-browser.conf}"
if grep -qE '^[[:space:]]*output[[:space:]]+\*?[^#]*[[:space:]]bg[[:space:]]' "$SWAYCONF" 2>/dev/null; then
  bad 'no background node' 'sway config sets output bg -- that second node blocks scanout'
else
  ok 'no background node' 'the scene can hold a single node'
fi
# And what the display controller is actually reading. wlroots allocates its
# own swapchain as XR24; Chromium's surface is AB24. A plane carrying XR24
# while the browser is up is the compositor still doing the work.
SUMMARY=/sys/kernel/debug/dri/0/summary
if ! pgrep -x sway >/dev/null 2>&1; then
  skip 'scanout plane' 'the browser is not running'
elif [ ! -r "$SUMMARY" ]; then
  skip 'scanout plane' 'no VOP2 summary on this kernel'
else
  planefmt=$(sed -n '/win[0-9]: ACTIVE/,/format:/p' "$SUMMARY" | grep -m1 -oE '[A-Z][A-Z0-9][0-9]{2}' || true)
  case "$planefmt" in
    AB24|AR24) ok 'scanout plane' "$planefmt -- the client's own buffer" ;;
    XR24)      bad 'scanout plane' 'XR24 -- this is wlroots compositing, not scanout' ;;
    *)         skip 'scanout plane' "unrecognised format '$planefmt'" ;;
  esac
fi

for want in LIBVA_DRIVER_NAME=rockchip "LIBVA_DRIVERS_PATH=$MEDIA_PREFIX/lib/dri"; do
  if grep -q "^Environment=$want" "$UNIT" 2>/dev/null; then
    ok "unit sets ${want%%=*}" "${want#*=}"
  else
    bad "unit sets ${want%%=*}" 'absent'
  fi
done

echo '== the flags, against this browser rather than a blog'
# A feature name Chromium no longer knows is accepted in silence. Each one is
# checked against the binary that is installed here.
for f in AcceleratedVideoDecoder AcceleratedVideoDecodeLinuxGL AcceleratedVideoDecodeLinuxZeroCopyGL; do
  in_launcher=no; in_binary=no
  grep -q "$f" "$LAUNCHER" 2>/dev/null && in_launcher=yes
  LC_ALL=C grep -aqF "$f" "$CHROMIUM" 2>/dev/null && in_binary=yes
  if [ "$in_launcher" = yes ] && [ "$in_binary" = yes ]; then
    ok "$f" 'asked for, and known to this build'
  elif [ "$in_launcher" = yes ]; then
    bad "$f" 'asked for, but this Chromium does not know it'
  else
    bad "$f" 'not asked for'
  fi
done

echo '== and what the running browser says'
if ! systemctl is-active --quiet mediabox-browser.service; then
  skip 'live decode profiles' 'the browser does not own the display'
elif ! curl -s -m 3 -o /dev/null "http://127.0.0.1:$PORT/json/version" 2>/dev/null; then
  skip 'live decode profiles' "no debugging port on $PORT"
else
  gpu=$(curl -s -m 5 "http://127.0.0.1:$PORT/json/version" 2>/dev/null || true)
  case "$gpu" in
    *Chrome*) ok 'debugging port' "$(printf '%s' "$gpu" | sed -n 's/.*"Browser": "\([^"]*\)".*/\1/p')" ;;
    *)        bad 'debugging port' 'no answer' ;;
  esac
fi

[ "$fails" -eq 0 ] || { echo '== browser decode verification FAILED'; exit 1; }
echo '== the browser reaches the video hardware'
