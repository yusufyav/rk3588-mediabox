#!/bin/sh
#
# Is this a whole MediaBox?
#
# Fail-closed, and deliberately dull: every required thing is named, and a
# required thing that is absent is a failure rather than a line that says it was
# skipped. A verifier that skips what it cannot find passes an empty disk.
#
# Two modes:
#
#   mediabox-product-verify
#       the installed product: files, linkage, units, and the services running.
#
#   MEDIABOX_VERIFY_ROOT=<dir> MEDIABOX_VERIFY_META=<dir> \
#   MEDIABOX_VERIFY_STATIC_ONLY=1 mediabox-product-verify
#       an unpacked release, before anything is installed. The binaries are for
#       another architecture than the machine checking them, so whatever has to
#       be *run* to be known -- the decoder the player offers, the libraries it
#       resolves -- is read out of meta/, where the capture recorded what the
#       golden board answered. Nothing is waived: the capture refuses to write a
#       meta/ that says otherwise. Whatever can be read out of a file instead is
#       read here, from the archive, with no tool a clean image does not have.
#
set -eu

ROOT="${MEDIABOX_VERIFY_ROOT:-}"
META="${MEDIABOX_VERIFY_META:-}"
STATIC="${MEDIABOX_VERIFY_STATIC_ONLY:-0}"
# Set by the installer when it measured no connected connector before it
# started. It waives nothing on its own: the checks below re-measure, and a
# board with a television attached is judged whatever the caller said.
NO_DISPLAY="${MEDIABOX_VERIFY_NO_DISPLAY:-0}"
P="$ROOT/opt/rk3588-mediabox"
ETC="$ROOT/etc"
fails=0
skips=0

MEDIABOXD_SOCK="${MEDIABOXD_SOCK:-/run/mediabox/mediaboxd.sock}"

# One line of JSON to the daemon's own socket, one line back. python3 is a
# runtime dependency of the product already -- the media worker is written in
# it -- so this adds nothing the appliance does not have.
mediabox_rpc() {
  python3 - "$MEDIABOXD_SOCK" "$1" <<'PYEOF'
import socket, sys
sock, payload = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(30)
try:
    s.connect(sock)
    s.sendall(payload.encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
except OSError as exc:
    print(f'{{"ok":false,"error":{{"code":"NO_DAEMON","message":"{exc}"}}}}')
else:
    sys.stdout.write(buf.decode("utf-8", "replace").strip())
PYEOF
}

pass() { printf '  PASS  %-40s %s\n' "$1" "${2:-}"; }
fail() { printf '  FAIL  %-40s %s\n' "$1" "${2:-}"; fails=$((fails + 1)); }
# The one thing this verifier is allowed not to know, and it says so in its own
# column and in its last line. Reachable only for the checks that need a
# display, and only on a board where none is plugged in.
skip() { printf '  SKIP  %-40s %s\n' "$1" "${2:-}"; skips=$((skips + 1)); }
req_exec() { [ -x "$P/$1" ] && pass "$2" "$1" || fail "$2" "MISSING $P/$1"; }
req_dir()  { [ -d "$P/$1" ] && pass "$2" "$1" || fail "$2" "MISSING $P/$1"; }
req_file() { [ -f "$P/$1" ] && pass "$2" "$1" || fail "$2" "MISSING $P/$1"; }

echo "== MediaBox product verify${ROOT:+ (archive at $ROOT)}"

# ------------------------------------------------------------ the binaries
req_exec bin/mediaboxd-rs        "control plane"
req_exec bin/mediaboxctl          "control client"
req_exec bin/mediabox-platform    "platform discovery"
req_exec bin/mediabox-tv          "television interface"
req_exec bin/mediabox-player      "player launcher"
req_dir  media-runtime            "media runtime"
req_dir  media-runtime/lib        "media runtime libraries"
req_exec player/bin/mpv           "player"
req_dir  player/share             "player data"
req_dir  mali-g24p0-root          "Mali user space"
req_dir  mali-g24p0-runtime       "Mali runtime links"
req_exec node/bin/node            "Node"
req_file stremio-server/server.js "Stremio server"
req_exec kodi/lib/kodi/kodi-gbm   "Kodi"
req_dir  media                    "media worker package"
req_dir  ui                       "interface assets"

# ------------------------------------------------- what the player can do
#
# On the installed product these are measured. On an unpacked archive they are
# read back from the capture, which measured them on the board the binaries came
# off; a missing or negative line is a failure either way.
capability() {
  name="$1"; key="$2"; probe="$3"
  if [ "$STATIC" = 1 ]; then
    [ -n "$META" ] && [ -f "$META/capability-baseline.txt" ] \
      || { fail "$name" "no capability baseline in the archive"; return; }
    if grep -q "^$key$(printf '\t')present$" "$META/capability-baseline.txt"
    then pass "$name" "recorded by the capture"
    else fail "$name" "the capture did not record it"; fi
  else
    if eval "$probe" >/dev/null 2>&1
    then pass "$name" measured
    else fail "$name" "not offered by $P/player/bin/mpv"; fi
  fi
}
MPVLD="$P/mali-g24p0-runtime/lib:$P/media-runtime/lib"
capability "vo_mediabox" mpv-vo-mediabox \
  "LD_LIBRARY_PATH=$MPVLD '$P/player/bin/mpv' --vo=help | grep -qw mediabox"
capability "hwdec rkmpp" mpv-hwdec-rkmpp \
  "LD_LIBRARY_PATH=$MPVLD '$P/player/bin/mpv' --hwdec=help | grep -q rkmpp"

# ------------------------------------------------------------ the linkage
#
# The runpath is read out of the binary itself, which works for a foreign
# architecture as well as for this one. Resolution -- what a library actually
# loads at run time -- only means anything on the board, so on an archive the
# capture's own closure is consulted instead of guessing.
#
# It used to be read with `readelf`, and that was a dependency on binutils that
# a clean Armbian Minimal image does not satisfy. The archive is verified
# *before* the runtime packages are installed -- it has to be, the package list
# comes out of the archive -- so on every fresh board the install stopped at:
#
#   FAIL  runpath player/bin/mpv   readelf is not installed; cannot check
#
# Making binutils a prerequisite would have put a toolchain in front of a
# product that compiles nothing, and weakening the check to a `grep` for the
# path would have accepted any binary that merely mentions it. So the dynamic
# section is read here instead, with od and awk, which this script already
# needs. The format is fixed and documented: the program header table names
# PT_DYNAMIC, the dynamic array names DT_RUNPATH (or the older DT_RPATH) as an
# index into the string table that DT_STRTAB names by virtual address, and the
# PT_LOAD segment covering that address turns it back into a file offset.
#
# Three outcomes, and only one of them is silent: the runpath, an empty string
# for a binary that carries none, and __unreadable__ for anything that is not a
# little-endian ELF64 or whose dynamic section does not parse. Both of the last
# two fail below.
elf_runpath() {
  _f="$1"
  _hdr="$(od -An -tu1 -v -N 64 "$_f" 2>/dev/null | awk '
    { for (i = 1; i <= NF; i++) b[n++] = $i }
    function u(o, l,   v, i) { v = 0; for (i = l - 1; i >= 0; i--) v = v * 256 + b[o + i]; return v }
    END {
      if (n < 64) exit 1
      if (b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70) exit 1
      if (b[4] != 2 || b[5] != 1) exit 1          # ELF64, little-endian
      printf "%.0f %.0f %.0f\n", u(32, 8), u(54, 2), u(56, 2)
    }' 2>/dev/null)" || { echo __unreadable__; return 0; }
  [ -n "$_hdr" ] || { echo __unreadable__; return 0; }
  # shellcheck disable=SC2086
  set -- $_hdr                                     # e_phoff e_phentsize e_phnum
  [ "$3" -gt 0 ] && [ "$2" -ge 56 ] || { echo __unreadable__; return 0; }

  # Every PT_LOAD (for the address arithmetic) and the one PT_DYNAMIC.
  _ph="$(od -An -tu1 -v -j "$1" -N "$(($2 * $3))" "$_f" 2>/dev/null |
    awk -v ent="$2" -v num="$3" '
    { for (i = 1; i <= NF; i++) b[n++] = $i }
    function u(o, l,   v, i) { v = 0; for (i = l - 1; i >= 0; i--) v = v * 256 + b[o + i]; return v }
    END {
      for (k = 0; k < num; k++) {
        o = k * ent
        if (o + 56 > n) break
        t = u(o, 4)                                # p_type
        if (t == 2)      printf "DYN %.0f %.0f\n",       u(o + 8, 8), u(o + 32, 8)
        else if (t == 1) printf "LOAD %.0f %.0f %.0f\n", u(o + 8, 8), u(o + 16, 8), u(o + 32, 8)
      }
    }' 2>/dev/null)" || _ph=""
  _off="$(printf '%s\n' "$_ph" | awk '$1=="DYN"{print $2; exit}')"
  _len="$(printf '%s\n' "$_ph" | awk '$1=="DYN"{print $3; exit}')"
  [ -n "$_off" ] && [ -n "$_len" ] && [ "$_len" -gt 0 ] || { echo __unreadable__; return 0; }

  _dyn="$(od -An -tu1 -v -j "$_off" -N "$_len" "$_f" 2>/dev/null | awk '
    { for (i = 1; i <= NF; i++) b[n++] = $i }
    function u(o, l,   v, i) { v = 0; for (i = l - 1; i >= 0; i--) v = v * 256 + b[o + i]; return v }
    END {
      for (o = 0; o + 16 <= n; o += 16) {
        t = u(o, 8); v = u(o + 8, 8)
        if (t == 0) break                          # DT_NULL
        if (t == 5)       printf "STRTAB %.0f\n", v
        else if (t == 29) printf "RUNPATH %.0f\n", v
        else if (t == 15) printf "RPATH %.0f\n", v
      }
    }' 2>/dev/null)" || _dyn=""
  _idx="$(printf '%s\n' "$_dyn" | awk '$1=="RUNPATH"{print $2; exit}')"
  [ -n "$_idx" ] || _idx="$(printf '%s\n' "$_dyn" | awk '$1=="RPATH"{print $2; exit}')"
  [ -n "$_idx" ] || { echo ""; return 0; }         # linked with no runpath at all
  _str="$(printf '%s\n' "$_dyn" | awk '$1=="STRTAB"{print $2; exit}')"
  [ -n "$_str" ] || { echo __unreadable__; return 0; }
  _str="$(printf '%s\n' "$_ph" |
    awk -v v="$_str" '$1=="LOAD" && v >= $3 && v < $3 + $4 { printf "%.0f\n", v - $3 + $2; exit }')"
  [ -n "$_str" ] || { echo __unreadable__; return 0; }

  od -An -tu1 -v -j "$((_str + _idx))" -N 4096 "$_f" 2>/dev/null | awk '
    { for (i = 1; i <= NF; i++) { if ($i == 0) exit; s = s sprintf("%c", $i) } }
    END { print s }' 2>/dev/null || echo __unreadable__
}

# What the capture measured, for the same two binaries, on the golden board.
#
# An archive cut before meta/runpath.tsv existed does not carry it, and the
# already published release is one of those. That is not a reason to skip the
# check: the binaries are in the archive and elf_runpath reads them directly,
# so the archive is checked either way. When the file *is* there the two
# readings have to agree -- the capture read the binary on the board it came
# off, and a disagreement means the archive is not carrying what was captured.
recorded_runpath() {
  [ -n "$META" ] && [ -f "$META/runpath.tsv" ] || return 1
  awk -F'\t' -v want="$1" '$1 == want { print $2; found = 1 } END { exit !found }' \
    "$META/runpath.tsv"
}

for b in player/bin/mpv kodi/lib/kodi/kodi-gbm; do
  [ -x "$P/$b" ] || continue
  rp="$(elf_runpath "$P/$b")"
  if [ "$rp" = __unreadable__ ]; then
    fail "runpath $b" "the dynamic section of $P/$b could not be read"
    continue
  fi
  if [ "$STATIC" = 1 ] && rec="$(recorded_runpath "$b")"; then
    if [ "$rec" != "$rp" ]; then
      fail "runpath $b" "the capture recorded '$rec', the archived binary says '${rp:-none}'"
      continue
    fi
  fi
  case "$rp" in
    */opt/rk3588-mediabox/media-runtime/lib*) pass "runpath $b" "$rp" ;;
    *) fail "runpath $b" "expected the MediaBox media runtime, got '${rp:-none}'" ;;
  esac
  case "$rp" in
    *rk3588-screenbridge*) fail "screenbridge runpath $b" "$rp" ;;
    *) pass "screenbridge runpath $b" none ;;
  esac
done

if [ "$STATIC" = 1 ]; then
  if [ -n "$META" ] && [ -f "$META/elf-closure.txt" ]; then
    n="$(awk -F'\t' '$4=="SCREENBRIDGE"' "$META/elf-closure.txt" | wc -l)"
    [ "$n" -eq 0 ] && pass "ScreenBridge linkage" "0 of $(($(wc -l <"$META/elf-closure.txt") - 1))" \
      || fail "ScreenBridge linkage" "$n resolutions"
    n="$(awk -F'\t' '$4=="INVALID"' "$META/elf-closure.txt" | wc -l)"
    [ "$n" -eq 0 ] && pass "unresolved libraries" 0 || fail "unresolved libraries" "$n"
  else
    fail "ScreenBridge linkage" "no ELF closure in the archive"
  fi
else
  foreign=0; unres=0
  for b in player/bin/mpv kodi/lib/kodi/kodi-gbm bin/mediabox-tv bin/mediaboxd-rs \
           bin/mediabox-platform node/bin/node media-runtime/bin/ffmpeg; do
    [ -x "$P/$b" ] || continue
    out="$(LD_LIBRARY_PATH="$MPVLD" ldd "$P/$b" 2>/dev/null || true)"
    foreign=$((foreign + $(printf '%s\n' "$out" | grep -c 'rk3588-screenbridge' || true)))
    unres=$((unres + $(printf '%s\n' "$out" | grep -c 'not found' || true)))
  done
  [ "$foreign" -eq 0 ] && pass "ScreenBridge linkage" 0 || fail "ScreenBridge linkage" "$foreign"
  [ "$unres" -eq 0 ] && pass "unresolved libraries" 0 || fail "unresolved libraries" "$unres"
fi

# -------------------------------------------------- nothing staged, nothing left over
#
# A product prefix is what was installed, not what it was built from.
#
# An A/B candidate of Kodi was once accepted by copying its binary over the
# production one. A Kodi binary carries the prefix it was configured with, so
# special://xbmc/ still resolved to /opt/rk3588-mediabox/kodi-candidate/share/kodi
# -- and it kept working, because that tree was still on the disk. When the
# staging tree was tidied away the player died one second into every start with
# "Unable to find path to Kodi data files!", and ExecStopPost put the interface
# back, so each failed launch looked exactly like a clean exit. Five of them went
# by unnoticed.
#
# The lesson is what this section checks, and it is deliberately not "does the
# data tree exist": that is the check that passed the whole time the candidate
# was installed. What is checked is where the binary will *look*, which is a
# property of the binary and survives whatever is or is not on the disk.

# Leftovers first: the backup beside the real thing, and the build tree that was
# never meant to ship.
#
# `build` is bounded to the top two levels because npm vendors directories of
# that name inside node_modules and those are package contents, not staging. A
# build tree that shipped by accident would be at $P/build or $P/<component>/build.
leftovers="$(
  { find "$P" -xdev -mindepth 1 \
      \( -name '*.orig' -o -name '*.bak' -o -name '*candidate*' \
         -o -name 'staging' -o -name 'kodi-src' \) -printf '%P\n' 2>/dev/null
    find "$P" -xdev -mindepth 1 -maxdepth 2 -name 'build' -printf '%P\n' 2>/dev/null
  } | sort -u
)"
if [ -z "$leftovers" ]; then
  pass "no staging leftovers" "0 under $P"
else
  fail "no staging leftovers" "$(printf '%s' "$leftovers" | tr '\n' ' ')"
fi

# And the mapping itself, read out of the binary.
#
# Kodi resolves special://xbmc/ from the prefix it was configured with unless
# KODI_HOME overrides it. kodi.service does set KODI_HOME, and that stays --
# it is the defence in depth -- but a release must not need it: the binary in
# the archive has to be one that finds its own data. So every
# /opt/rk3588-mediabox/<something>/share/kodi baked into the executable is read
# out and the set has to be exactly the canonical one.
#
# `grep -a` and not `strings`, because binutils is not a runtime dependency of
# this appliance and a verifier that cannot run on a clean board verifies
# nothing.
kodi_bin="$P/kodi/lib/kodi/kodi-gbm"
if [ -f "$kodi_bin" ]; then
  baked="$(LC_ALL=C grep -aoE '/opt/rk3588-mediabox/[A-Za-z0-9._+-]+/share/kodi' "$kodi_bin" 2>/dev/null | sort -u || true)"
  if [ "$baked" = "/opt/rk3588-mediabox/kodi/share/kodi" ]; then
    pass "Kodi data prefix" "$baked"
  elif [ -z "$baked" ]; then
    fail "Kodi data prefix" "the binary names no data prefix at all"
  else
    fail "Kodi data prefix" "$(printf '%s' "$baked" | tr '\n' ' ')"
  fi
  if LC_ALL=C grep -aq 'rk3588-mediabox/kodi-candidate' "$kodi_bin" 2>/dev/null; then
    fail "Kodi staging reference" "the binary still names kodi-candidate"
  else
    pass "Kodi staging reference" none
  fi
  # The tree that prefix points at has to be here too. This is the weaker of the
  # two checks and it is second on purpose.
  req_file kodi/share/kodi/system/settings/settings.xml "Kodi data files"
else
  fail "Kodi data prefix" "MISSING $kodi_bin"
fi

# ------------------------------------------------------------- the symlinks
#
# The Mali links inside the prefix are absolute -- they name /opt/rk3588-mediabox
# because that is where they will live. Under an unpacked archive that path does
# not exist yet, so `test -e` calls every one of them broken and a verifier that
# believed it would reject every correct release. Links are resolved against the
# root being checked, which is "/" on the installed product and the staging
# directory on an archive.
resolves() {
  cur="$1"; hops=0
  # Walked rather than tested in one step, because the Mali links are a chain:
  # libmali.so -> libmali.so.1 -> libmali.so.1.9.0 -> /opt/... and only the last
  # hop is absolute. Testing the first hop asks whether a link that is itself
  # unresolved-under-this-root exists, and gets "no" for a chain that is fine.
  while [ -L "$cur" ] && [ "$hops" -lt 16 ]; do
    t="$(readlink "$cur")"
    case "$t" in
      /*) cur="$ROOT$t" ;;
      *)  cur="$(dirname "$cur")/$t" ;;
    esac
    hops=$((hops + 1))
  done
  [ -e "$cur" ]
}
broken=0
for l in $(find "$P" -xdev -type l 2>/dev/null); do
  resolves "$l" || { broken=$((broken + 1)); printf '        %s -> %s\n' "$l" "$(readlink "$l")"; }
done
[ "$broken" -eq 0 ] && pass "broken symlinks" 0 || fail "broken symlinks" "$broken"
for l in libmali.so.1 libEGL.so.1 libGLESv2.so.2 libgbm.so.1 libmali-hook.so.1; do
  f="$P/mali-g24p0-runtime/lib/$l"
  if [ -e "$f" ] || [ -L "$f" ]; then
    resolves "$f" && pass "Mali $l" resolved || fail "Mali $l" "does not resolve"
  else fail "Mali $l" "MISSING"; fi
done

# ---------------------------------------------------------------- the units
for u in mediaboxd-rs mediabox-tv-ui mediabox-media-worker stremio-server \
         mediabox-console-off mediabox-display-changed mediabox-browser kodi; do
  f="$ETC/systemd/system/$u.service"
  [ -f "$f" ] && pass "unit $u.service" installed || fail "unit $u.service" "MISSING $f"
done
for f in etc/mediaboxd.toml etc/mediabox-library.json etc/mediabox-applications.json \
         etc/mediabox-media-worker.env etc/mediabox/sway-browser.conf \
         etc/udev/rules.d/80-mediabox-no-power-switch.rules \
         etc/udev/rules.d/81-mediabox-display-hotplug.rules \
         etc/systemd/logind.conf.d/10-mediabox.conf; do
  [ -f "$ROOT/$f" ] && pass "integration $(basename "$f")" ok || fail "integration $f" "MISSING"
done

# -------------------------------------------------- and, on the board itself
if [ "$STATIC" != 1 ]; then
  if "$P/bin/mediabox-platform" inspect >/dev/null 2>&1
  then pass "platform inspect" succeeds
  else fail "platform inspect" "the platform cannot be described"; fi

  out=""
  for s in /sys/class/drm/card*-*/status; do
    [ -e "$s" ] || continue
    [ "$(cat "$s")" = connected ] && out="$out $(basename "$(dirname "$s")")"
  done
  # Headless is a state of the cabling, not a mode the caller can declare: it
  # holds only while this loop agrees that nothing is connected.
  headless=0
  [ -z "$out" ] && [ "$NO_DISPLAY" = 1 ] && headless=1
  if [ -n "$out" ]; then
    pass "connected output" "${out# }"
  elif [ "$headless" = 1 ]; then
    skip "connected output" "no display is attached to this board"
  else
    fail "connected output" none
  fi

  for u in mediaboxd-rs mediabox-media-worker stremio-server; do
    st="$(systemctl is-active "$u.service" 2>/dev/null || true)"
    [ "$st" = active ] && pass "$u running" "$st" || fail "$u running" "${st:-unknown}"
  done

  # The interface and Kodi are declared incompatible: exactly one of them holds
  # the television, and while Kodi has it the interface is *supposed* to be
  # stopped. Requiring mediabox-tv-ui to be active failed a perfectly healthy
  # appliance that happened to be showing Kodi when it was asked.
  ui_state="$(systemctl is-active mediabox-tv-ui.service 2>/dev/null || true)"
  kodi_state="$(systemctl is-active kodi.service 2>/dev/null || true)"
  case "$ui_state:$kodi_state" in
    active:*)   pass "the television has an owner" "the interface" ;;
    *:active)   pass "the television has an owner" "Kodi (the interface stands down for it)" ;;
    *)          if [ "$headless" = 1 ]; then
                  skip "the television has an owner" "there is no television to own"
                else
                  fail "the television has an owner" "neither the interface nor Kodi is running"
                fi ;;
  esac
  # A socket file is not a listener.
  #
  # This used to be `[ -S ... ]`, which a stale socket left behind by a dead
  # interface passes just as well as a live one. What the player needs is
  # something accepting on the other end, so that is what is asked.
  sock=/run/mediabox-ui/video.sock
  if [ "$headless" = 1 ] && [ "$ui_state" != active ]; then
    skip "interface video socket" "the interface is not running: no display is attached"
  elif [ "$ui_state" != active ]; then
    # Nothing to listen: the socket belongs to the interface's runtime
    # directory and goes away with it. Checked whenever the interface is up,
    # which is every case that matters -- including the end of an install.
    pass "interface video socket" "not applicable while Kodi holds the display"
  elif [ ! -S "$sock" ]; then
    fail "interface video socket" "MISSING $sock"
  elif ss -xlnp 2>/dev/null | grep -q "$sock"; then
    pass "interface video socket" listening
  elif [ -n "$(ss -xln 2>/dev/null | grep -F "$sock")" ]; then
    pass "interface video socket" listening
  else
    fail "interface video socket" "$sock exists but nothing is listening on it"
  fi

  # The probe the whole player path hangs off.
  #
  # Everything above this line passed on a clean board whose own player could
  # not start a single film: the worker probes every source before anything
  # plays, it finds ffprobe on PATH, and on that board PATH did not contain
  # this appliance. A verifier that only looks at files says PASS to that. So
  # the daemon is asked to plan a source that ships with the product -- the
  # same call the television makes -- and the answer has to come back.
  # And that the ffprobe the worker will actually use speaks TLS.
  #
  # The probe below uses a file:// source, which every ffprobe can open. Real
  # sources are https, and the FFmpeg this appliance ships is built for the
  # Rockchip decoder with no TLS at all -- it answers "Protocol not found" to
  # every real link. Pointing the worker's PATH at it fixed a clean install and
  # broke every film on it, and nothing here noticed, because a packaged clip
  # plays perfectly either way. So the winner of the PATH is asked what
  # protocols it has.
  worker_path="$(systemctl show mediabox-media-worker.service -p Environment --value 2>/dev/null |
                 tr ' ' '\n' | sed -n 's/^PATH=//p' | head -1)"
  probe_bin="$(PATH="${worker_path:-$PATH}" command -v ffprobe 2>/dev/null || true)"
  if [ -z "$probe_bin" ]; then
    fail "probe binary" "no ffprobe on the media worker's PATH"
  elif "$probe_bin" -hide_banner -protocols 2>/dev/null | tr ',' '\n' | grep -qx ' *https'; then
    pass "probe speaks https" "$probe_bin"
  else
    fail "probe speaks https" "$probe_bin cannot open https; every catalogue source is https"
  fi

  # The glyphs the catalogue is written in.
  #
  # A clean board came up with DejaVu and nothing else. Turkish rendered
  # perfectly, and every stream row drew its seeder count, its size and its
  # language flags as empty boxes, because nothing installed covered emoji.
  # Nothing in a file listing or an ELF closure can see that -- the interface
  # asks fontconfig at run time -- so it is asked here.
  if ! command -v fc-list >/dev/null 2>&1; then
    fail "catalogue glyphs" "fontconfig is not installed; the interface's fonts cannot be checked"
  else
    missing=""
    for ch in 0041 1F4BE 1F464; do
      fc-list ":charset=$ch" family 2>/dev/null | grep -q . || missing="$missing U+$ch"
    done
    if [ -z "$missing" ]; then
      pass "catalogue glyphs" "$(fc-list ":charset=1F4BE" family 2>/dev/null | head -1 | cut -d, -f1)"
    else
      fail "catalogue glyphs" "no installed font covers$missing; catalogue rows will draw empty boxes"
    fi
  fi

  # Kodi has to be reachable, or a handover has nowhere to go.
  #
  # The control plane moves a film into Kodi over its HTTP control endpoint,
  # and Kodi ships with that endpoint switched off. On a clean install Kodi
  # started, took the television and showed an empty library, because
  # Player.Open went to a port nothing was listening on. Checked against the
  # settings file, so it holds whether or not Kodi is running right now.
  profile=/var/tmp/kodi-home/.kodi/userdata/guisettings.xml
  seed="$P/share/kodi/guisettings-appliance.xml"
  if [ ! -f "$seed" ]; then
    fail "Kodi appliance profile" "MISSING $seed; a first run would get Kodi's own defaults"
  elif [ ! -f "$profile" ]; then
    pass "Kodi appliance profile" "will be seeded on the first run"
  elif ! grep -q '"services.webserver"[^>]*>true' "$profile"; then
    fail "Kodi control endpoint" "switched off in $profile; a film cannot be handed to Kodi"
  else
    pass "Kodi control endpoint" enabled
    # The settings whose absence does not stop Kodi starting and does stop it
    # showing a film correctly. Each of these was found the hard way.
    missing=""
    for key in videoscreen.whitelist videoplayer.useprimerenderer audiooutput.ac3transcode; do
      grep -q "\"$key\"" "$profile" || missing="$missing $key"
    done
    if [ -z "$missing" ]; then
      pass "Kodi picture and sound settings" present
    else
      fail "Kodi picture and sound settings" "Kodi is running on its own defaults for:$missing"
    fi
  fi

  asset="$P/assets/sdr-4k-2398-main.mp4"
  if [ ! -f "$asset" ]; then
    fail "source probe" "MISSING $asset"
  else
    plan="$(mediabox_rpc "{\"command\":\"media_policy\",\"url\":\"file://$asset\"}" 2>/dev/null || true)"
    case "$plan" in
      *'"ok":true'*'"playback"'*) pass "source probe" "the worker planned a packaged source" ;;
      *PROBE_FAILED*) fail "source probe" "the worker cannot run ffprobe: ${plan#*\"message\": \"}" ;;
      "") fail "source probe" "the daemon did not answer on $MEDIABOXD_SOCK" ;;
      *) fail "source probe" "$(printf '%s' "$plan" | cut -c1-160)" ;;
    esac
  fi
fi

echo
if [ "$fails" -eq 0 ] && [ "$skips" -eq 0 ]; then
  echo "== product verify PASS"
elif [ "$fails" -eq 0 ]; then
  echo "== product verify PASS with $skips display check(s) not run: no display is attached"
else
  echo "== product verify FAIL ($fails required item(s) missing or wrong)"
fi
[ "$fails" -eq 0 ]
