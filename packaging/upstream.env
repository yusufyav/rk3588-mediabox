# Pinned third-party components of the MediaBox streaming server.
#
# Every one of these is a fixed revision or a checksummed artefact. Nothing here
# floats: "latest" would make the appliance a different product on every build,
# and a streaming server that changed under us would change what Kodi is handed.
#
# Revisions are the ones the S0-A architecture gate examined and accepted.
# Installed by scripts/install-stremio-server.sh.
#
# The upstream stremio-web application used to be pinned here too. It was the
# first architecture's product surface — a composed page with a MediaBox shell
# layered over it — and it is gone: the product UI is rust/crates/mediabox-ui
# and the television has an interface of its own. Only the streaming server is
# still upstream's.

# Source of the streaming server bundle. Stremio ships it inside the Linux shell
# repository as a vendored artefact; it is not built from source by anyone,
# upstream included, so it is pinned by content hash rather than by build.
STREMIO_SHELL_REPO="https://github.com/Stremio/stremio-linux-shell.git"
STREMIO_SHELL_REV="c6e7cd22e23ed6401e573fe7fe1a023fc07399a2"
STREMIO_SHELL_TAG="v1.2.0"
STREMIO_SERVER_RELPATH="data/server.js"
STREMIO_SERVER_SHA256="82175d7982bce864df071df93b4b3d567a401e65881a8ac579d7db0ce71dafd7"
STREMIO_SERVER_BYTES="6676491"

# The runtime that bundle is supported on. This exact version is the one
# upstream's own arm64 packaging pins, so the appliance runs a combination
# Stremio ships rather than one we invented.
NODE_VERSION="22.23.1"
NODE_TARBALL="node-v${NODE_VERSION}-linux-arm64.tar.xz"
NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TARBALL}"
NODE_SHA256="0294e8b915ab75f92c7513d2fcb830ae06e10684e6c603e99a87dbf8835389c1"

# Where the appliance keeps them.
TARGET_PREFIX="/opt/rk3588-mediabox"
TARGET_NODE_DIR="${TARGET_PREFIX}/node"
TARGET_SERVER_DIR="${TARGET_PREFIX}/stremio-server"
TARGET_SERVER_STATE="/var/lib/stremio-server"
