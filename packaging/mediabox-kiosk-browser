#!/bin/sh
#
# The television's browser.
#
# It lives in its own script rather than on the compositor's exec line because
# sway's config parser splits commands on "," and ";" — characters that appear
# inside ordinary Chromium flags — and has no line continuation. A wrapped or
# comma-bearing command line silently loses its arguments, which is a browser
# sitting on its default start page instead of the product.
#
# When the browser exits the compositor goes with it, so systemd sees one unit
# that is either showing the interface or not running at all.
set -eu

# `?tv=1` is how the interface learns it is on the television. It cannot be
# worked out from the browser: this kiosk reports the same pointer and hover
# capabilities as a desktop, measured on this appliance. Without the flag the
# page behaves as an ordinary scrolling page, which is what a phone needs.
URL="${MEDIABOX_UI_URL:-http://127.0.0.1:8787/?tv=1}"
PROFILE="${MEDIABOX_UI_PROFILE:-/var/lib/mediabox-ui/chromium}"

# Measurement, off unless asked for. Performance on a television is a property
# of the real browser on the real panel, so the instrument has to attach to
# this process rather than to a headless copy of it. The port is bound to
# loopback and the variable is unset in production, so shipping behaviour is
# byte-for-byte what it was without it.
# What one CSS pixel is worth on the panel that is actually attached. It was
# the literal 2 here, which is a 4K television and nothing else; on the
# 2560x1440 monitor this box is plugged into today that laid the interface out
# in 1280x720 logical pixels. Measured per launch instead — see
# mediabox-display-scale — so the same image works on a 1080p set, a 1440p
# monitor and a 4K television without being told which one it is on.
SCALE="$(/opt/rk3588-mediabox/bin/mediabox-display-scale 1920 1080 2>/dev/null || echo 1)"

debug=""
if [ -n "${MEDIABOX_UI_DEBUG_PORT:-}" ]; then
  debug="--remote-debugging-port=${MEDIABOX_UI_DEBUG_PORT} --remote-allow-origins=*"
fi

# --lang=tr is not cosmetic: the browser offers to translate a page whose
# language differs from its own interface, and this interface is Turkish. The
# managed policy in /etc/chromium/policies/managed/mediabox.json is what
# actually forbids the bubble; this makes the question stop being asked.
#
# shellcheck disable=SC2086  # $debug is either empty or two known flags.
# `--test-type` silences the one infobar that survives `--disable-infobars`:
# the warning about `--no-sandbox`, which is here because this runs as root and
# Chromium refuses to without it. Kiosk mode suppressed that warning; an
# application window draws it across the top of the product instead.
#
# The window is made to fill the panel by the compositor, not by the browser.
# Asking the browser for it (`--start-fullscreen`, or the page asking for
# fullscreen itself) makes it announce "Press Esc to exit full screen" across
# the top on every start, because as far as it knows a person chose that and
# may want out. sway gives it the whole output instead and there is nothing to
# announce.
#
# An application window, not a kiosk.
#
# `--kiosk` is a mode, and a mode can fail to apply: when it did, the browser
# came up as a browser — tab strip, address bar, bookmark star — with the
# product inside it, which is the one thing an appliance must never show.
# `--app=` does not have a mode to lose: a window opened this way has no tab
# strip and no omnibox because none is ever created for it.
/usr/bin/chromium \
  $debug \
  --app="$URL" \
  --no-sandbox \
  --ozone-platform=wayland \
  --force-device-scale-factor="$SCALE" \
  --user-data-dir="$PROFILE" \
  --no-first-run \
  --no-default-browser-check \
  --disable-background-networking \
  --disable-component-update \
  --disable-sync \
  --disable-infobars \
  --test-type \
  --disable-features=Translate,TranslateUI \
  --lang=tr \
  --disable-session-crashed-bubble \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required \
  --hide-scrollbars || true

exec /usr/bin/swaymsg exit
