#!/bin/sh
#
# What this unit starts is not always in its cgroup, so somebody has to wait for
# it.
#
# The unit ran a compositor before it ran the product's own interface, and
# `PAMName=login` put that compositor and everything under it into a PAM session
# scope rather than into mediabox-tv-ui.service's own cgroup. Measured on the
# appliance: `systemd-cgls -u mediabox-tv-ui.service` was empty while sway and
# nine Chromium processes sat in /user.slice/user-0.slice/session-N.scope, where
# KillMode= never reached them. The native shell has no compositor and does sit
# in the unit's cgroup, so this is now a net rather than the mechanism — but a
# browser left over from a box part-way through an upgrade still holds the GPU
# and the DRM device, and Kodi must not be started on top of one.
#
# Processes are found by what they *are*, never by what their command line
# mentions.
#
#   pkill -f -- /opt/rk3588-mediabox/bin/mediabox-tv
#
# is a pattern against every process's full command line, and during a deploy
# the command line that matches it is the administrator's own shell:
#
#   install -m 0755 /var/tmp/mediabox-tv /opt/rk3588-mediabox/bin/mediabox-tv
#
# That is not a hypothetical. It killed the SSH session of every deploy that
# restarted this unit in the same command it installed the binary — which read
# as the appliance dropping off the network. So the shell is matched on
# /proc/<pid>/exe, which is the file a process is actually running, and the
# browser additionally on its own profile directory.
set -eu

NATIVE='/opt/rk3588-mediabox/bin/mediabox-tv'
BROWSER='--user-data-dir=/var/lib/mediabox-ui/chromium'

# Every pid that is one of the two, one per line.
matching() {
  self=$$
  for entry in /proc/[0-9]*; do
    pid="${entry#/proc/}"
    [ "$pid" = "$self" ] && continue
    exe="$(readlink "$entry/exe" 2>/dev/null)" || continue
    case "$exe" in
      "$NATIVE") echo "$pid"; continue ;;
    esac
    # A browser, and this appliance's kiosk profile. Both halves are required:
    # the television's own browser application and any other Chromium on the
    # box are none of this script's business.
    case "$exe" in
      *chrome|*chromium|*chromium-browser) ;;
      *) continue ;;
    esac
    if tr '\0' ' ' < "$entry/cmdline" 2>/dev/null | grep -qF -- "$BROWSER"; then
      echo "$pid"
    fi
  done
}

gone() {
  [ -z "$(matching)" ]
}

signal() {
  for pid in $(matching); do
    kill "$1" "$pid" 2>/dev/null || true
  done
}

signal -TERM

# Five seconds is generous for an interface with no unsaved state;
# the unit's own TimeoutStopSec is 15.
i=0
while [ "$i" -lt 50 ]; do
  gone && exit 0
  sleep 0.1
  i=$((i + 1))
done

signal -KILL
i=0
while [ "$i" -lt 20 ]; do
  gone && exit 0
  sleep 0.1
  i=$((i + 1))
done

still="$(matching | tr '\n' ' ')"
echo "mediabox-ui-reap: arayüz hâlâ ayakta: $still" >&2
exit 0
