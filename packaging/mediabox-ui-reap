#!/bin/sh
#
# What this unit starts is not in its cgroup, so somebody has to wait for it.
#
# PAMName=login puts the compositor and everything it starts into a PAM session
# scope instead of into mediabox-tv-ui.service's own cgroup. Measured on the
# appliance: `systemd-cgls -u mediabox-tv-ui.service` is empty while sway and
# nine Chromium processes sit in /user.slice/user-0.slice/session-N.scope. That
# means KillMode= never reaches them — systemd signals the main PID and its own
# cgroup, and the cgroup has nothing in it.
#
# A bare `pkill` was not enough either. It delivers SIGTERM and returns
# immediately, so the unit reports "Deactivated successfully" while a browser
# that still holds the GPU and the DRM device is only beginning to unwind, and
# Kodi is started on top of it. This waits for them to actually be gone, and
# insists if they are not.
set -eu

# Two patterns, because this unit ran a browser before it ran the product's own
# interface, and a box part-way through an upgrade may still have one.
#
# The first is the native interface's own path. The second is the kiosk
# browser's profile directory, which no other browser on this box uses: the
# television's browser application and any other Chromium are untouched.
#
# Named separately rather than as one word-split list: a pattern with a space in
# it would silently become two, and the thing this script exists to prevent is a
# process nobody noticed was still running.
NATIVE='/opt/rk3588-mediabox/bin/mediabox-tv'
BROWSER='--user-data-dir=/var/lib/mediabox-ui/chromium'

# Written out rather than looped over a list, for the same reason the patterns
# are named separately: two lines that say what they check beat one that has to
# be reasoned about.
gone() {
  if pgrep -f -- "$NATIVE" >/dev/null 2>&1; then
    return 1
  fi
  if pgrep -f -- "$BROWSER" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

signal() {
  pkill "$1" -f -- "$NATIVE" 2>/dev/null || true
  pkill "$1" -f -- "$BROWSER" 2>/dev/null || true
}

signal -TERM

# Five seconds is generous for an interface with no unsaved state;
# the unit's own TimeoutStopSec is 15.
i=0
while [ "$i" -lt 50 ]; do
  gone && exit 0
  sleep 0.1
  i=$((i + 1))
done

signal -KILL
i=0
while [ "$i" -lt 20 ]; do
  gone && exit 0
  sleep 0.1
  i=$((i + 1))
done

still="$(pgrep -f -- "$NATIVE" 2>/dev/null | tr '\n' ' ')$(pgrep -f -- "$BROWSER" 2>/dev/null | tr '\n' ' ')"
echo "mediabox-ui-reap: arayüz hâlâ ayakta: $still" >&2
exit 0
