<?xml version="1.0" encoding="UTF-8"?>
<!--
  Back means what it means in Kodi: one step back, and nothing more.

  This file used to rebind Back on Kodi's home window to hand the television
  over to the interface. That made Back close Kodi, which it does on no other
  box, and it made leaving a menu one press away from leaving the application.
  Getting back to the interface belongs to the remote's Home key, which the
  control plane already answers, not to Back.

  What is rebound here is Back during playback, and only that.
-->
<keymap>
  <!--
    Back while a film is on: leave full screen and show Kodi's menu with the
    film still running behind it. That is what Kodi does on every other box and
    what the remote is expected to do; the earlier version of this file only
    rebound the home window, so Back during playback fell through to Kodi's own
    top-level answer and the film went away.
  -->
  <FullscreenVideo>
    <keyboard>
      <escape>Fullscreen</escape>
      <backspace>Fullscreen</backspace>
    </keyboard>
    <remote>
      <back>Fullscreen</back>
    </remote>
    <gamepad>
      <b>Fullscreen</b>
    </gamepad>
  </FullscreenVideo>

</keymap>
