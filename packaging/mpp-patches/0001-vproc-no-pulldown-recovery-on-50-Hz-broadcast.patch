--- a/mpp/vproc/mpp_dec_vproc.c
+++ b/mpp/vproc/mpp_dec_vproc.c
@@ -654,10 +654,13 @@
 
         dec_vproc_output_dei_v2(ctx, frm, 0);
 
-        if (ctx->dei_info.pd_types == PD_TYPES_UNKNOWN)
-            ctx->pd_mode = 0;
-        else
-            ctx->pd_mode = 1;
+        /* MediaBox: never pulldown recovery. IEP2 knows only 3:2 cadences
+         * (PD_TYPES_*), which a 50 Hz broadcast never carries: on 1080i50
