diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
@@ -14,6 +14,7 @@
 #include "windowing/WinSystem.h"
 #include "windowing/gbm/drm/DRMAtomic.h"
 #include "utils/DRMHelpers.h"
+#include "utils/HDRUtils.h"
 
 #include <utility>
 
@@ -198,14 +199,32 @@ void CVideoLayerBridgeDRMPRIME::Configure(CVideoBufferDRMPRIME* buffer)
   if (colorRange)
     m_DRM->AddProperty(plane, "COLOR_RANGE", colorRange.value());
 
+  // Rockchip VOP2 decides whether a plane contains HDR samples from this
+  // atomic-only property. Connector HDR_OUTPUT_METADATA describes the wire;
+  // it does not tag the input plane. Leaving a PQ NV15 plane at the default
+  // EOTF=0 makes VOP2 classify it as SDR and run the SDR-to-HDR path before
+  // sending an already-PQ picture to an HDR output.
+  const auto eotf = KODI::UTILS::GetEOTF(picture);
+  if (plane->SupportsProperty("EOTF"))
+  {
+    // Kodi's Eotf values intentionally follow linux/hdmi.h: SDR=0,
+    // traditional HDR=1, SMPTE ST 2084=2 and HLG=3.
+    m_DRM->AddProperty(plane, "EOTF", static_cast<uint64_t>(eotf));
+  }
+  else
+  {
+    CLog::LogF(LOGWARNING, "direct video plane {} has no EOTF property",
+               plane->GetPlaneId());
+  }
+
   // The bridge's own view of the transition. Pairing this with the MP2COLOR
   // line SetColorimetry emits is what shows which connector state each
   // GUI/video/OSD transition actually asked for.
   CLog::LogF(LOGDEBUG,
              "MP2COLOR where=VideoLayerBridge:Configure plane={} plane_fourcc={} encoding={} "
-             "range={}",
+             "range={} eotf={}",
              plane->GetPlaneId(), DRMHELPERS::FourCCToString(plane->GetFormat()),
-             GetColorEncoding(picture), GetColorRange(picture));
+             GetColorEncoding(picture), GetColorRange(picture), static_cast<int>(eotf));
 }
 
