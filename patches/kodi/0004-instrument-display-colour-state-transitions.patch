+namespace
+{
+std::string FourccToString(uint32_t fourcc)
+{
+  if (fourcc == 0)
+    return "none";
+  char b[5] = {static_cast<char>(fourcc & 0xff), static_cast<char>((fourcc >> 8) & 0xff),
+               static_cast<char>((fourcc >> 16) & 0xff), static_cast<char>((fourcc >> 24) & 0xff),
+               0};
+  return std::string(b);
+}
+
+std::string PropOrDash(const KODI::WINDOWING::GBM::CDRMObject* obj, const char* name)
+{
+  if (!obj)
+    return "-";
+  auto* mutableObj = const_cast<KODI::WINDOWING::GBM::CDRMObject*>(obj);
+  if (!mutableObj->SupportsProperty(name))
+    return "absent";
+  auto v = obj->GetPropertyValue(name);
+  return v ? std::to_string(v.value()) : "?";
+}
+} // namespace
+
+void CWinSystemGbm::LogColorState(const char* where) const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return;
+
+  const CDRMPlane* gui = drm->GetGuiPlane();
+  const CDRMPlane* video = drm->GetVideoPlane();
+  const CDRMConnector* connector = drm->GetConnector();
+  const CDRMCrtc* crtc = drm->GetCrtc();
+
+  CLog::Log(LOGDEBUG,
+            "MP2COLOR where={} gui_plane={}/{} video_plane={}/{} yuv_scanout={} "
+            "colorimetry={} eotf={} "
+            "gui[COLOR_ENCODING={} COLOR_RANGE={}] video[COLOR_ENCODING={} COLOR_RANGE={}] "
+            "conn[Colorspace={} color_depth={} max_bpc={} HDR_OUTPUT_METADATA={}] crtc={}",
+            where,
+            gui ? std::to_string(gui->GetPlaneId()) : "-",
+            gui ? FourccToString(gui->GetFormat()) : "-",
+            video ? std::to_string(video->GetPlaneId()) : "-",
+            video ? FourccToString(video->GetFormat()) : "-",
+            IsDirectToPlaneYuvScanout() ? 1 : 0,
+            KODI::UTILS::ColorimetryToString(m_colorimetry),
+            static_cast<int>(m_eotf),
+            PropOrDash(gui, "COLOR_ENCODING"), PropOrDash(gui, "COLOR_RANGE"),
+            PropOrDash(video, "COLOR_ENCODING"), PropOrDash(video, "COLOR_RANGE"),
+            PropOrDash(connector, "Colorspace"), PropOrDash(connector, "color_depth"),
+            PropOrDash(connector, "max bpc"), PropOrDash(connector, "HDR_OUTPUT_METADATA"),
+            crtc ? std::to_string(crtc->GetCrtcId()) : "-");
 }
 
