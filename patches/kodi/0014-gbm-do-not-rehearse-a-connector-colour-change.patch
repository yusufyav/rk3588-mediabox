+std::vector<std::string> CDRMAtomic::CDRMAtomicRequest::PropertyNames(CDRMObject* object) const
+{
+  std::vector<std::string> names;
+  if (auto properties = m_atomicRequestItems.find(object);
+      properties != m_atomicRequestItems.end())
+  {
+    for (const auto& property : properties->second)
+      names.emplace_back(object->GetPropertyName(property.first));
+  }
+  return names;
+}
