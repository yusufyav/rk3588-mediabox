+// The connector properties the output colour is worked out from: the pixel
+// encoding, its depth (the vendor's enum and the standard property), the
+// colorimetry and the HDR metadata, whose EOTF decides whether the vendor
+// driver prefers YCbCr 4:2:2. These are the properties a TEST_ONLY rehearsal
+// must not see; see RehearseWithTestOnly.
+constexpr std::array<std::string_view, 5> CONNECTOR_COLOUR_PROPERTIES = {
+    "color_format", "color_depth", "max bpc", "Colorspace", "HDR_OUTPUT_METADATA"};
+
+constexpr bool IsConnectorColourProperty(std::string_view name)
+{
+  return std::ranges::find(CONNECTOR_COLOUR_PROPERTIES, name) !=
+         CONNECTOR_COLOUR_PROPERTIES.end();
+}
+
+// Whether a commit is rehearsed with TEST_ONLY first, given the names of the
+// connector properties the caller put in the request -- before the commit
+// adds the connector's CRTC_ID for a modeset of its own.
+//
+// A request that changes the connector's colour is not rehearsed. The vendor
+// RK3588 HDMI driver's atomic_check is not free of side effects: it stores the
+// output bus format it works out in the driver itself, and the 6.1.172 driver
+// decides whether the colour changed by comparing against that stored value
+// instead of the old state. After a rehearsal the real commit therefore sees
+// no change and never rewrites the AVI infoframe -- YCbCr 4:2:2 on the wire,
+// "RGB, BT.709" in the infoframe, and the television shows black as blue.
+// Measured on 6.1.172; the 6.1.115 driver compares states and was unaffected.
+//
+// Everything else keeps its rehearsal: page flips, and modesets too. A
+// modeset that leaves the colour alone reaches the same check, but the bus
+// format it works out is the one already in place, and the full enable the
+// modeset goes through writes the infoframe regardless.
+template<typename Names>
+constexpr bool RehearseWithTestOnly(const Names& connectorProperties)
+{
+  return std::ranges::none_of(connectorProperties, [](const auto& name)
+                              { return IsConnectorColourProperty(name); });
+}
+
+} // namespace ATOMIC
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
