+std::optional<int> CWinSystemGbm::SinkMaxCharacterRateKHz() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector)
+    return {};
+
+  const std::vector<uint8_t> edid = connector->GetEDID();
+  if (edid.size() < 128 || edid[0] != 0x00 || edid[1] != 0xFF)
+    return {};
+
+  std::optional<int> rate;
+  // Walk the CTA-861 extension blocks' data block collections. Two vendor
+  // blocks carry a ceiling: the HDMI 1.4 one, and the HDMI Forum one that
+  // supersedes it. A 2.0 sink leaves a value in the older field that a 1.4
+  // source can live with, so the Forum block wins wherever it appears.
+  for (size_t block = 128; block + 128 <= edid.size(); block += 128)
+  {
+    const uint8_t* cta = &edid[block];
+    if (cta[0] != 0x02)
+      continue;
+    const size_t dtd = cta[2];
+    if (dtd < 4 || dtd > 127)
+      continue;
+    size_t at = 4;
+    while (at < dtd)
+    {
+      const size_t len = cta[at] & 0x1F;
+      const size_t tag = cta[at] >> 5;
+      const size_t end = at + 1 + len;
+      if (len == 0 || end > dtd)
+        break;
+      const uint8_t* payload = &cta[at + 1];
+      if (tag == 3 && len >= 3)
+      {
+        // HDMI 1.4: OUI 00-0C-03, then two bytes of source physical address,
+        // the deep colour flags, and the maximum TMDS clock in units of 5 MHz.
+        if (payload[0] == 0x03 && payload[1] == 0x0C && payload[2] == 0x00 && len >= 7 &&
+            payload[6] != 0 && !rate)
+          rate = payload[6] * 5000;
+        // HDMI Forum: OUI C4-5D-D8, a version byte, then the maximum character
+        // rate in the same units.
+        if (payload[0] == 0xD8 && payload[1] == 0x5D && payload[2] == 0xC4 && len >= 5 &&
+            payload[4] != 0)
+          rate = payload[4] * 5000;
+      }
+      at = end;
+    }
+  }
+  return rate;
+}
+
+bool CWinSystemGbm::RgbLinkFits(int bpc) const
+{
+  const std::optional<int> ceiling = SinkMaxCharacterRateKHz();
+  if (!ceiling)
+  {
+    // A sink that declared nothing is not a sink that declared a narrow link.
+    // A DVI monitor with no CTA extension at all takes RGB and nothing else,
+    // and switching it to YCbCr on the strength of a missing byte would break
+    // a display this has no evidence about. Behaviour is unchanged there.
+    return true;
+  }
+
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return true;
+
+  const int clock = drm->GetCurrentModeClockKHz();
+  if (clock <= 0)
+    return true;
+
+  // RGB and 4:4:4 carry every component of every pixel, so depth costs rate in
+  // proportion. (4:2:2 is the one that does not, which is exactly why it is
+  // where a deep-colour link ends up when there is no room for RGB.)
+  const int64_t needed = static_cast<int64_t>(clock) * bpc / 8;
+  const bool fits = needed <= *ceiling;
+  CLog::LogF(LOGDEBUG, "RGB {}-bit at {} kHz needs {} kHz, sink accepts {} kHz: {}", bpc, clock,
+             needed, *ceiling, fits ? "fits" : "does not fit");
+  return fits;
+}
