@@ -878,6 +1036,32 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
     return false;
   }
 
+  // PQ content, and now the question this used not to ask: can the link this
+  // television is on actually carry HDR? Where it cannot, saying so is the
+  // whole fix. The connector stays SDR, the video plane keeps the PQ tag that
+  // `0008` gives it, and VOP2 converts in hardware -- which is what the vendor
+  // Android stack does on a socket that cannot take HDR, and what this box
+  // used to fail to do while reporting HDR on screen.
+  if (!HdrLinkFits())
+  {
+    CLog::LogF(LOGDEBUG, "this link cannot carry HDR at this mode; leaving the connector SDR");
+    if (connector->SupportsProperty("HDR_OUTPUT_METADATA"))
+    {
+      drm->AddProperty(connector, "HDR_OUTPUT_METADATA", 0);
+      m_hdrBlob.Reset();
+    }
+    // Eight bits, and this is the half that actually keeps the link RGB.
+    // Holding ten is what `0011` does to stop the driver preferring 4:2:2 --
+    // but that only works where ten-bit RGB fits. Where it does not, holding
+    // ten is what *causes* the 4:2:2 link, because the driver keeps the depth
+    // and gives up the chroma instead. So depth is what gets given up here.
+    SetDeepColor(false);
+    m_eotf = KODI::UTILS::Eotf::TRADITIONAL_SDR;
+    drm->SetActive(true);
+    LogColorState("SetHDR:exit:link-cannot-carry-hdr");
+    return false;
+  }
+
   KODI::UTILS::Eotf eotf = KODI::UTILS::GetEOTF(*videoPicture);
   m_eotf = eotf;
 
