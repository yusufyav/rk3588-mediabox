+bool CWinSystemGbm::CanDisplayComposeSdrGuiOverHdrVideo()
+{
+  // Some display controllers convert an SDR layer into the HDR output
+  // themselves when the composition mixes SDR and HDR layers, which is how the
+  // vendor Android stack drives this hardware: the GUI stays plain sRGB on a
+  // plane tagged SDR, the video plane is tagged PQ, and the controller does the
+  // SDR-to-HDR conversion. Kodi's software HDR compositor defeats that path by
+  // PQ-encoding the GUI and tagging its plane PQ as well, leaving the hardware
+  // nothing to recognise as SDR.
+  //
+  // The capability is expressed rather than assumed. Direct-to-plane scanout
+  // must be running with a GUI plane distinct from the video plane, and both
+  // planes must carry the per-plane EOTF property, since that is what lets the
+  // mix be described to the hardware at all. Displays that cannot be told which
+  // layer is SDR keep Kodi's software compositing path.
+  if (!m_DRM)
+    return false;
+
+  CDRMPlane* videoPlane = m_DRM->GetVideoPlane();
+  CDRMPlane* guiPlane = m_DRM->GetGuiPlane();
+
+  if (!videoPlane || !guiPlane || videoPlane == guiPlane)
+    return false;
+
+  return videoPlane->SupportsProperty("EOTF") && guiPlane->SupportsProperty("EOTF");
+}
