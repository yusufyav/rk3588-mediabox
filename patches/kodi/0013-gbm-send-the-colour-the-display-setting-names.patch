new file mode 100644
index 0000000..92d192f
--- /dev/null
+++ b/xbmc/windowing/gbm/OutputPlan.h
@@ -0,0 +1,120 @@
+/*
+ *  Copyright (C) 2026 MediaBox
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// MediaBox's display setting, as Kodi takes it: /run/mediabox/output-plan,
+// used only when it was made for the display that is there now.
+//
+// The appliance's control plane writes the plan for one display generation
+// of its observer -- one boot, one connector, one sink by the SHA-256 of its
+// EDID -- and removes it when that generation ends. Removal is not enough on
+// its own: between a sink changing and the control plane reacting, the file
+// still names the last sink, and its colour lines are that sink's. So nothing
+// here trusts the file. A plan is used only when its provenance matches what
+// is there now, by three accounts that do not depend on each other: the
+// kernel's boot, the observer's current generation and sink, and the
+// connector Kodi itself drives with the EDID the kernel has on it now.
+//
+// No Kodi types in here, so it can be tested on its own.
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM::OUTPUTPLAN
+{
+
+// The plan version this reader understands. A plan without it -- an older
+// one that carried no provenance -- is not a plan.
+constexpr int SCHEMA = 2;
+
+// A colour by this driver's `color_format` enum name, and a depth.
+struct Colour
+{
+  std::string format;
+  int bits = 8;
+
+  bool operator==(const Colour&) const = default;
+};
+
+// The colour sent at one mode: for SDR, and for an HDR film (none where
+// nothing carries HDR10 there).
+struct Colours
+{
+  std::optional<Colour> sdr;
+  std::optional<Colour> hdr;
+
+  bool operator==(const Colours&) const = default;
+};
+
+// The display now.
+struct Display
+{
+  // The kernel's boot id.
+  std::string bootId;
+  // The observer's published snapshot, when there is a recent one.
+  bool observed = false;
+  std::string observerBootId;
+  uint64_t generation = 0;
+  bool connected = false;
+  std::string observerConnector;
+  std::string observerEdidSha256;
+  // The connector Kodi drives, and the SHA-256 of the EDID the kernel has on
+  // it now.
+  std::string connector;
+  std::string edidSha256;
+
+  bool operator==(const Display&) const = default;
+};
+
+// What a plan was made for, and its colour lines.
+struct Plan
+{
+  std::string bootId;
+  uint64_t generation = 0;
+  std::string connector;
+  std::string edidSha256;
+  std::vector<std::string> colours;
+
+  // `<boot>:<generation> <connector> <edid, short>`, for the log.
+  std::string Provenance() const;
+};
+
+// A plan file, whole, or why it is not one.
+std::optional<Plan> Parse(const std::string& text, std::string& why);
+
+// Why this plan is not for the display now; nothing when it is.
+std::optional<std::string> Stale(const Plan& plan, const Display& now);
+
+// The colour line for a mode, keyed `<w>x<h>[i]@<clock kHz>/<htotal>x<vtotal>`.
+std::optional<Colours> ColoursAt(const Plan& plan, const std::string& mode);
+
+// The outcome of one read: whether a current plan was found, the colours it
+// names at the mode (none when it has no line for it), and either its
+// provenance or why it was not used.
+struct Decision
+{
+  bool accepted = false;
+  std::optional<Colours> colours;
+  std::string provenance;
+  std::string why;
+};
+
+// Reads the display and the plan, checks one against the other, then reads
+// both again and takes the plan only if neither moved in between. What is
+// used is what was checked: the colour lines come from the same bytes as the
+// provenance, and nothing is kept for the next caller -- every decision reads
+// again.
+Decision Read(const std::function<std::optional<std::string>()>& readPlan,
+              const std::function<Display()>& readDisplay,
+              const std::string& mode);
+
+} // namespace KODI::WINDOWING::GBM::OUTPUTPLAN
