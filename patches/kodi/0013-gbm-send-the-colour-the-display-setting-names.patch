+namespace
+{
+constexpr const char* OUTPUT_PLAN = "/run/mediabox/output-plan";
+constexpr const char* OBSERVER_SNAPSHOT = "/run/mediabox-display-observer/snapshot.json";
+constexpr int64_t OBSERVER_SCHEMA = 2;
+// The observer's own rule (STALE_AFTER): a snapshot older than this is not
+// the display now -- the observer has stopped looking.
+constexpr uint64_t OBSERVER_STALE_AFTER_NS = 10'000'000'000ULL;
+
+std::optional<std::string> ReadFile(const char* path)
+{
+  std::ifstream file(path, std::ios::binary);
+  if (!file)
+    return {};
+  std::ostringstream text;
+  text << file.rdbuf();
+  if (file.bad())
+    return {};
+  return text.str();
+}
+
+std::string Spell(const std::optional<OUTPUTPLAN::Colour>& colour)
+{
+  return colour ? colour->format + ":" + std::to_string(colour->bits) : "none";
+}
+} // namespace
+
+OUTPUTPLAN::Display CWinSystemGbm::CurrentDisplay() const
+{
+  OUTPUTPLAN::Display now;
+  if (std::optional<std::string> boot = ReadFile("/proc/sys/kernel/random/boot_id"))
+    now.bootId = StringUtils::Trim(*boot);
+
+  // The observer's generation and the sink it sees, if it is still looking.
+  CVariant snapshot;
+  if (std::optional<std::string> text = ReadFile(OBSERVER_SNAPSHOT);
+      text && CJSONVariantParser::Parse(*text, snapshot) && snapshot.isObject() &&
+      snapshot["schema"].asInteger() == OBSERVER_SCHEMA)
+  {
+    timespec clock{};
+    clock_gettime(CLOCK_BOOTTIME, &clock);
+    const uint64_t nowNs = static_cast<uint64_t>(clock.tv_sec) * 1'000'000'000ULL +
+                           static_cast<uint64_t>(clock.tv_nsec);
+    const uint64_t at = snapshot["boottime_ns"].asUnsignedInteger();
+    const CVariant& generation = snapshot["generation"];
+    const CVariant& material = snapshot["material"];
+    const CVariant& seq = generation["seq"];
+    now.observed = at > 0 && at <= nowNs && nowNs - at <= OBSERVER_STALE_AFTER_NS &&
+                   generation["boot_id"].isString() &&
+                   (seq.isInteger() || seq.isUnsignedInteger()) &&
+                   material["connected"].isBoolean();
+    now.observerBootId = generation["boot_id"].asString();
+    now.generation = seq.asUnsignedInteger();
+    now.connected = material["connected"].asBoolean();
+    now.observerConnector = material["connector"].asString();
+    now.observerEdidSha256 = material["edid_sha256"].asString();
+  }
+
+  // The connector this player drives, and the EDID the kernel has on it now:
+  // read live, not the copy taken when Kodi started, which names whatever
+  // sink was there then.
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return now;
+  now.connector = connector->GetName();
+  const std::optional<uint64_t> blobId = ReadLiveConnectorProperty("EDID");
+  if (!blobId || *blobId == 0)
+    return now;
+  drmModePropertyBlobPtr blob = drmModeGetPropertyBlob(drm->GetFileDescriptor(), *blobId);
+  if (!blob)
+    return now;
+  if (blob->length > 0)
+    now.edidSha256 = KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256,
+                                                       blob->data, blob->length);
+  drmModeFreePropertyBlob(blob);
+  return now;
+}
+
+OUTPUTPLAN::Decision CWinSystemGbm::PlannedOutput() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+  const int clock = drm->GetCurrentModeClockKHz();
+  if (clock <= 0)
+    return {};
+  // The clock alone does not name a mode: 2160p23.976 and 2160p29.97 share
+  // one and the totals tell them apart; 1080i60 and 1080p30 share those too,
+  // and only the interlace flag does.
+  const std::string key = std::to_string(drm->GetCurrentModeWidth()) + "x" +
+                          std::to_string(drm->GetCurrentModeHeight()) +
+                          (drm->IsCurrentModeInterlaced() ? "i" : "") + "@" +
+                          std::to_string(clock) + "/" +
+                          std::to_string(drm->GetCurrentModeHTotal()) + "x" +
+                          std::to_string(drm->GetCurrentModeVTotal());
+
+  OUTPUTPLAN::Decision plan = OUTPUTPLAN::Read([] { return ReadFile(OUTPUT_PLAN); },
+                                               [this] { return CurrentDisplay(); }, key);
+  if (!plan.accepted)
+    CLog::LogF(LOGWARNING, "output plan rejected: {}; the link is chosen by this player's own rule",
+               plan.why);
+  else if (!plan.colours)
+    CLog::LogF(LOGINFO, "output plan accepted: {}; it has no line for {}", plan.provenance, key);
+  else
+    CLog::LogF(LOGINFO, "output plan accepted: {} at {}: SDR {} HDR {}", plan.provenance, key,
+               Spell(plan.colours->sdr), Spell(plan.colours->hdr));
+  return plan;
+}
+
+std::optional<bool> CWinSystemGbm::RequestOutputFormat(const std::string& name)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty("color_format"))
+    return {};
+
+  std::optional<uint64_t> rgb = connector->GetPropertyEnumValue("color_format", "rgb");
+  std::optional<uint64_t> wanted = connector->GetPropertyEnumValue("color_format", name.c_str());
+  if (!rgb || !wanted)
+  {
