diff --git a/xbmc/windowing/gbm/OutputPlan.cpp b/xbmc/windowing/gbm/OutputPlan.cpp
new file mode 100644
index 0000000..f6bd3a2
--- /dev/null
+++ b/xbmc/windowing/gbm/OutputPlan.cpp
@@ -0,0 +1,181 @@
+/*
+ *  Copyright (C) 2026 MediaBox
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "OutputPlan.h"
+
+#include <map>
+#include <sstream>
+
+namespace KODI::WINDOWING::GBM::OUTPUTPLAN
+{
+namespace
+{
+bool Digits(const std::string& text)
+{
+  return !text.empty() && text.size() <= 19 &&
+         text.find_first_not_of("0123456789") == std::string::npos;
+}
+
+std::string Short(const std::string& sha)
+{
+  return sha.substr(0, 12);
+}
+
+std::optional<Colour> ParseColour(const std::string& token)
+{
+  const size_t colon = token.find(':');
+  if (token == "none" || colon == std::string::npos || colon == 0)
+    return {};
+  const std::string bits = token.substr(colon + 1);
+  if (!Digits(bits) || bits.size() > 2)
+    return {};
+  return Colour{token.substr(0, colon), std::stoi(bits)};
+}
+} // namespace
+
+std::string Plan::Provenance() const
+{
+  return bootId + ":" + std::to_string(generation) + " " + connector + " " + Short(edidSha256);
+}
+
+std::optional<Plan> Parse(const std::string& text, std::string& why)
+{
+  std::map<std::string, std::string> values;
+  Plan plan;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line))
+  {
+    if (line.starts_with("colour "))
+      plan.colours.push_back(line);
+    else if (const size_t equals = line.find('='); equals != std::string::npos)
+      values[line.substr(0, equals)] = line.substr(equals + 1);
+  }
+  auto get = [&values](const char* key) -> std::optional<std::string> {
+    auto it = values.find(key);
+    if (it == values.end() || it->second.empty())
+      return {};
+    return it->second;
+  };
+
+  const std::optional<std::string> schema = get("schema");
+  if (!schema)
+  {
+    why = "the plan has no schema: one from before plans carried their provenance";
+    return {};
+  }
+  if (*schema != std::to_string(SCHEMA))
+  {
+    why = "the plan is schema " + *schema + ", this reader takes " + std::to_string(SCHEMA);
+    return {};
+  }
+  for (const char* key : {"boot_id", "generation", "connector", "edid_sha256"})
+  {
+    if (!get(key))
+    {
+      why = std::string("the plan has no ") + key;
+      return {};
+    }
+  }
+  if (!Digits(*get("generation")))
+  {
+    why = "the plan's generation is not a number";
+    return {};
+  }
+  plan.bootId = *get("boot_id");
+  plan.generation = std::stoull(*get("generation"));
+  plan.connector = *get("connector");
+  plan.edidSha256 = *get("edid_sha256");
+  return plan;
+}
+
+std::optional<std::string> Stale(const Plan& plan, const Display& now)
+{
+  // This boot.
+  if (now.bootId.empty())
+    return "the kernel's boot id cannot be read";
+  if (plan.bootId != now.bootId)
+    return "the plan is from boot " + plan.bootId + ", this is " + now.bootId;
+
+  // The observer's current generation, and the sink it sees.
+  if (!now.observed)
+    return "no recent observer snapshot to check the plan against";
+  if (now.observerBootId != now.bootId)
+    return "the observer's snapshot is from boot " + now.observerBootId;
+  if (plan.generation != now.generation)
+    return "the plan is for generation " + std::to_string(plan.generation) +
+           ", the display is at " + std::to_string(now.generation);
+  if (!now.connected)
+    return "the observer sees no connected sink";
+  if (plan.connector != now.observerConnector || plan.edidSha256 != now.observerEdidSha256)
+    return "the plan is for " + plan.connector + " " + Short(plan.edidSha256) +
+           ", the observer sees " + now.observerConnector + " " + Short(now.observerEdidSha256);
+
+  // And the hardware Kodi drives, read by Kodi now: its connector, and the
+  // EDID the kernel has on it. This is what catches a sink that changed
+  // before the observer looked.
+  if (now.connector.empty())
+    return "Kodi drives no connector";
+  if (plan.connector != now.connector)
+    return "the plan is for " + plan.connector + ", Kodi drives " + now.connector;
+  if (now.edidSha256.empty())
+    return "no EDID on " + now.connector + " now";
+  if (plan.edidSha256 != now.edidSha256)
+    return "the plan is for EDID " + Short(plan.edidSha256) + ", " + now.connector + " has " +
+           Short(now.edidSha256) + " now";
+  return {};
+}
+
+std::optional<Colours> ColoursAt(const Plan& plan, const std::string& mode)
+{
+  // colour <w>x<h>[i]@<clock kHz>/<htotal>x<vtotal> <sdr format:bits> <hdr format:bits|none>
+  for (const std::string& line : plan.colours)
+  {
+    std::istringstream words(line);
+    std::string tag, key, sdr, hdr;
+    if (!(words >> tag >> key >> sdr >> hdr) || key != mode)
+      continue;
+    return Colours{ParseColour(sdr), ParseColour(hdr)};
+  }
+  return {};
+}
+
+Decision Read(const std::function<std::optional<std::string>()>& readPlan,
+              const std::function<Display()>& readDisplay,
+              const std::string& mode)
+{
+  Decision decision;
+  const Display before = readDisplay();
+  const std::optional<std::string> text = readPlan();
+  if (!text)
+  {
+    decision.why = "there is no plan";
+    return decision;
+  }
+  const std::optional<Plan> plan = Parse(*text, decision.why);
+  if (!plan)
+    return decision;
+  if (std::optional<std::string> stale = Stale(*plan, before))
+  {
+    decision.why = *stale;
+    return decision;
+  }
+  // The check above held for one instant. Look again: a generation that
+  // ended, or a plan rewritten, while it ran is not the one that was checked.
+  if (readDisplay() != before || readPlan() != text)
+  {
+    decision.why = "the display or its plan changed while the plan was checked";
+    return decision;
+  }
+  decision.accepted = true;
+  decision.provenance = plan->Provenance();
+  decision.colours = ColoursAt(*plan, mode);
+  return decision;
+}
+
+} // namespace KODI::WINDOWING::GBM::OUTPUTPLAN
