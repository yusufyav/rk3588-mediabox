+std::optional<CWinSystemGbm::OutputPlan> CWinSystemGbm::PlannedOutput() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+  const int clock = drm->GetCurrentModeClockKHz();
+  if (clock <= 0)
+    return {};
+  // The clock alone does not name a mode: 2160p23.976 and 2160p29.97 share
+  // one and the totals tell them apart; 1080i60 and 1080p30 share those too,
+  // and only the interlace flag does.
+  const std::string key = std::to_string(drm->GetCurrentModeWidth()) + "x" +
+                          std::to_string(drm->GetCurrentModeHeight()) +
+                          (drm->IsCurrentModeInterlaced() ? "i" : "") + "@" +
+                          std::to_string(clock) + "/" +
+                          std::to_string(drm->GetCurrentModeHTotal()) + "x" +
+                          std::to_string(drm->GetCurrentModeVTotal());
+
+  std::ifstream file("/run/mediabox/output-plan");
+  if (!file)
+    return {};
+
+  auto parse = [](const std::string& token) -> std::optional<PlannedColour> {
+    const size_t colon = token.find(':');
+    if (token == "none" || colon == std::string::npos)
+      return {};
+    const std::string bits = token.substr(colon + 1);
+    if (bits.empty() || bits.find_first_not_of("0123456789") != std::string::npos)
+      return {};
+    return PlannedColour{token.substr(0, colon), std::stoi(bits)};
+  };
+
+  // colour <w>x<h>[i]@<clock kHz>/<htotal>x<vtotal> <sdr format:bits> <hdr format:bits|none>
+  std::string line;
+  while (std::getline(file, line))
+  {
+    std::istringstream words(line);
+    std::string tag, mode, sdr, hdr;
+    if (!(words >> tag >> mode >> sdr >> hdr) || tag != "colour" || mode != key)
+      continue;
+    CLog::LogF(LOGDEBUG, "display setting at {}: SDR {} HDR {}", key, sdr, hdr);
+    return OutputPlan{parse(sdr), parse(hdr)};
+  }
+  CLog::LogF(LOGDEBUG, "no display setting for {}", key);
+  return {};
+}
+
+std::optional<bool> CWinSystemGbm::RequestOutputFormat(const std::string& name)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty("color_format"))
+    return {};
+
+  std::optional<uint64_t> rgb = connector->GetPropertyEnumValue("color_format", "rgb");
+  std::optional<uint64_t> wanted = connector->GetPropertyEnumValue("color_format", name.c_str());
+  if (!rgb || !wanted)
+  {
+    CLog::LogF(LOGWARNING, "connector has no \"{}\" color_format", name);
+    return {};
+  }
+
+  CLog::LogF(LOGDEBUG, "requesting output pixel format \"{}\" ({}) from the display setting",
+             name, wanted.value());
+  drm->AddProperty(connector, "color_format", wanted.value());
+  drm->SetActive(true);
+  return wanted.value() == rgb.value();
+}
+
+void CWinSystemGbm::SetColourDepth(int bits)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return;
+
+  auto connector = drm->GetConnector();
+  if (!connector)
+    return;
+
+  if (connector->SupportsProperty("max bpc"))
+  {
+    CLog::LogF(LOGDEBUG, "setting max bpc to {} from the display setting", bits);
+    drm->AddProperty(connector, "max bpc", static_cast<uint64_t>(bits));
+    drm->SetActive(true);
+    return;
+  }
+
+  if (connector->SupportsProperty("color_depth"))
+  {
+    const std::string want = std::to_string(bits * 3) + "bit";
+    std::optional<uint64_t> value = connector->GetPropertyEnumValue("color_depth", want.c_str());
+    if (!value)
+    {
+      CLog::LogF(LOGWARNING, "connector has no \"{}\" color_depth", want);
+      return;
+    }
+    CLog::LogF(LOGDEBUG, "setting color_depth to {} from the display setting", want);
+    drm->AddProperty(connector, "color_depth", value.value());
+    drm->SetActive(true);
+  }
+}
