diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index b0b395d..a2276c6 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -109,6 +109,31 @@ public:
   // Whether HDR can be put on this link at all, at the mode currently set.
   bool HdrLinkFits() const;
 
+  // The colour MediaBox's display setting sends at the mode currently set --
+  // a format by this driver's own enum name and a depth -- for SDR and for an
+  // HDR film. Read from /run/mediabox/output-plan, which the appliance's
+  // control plane writes from the HDMI rules and the person's choice, so this
+  // player sends what the appliance's own player sends at the same mode.
+  // Empty when there is no plan, or no line for this mode.
+  struct PlannedColour
+  {
+    std::string format;
+    int bits = 8;
+  };
+  struct OutputPlan
+  {
+    std::optional<PlannedColour> sdr;
+    std::optional<PlannedColour> hdr;
+  };
+  std::optional<OutputPlan> PlannedOutput() const;
+
+  // Ask for one output pixel format by its enum name. Returns whether it is
+  // RGB, or nothing when the driver cannot be asked.
+  std::optional<bool> RequestOutputFormat(const std::string& name);
+
+  // Ask for a depth in bits per component.
+  void SetColourDepth(int bits);
+
   // A connector property's CURRENT value, read from the kernel rather than
   // from CDRMObject's cache, which only tracks values Kodi itself set.
   std::optional<uint64_t> ReadLiveConnectorProperty(const char* name) const;
