+bool CWinSystemGbm::IsDirectToPlaneYuvScanout() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return false;
+
+  const CDRMPlane* videoPlane = drm->GetVideoPlane();
+  if (!videoPlane)
+    return false;
+
+  // A video plane is only bound when a decoded buffer is being scanned out
+  // directly. Its DRM fourcc is what the display engine is reading, so it is
+  // also what decides whether the composed output can be RGB at all.
+  switch (videoPlane->GetFormat())
+  {
+    case DRM_FORMAT_NV12:
+    case DRM_FORMAT_NV21:
+    case DRM_FORMAT_NV16:
+    case DRM_FORMAT_NV61:
+    case DRM_FORMAT_NV24:
+    case DRM_FORMAT_NV42:
+    case DRM_FORMAT_YUV420:
+    case DRM_FORMAT_YVU420:
+    case DRM_FORMAT_YUYV:
+    case DRM_FORMAT_YVYU:
+    case DRM_FORMAT_UYVY:
+    case DRM_FORMAT_VYUY:
+    case DRM_FORMAT_P010:
+#ifdef DRM_FORMAT_NV15
+    case DRM_FORMAT_NV15:
+#endif
+#ifdef DRM_FORMAT_NV20
+    case DRM_FORMAT_NV20:
+#endif
+#ifdef DRM_FORMAT_NV30
+    case DRM_FORMAT_NV30:
+#endif
+      return true;
+    default:
+      return false;
+  }
+}
+
+void CWinSystemGbm::SetDeepColor(bool enable)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return;
+
+  auto connector = drm->GetConnector();
+  if (!connector)
+    return;
+
+  // The standard property, where the driver has it.
+  if (connector->SupportsProperty("max bpc"))
+  {
+    const uint64_t bpc = enable ? 10 : 8;
+    CLog::LogF(LOGDEBUG, "setting max bpc to {}", bpc);
+    drm->AddProperty(connector, "max bpc", bpc);
+    drm->SetActive(true);
+    return;
+  }
+
+  // Some drivers expose no "max bpc" and carry a "color_depth" enum instead.
+  // Left alone, such a connector transmits 8 bits per component whatever HDR
+  // metadata is attached, so HDR10 would be signalled correctly and then sent
+  // at 8-bit. The enum is resolved by NAME: nothing here assumes how "30bit"
+  // is numbered, or that any particular driver is present.
+  if (connector->SupportsProperty("color_depth"))
+  {
+    const char* want = enable ? "30bit" : "Automatic";
+    std::optional<uint64_t> value = connector->GetPropertyEnumValue("color_depth", want);
+    if (value)
+    {
+      CLog::LogF(LOGDEBUG, "no \"max bpc\" property; setting color_depth to {}", want);
+      drm->AddProperty(connector, "color_depth", value.value());
+      drm->SetActive(true);
+    }
+    else
+    {
+      CLog::LogF(LOGWARNING, "connector has color_depth but no \"{}\" enum value", want);
+    }
+    return;
+  }
+
+  CLog::LogF(LOGDEBUG, "connector exposes neither \"max bpc\" nor \"color_depth\"; "
+                       "deep colour cannot be requested");
+}
