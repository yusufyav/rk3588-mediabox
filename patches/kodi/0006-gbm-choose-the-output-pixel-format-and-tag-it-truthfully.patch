+std::optional<uint64_t> CWinSystemGbm::ReadLiveConnectorProperty(const char* name) const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty(name))
+    return {};
+
+  // Read live rather than from CDRMObject's cache. That cache is filled when
+  // the object is created and afterwards only tracks values Kodi itself sets,
+  // which is right for Kodi's own requests and wrong for anything the driver
+  // owns. The output format is driver-owned: it negotiates down from the
+  // requested one when the link cannot carry it -- a 4K24 10-bit request that
+  // is transmitted as 4:2:2 is the normal case here -- so the cached copy can
+  // describe a signal that is not on the wire.
+  std::unique_ptr<drmModeObjectProperties, ObjectPropertiesDeleter> props(
+      drmModeObjectGetProperties(drm->GetFileDescriptor(), connector->GetId(),
+                                 DRM_MODE_OBJECT_CONNECTOR));
+  if (!props)
+    return {};
+
+  const uint32_t wanted = connector->GetPropertyId(name);
+  for (uint32_t i = 0; i < props->count_props; i++)
+    if (props->props[i] == wanted)
+      return props->prop_values[i];
+
+  return {};
+}
+
+std::optional<bool> CWinSystemGbm::IsYuvOutput() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty("color_format"))
+    return {};
+
+  // Resolved by NAME, like the colour depth enum: nothing here assumes how a
+  // particular driver numbers its output formats.
+  std::optional<uint64_t> rgb = connector->GetPropertyEnumValue("color_format", "rgb");
+  if (!rgb)
+    return {};
+
+  std::optional<uint64_t> live = ReadLiveConnectorProperty("color_format");
+  if (!live)
+    return {};
+
+  return live.value() != rgb.value();
+}
+
+std::optional<bool> CWinSystemGbm::RequestRgbOutput(bool wantRgb)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return {};
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty("color_format"))
+    return {};
+
+  // Enum values resolved by NAME throughout: nothing assumes how a particular
+  // driver numbers its output formats.
+  std::optional<uint64_t> rgb = connector->GetPropertyEnumValue("color_format", "rgb");
+  if (!rgb)
+    return {};
+
+  std::optional<uint64_t> wanted;
+  const char* wantedName = nullptr;
+
+  if (wantRgb)
+  {
+    wanted = rgb;
+    wantedName = "rgb";
+  }
+  else
+  {
+    // Name a YCbCr format rather than trying to remember what the driver
+    // "originally" had. Connector state survives a Kodi restart, so anything
+    // read back at start-up may simply be this code's own request from the
+    // last run -- and handing that back would ask for RGB on the video path,
+    // get a YCbCr link anyway because 10-bit RGB does not fit, and then tag
+    // the wire as RGB. That is exactly the mismatch this file already warns
+    // about in the other direction.
+    //
+    // Best first: the driver negotiates the subsampling down to fit the link,
+    // and asking for 4:4:4 at 4K24 with 10 bits is how a real 4:2:2 10-bit
+    // output is reached here. Whatever it settles on stays YCbCr, so the tag
+    // chosen from this request stays correct.
+    for (const char* name : {"ycbcr444", "ycbcr422", "ycbcr420"})
+    {
+      wanted = connector->GetPropertyEnumValue("color_format", name);
+      if (wanted)
+      {
+        wantedName = name;
+        break;
+      }
+    }
+  }
+
+  if (!wanted)
+    return {};
+
+  CLog::LogF(LOGDEBUG, "requesting output pixel format \"{}\" ({})", wantedName, wanted.value());
+  drm->AddProperty(connector, "color_format", wanted.value());
+  drm->SetActive(true);
+
+  return wanted.value() == rgb.value();
+}
+
+bool CWinSystemGbm::IsHdOrLargerMode() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return true;
+
+  // 720 lines is the CTA-861 boundary between SD and HD colorimetry. Anything
+  // this appliance drives is at or above it, but the mode is read rather than
+  // assumed so that an SD output is signalled correctly too.
+  return drm->GetCurrentMode().iHeight >= 720;
+}
