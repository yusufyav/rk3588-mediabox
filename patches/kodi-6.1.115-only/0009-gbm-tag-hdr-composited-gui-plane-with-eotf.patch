@@ -952,6 +952,31 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   return m_hdrBlob.IsValid();
 }
 
+void CWinSystemGbm::SetGuiPlaneEotf(bool hdrEncoded)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return;
+
+  // Direct-to-plane uses the GUI plane for the EGL back buffer. In
+  // single-plane mode FindVideoPlane uses the video plane as the sole output.
+  CDRMPlane* plane = drm->GetGuiPlane();
+  if (!plane)
+    plane = drm->GetVideoPlane();
+
+  if (!plane || !plane->SupportsProperty("EOTF"))
+  {
+    if (hdrEncoded)
+      CLog::LogF(LOGWARNING, "HDR-composited GUI output plane has no EOTF property");
+    return;
+  }
+
+  const auto eotf = hdrEncoded ? m_eotf : KODI::UTILS::Eotf::TRADITIONAL_SDR;
+  drm->AddProperty(plane, "EOTF", static_cast<uint64_t>(eotf));
+  CLog::LogF(LOGDEBUG, "MP2COLOR where=SetGuiPlaneEotf plane={} hdr_encoded={} eotf={}",
+             plane->GetId(), hdrEncoded, static_cast<uint64_t>(eotf));
+}
+
 bool CWinSystemGbm::IsHDRDisplay()
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
